@page "/Companion"
@model AniLingo.Web.Pages.Companion.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["companion.pageTitle"];
}

<div class="page-shell companion-shell"
     data-companion
     data-pair-url="/api/client/v1/playback-sessions/pair">
    <section class="panel companion-connect" data-companion-connect>
        <span class="eyebrow">@ui["companion.eyebrow.connect"]</span>
        <h1>@ui["companion.title"]</h1>
        <p class="muted">
            @ui["companion.description"]
        </p>

        <form data-pair-form class="form-stack">
            <label>
                <span>@ui["companion.pairingCodeLabel"]</span>
                <input data-pair-code
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="6"
                       pattern="[0-9]{6}"
                       placeholder="123456" />
            </label>
            <button class="button button-primary" type="submit">
                @ui["companion.connect"]
            </button>
        </form>

        <p class="validation" data-pair-error hidden></p>
    </section>

    <section class="panel companion-live" data-companion-live hidden>
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["companion.eyebrow.live"]</span>
                <h1 data-session-title>@ui["companion.sessionTitle"]</h1>
                <p class="muted" data-session-episode></p>
            </div>
            <span class="status-pill status-ok" data-session-status>@ui["companion.live"]</span>
        </div>

        <div class="companion-sentence">
            <p lang="ja" data-current-sentence>@ui["companion.waitingSubtitle"]</p>
            <div class="companion-tokens" data-current-tokens></div>
        </div>

        <div class="companion-word" data-selected-word hidden>
            <span class="eyebrow">@ui["companion.selectedWordEyebrow"]</span>
            <strong data-word-surface></strong>
            <span data-word-reading></span>
            <p data-word-meaning></p>
            <span class="status-pill" data-word-state></span>
            <div class="button-row">
                <button class="button" type="button" data-command="addToLearning">
                    @ui["companion.addToLearning"]
                </button>
                <button class="button" type="button" data-command="markKnown">
                    @ui["companion.markKnown"]
                </button>
            </div>
        </div>

        <div class="companion-controls">
            <button class="button" type="button" data-command="seekBack10">@ui["companion.seekBack10"]</button>
            <button class="button button-primary" type="button" data-command="playPause">
                @ui["companion.playPause"]
            </button>
            <button class="button" type="button" data-command="seekForward10">@ui["companion.seekForward10"]</button>
            <button class="button" type="button" data-command="repeatCurrentCue">
                @ui["companion.repeatSentence"]
            </button>
        </div>

        <div class="companion-meta">
            <span data-position></span>
            <span data-revision></span>
        </div>

        <a class="button" data-open-learning href="#">
            @ui["companion.openEpisode"]
        </a>

        <p class="validation" data-session-error hidden></p>
    </section>
</div>

@section Scripts {
    <script src="~/js/companion.js" asp-append-version="true"></script>
}
