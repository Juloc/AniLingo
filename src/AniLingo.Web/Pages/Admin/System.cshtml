@page
@model AniLingo.Web.Pages.Admin.SystemModel
@using AniLingo.Web.Features.Operations
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.nav.system"];

    string OperationStatusLabel(OperationStatus status) => status switch
    {
        OperationStatus.Queued => ui["admin.operations.status.queued"],
        OperationStatus.Running => ui["admin.operations.status.running"],
        OperationStatus.Succeeded => ui["admin.operations.status.succeeded"],
        OperationStatus.Failed => ui["admin.operations.status.failed"],
        OperationStatus.Cancelled => ui["admin.operations.status.cancelled"],
        OperationStatus.Interrupted => ui["admin.operations.status.interrupted"],
        _ => status.ToString()
    };
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["nav.admin"]</span>
        <h1>@ui["admin.nav.system"]</h1>
        <p>@ui["admin.system.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["admin.system.mediaStorage"]</span>
                <h2>@ui["admin.system.configuredRoots"]</h2>
            </div>
            <span>@Model.Roots.Count</span>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        @if (Model.Roots.Count == 0)
        {
            <p class="muted">@ui["admin.system.noRoots"]</p>
        }
        else
        {
            <div class="root-list">
                @foreach (var root in Model.Roots)
                {
                    <div class="root-row">
                        <div class="form-stack" style="flex:1; min-width:0;">
                            <div>
                                <strong>@root.Name</strong>
                                <span class="status-pill @root.AvailabilityCss">@root.AvailabilityLabel(ui)</span>
                            </div>
                            <code>@root.Path</code>
                            <small>
                                @ui["admin.system.lastAvailable"]
                                @(root.Availability.LastAvailableAtUtc?.ToLocalTime().ToString("g") ?? ui["admin.system.notYet"])
                                · @ui["admin.system.lastFullScan"]
                                @(root.LastScannedAt?.ToLocalTime().ToString("g") ?? ui["admin.system.never"])
                                · @ui["admin.system.periodicReconciliation"]
                                @(root.ReconciliationIntervalMinutes == 0 ? ui["admin.system.off"] : ui.Format("admin.system.everyMinutes", ("minutes", root.ReconciliationIntervalMinutes)))
                            </small>

                            @if (root.ActiveScan is { } active)
                            {
                                <small>
                                    <span class="status-pill operation-status-@active.Operation.Status.ToString().ToLowerInvariant()">@OperationStatusLabel(active.Operation.Status)</span>
                                    @ui.Format("admin.system.triggerScan", ("trigger", active.Trigger), ("scope", active.Scope)) · @active.Phase
                                    @if (active.FileProgress is { } files)
                                    {
                                        <text> · @files</text>
                                    }
                                    · <a asp-page="/Admin/Operation" asp-route-id="@active.Operation.Id">@ui["admin.system.details"]</a>
                                </small>
                                @if (active.Operation.ProgressPercent is { } progress)
                                {
                                    <div class="operation-progress" aria-label="@ui.Format("admin.operation.progressComplete", ("percent", progress))">
                                        <span style="width:@progress%"></span>
                                    </div>
                                }
                            }
                            else if (root.LastScan is { } last)
                            {
                                <small>
                                    <span class="status-pill operation-status-@last.Operation.Status.ToString().ToLowerInvariant()">@OperationStatusLabel(last.Operation.Status)</span>
                                    @ui.Format("admin.system.triggerScan", ("trigger", last.Trigger), ("scope", last.Scope))
                                    @(last.Operation.FinishedAtUtc?.ToLocalTime().ToString("g") ?? "")
                                    @if (last.Counters is { } counters)
                                    {
                                        <text> · @AniLingo.Web.Features.Library.LibraryScanCoordinator.Summarize(counters)</text>
                                        @if (last.Warnings > 0)
                                        {
                                            <text> @ui.Format("admin.system.warningsCount", ("count", last.Warnings))</text>
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(last.Operation.Error))
                                    {
                                        <text> · @last.Operation.Error</text>
                                    }
                                    · <a asp-page="/Admin/Operation" asp-route-id="@last.Operation.Id">@ui["admin.system.details"]</a>
                                </small>
                            }

                            <div class="inline-actions">
                                <form method="post" asp-page-handler="TestRoot">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <button class="button" type="submit">@ui["admin.system.testStorage"]</button>
                                </form>

                                <form method="post" asp-page-handler="Scan">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <button class="button button-primary" type="submit" disabled="@(root.ActiveScan is not null)">
                                        @(root.ActiveScan is null ? ui["admin.system.queueScan"] : ui["admin.system.scanActive"])
                                    </button>
                                </form>

                                <a class="button" asp-page="/Admin/Scans" asp-route-rootId="@root.Id">@ui["admin.system.scanHistory"]</a>

                                @if (root.WakeOnLanEnabled && root.Availability.WakeConfigured)
                                {
                                    <form method="post" asp-page-handler="WakeRoot">
                                        <input type="hidden" name="rootId" value="@root.Id" />
                                        <button class="button" type="submit">@ui["admin.system.wakeNas"]</button>
                                    </form>
                                }
                            </div>

                            <details>
                                <summary>@ui["admin.system.wakeOnLan"]</summary>
                                <form method="post" asp-page-handler="ConfigureWake" class="form-stack" style="margin-top:.75rem;">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <label>
                                        <span>
                                            @if (root.WakeOnLanEnabled)
                                            {
                                                <input type="checkbox"
                                                       name="wakeOnLanEnabled"
                                                       value="true"
                                                       checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox"
                                                       name="wakeOnLanEnabled"
                                                       value="true" />
                                            }
                                            @ui["admin.system.enableWakeOnLan"]
                                        </span>
                                    </label>
                                    <label>
                                        <span>@ui["admin.system.nasMacAddress"]</span>
                                        <input name="wakeMacAddress"
                                               value="@root.WakeMacAddress"
                                               autocomplete="off"
                                               placeholder="AA:BB:CC:DD:EE:FF" />
                                    </label>
                                    <label>
                                        <span>@ui["admin.system.broadcastIpv4"]</span>
                                        <input name="wakeBroadcastAddress"
                                               value="@root.WakeBroadcastAddress"
                                               autocomplete="off"
                                               placeholder="255.255.255.255" />
                                    </label>
                                    <button class="button" type="submit">@ui["admin.system.saveWakeOnLan"]</button>
                                </form>
                            </details>

                            <details>
                                <summary>@ui["admin.system.periodicReconciliationTitle"]</summary>
                                <form method="post" asp-page-handler="ConfigureReconciliation" class="form-stack" style="margin-top:.75rem;">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <label>
                                        <span>@ui["admin.system.reconciliationIntervalLabel"]</span>
                                        <input name="reconciliationIntervalMinutes"
                                               type="number"
                                               inputmode="numeric"
                                               min="0"
                                               max="@AniLingo.Web.Features.Library.LibraryRoot.MaximumReconciliationIntervalMinutes"
                                               value="@root.ReconciliationIntervalMinutes" />
                                    </label>
                                    <small class="muted">
                                        @ui["admin.system.reconciliationHint"]
                                    </small>
                                    <button class="button" type="submit">@ui["admin.system.saveInterval"]</button>
                                </form>
                            </details>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.system.addRoot"]</h2></div>
        <form method="post" asp-page-handler="Add" class="form-stack">
            <label>
                <span>@ui["admin.system.nameLabel"]</span>
                <input asp-for="Name" />
            </label>
            <label>
                <span>@ui["admin.system.containerPathLabel"]</span>
                <input asp-for="Path" />
            </label>
            <button class="button button-primary" type="submit">@ui["admin.system.addLibraryRoot"]</button>
        </form>
    </section>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.subtitles.title"]</h2><span>@ui["admin.system.scope.server"]</span></div>
        <p class="muted">@ui["admin.system.subtitlesDescription"]</p>
        <a class="button" asp-page="/Admin/Subtitles">@ui["admin.system.manageSubtitles"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.system.sonarr"]</h2><span>@ui["admin.system.scope.server"]</span></div>
        <p class="muted">@ui["admin.system.sonarrDescription"]</p>
        <a class="button" asp-page="/Admin/Sonarr">@ui["admin.system.manageSonarr"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Download clients</h2><span>Server</span></div>
        <p class="muted">
            SABnzbd and qBittorrent connections, categories, priority and health
            (@Model.HealthyDownloadClients/@Model.TotalDownloadClients healthy).
        </p>
        <a class="button" asp-page="/Settings/DownloadClients/Index">Manage download clients</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Indexers</h2><span>Server</span></div>
        <p class="muted">
            Prowlarr and direct Newznab/Torznab connections, priority and health
            (@Model.HealthyIndexers/@Model.TotalIndexers healthy).
        </p>
        <a class="button" asp-page="/Settings/Indexers/Index">Manage indexers</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.system.animeAcquisition"]</h2><span>@ui["admin.system.scope.server"]</span></div>
        <p class="muted">@ui["admin.system.acquisitionDescription"]</p>
        <a class="button" asp-page="/Acquisition/Index">@ui["admin.system.openAcquisition"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.system.ai"]</h2><span>@ui["admin.system.scope.server"]</span></div>
        <p class="muted">@ui["admin.system.aiDescription"]</p>
        <a class="button" asp-page="/Admin/Ai">@ui["admin.system.manageAi"]</a>
    </section>
</div>
