@page
@model AniLingo.Web.Pages.Admin.SystemModel
@{
    ViewData["Title"] = "System";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Admin</span>
        <h1>System</h1>
        <p>Server-wide media storage and integrations.</p>
    </div>
</header>

<partial name="_AdminNavigation" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">Media storage</span>
                <h2>Configured roots</h2>
            </div>
            <span>@Model.Roots.Count</span>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        @if (Model.Roots.Count == 0)
        {
            <p class="muted">No roots configured.</p>
        }
        else
        {
            <div class="root-list">
                @foreach (var root in Model.Roots)
                {
                    <div class="root-row">
                        <div class="form-stack" style="flex:1; min-width:0;">
                            <div>
                                <strong>@root.Name</strong>
                                <span class="status-pill @root.AvailabilityCss">@root.AvailabilityLabel</span>
                            </div>
                            <code>@root.Path</code>
                            <small>
                                Last available:
                                @(root.Availability.LastAvailableAtUtc?.ToLocalTime().ToString("g") ?? "not yet")
                                · Last full scan:
                                @(root.LastScannedAt?.ToLocalTime().ToString("g") ?? "never")
                                · Periodic reconciliation:
                                @(root.ReconciliationIntervalMinutes == 0 ? "off" : $"every {root.ReconciliationIntervalMinutes} min")
                            </small>

                            @if (root.ActiveScan is { } active)
                            {
                                <small>
                                    <span class="status-pill operation-status-@active.Operation.Status.ToString().ToLowerInvariant()">@active.Operation.StatusLabel</span>
                                    @active.Trigger scan (@active.Scope) · @active.Phase
                                    @if (active.FileProgress is { } files)
                                    {
                                        <text> · @files</text>
                                    }
                                    · <a asp-page="/Admin/Operation" asp-route-id="@active.Operation.Id">Details</a>
                                </small>
                                @if (active.Operation.ProgressPercent is { } progress)
                                {
                                    <div class="operation-progress" aria-label="@progress% complete">
                                        <span style="width:@progress%"></span>
                                    </div>
                                }
                            }
                            else if (root.LastScan is { } last)
                            {
                                <small>
                                    <span class="status-pill operation-status-@last.Operation.Status.ToString().ToLowerInvariant()">@last.Operation.StatusLabel</span>
                                    @last.Trigger scan (@last.Scope)
                                    @(last.Operation.FinishedAtUtc?.ToLocalTime().ToString("g") ?? "")
                                    @if (last.Counters is { } counters)
                                    {
                                        <text> · @AniLingo.Web.Features.Library.LibraryScanCoordinator.Summarize(counters)</text>
                                        @if (last.Warnings > 0)
                                        {
                                            <text> @last.Warnings warning(s).</text>
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(last.Operation.Error))
                                    {
                                        <text> · @last.Operation.Error</text>
                                    }
                                    · <a asp-page="/Admin/Operation" asp-route-id="@last.Operation.Id">Details</a>
                                </small>
                            }

                            <div class="inline-actions">
                                <form method="post" asp-page-handler="TestRoot">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <button class="button" type="submit">Test storage</button>
                                </form>

                                <form method="post" asp-page-handler="Scan">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <button class="button button-primary" type="submit" disabled="@(root.ActiveScan is not null)">
                                        @(root.ActiveScan is null ? "Queue library scan" : "Scan active")
                                    </button>
                                </form>

                                <a class="button" asp-page="/Admin/Scans" asp-route-rootId="@root.Id">Scan history</a>

                                @if (root.WakeOnLanEnabled && root.Availability.WakeConfigured)
                                {
                                    <form method="post" asp-page-handler="WakeRoot">
                                        <input type="hidden" name="rootId" value="@root.Id" />
                                        <button class="button" type="submit">Wake NAS</button>
                                    </form>
                                }
                            </div>

                            <details>
                                <summary>Wake-on-LAN</summary>
                                <form method="post" asp-page-handler="ConfigureWake" class="form-stack" style="margin-top:.75rem;">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <label>
                                        <span>
                                            @if (root.WakeOnLanEnabled)
                                            {
                                                <input type="checkbox"
                                                       name="wakeOnLanEnabled"
                                                       value="true"
                                                       checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox"
                                                       name="wakeOnLanEnabled"
                                                       value="true" />
                                            }
                                            Enable Wake-on-LAN
                                        </span>
                                    </label>
                                    <label>
                                        <span>NAS MAC address</span>
                                        <input name="wakeMacAddress"
                                               value="@root.WakeMacAddress"
                                               autocomplete="off"
                                               placeholder="AA:BB:CC:DD:EE:FF" />
                                    </label>
                                    <label>
                                        <span>Broadcast IPv4 (optional)</span>
                                        <input name="wakeBroadcastAddress"
                                               value="@root.WakeBroadcastAddress"
                                               autocomplete="off"
                                               placeholder="255.255.255.255" />
                                    </label>
                                    <button class="button" type="submit">Save Wake-on-LAN</button>
                                </form>
                            </details>

                            <details>
                                <summary>Periodic reconciliation</summary>
                                <form method="post" asp-page-handler="ConfigureReconciliation" class="form-stack" style="margin-top:.75rem;">
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <label>
                                        <span>Full reconciliation interval in minutes (0 turns it off)</span>
                                        <input name="reconciliationIntervalMinutes"
                                               type="number"
                                               inputmode="numeric"
                                               min="0"
                                               max="@AniLingo.Web.Features.Library.LibraryRoot.MaximumReconciliationIntervalMinutes"
                                               value="@root.ReconciliationIntervalMinutes" />
                                    </label>
                                    <small class="muted">
                                        Filesystem changes are picked up within seconds where the mount raises events; this full pass repairs anything missed, for example on network mounts. Runs are skipped while the storage is offline.
                                    </small>
                                    <button class="button" type="submit">Save interval</button>
                                </form>
                            </details>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Add root</h2></div>
        <form method="post" asp-page-handler="Add" class="form-stack">
            <label>
                <span>Name</span>
                <input asp-for="Name" />
            </label>
            <label>
                <span>Container path</span>
                <input asp-for="Path" />
            </label>
            <button class="button button-primary" type="submit">Add library root</button>
        </form>
    </section>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>Subtitles</h2><span>Server</span></div>
        <p class="muted">Coverage, Jimaku lookup and missing transcript preparation.</p>
        <a class="button" asp-page="/Admin/Subtitles">Manage subtitles</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Sonarr</h2><span>Server</span></div>
        <p class="muted">Configure artwork import from the server's Sonarr library.</p>
        <a class="button" asp-page="/Admin/Sonarr">Manage Sonarr</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>SABnzbd</h2><span>Server</span></div>
        <p class="muted">One download client connection and categories for Books and Anime.</p>
        <a class="button" asp-page="/Settings/Sabnzbd">Manage SABnzbd</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Prowlarr</h2><span>Server</span></div>
        <p class="muted">Indexer search for anime acquisition.</p>
        <a class="button" asp-page="/Settings/Prowlarr">Manage Prowlarr</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Anime acquisition</h2><span>Server</span></div>
        <p class="muted">Monitored anime, wanted episodes, downloads, imports and decisions.</p>
        <a class="button" asp-page="/Acquisition/Index">Open acquisition</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Acquisition import &amp; policy</h2><span>Server</span></div>
        <p class="muted">Import mode, remote path mapping, tags, delay profiles, indexer restrictions, AniList auto-monitor and backup/restore.</p>
        <a class="button" asp-page="/Settings/Acquisition">Manage import &amp; policy</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>AI</h2><span>Server</span></div>
        <p class="muted">Configure optional server-side AI providers and caches.</p>
        <a class="button" asp-page="/Admin/Ai">Manage AI</a>
    </section>
</div>
