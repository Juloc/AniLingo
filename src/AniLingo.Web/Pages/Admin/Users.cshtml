@page
@using AniLingo.Web.Features.Auth
@model AniLingo.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Admin · Users</span>
        <h1>Users</h1>
        <p>Manage local accounts and review their AniLingo progress.</p>
    </div>
</header>

<partial name="_AdminNavigation" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>Accounts</h2>
            <span>@Model.Users.Count</span>
        </div>

        <div class="user-admin-list">
            @foreach (var user in Model.Users)
            {
                var account = user.Account;
                <article class="user-admin-card">
                    <div class="user-admin-header">
                        <div>
                            <strong>@account.UserName</strong>
                            <small>
                                @account.Role · @(account.IsEnabled ? "enabled" : "awaiting approval / disabled")
                                @if (user.LastActivityAt is { } lastActivity)
                                {
                                    <text> · active @lastActivity.ToString("yyyy-MM-dd HH:mm") UTC</text>
                                }
                            </small>
                        </div>

                        <div class="inline-actions">
                            @if (account.Role != AccountRole.Owner)
                            {
                                @if (account.IsEnabled)
                                {
                                    <form method="post" asp-page-handler="Disable">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button" type="submit">Disable</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Approve">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button button-primary" type="submit">Approve / enable</button>
                                    </form>
                                }
                            }
                            <a class="button"
                               asp-page="/Admin/User"
                               asp-route-id="@account.Id">Manage</a>
                        </div>
                    </div>

                    <div class="user-progress-grid">
                        <div class="user-progress-item">
                            <span>Anime</span>
                            @if (user.CurrentAnime is { } anime)
                            {
                                <strong>@anime.AnimeTitle</strong>
                                <small>
                                    S@(anime.SeasonNumber.ToString("00")) E@(anime.EpisodeNumber.ToString("00"))
                                    · @(anime.IsCompleted ? "completed" : $"{anime.Percent}%")
                                </small>
                            }
                            else
                            {
                                <strong>No progress</strong>
                                <small>No episode started yet</small>
                            }
                            <em>@user.EpisodesStarted started · @user.EpisodesCompleted completed</em>
                        </div>

                        <div class="user-progress-item">
                            <span>Novels</span>
                            @if (user.CurrentNovel is { } novel)
                            {
                                <strong>@novel.WorkTitle</strong>
                                <small>Chapter @novel.ChapterNumber · @novel.Percent%</small>
                            }
                            else
                            {
                                <strong>No progress</strong>
                                <small>No novel started yet</small>
                            }
                            <em>@user.NovelsStarted started</em>
                        </div>

                        <div class="user-progress-item">
                            <span>Learning</span>
                            <strong>@user.Learning.KnownTerms known</strong>
                            <small>@user.Learning.LearningTerms learning · @user.Learning.Reviews reviews</small>
                            <em>
                                @if (user.Learning.LastReviewAt is { } lastReview)
                                {
                                    <text>Last review @lastReview.ToString("yyyy-MM-dd HH:mm") UTC</text>
                                }
                                else
                                {
                                    <text>No reviews yet</text>
                                }
                            </em>
                        </div>
                    </div>

                </article>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Create user</h2></div>
        <form method="post" asp-page-handler="Create" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label>
                <span>User name</span>
                <input asp-for="UserName" autocomplete="username" />
                <span asp-validation-for="UserName" class="validation"></span>
            </label>
            <label>
                <span>Initial password</span>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </label>
            <button class="button button-primary" type="submit">Create user</button>
        </form>
    </section>
</div>
