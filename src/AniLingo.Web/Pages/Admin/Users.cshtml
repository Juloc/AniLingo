@page
@using AniLingo.Web.Features.Auth
@model AniLingo.Web.Pages.Admin.UsersModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.nav.users"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["admin.user.eyebrow"]</span>
        <h1>@ui["admin.nav.users"]</h1>
        <p>@ui["admin.users.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.users.accounts"]</h2>
            <span>@Model.Users.Count</span>
        </div>

        <div class="user-admin-list">
            @foreach (var user in Model.Users)
            {
                var account = user.Account;
                <article class="user-admin-card">
                    <div class="user-admin-header">
                        <div>
                            <strong>@account.UserName</strong>
                            <small>
                                @account.Role · @(account.IsEnabled ? ui["admin.user.statusEnabled"] : ui["admin.user.statusPending"])
                                @if (user.LastActivityAt is { } lastActivity)
                                {
                                    <text> · @ui.Format("admin.users.activeAt", ("time", lastActivity.ToString("yyyy-MM-dd HH:mm")))</text>
                                }
                            </small>
                        </div>

                        <div class="inline-actions">
                            @if (account.Role != AccountRole.Owner)
                            {
                                @if (account.IsEnabled)
                                {
                                    <form method="post" asp-page-handler="Disable">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button" type="submit">@ui["admin.users.disable"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Approve">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button button-primary" type="submit">@ui["admin.user.approveEnable"]</button>
                                    </form>
                                }
                            }
                            <a class="button"
                               asp-page="/Admin/User"
                               asp-route-id="@account.Id">@ui["admin.users.manage"]</a>
                        </div>
                    </div>

                    <div class="user-progress-grid">
                        <div class="user-progress-item">
                            <span>@ui["admin.operation.anime"]</span>
                            @if (user.CurrentAnime is { } anime)
                            {
                                <strong>@anime.AnimeTitle</strong>
                                <small>
                                    S@(anime.SeasonNumber.ToString("00")) E@(anime.EpisodeNumber.ToString("00"))
                                    · @(anime.IsCompleted ? ui["admin.user.completed"] : $"{anime.Percent}%")
                                </small>
                            }
                            else
                            {
                                <strong>@ui["admin.user.noProgress"]</strong>
                                <small>@ui["admin.user.noEpisodeStarted"]</small>
                            }
                            <em>@ui.Format("admin.user.episodesSummary", ("started", user.EpisodesStarted), ("completed", user.EpisodesCompleted))</em>
                        </div>

                        <div class="user-progress-item">
                            <span>@ui["admin.user.novels"]</span>
                            @if (user.CurrentNovel is { } novel)
                            {
                                <strong>@novel.WorkTitle</strong>
                                <small>@ui.Format("admin.user.chapterPercent", ("chapter", novel.ChapterNumber), ("percent", novel.Percent))</small>
                            }
                            else
                            {
                                <strong>@ui["admin.user.noProgress"]</strong>
                                <small>@ui["admin.user.noNovelStarted"]</small>
                            }
                            <em>@ui.Format("admin.user.novelsStarted", ("count", user.NovelsStarted))</em>
                        </div>

                        <div class="user-progress-item">
                            <span>@ui["admin.user.learning"]</span>
                            <strong>@ui.Format("admin.user.knownTerms", ("count", user.Learning.KnownTerms))</strong>
                            <small>@ui.Format("admin.user.learningSummary", ("learning", user.Learning.LearningTerms), ("reviews", user.Learning.Reviews))</small>
                            <em>
                                @if (user.Learning.LastReviewAt is { } lastReview)
                                {
                                    @ui.Format("admin.user.lastReviewAt", ("time", lastReview.ToString("yyyy-MM-dd HH:mm")))
                                }
                                else
                                {
                                    @ui["admin.user.noReviewsYet"]
                                }
                            </em>
                        </div>
                    </div>

                </article>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.users.createUser"]</h2></div>
        <form method="post" asp-page-handler="Create" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label>
                <span>@ui["admin.user.userNameLabel"]</span>
                <input asp-for="UserName" autocomplete="username" />
                <span asp-validation-for="UserName" class="validation"></span>
            </label>
            <label>
                <span>@ui["admin.users.initialPassword"]</span>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </label>
            <button class="button button-primary" type="submit">@ui["admin.users.createUser"]</button>
        </form>
    </section>
</div>
