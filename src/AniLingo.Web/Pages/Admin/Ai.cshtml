@page
@model AniLingo.Web.Pages.Admin.AiModel
@using AniLingo.Web.Features.Ai
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.system.ai"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Admin/System">← @ui["admin.nav.system"]</a>
        <span class="eyebrow">@ui["admin.ai.eyebrow"]</span>
        <h1>@ui["admin.system.ai"]</h1>
        <p>@ui["admin.ai.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@Model.Provider.DisplayName</h2>
            @if (Model.Provider.IsAuthenticated)
            {
                <span class="status-pill status-ok">@ui["admin.subtitles.connected"]</span>
            }
            else if (Model.Provider.IsAvailable)
            {
                <span class="status-pill">@ui["admin.ai.notConnected"]</span>
            }
            else
            {
                <span class="status-pill status-error">@ui["admin.ai.unavailable"]</span>
            }
        </div>

        <div class="status-list">
            <div>
                <span>@ui["admin.ai.cli"]</span>
                <strong>@(Model.Provider.IsAvailable ? ui["admin.ai.installed"] : ui["admin.ai.missing"])</strong>
            </div>
            <div>
                <span>@ui["admin.ai.version"]</span>
                <strong>@(Model.Provider.Version ?? "—")</strong>
            </div>
            <div>
                <span>@ui["admin.ai.authentication"]</span>
                <strong>@(Model.Provider.AuthenticationMethod ?? "—")</strong>
            </div>
            <div>
                <span>@ui["admin.ai.credentialStorage"]</span>
                <strong>/data/codex</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Provider.Error))
        {
            <p class="validation">@Model.Provider.Error</p>
        }

        @if (Model.Provider.IsAuthenticated)
        {
            <form method="post" asp-page-handler="Logout">
                <button class="button" type="submit">@ui["admin.ai.disconnect"]</button>
            </form>
        }
        else if (Model.Provider.IsAvailable && !Model.Login.IsActive)
        {
            <form method="post" asp-page-handler="Connect">
                <button class="button button-primary" type="submit">@ui["admin.ai.connectWithChatGpt"]</button>
            </form>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.ai.deviceLogin"]</h2></div>

        @if (Model.Login.State == DeviceLoginState.WaitingForUser)
        {
            <div class="device-login">
                <p>@ui["admin.ai.step1"]</p>
                <a class="button button-primary" href="@Model.Login.VerificationUrl" target="_blank" rel="noopener noreferrer">
                    @ui["admin.ai.openLoginPage"]
                </a>

                <p>@ui["admin.ai.step2"]</p>
                <code class="device-code">@Model.Login.UserCode</code>

                <p class="muted">@ui["admin.ai.codeExpires"]</p>

                <div class="inline-actions">
                    <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.checkConnection"]</a>
                    <form method="post" asp-page-handler="Cancel">
                        <button class="button" type="submit">@ui["common.cancel"]</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Login.State == DeviceLoginState.Starting)
        {
            <p class="muted">@ui["admin.ai.waitingForDeviceCode"]</p>
            <div class="inline-actions">
                <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.refresh"]</a>
                <form method="post" asp-page-handler="Cancel">
                    <button class="button" type="submit">@ui["common.cancel"]</button>
                </form>
            </div>
        }
        else if (Model.Login.State is DeviceLoginState.Failed or DeviceLoginState.Cancelled)
        {
            <p class="validation">@(Model.Login.Message ?? ui["admin.ai.loginIncomplete"])</p>
            @if (Model.Provider.IsAvailable && !Model.Provider.IsAuthenticated)
            {
                <form method="post" asp-page-handler="Connect">
                    <button class="button" type="submit">@ui["admin.ai.tryAgain"]</button>
                </form>
            }
        }
        else
        {
            <p class="muted">
                @ui["admin.ai.headlessDescription"]
            </p>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.ai.providerDesign"]</h2></div>
        <p class="muted">
            @ui["admin.ai.providerDesignDescription"]
        </p>
    </section>
</div>
