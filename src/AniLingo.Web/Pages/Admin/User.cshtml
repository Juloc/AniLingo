@page "{id}"
@using AniLingo.Web.Features.Auth
@model AniLingo.Web.Pages.Admin.UserModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("admin.user.manageTitle", ("userName", Model.Account.Account.UserName));
    var account = Model.Account.Account;
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["admin.user.eyebrow"]</span>
        <h1>@account.UserName</h1>
        <p>@account.Role · @(account.IsEnabled ? ui["admin.user.statusEnabled"] : ui["admin.user.statusPending"])</p>
    </div>
    <a class="button" asp-page="/Admin/Users">@ui["admin.user.backToUsers"]</a>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div asp-validation-summary="ModelOnly" class="validation"></div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.user.progress"]</h2>
        @if (Model.Account.LastActivityAt is { } lastActivity)
        {
            <span>@ui.Format("admin.user.activeAt", ("time", lastActivity.ToString("yyyy-MM-dd HH:mm")))</span>
        }
        else
        {
            <span>@ui["admin.user.noActivityYet"]</span>
        }
    </div>

    <div class="user-progress-grid">
        <div class="user-progress-item">
            <span>@ui["admin.operation.anime"]</span>
            @if (Model.Account.CurrentAnime is { } anime)
            {
                <strong>@anime.AnimeTitle</strong>
                <small>
                    S@(anime.SeasonNumber.ToString("00")) E@(anime.EpisodeNumber.ToString("00"))
                    · @(anime.IsCompleted ? ui["admin.user.completed"] : $"{anime.Percent}%")
                </small>
            }
            else
            {
                <strong>@ui["admin.user.noProgress"]</strong>
                <small>@ui["admin.user.noEpisodeStarted"]</small>
            }
            <em>@ui.Format("admin.user.episodesSummary", ("started", Model.Account.EpisodesStarted), ("completed", Model.Account.EpisodesCompleted))</em>
        </div>

        <div class="user-progress-item">
            <span>@ui["admin.user.novels"]</span>
            @if (Model.Account.CurrentNovel is { } novel)
            {
                <strong>@novel.WorkTitle</strong>
                <small>@ui.Format("admin.user.chapterPercent", ("chapter", novel.ChapterNumber), ("percent", novel.Percent))</small>
            }
            else
            {
                <strong>@ui["admin.user.noProgress"]</strong>
                <small>@ui["admin.user.noNovelStarted"]</small>
            }
            <em>@ui.Format("admin.user.novelsStarted", ("count", Model.Account.NovelsStarted))</em>
        </div>

        <div class="user-progress-item">
            <span>@ui["admin.user.learning"]</span>
            <strong>@ui.Format("admin.user.knownTerms", ("count", Model.Account.Learning.KnownTerms))</strong>
            <small>@ui.Format("admin.user.learningSummary", ("learning", Model.Account.Learning.LearningTerms), ("reviews", Model.Account.Learning.Reviews))</small>
            <em>
                @if (Model.Account.Learning.LastReviewAt is { } lastReview)
                {
                    @ui.Format("admin.user.lastReviewAt", ("time", lastReview.ToString("yyyy-MM-dd HH:mm")))
                }
                else
                {
                    @ui["admin.user.noReviewsYet"]
                }
            </em>
        </div>
    </div>
</section>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.user.account"]</h2></div>

        <div class="status-list">
            <div><span>@ui["admin.user.role"]</span><strong>@account.Role</strong></div>
            <div><span>@ui["admin.operation.status"]</span><strong>@(account.IsEnabled ? ui["admin.user.enabledLabel"] : ui["admin.user.disabledPendingLabel"])</strong></div>
            <div><span>@ui["admin.operation.created"]</span><strong>@account.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</strong></div>
        </div>

        <form method="post" asp-page-handler="Rename" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.userNameLabel"]</span>
                <input name="userName"
                       value="@account.UserName"
                       maxlength="80"
                       autocomplete="username"
                       required />
            </label>
            <button class="button button-primary" type="submit">@ui["admin.user.renameUser"]</button>
        </form>

        @if (account.Role != AccountRole.Owner)
        {
            <div class="inline-actions">
                <form method="post" asp-page-handler="SetEnabled">
                    <input type="hidden" name="id" value="@account.Id" />
                    <input type="hidden" name="enabled" value="@(!account.IsEnabled)" />
                    <button class="button" type="submit">
                        @(account.IsEnabled ? ui["admin.user.disableUser"] : ui["admin.user.approveEnable"])
                    </button>
                </form>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.user.security"]</h2></div>

        <form method="post" asp-page-handler="ResetPassword" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.newPassword"]</span>
                <input name="newPassword"
                       type="password"
                       minlength="12"
                       autocomplete="new-password"
                       required />
            </label>
            <button class="button" type="submit">@ui["admin.user.resetPassword"]</button>
        </form>

        <form method="post" asp-page-handler="InvalidateSessions" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <p class="muted">
                @ui["admin.user.signOutAllDescription"]
            </p>
            <button class="button" type="submit">@ui["admin.user.signOutAllSessions"]</button>
        </form>
    </section>
</div>

@if (account.Role != AccountRole.Owner)
{
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.user.deleteUser"]</h2></div>
        <p class="muted">
            @ui["admin.user.deleteDescription1"]
            @ui.Format("admin.user.deleteDescription2", ("userName", account.UserName))
        </p>
        <form method="post" asp-page-handler="Delete" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.confirmationLabel"]</span>
                <input name="confirmation"
                       autocomplete="off"
                       placeholder="@account.UserName"
                       required />
            </label>
            <button class="button" type="submit">@ui["admin.user.deletePermanently"]</button>
        </form>
    </section>
}
