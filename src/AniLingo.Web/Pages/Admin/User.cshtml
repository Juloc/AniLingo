@page "{id}"
@using AniLingo.Web.Features.Auth
@model AniLingo.Web.Pages.Admin.UserModel
@{
    ViewData["Title"] = $"Manage {Model.Account.Account.UserName}";
    var account = Model.Account.Account;
}

<header class="page-header">
    <div>
        <span class="eyebrow">Settings · Users</span>
        <h1>@account.UserName</h1>
        <p>@account.Role · @(account.IsEnabled ? "enabled" : "awaiting approval / disabled")</p>
    </div>
    <a class="button" asp-page="/Admin/Users">Back to users</a>
</header>

<partial name="_AdminNavigation" />

<div asp-validation-summary="ModelOnly" class="validation"></div>

<section class="panel">
    <div class="panel-heading">
        <h2>Progress</h2>
        @if (Model.Account.LastActivityAt is { } lastActivity)
        {
            <span>Active @lastActivity.ToString("yyyy-MM-dd HH:mm") UTC</span>
        }
        else
        {
            <span>No activity yet</span>
        }
    </div>

    <div class="user-progress-grid">
        <div class="user-progress-item">
            <span>Anime</span>
            @if (Model.Account.CurrentAnime is { } anime)
            {
                <strong>@anime.AnimeTitle</strong>
                <small>
                    S@(anime.SeasonNumber.ToString("00")) E@(anime.EpisodeNumber.ToString("00"))
                    · @(anime.IsCompleted ? "completed" : $"{anime.Percent}%")
                </small>
            }
            else
            {
                <strong>No progress</strong>
                <small>No episode started yet</small>
            }
            <em>@Model.Account.EpisodesStarted started · @Model.Account.EpisodesCompleted completed</em>
        </div>

        <div class="user-progress-item">
            <span>Novels</span>
            @if (Model.Account.CurrentNovel is { } novel)
            {
                <strong>@novel.WorkTitle</strong>
                <small>Chapter @novel.ChapterNumber · @novel.Percent%</small>
            }
            else
            {
                <strong>No progress</strong>
                <small>No novel started yet</small>
            }
            <em>@Model.Account.NovelsStarted started</em>
        </div>

        <div class="user-progress-item">
            <span>Learning</span>
            <strong>@Model.Account.Learning.KnownTerms known</strong>
            <small>@Model.Account.Learning.LearningTerms learning · @Model.Account.Learning.Reviews reviews</small>
            <em>
                @if (Model.Account.Learning.LastReviewAt is { } lastReview)
                {
                    <text>Last review @lastReview.ToString("yyyy-MM-dd HH:mm") UTC</text>
                }
                else
                {
                    <text>No reviews yet</text>
                }
            </em>
        </div>
    </div>
</section>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>Account</h2></div>

        <div class="status-list">
            <div><span>Role</span><strong>@account.Role</strong></div>
            <div><span>Status</span><strong>@(account.IsEnabled ? "Enabled" : "Disabled / pending")</strong></div>
            <div><span>Created</span><strong>@account.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</strong></div>
        </div>

        <form method="post" asp-page-handler="Rename" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>User name</span>
                <input name="userName"
                       value="@account.UserName"
                       maxlength="80"
                       autocomplete="username"
                       required />
            </label>
            <button class="button button-primary" type="submit">Rename user</button>
        </form>

        @if (account.Role != AccountRole.Owner)
        {
            <div class="inline-actions">
                <form method="post" asp-page-handler="SetEnabled">
                    <input type="hidden" name="id" value="@account.Id" />
                    <input type="hidden" name="enabled" value="@(!account.IsEnabled)" />
                    <button class="button" type="submit">
                        @(account.IsEnabled ? "Disable user" : "Approve / enable")
                    </button>
                </form>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Security</h2></div>

        <form method="post" asp-page-handler="ResetPassword" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>New password</span>
                <input name="newPassword"
                       type="password"
                       minlength="12"
                       autocomplete="new-password"
                       required />
            </label>
            <button class="button" type="submit">Reset password</button>
        </form>

        <form method="post" asp-page-handler="InvalidateSessions" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <p class="muted">
                Signs this account out on every device. The next use requires a fresh login.
            </p>
            <button class="button" type="submit">Sign out all sessions</button>
        </form>
    </section>
</div>

@if (account.Role != AccountRole.Owner)
{
    <section class="panel">
        <div class="panel-heading"><h2>Delete user</h2></div>
        <p class="muted">
            This permanently removes the account and its AniLingo profile data.
            Enter <strong>@account.UserName</strong> to confirm.
        </p>
        <form method="post" asp-page-handler="Delete" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>Confirmation</span>
                <input name="confirmation"
                       autocomplete="off"
                       placeholder="@account.UserName"
                       required />
            </label>
            <button class="button" type="submit">Delete user permanently</button>
        </form>
    </section>
}
