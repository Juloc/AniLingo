@page
@model AniLingo.Web.Pages.Library.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["nav.library"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["nav.library"]</span>
        <h1>@ui["library.index.title"]</h1>
        <p>@ui["library.index.subtitle"]</p>
    </div>
    <div class="inline-actions">
        <a class="button" href="/Settings/Sonarr">@ui["library.index.importFromSonarr"]</a>
        <a class="button" href="/Settings">@ui["library.index.manageRoots"]</a>
    </div>
</header>

@if (Model.Anime.Count == 0)
{
    <div class="empty-state">
        <h3>@ui["library.index.emptyTitle"]</h3>
        <p>@ui["library.index.emptyHint"]</p>
    </div>
}
else
{
    <div class="media-grid">
        @foreach (var anime in Model.Anime)
        {
            <partial name="_MediaCard" model='new MediaCardModel(
                anime.Title,
                ui.Format("library.index.episodeCount", ("count", anime.EpisodeCount)),
                $"/Library/Anime/{anime.Id}",
                ImageUrl: anime.CoverImageUrl,
                Ui: ui)' />
        }
    </div>
}
