@page "/Library/Episode/{id:guid}"
@using System.Text.Json
@using AniLingo.Web.Features.Playback
@model AniLingo.Web.Pages.Library.EpisodeModel
@{
    ViewData["Title"] = $"{Model.AnimeTitle} E{Model.EpisodeNumber}";
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Library/Anime/@Model.AnimeId">← @Model.AnimeTitle</a>
        <span class="eyebrow">S@(Model.SeasonNumber.ToString("00")) · E@(Model.EpisodeNumber.ToString("00"))</span>
        <h1>@Model.EpisodeTitle</h1>
        <p>@Model.Terms.Count candidates · @Model.Preparation.KnownPercent% known · @Model.Preparation.PreparedPercent% prepared</p>
    </div>
</header>

<section class="panel subtitle-source-panel">
    <div class="panel-heading">
        <div>
            <span class="eyebrow">Learning source</span>
            <h2>Japanese subtitles</h2>
        </div>
        @if (Model.ActiveSubtitle is { } activeBadge)
        {
            <span class="status-pill status-ok">@activeBadge.CueCount cues · @Model.Terms.Count terms</span>
        }
        else
        {
            <span class="status-pill status-warning">Not imported</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SubtitleNotice))
    {
        <div class="subtitle-source-message status-ok">@Model.SubtitleNotice</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SubtitleError))
    {
        <div class="subtitle-source-message status-error">@Model.SubtitleError</div>
    }

    @if (Model.ActiveSubtitle is null &&
         Model.Transcription.Status is AudioTranscriptionStatus.Queued or AudioTranscriptionStatus.Processing)
    {
        <div class="subtitle-source-message status-warning">
            Generating Japanese transcript from the episode audio locally. Playback can start immediately.
        </div>
    }
    else if (Model.ActiveSubtitle is null &&
             Model.Transcription.Status == AudioTranscriptionStatus.Failed)
    {
        <div class="subtitle-source-message status-error">
            @(Model.Transcription.Message ?? "Japanese audio transcription failed.")
        </div>
    }

    @if (Model.ActiveSubtitle is { } active)
    {
        <div class="active-subtitle-source">
            <span>Current Japanese source</span>
            <strong>@active.Label</strong>
            <small>@(active.Format.ToUpperInvariant()) · @active.CueCount imported cues</small>
        </div>
    }
    else
    {
        <p class="muted subtitle-source-help">
            AniLingo did not import a Japanese text track automatically. If no Japanese text stream is detected, a local Japanese audio transcription is queued automatically while playback remains available.
        </p>
    }

    @if (Model.SubtitleSources.Count == 0)
    {
        <div class="subtitle-source-empty">
            No embedded subtitle streams were found. AniLingo will use local Japanese audio transcription as the fallback.
        </div>
    }
    else
    {
        <div class="subtitle-source-list">
            @foreach (var source in Model.SubtitleSources)
            {
                <div class="subtitle-source-row">
                    <div class="subtitle-source-copy">
                        <strong>
                            @(string.IsNullOrWhiteSpace(source.Title)
                                ? $"Stream #{source.StreamIndex}"
                                : source.Title)
                        </strong>
                        <span>
                            #@source.StreamIndex · @(source.Codec.ToUpperInvariant()) ·
                            @(string.IsNullOrWhiteSpace(source.Language) ? "und" : source.Language)
                            @if (source.IsDefault)
                            {
                                <text> · default</text>
                            }
                            @if (source.IsForced)
                            {
                                <text> · forced</text>
                            }
                        </span>
                    </div>

                    @if (source.IsSelected)
                    {
                        <span class="status-pill status-ok">Japanese source</span>
                    }
                    else if (source.IsText)
                    {
                        <form method="post"
                              asp-page-handler="UseSubtitle"
                              asp-route-id="@Model.EpisodeId">
                            <input type="hidden" name="streamIndex" value="@source.StreamIndex" />
                            <button class="button" type="submit">Use as Japanese</button>
                        </form>
                    }
                    else
                    {
                        <span class="status-pill status-warning">Image/unsupported · OCR required</span>
                    }
                </div>
            }
        </div>
    }
</section>

@if (Model.Playback.Media is { } media)
{
    <section class="player-panel"
             data-episode-player
             data-playback-refresh="@(media.IsPreparing ? "true" : "false")"
             data-video-codec="@media.VideoCodec"
             data-device-availability="@(media.Device.Availability.ToString().ToLowerInvariant())"
             data-device-status="@media.Device.StatusMessage"
             data-server-availability="@(media.Server.Availability.ToString().ToLowerInvariant())"
             data-server-status="@media.Server.StatusMessage"
             data-media-url="@Url.Page("/Library/Episode", "Media", new { id = Model.EpisodeId })">
        <div class="video-stage player-placeholder" data-video-stage>
            <video controls preload="metadata" playsinline hidden data-playback-video></video>
            <div class="subtitle-overlay" data-subtitle-overlay lang="ja"></div>

            <div class="playback-preparation" data-playback-placeholder>
                <span class="eyebrow">Browser playback</span>
                <strong data-playback-status>Starting instant playback…</strong>
            </div>
        </div>

        <div class="player-meta">
            <div>
                <span class="eyebrow">Player</span>
                <strong>@media.FileName</strong>
                <span>@Model.Playback.Cues.Count synced Japanese cues · <span data-playback-summary>Checking device…</span></span>
            </div>
            <div class="playback-mode-control">
                <label>
                    <span>Playback</span>
                    <select data-playback-mode>
                        <option value="auto">Auto · device first</option>
                        <option value="device">Device only</option>
                        <option value="server">Server</option>
                    </select>
                </label>
                <small data-playback-mode-hint></small>
                <span class="status-pill" data-playback-badge>Checking…</span>
            </div>
        </div>

        <div class="player-error" data-player-error hidden></div>

        <div class="word-inspector" data-word-inspector hidden>
            <div>
                <strong data-word lang="ja"></strong>
                <span data-reading lang="ja"></span>
                <p data-meaning></p>
            </div>
            <div class="word-inspector-actions">
                <span class="status-pill" data-state></span>
                <button class="button" type="button" data-replay>Replay line</button>
            </div>
        </div>

        <script type="application/json" data-cue-data>@Html.Raw(JsonSerializer.Serialize(Model.Playback.Cues, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    </section>
    <script src="~/js/episode-player.js" asp-append-version="true"></script>
}

@if (Model.Terms.Count == 0)
{
    <div class="empty-state">
        <h3>No vocabulary yet</h3>
        <p>AniLingo will build vocabulary from a Japanese text source. When none is available, it generates a local Japanese audio transcript automatically. Image subtitles such as PGS can still be replaced by the audio transcript without OCR.</p>
    </div>
}
else
{
    <section class="preparation-panel">
        <div class="preparation-copy">
            <span class="eyebrow">Episode preparation</span>
            <strong>@Model.Preparation.PreparedPercent% lexical coverage</strong>
            <span>@Model.Preparation.PreparedOccurrences of @Model.Preparation.TotalOccurrences subtitle term occurrences are known or queued.</span>
            <div class="progress-track"><span style="width:@Model.Preparation.PreparedPercent%"></span></div>
            <small>Coverage is occurrence-weighted vocabulary coverage, not estimated dialogue comprehension.</small>
        </div>

        @if (Model.Preparation.RecommendedCount > 0)
        {
            <form method="post" asp-page-handler="Prepare" asp-route-id="@Model.EpisodeId">
                <button class="button button-primary" type="submit">
                    Prepare to @Model.Preparation.TargetPercent% · @Model.Preparation.RecommendedCount words
                </button>
            </form>
        }
        else
        {
            <span class="status-pill status-ok">@Model.Preparation.TargetPercent% prepared</span>
        }
    </section>

    <div class="term-table">
        <div class="term-table-head">
            <span>Term</span><span>Seen</span><span>Status</span>
        </div>
        @foreach (var term in Model.Terms)
        {
            <div class="term-row">
                <div class="term-word">
                    <strong lang="ja">@term.Canonical</strong>
                    @if (!string.IsNullOrWhiteSpace(term.Reading))
                    {
                        <span>@term.Reading</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(term.Meaning))
                    {
                        <small>@term.Meaning</small>
                    }
                </div>
                <span class="occurrence">@term.EpisodeOccurrences×</span>
                <div class="term-actions">
                    <form method="post" asp-page-handler="Learning" asp-route-id="@Model.EpisodeId">
                        <input type="hidden" name="termId" value="@term.TermId" />
                        <button class="chip @(term.State == UserTermState.Learning ? "selected" : "")" type="submit">Learn</button>
                    </form>
                    <form method="post" asp-page-handler="Known" asp-route-id="@Model.EpisodeId">
                        <input type="hidden" name="termId" value="@term.TermId" />
                        <button class="chip @(term.State == UserTermState.Known ? "selected" : "")" type="submit">Known</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
