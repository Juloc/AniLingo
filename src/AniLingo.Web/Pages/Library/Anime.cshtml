@page "/Library/Anime/{id:guid}"
@model AniLingo.Web.Pages.Library.AnimeModel
@{
    ViewData["Title"] = Model.AnimeTitle;
}

<section class="anime-hero">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img class="anime-banner-image"
             src="@Model.BannerImageUrl"
             alt=""
             loading="eager"
             referrerpolicy="no-referrer" />
    }
    <div class="anime-hero-shade"></div>
    <div class="anime-hero-content">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img class="anime-detail-poster"
                 src="@Model.CoverImageUrl"
                 alt=""
                 loading="eager"
                 referrerpolicy="no-referrer" />
        }
        <div class="anime-hero-copy">
            <a class="back-link" href="/Library">← Library</a>
            <span class="eyebrow">Anime library</span>
            <h1>@Model.AnimeTitle</h1>

            @if (Model.Metadata is { } metadata)
            {
                @if (!string.Equals(Model.LocalAnimeTitle, Model.AnimeTitle, StringComparison.Ordinal))
                {
                    <span class="local-title">@Model.LocalAnimeTitle</span>
                }
                @if (!string.IsNullOrWhiteSpace(metadata.NativeTitle))
                {
                    <span class="native-title" lang="ja">@metadata.NativeTitle</span>
                }

                <div class="anime-facts">
                    @if (metadata.SeasonYear is int seasonYear)
                    {
                        <span>@seasonYear</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(metadata.Format))
                    {
                        <span>@metadata.Format</span>
                    }
                    @if (metadata.EpisodeCount is int episodeCount)
                    {
                        <span>@episodeCount episodes</span>
                    }
                    @if (metadata.EpisodeDurationMinutes is int duration)
                    {
                        <span>@duration min</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(metadata.Description))
                {
                    <p class="anime-description">@metadata.Description</p>
                }

                @if (Model.IsOwner)
                {
                    <div class="inline-actions">
                        <form method="post" asp-page-handler="RefreshMetadata" asp-route-id="@Model.AnimeId">
                            <button class="button" type="submit">Refresh metadata</button>
                        </form>
                        <form method="post" asp-page-handler="RemoveMetadata" asp-route-id="@Model.AnimeId">
                            <button class="button" type="submit">Remove match</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <p>@Model.Episodes.Count episodes discovered.</p>
            }
        </div>
    </div>
</section>

@if (Model.IsOwner)
{
    <section class="panel metadata-panel">
        <div class="panel-heading">
            <h2>@(Model.Metadata is null ? "Match AniList" : "Change AniList match")</h2>
            @if (Model.Metadata is { } current)
            {
                <span>@current.Provider · ID @current.ExternalId</span>
            }
        </div>
    
        <form method="get" class="metadata-search">
            <input type="search"
                   name="q"
                   value="@Model.SearchQuery"
                   aria-label="Anime title"
                   placeholder="Search AniList" />
            <button class="button button-primary" type="submit">Search AniList</button>
        </form>
    
        @if (!string.IsNullOrWhiteSpace(Model.MetadataError))
        {
            <p class="metadata-error">@Model.MetadataError</p>
        }
    
        @if (Model.SearchResults.Count > 0)
        {
            <div class="metadata-results">
                @foreach (var candidate in Model.SearchResults)
                {
                    <article class="metadata-result">
                        <div class="metadata-result-poster">
                            @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                            {
                                <img src="@candidate.CoverImageUrl"
                                     alt=""
                                     loading="lazy"
                                     referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span>@candidate.PreferredTitle[..1]</span>
                            }
                        </div>
                        <div class="metadata-result-copy">
                            <strong>@candidate.PreferredTitle</strong>
                            @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                            {
                                <span lang="ja">@candidate.NativeTitle</span>
                            }
                            <small>
                                @if (candidate.SeasonYear is int year)
                                {
                                    <text>@year</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(candidate.Format))
                                {
                                    <text> · @candidate.Format</text>
                                }
                                @if (candidate.EpisodeCount is int count)
                                {
                                    <text> · @count eps</text>
                                }
                            </small>
                        </div>
                        <div>
                            <form method="post"
                                  asp-page-handler="MatchMetadata"
                                  asp-route-id="@Model.AnimeId">
                                <input type="hidden" name="provider" value="@candidate.Provider" />
                                <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                <button class="button" type="submit">
                                    @(Model.Metadata?.Provider == candidate.Provider &&
                                      Model.Metadata?.ExternalId == candidate.ExternalId
                                        ? "Matched"
                                        : "Use for display")
                                </button>
                            </form>

                            <details>
                                <summary>Map local episodes</summary>
                                <form method="post"
                                      asp-page-handler="MatchEpisodeRange"
                                      asp-route-id="@Model.AnimeId">
                                    <input type="hidden" name="provider" value="@candidate.Provider" />
                                    <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                    <label>
                                        Local season
                                        <input type="number"
                                               name="seasonNumber"
                                               min="0"
                                               value="@Model.SuggestedMappingSeason"
                                               required />
                                    </label>
                                    <label>
                                        Local from
                                        <input type="number"
                                               name="localEpisodeStart"
                                               min="1"
                                               value="@Model.SuggestedMappingEpisodeStart"
                                               required />
                                    </label>
                                    <label>
                                        Local to
                                        <input type="number"
                                               name="localEpisodeEnd"
                                               min="1"
                                               placeholder="auto" />
                                    </label>
                                    <label>
                                        AniList starts at
                                        <input type="number"
                                               name="remoteEpisodeStart"
                                               min="1"
                                               value="1"
                                               required />
                                    </label>
                                    <small>Leave “Local to” empty to use the AniList episode count automatically.</small>
                                    <button class="button button-primary" type="submit">Add mapping</button>
                                </form>
                            </details>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel metadata-panel">
        <div class="panel-heading">
            <h2>AniList episode mappings</h2>
            <span>Local season/episode range → AniList media entry</span>
        </div>

        @if (Model.EpisodeMappings.Count == 0)
        {
            <p>No explicit ranges yet. Single-season anime still use the normal AniList match. Multi-season anime and specials require explicit ranges for safe progress sync.</p>
        }
        else
        {
            <div class="episode-list">
                @foreach (var mapping in Model.EpisodeMappings)
                {
                    var remoteEnd = mapping.RemoteEpisodeStart
                        + (mapping.LocalEpisodeEnd - mapping.LocalEpisodeStart);

                    <div class="episode-row">
                        <div class="episode-number">S@(mapping.SeasonNumber.ToString("00"))</div>
                        <div class="episode-main">
                            <strong>
                                E@(mapping.LocalEpisodeStart.ToString("00"))–E@(mapping.LocalEpisodeEnd.ToString("00"))
                                → @mapping.PreferredTitle
                            </strong>
                            <span>
                                AniList E@(mapping.RemoteEpisodeStart.ToString("00"))–E@(remoteEnd.ToString("00"))
                                · ID @mapping.ExternalId
                            </span>
                        </div>
                        <form method="post"
                              asp-page-handler="RemoveEpisodeMapping"
                              asp-route-id="@Model.AnimeId">
                            <input type="hidden" name="mappingId" value="@mapping.Id" />
                            <button class="button" type="submit">Remove</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>
}

<div class="episode-list">
    @foreach (var episode in Model.Episodes)
    {
        <a class="episode-row" href="/Library/Episode/@episode.Id">
            <div class="episode-number">E@(episode.Number.ToString("00"))</div>
            <div class="episode-main">
                <strong>S@(episode.SeasonNumber.ToString("00")) · @episode.Title</strong>
                <span>
                    @if (episode.JapaneseSubtitleTracks == 0)
                    {
                        <text>No Japanese subtitle imported</text>
                    }
                    else
                    {
                        <text>@episode.TotalTerms vocabulary candidates · @episode.PreparationPercent% prepared</text>
                    }
                </span>
                <div class="progress-track"><span style="width:@episode.PreparationPercent%"></span></div>
            </div>
            <span class="episode-arrow">›</span>
        </a>
    }
</div>
