@page "/Library/Anime/{id:guid}"
@using AniLingo.Web.Features.Learning
@using AniLingo.Web.Features.Tracking
@model AniLingo.Web.Pages.Library.AnimeModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.AnimeTitle;
}

<section class="anime-hero">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img class="anime-banner-image"
             src="@Model.BannerImageUrl"
             alt=""
             loading="eager"
             referrerpolicy="no-referrer" />
    }
    <div class="anime-hero-shade"></div>
    <div class="anime-hero-content">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img class="anime-detail-poster"
                 src="@Model.CoverImageUrl"
                 alt=""
                 loading="eager"
                 referrerpolicy="no-referrer" />
        }
        <div class="anime-hero-copy">
            <a class="back-link" href="/Library">← @ui["nav.library"]</a>
            <span class="eyebrow">@ui["library.anime.eyebrow"]</span>
            <h1>@Model.AnimeTitle</h1>

            @if (Model.Metadata is { } metadata)
            {
                @if (!string.Equals(Model.LocalAnimeTitle, Model.AnimeTitle, StringComparison.Ordinal))
                {
                    <span class="local-title">@Model.LocalAnimeTitle</span>
                }
                @if (!string.IsNullOrWhiteSpace(metadata.NativeTitle))
                {
                    <span class="native-title" lang="ja">@metadata.NativeTitle</span>
                }

                <div class="anime-facts">
                    @if (metadata.SeasonYear is int seasonYear)
                    {
                        <span>@seasonYear</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(metadata.Format))
                    {
                        <span>@metadata.Format</span>
                    }
                    @if (metadata.EpisodeCount is int episodeCount)
                    {
                        <span>@ui.Format("library.index.episodeCount", ("count", episodeCount))</span>
                    }
                    @if (metadata.EpisodeDurationMinutes is int duration)
                    {
                        <span>@ui.Format("library.anime.durationMinutes", ("minutes", duration))</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(metadata.Description))
                {
                    <p class="anime-description">@metadata.Description</p>
                }
            }
            else if (Model.LocalMetadata is { } localMetadata)
            {
                @if (!string.Equals(Model.LocalAnimeTitle, Model.AnimeTitle, StringComparison.Ordinal))
                {
                    <span class="local-title">@Model.LocalAnimeTitle</span>
                }

                @* No provider match yet: the local tvshow.nfo year/plot is shown as a fallback only. *@
                <div class="anime-facts">
                    @if (localMetadata.Year is int localYear)
                    {
                        <span>@localYear</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(localMetadata.Plot))
                {
                    <p class="anime-description">@localMetadata.Plot</p>
                }
            }

            @if (Model.Metadata is not null)
            {
                <div class="inline-actions">
                    <a class="button"
                       href="@Url.Page("/Settings/LearningScope", new {
                           mediaType = LearningMediaType.Anime,
                           scope = "work",
                           workKey = Model.AnimeId.ToString(),
                           label = Model.AnimeTitle,
                           returnUrl = $"/Library/Anime/{Model.AnimeId}"
                       })">
                        @ui["library.languageToolsAndLearning"]
                    </a>
                </div>

                @if (Model.IsOwner)
                {
                    <div class="inline-actions">
                        <form method="post" asp-page-handler="RefreshMetadata" asp-route-id="@Model.AnimeId">
                            <button class="button" type="submit">@ui["library.anime.refreshMetadata"]</button>
                        </form>
                        <form method="post" asp-page-handler="RemoveMetadata" asp-route-id="@Model.AnimeId">
                            <button class="button" type="submit">@ui["library.anime.removeMatch"]</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <p>@ui.Format("library.anime.episodesDiscovered", ("count", Model.Episodes.Count))</p>
            }
            @if (Model.IsOwner) { <a class="button" href="/Library/Rename/@Model.AnimeId">@ui["library.anime.renameFiles"]</a> }
            @if (Model.IsOwner) { <a class="button" href="/Library/AnimeRepair/@Model.AnimeId">@ui["library.anime.repair"]</a> }
        </div>
    </div>
</section>

@if (Model.ExternalProgress is { } externalProgress)
{
    var externalPanel = new ExternalProgressPanel(
        externalProgress,
        Url.Page(null, "ExternalProgress", new { id = Model.AnimeId })!,
        // Range mappings can point at another AniList part; only reuse the
        // matched cover when the resolved entry is the metadata match itself.
        Model.Metadata is { } matchedMetadata &&
        matchedMetadata.ExternalId == externalProgress.MatchedMediaId?.ToString()
            ? matchedMetadata.CoverImageUrl
            : null,
        MatchUrl: "#anilist-match",
        MappingUrl: "#anilist-episode-mappings",
        CanManageMapping: Model.IsOwner,
        Ui: ui);
    <partial name="_ExternalProgress" model="externalPanel" />
}

@if (Model.IsOwner)
{
    <section class="panel metadata-panel" id="anilist-match">
        <div class="panel-heading">
            <h2>@(Model.Metadata is null ? ui["library.searchAniList"] : ui["library.anime.changeAniListMatch"])</h2>
            @if (Model.Metadata is { } current)
            {
                <span>@current.Provider · ID @current.ExternalId</span>
            }
        </div>

        <form method="get" class="metadata-search">
            <input type="search"
                   name="q"
                   value="@Model.SearchQuery"
                   aria-label="@ui["library.animeTitleAria"]"
                   placeholder="@ui["library.searchAniListPlaceholder"]" />
            <button class="button button-primary" type="submit">@ui["library.searchAniList"]</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.MetadataError))
        {
            <p class="metadata-error">@Model.MetadataError</p>
        }

        @if (Model.SearchResults.Count > 0)
        {
            <div class="metadata-results">
                @foreach (var candidate in Model.SearchResults)
                {
                    <article class="metadata-result">
                        <div class="metadata-result-poster">
                            @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                            {
                                <img src="@candidate.CoverImageUrl"
                                     alt=""
                                     loading="lazy"
                                     referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span>@candidate.PreferredTitle[..1]</span>
                            }
                        </div>
                        <div class="metadata-result-copy">
                            <strong>@candidate.PreferredTitle</strong>
                            @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                            {
                                <span lang="ja">@candidate.NativeTitle</span>
                            }
                            <small>
                                @if (candidate.SeasonYear is int year)
                                {
                                    <text>@year</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(candidate.Format))
                                {
                                    <text> · @candidate.Format</text>
                                }
                                @if (candidate.EpisodeCount is int count)
                                {
                                    <text> · @ui.Format("library.episodeCountAbbrev", ("count", count))</text>
                                }
                            </small>
                        </div>
                        <div>
                            <form method="post"
                                  asp-page-handler="MatchMetadata"
                                  asp-route-id="@Model.AnimeId">
                                <input type="hidden" name="provider" value="@candidate.Provider" />
                                <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                <button class="button" type="submit">
                                    @(Model.Metadata?.Provider == candidate.Provider &&
                                      Model.Metadata?.ExternalId == candidate.ExternalId
                                        ? ui["library.matched"]
                                        : ui["library.anime.useForDisplay"])
                                </button>
                            </form>

                            <details>
                                <summary>@ui["library.anime.mapLocalEpisodes"]</summary>
                                <form method="post"
                                      asp-page-handler="MatchEpisodeRange"
                                      asp-route-id="@Model.AnimeId">
                                    <input type="hidden" name="provider" value="@candidate.Provider" />
                                    <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                    <label>
                                        @ui["library.anime.localSeason"]
                                        <input type="number"
                                               name="seasonNumber"
                                               min="0"
                                               value="@Model.SuggestedMappingSeason"
                                               required />
                                    </label>
                                    <label>
                                        @ui["library.anime.localFrom"]
                                        <input type="number"
                                               name="localEpisodeStart"
                                               min="1"
                                               value="@Model.SuggestedMappingEpisodeStart"
                                               required />
                                    </label>
                                    <label>
                                        @ui["library.anime.localTo"]
                                        <input type="number"
                                               name="localEpisodeEnd"
                                               min="1"
                                               placeholder="@ui["library.anime.autoPlaceholder"]" />
                                    </label>
                                    <label>
                                        @ui["library.anime.aniListStartsAt"]
                                        <input type="number"
                                               name="remoteEpisodeStart"
                                               min="1"
                                               value="1"
                                               required />
                                    </label>
                                    <small>@ui["library.anime.localToHint"]</small>
                                    <button class="button button-primary" type="submit">@ui["library.anime.addMapping"]</button>
                                </form>
                            </details>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel metadata-panel" id="anilist-episode-mappings">
        <div class="panel-heading">
            <h2>@ui["library.anime.episodeMappingsHeading"]</h2>
            <span>@ui["library.anime.episodeMappingsCaption"]</span>
        </div>

        @if (Model.EpisodeMappings.Count == 0)
        {
            <p>@ui["library.anime.noExplicitRanges"]</p>
        }
        else
        {
            <div class="episode-list">
                @foreach (var mapping in Model.EpisodeMappings)
                {
                    var remoteEnd = mapping.RemoteEpisodeStart
                        + (mapping.LocalEpisodeEnd - mapping.LocalEpisodeStart);

                    <div class="episode-row">
                        <div class="episode-number">S@(mapping.SeasonNumber.ToString("00"))</div>
                        <div class="episode-main">
                            <strong>
                                E@(mapping.LocalEpisodeStart.ToString("00"))–E@(mapping.LocalEpisodeEnd.ToString("00"))
                                → @mapping.PreferredTitle
                            </strong>
                            <span>
                                @ui.Format("library.anime.aniListRange", ("start", mapping.RemoteEpisodeStart.ToString("00")), ("end", remoteEnd.ToString("00")))
                                · ID @mapping.ExternalId
                            </span>
                        </div>
                        <form method="post"
                              asp-page-handler="RemoveEpisodeMapping"
                              asp-route-id="@Model.AnimeId">
                            <input type="hidden" name="mappingId" value="@mapping.Id" />
                            <button class="button" type="submit">@ui["common.remove"]</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>

    <partial name="_AnimeAcquisitionPanel" model="(Model.AnimeId, ui)" />
}

<div class="episode-list">
    @foreach (var episode in Model.Episodes)
    {
        var episodeCode = $"S{episode.SeasonNumber:00}E{episode.Number:00}";
        <div class="episode-row-shell @(episode.IsWatched ? "is-watched" : "")">
        <a class="episode-row" href="/Library/Episode/@episode.Id">
            <div class="episode-number">E@(episode.Number.ToString("00"))</div>
            <div class="episode-main">
                <strong>S@(episode.SeasonNumber.ToString("00")) · @episode.Title</strong>
                @if (episode.IsWatched)
                {
                    <span class="episode-watch-state">✓ @ui["library.episode.watched"]</span>
                }
                else if (episode.ResumePercent is int resumePercent)
                {
                    <span class="episode-watch-state">@ui.Format("library.anime.inProgressWatched", ("percent", resumePercent))</span>
                }
                <span>
                    @if (episode.JapaneseSubtitleTracks == 0)
                    {
                        <text>@ui["library.anime.noJapaneseSubtitle"]</text>
                    }
                    else if (Model.ShowContentMetrics)
                    {
                        <text>@ui.Format("library.anime.vocabularyCandidates", ("count", episode.TotalTerms), ("percent", episode.PreparationPercent))</text>
                    }
                    else
                    {
                        <text>@ui.Format("library.anime.subtitleTrackCount", ("count", episode.JapaneseSubtitleTracks))</text>
                    }
                </span>
                @if (Model.ShowContentMetrics)
                {
                    <div class="progress-track"><span style="width:@episode.PreparationPercent%"></span></div>
                }
            </div>
            <span class="episode-arrow">›</span>
        </a>
        <form method="post"
              class="episode-watched-form"
              asp-page-handler="Watched"
              asp-route-id="@Model.AnimeId">
            <input type="hidden" name="episodeId" value="@episode.Id" />
            <input type="hidden" name="watched" value="@(episode.IsWatched ? "false" : "true")" />
            <button class="button"
                    type="submit"
                    aria-label="@(episode.IsWatched ? ui.Format("library.anime.markUnwatchedAria", ("code", episodeCode)) : ui.Format("library.anime.markWatchedAria", ("code", episodeCode)))">
                @(episode.IsWatched ? ui["library.episode.markUnwatched"] : ui["library.episode.markWatched"])
            </button>
        </form>
        </div>
    }
</div>
