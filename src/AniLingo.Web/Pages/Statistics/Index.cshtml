@page
@model AniLingo.Web.Pages.Statistics.IndexModel
@{
    ViewData["Title"] = "Statistics";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Learning</span>
        <h1>Statistics</h1>
        <p>Your local learning progress across the anime library.</p>
    </div>
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model='new MetricCardModel("Known", Model.Statistics.KnownTerms.ToString(), "Vocabulary terms")' />
    <partial name="_MetricCard" model='new MetricCardModel("Learning", Model.Statistics.LearningTerms.ToString(), $"{Model.Statistics.DueReviews} due now")' />
    <partial name="_MetricCard" model='new MetricCardModel("Prepared", $"{Model.Statistics.PreparedCoveragePercent}%", "Occurrence-weighted library coverage")' />
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Review activity</h2>
        <span>FSRS history</span>
    </div>
    <div class="status-list">
        <div><span>Total reviews</span><strong>@Model.Statistics.TotalReviews</strong></div>
        <div><span>Last 24 hours</span><strong>@Model.Statistics.ReviewsLast24Hours</strong></div>
        <div><span>Last 7 days</span><strong>@Model.Statistics.ReviewsLast7Days</strong></div>
        <div>
            <span>Prepared occurrences</span>
            <strong>@Model.Statistics.PreparedOccurrences / @Model.Statistics.TotalOccurrences</strong>
        </div>
    </div>
    <p class="muted">
        Prepared coverage counts known and learning vocabulary occurrences. It is not a direct estimate of dialogue comprehension.
    </p>
</section>
