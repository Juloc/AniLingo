@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<header class="page-header hero-header">
    <div>
        <span class="eyebrow">Japanese through your anime</span>
        <h1>Continue where you left off</h1>
        <p>Scan your NAS, prepare vocabulary, then watch.</p>
    </div>
    <a class="button button-primary" href="/Learn">Review @Model.DueReviews due</a>
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model="new MetricCardModel(&quot;Due reviews&quot;, Model.DueReviews.ToString(), &quot;Ready now&quot;)" />
    <partial name="_MetricCard" model="new MetricCardModel(&quot;Anime&quot;, Model.AnimeCount.ToString(), &quot;In your library&quot;)" />
    <partial name="_MetricCard" model="new MetricCardModel(&quot;Episodes&quot;, Model.EpisodeCount.ToString(), &quot;Discovered on NAS&quot;)" />
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Library</span>
            <h2>Recently discovered</h2>
        </div>
        <a class="text-link" href="/Library">View library</a>
    </div>

    @if (Model.RecentEpisodes.Count == 0)
    {
        <div class="empty-state">
            <h3>No episodes yet</h3>
            <p>Add a NAS root in Settings and start a scan.</p>
            <a class="button" href="/Settings">Open settings</a>
        </div>
    }
    else
    {
        <div class="media-grid">
            @foreach (var episode in Model.RecentEpisodes)
            {
                <partial name="_MediaCard" model="new MediaCardModel(
                    episode.AnimeTitle,
                    $&quot;S{episode.SeasonNumber:00} · Episode {episode.Number}&quot;,
                    $&quot;/Library/Episode/{episode.Id}&quot;,
                    episode.PreparationPercent,
                    episode.TotalTerms == 0 ? &quot;No JP subs&quot; : $&quot;{episode.PreparationPercent}%&quot;)" />
            }
        </div>
    }
</section>
