@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<header class="page-header hero-header">
    <div>
        <span class="eyebrow">Japanese through your anime</span>
        <h1>Continue where you left off</h1>
        <p>Scan your NAS, prepare vocabulary, then watch.</p>
    </div>
    <a class="button button-primary" href="/Learn">Review @Model.DueReviews due</a>
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model='new MetricCardModel("Due reviews", Model.DueReviews.ToString(), "Ready now")' />
    <partial name="_MetricCard" model='new MetricCardModel("Anime", Model.AnimeCount.ToString(), "In your library")' />
    <partial name="_MetricCard" model='new MetricCardModel("Episodes", Model.EpisodeCount.ToString(), "Discovered on NAS")' />
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Library</span>
            <h2>Recently discovered</h2>
        </div>
        <a class="text-link" href="/Library">View library</a>
    </div>

    @if (Model.RecentEpisodes.Count == 0)
    {
        <div class="empty-state">
            <h3>No episodes yet</h3>
            <p>Add a NAS root in Settings and start a scan.</p>
            <a class="button" href="/Settings">Open settings</a>
        </div>
    }
    else
    {
        <div class="media-grid">
            @foreach (var episode in Model.RecentEpisodes)
            {
                <partial name="_MediaCard" model='new MediaCardModel(
                    episode.AnimeTitle,
                    $"S{episode.SeasonNumber:00} · Episode {episode.Number}",
                    $"/Library/Episode/{episode.Id}",
                    episode.PreparationPercent,
                    episode.TotalOccurrences == 0 ? "No JP subs" : $"{episode.PreparationPercent}% prepared",
                    episode.CoverImageUrl)' />
            }
        </div>
    }
</section>
