@page
@model IndexModel
@{
    ViewData["Title"] = Model.Ui["nav.home"];
}

<header class="page-header hero-header">
    <div>
        <span class="eyebrow">@Model.Ui["home.eyebrow"]</span>
        <h1>@Model.Ui["home.title"]</h1>
        <p>@Model.Ui["home.subtitle"]</p>
    </div>
    @if (Model.DueReviews > 0)
    {
        <a class="button" href="/Learn">@Model.Ui.Format("home.reviewButton", ("count", Model.DueReviews))</a>
    }
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["home.metric.due"], Model.DueReviews.ToString(), Model.Ui["home.metric.ready"])' />
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["home.metric.anime"], Model.AnimeCount.ToString(), Model.Ui["home.metric.inLibrary"])' />
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["home.metric.episodes"], Model.EpisodeCount.ToString(), Model.Ui["home.metric.discovered"])' />
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@Model.Ui["home.library.eyebrow"]</span>
            <h2>@Model.Ui["home.library.recent"]</h2>
        </div>
        <a class="text-link" href="/Library">@Model.Ui["home.library.view"]</a>
    </div>

    @if (Model.RecentEpisodes.Count == 0)
    {
        <div class="empty-state">
            <h3>@Model.Ui["home.empty.title"]</h3>
            <p>@Model.Ui["home.empty.body"]</p>
            <a class="button" href="/Settings">@Model.Ui["home.empty.settings"]</a>
        </div>
    }
    else
    {
        <div class="media-grid">
            @foreach (var episode in Model.RecentEpisodes)
            {
                <partial name="_MediaCard" model='new MediaCardModel(
                    episode.AnimeTitle,
                    $"S{episode.SeasonNumber:00} · Episode {episode.Number}",
                    $"/Library/Episode/{episode.Id}",
                    episode.PreparationPercent,
                    episode.TotalOccurrences == 0 ? "No JP subs" : $"{episode.PreparationPercent}% prepared",
                    episode.CoverImageUrl)' />
            }
        </div>
    }
</section>
