@page
@model AniLingo.Web.Pages.Settings.AiModel
@using AniLingo.Web.Features.Ai
@{
    ViewData["Title"] = Model.Ui["settings.ai.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← @Model.Ui["nav.settings"]</a>
        <span class="eyebrow">@Model.Ui["nav.settings"]</span>
        <h1>@Model.Ui["settings.ai.title"]</h1>
        <p>@Model.Ui["settings.ai.description"]</p>
    </div>
</header>

<section class="panel">
    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label>
            <span>@Model.Ui["settings.ai.provider"]</span>
            <select asp-for="ProviderId">
                <option value="@AiProviderIds.Server">@Model.Ui["settings.ai.server"]</option>
                <option value="@AiProviderIds.OpenAiCompatible">@Model.Ui["settings.ai.openaiCompatible"]</option>
            </select>
        </label>

        <label>
            <span>@Model.Ui["settings.ai.baseUrl"]</span>
            <input asp-for="BaseUrl" type="url" autocomplete="url" placeholder="https://api.openai.com/v1" />
        </label>

        <label>
            <span>@Model.Ui["settings.ai.model"]</span>
            <input asp-for="ModelName" autocomplete="off" placeholder="gpt-5-mini" />
        </label>

        <label>
            <span>@Model.Ui["settings.ai.apiKey"]</span>
            <input asp-for="ApiKey" type="password" autocomplete="new-password" />
            @if (Model.HasStoredApiKey)
            {
                <small class="muted">@Model.Ui["settings.ai.apiKeyKeep"]</small>
            }
        </label>

        <label>
            <span>@Model.Ui["settings.ai.translationMode"]</span>
            <select asp-for="TranslationMode">
                <option value="@AiTranslationMode.Efficient">@Model.Ui["settings.ai.efficient"]</option>
                <option value="@AiTranslationMode.Quality">@Model.Ui["settings.ai.quality"]</option>
                <option value="@AiTranslationMode.Maximum">@Model.Ui["settings.ai.maximum"]</option>
            </select>
        </label>

        <div class="inline-actions">
            <button class="button button-primary" type="submit" asp-page-handler="Save">
                @Model.Ui["settings.ai.save"]
            </button>
            <button class="button" type="submit" asp-page-handler="Test">
                @Model.Ui["settings.ai.test"]
            </button>
            <button class="button" type="submit" asp-page-handler="Reset" formnovalidate>
                @Model.Ui["settings.ai.reset"]
            </button>
        </div>
    </form>
</section>

@if (Model.IsOwner)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@Model.Ui["settings.ai.server"]</h2>
        </div>
        <p class="muted">The Owner manages the shared Codex CLI connection separately.</p>
        <a class="button" asp-page="/Admin/Ai">Open server AI</a>
    </section>
}
