@page
@model AniLingo.Web.Pages.Settings.ProwlarrModel
@{
    ViewData["Title"] = "Prowlarr";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Settings · Server</span>
        <h1>Prowlarr</h1>
        <p>Indexer search for anime acquisition. Only usenet results are sent to SABnzbd.</p>
    </div>
    <a class="button" asp-page="/Acquisition/Index">Anime acquisition</a>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>Connection</h2>
            <span>@(Model.IsConfigured ? "Configured" : "Not configured")</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notice))
        {
            <p class="muted" role="status">@Model.Notice</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <p class="metadata-error" role="alert">@Model.Error</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LoadError))
        {
            <p class="metadata-error" role="alert">@Model.LoadError</p>
        }

        <form method="post" class="form-stack">
            <label>
                <span>Prowlarr URL</span>
                <input asp-for="BaseUrl" type="url" placeholder="http://prowlarr:9696" required />
            </label>
            <label>
                <span>API key</span>
                <input asp-for="ApiKey"
                       type="password"
                       value=""
                       autocomplete="new-password"
                       placeholder="@(Model.IsConfigured ? "Saved — leave blank to keep" : "Prowlarr API key")" />
            </label>
            <label>
                <span>Categories</span>
                <input asp-for="Categories" inputmode="numeric" placeholder="5000, 5070" />
                <small class="muted">Newznab category IDs; 5070 is TV/Anime.</small>
            </label>
            <label>
                <span>Indexer IDs</span>
                <input asp-for="IndexerIds" inputmode="numeric" placeholder="All indexers" />
                <small class="muted">Leave empty to search every Prowlarr indexer. An anime can narrow this on its own page.</small>
            </label>
            <label>
                <span>Results per query</span>
                <input asp-for="SearchLimit" type="number" min="1" max="1000" />
            </label>

            <div class="inline-actions">
                <button class="button button-primary" type="submit" asp-page-handler="Save">Save</button>
                @if (Model.IsConfigured)
                {
                    <button class="button" type="submit" asp-page-handler="Test" formnovalidate>Test connection</button>
                    <button class="button" type="submit" asp-page-handler="Remove" formnovalidate>Remove</button>
                }
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>How it is used</h2></div>
        <p class="muted">
            The acquisition scheduler searches wanted episodes of monitored anime, scores every result with the
            anime's quality profile and records why each release was accepted or rejected. The API key is stored
            encrypted and never appears in URLs or logs.
        </p>
    </section>
</div>
