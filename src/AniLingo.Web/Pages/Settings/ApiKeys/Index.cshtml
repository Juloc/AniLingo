@page
@model AniLingo.Web.Pages.Settings.ApiKeys.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.apiKeys.title"];
}

<h1>@ui["settings.apiKeys.heading"]</h1>
<p class="muted">@ui["settings.apiKeys.description"]</p>

@if (Model.Notice is not null)
{
    <p class="metadata-notice">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error">@Model.Error</p>
}

@if (Model.CreatedRawKey is not null)
{
    <div class="metadata-notice">
        <p><strong>'@Model.CreatedKeyName'</strong> — copy this key now; it will not be shown again:</p>
        <p><code>@Model.CreatedRawKey</code></p>
    </div>
}

<form method="post" asp-page-handler="Create">
    <label>
        @ui["settings.apiKeys.nameLabel"]
        <input type="text" name="name" placeholder="e.g. Sonarr-style automation script" maxlength="120" required />
    </label>
    <button type="submit">@ui["settings.apiKeys.create"]</button>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>@ui["settings.apiKeys.nameColumn"]</th>
            <th>@ui["settings.apiKeys.prefixColumn"]</th>
            <th>@ui["settings.apiKeys.createdColumn"]</th>
            <th>@ui["settings.apiKeys.lastUsedColumn"]</th>
            <th>@ui["settings.apiKeys.statusColumn"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var key in Model.Keys)
        {
            <tr>
                <td>@key.Name</td>
                <td><code>@key.KeyPrefix…</code></td>
                <td>@key.CreatedAtUtc.ToString("u")</td>
                <td>@(key.LastUsedAtUtc?.ToString("u") ?? ui["settings.apiKeys.never"])</td>
                <td>
                    @if (key.IsActive)
                    {
                        <span class="status-pill status-ok">@ui["settings.apiKeys.active"]</span>
                    }
                    else
                    {
                        <span class="status-pill status-warn">@ui.Format("settings.apiKeys.revoked", ("date", key.RevokedAtUtc?.ToString("u") ?? ""))</span>
                    }
                </td>
                <td>
                    @if (key.IsActive)
                    {
                        <form method="post" asp-page-handler="Revoke" asp-route-id="@key.Id" style="display:inline">
                            <button type="submit">@ui["settings.apiKeys.revoke"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Keys.Count == 0)
        {
            <tr><td colspan="6" class="muted">@ui["settings.apiKeys.empty"]</td></tr>
        }
    </tbody>
</table>
