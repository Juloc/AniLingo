@page
@model AniLingo.Web.Pages.Settings.LearningCoursesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.learningCourses.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Learning">@ui["settings.learningCourses.backToLearning"]</a>
        <span class="eyebrow">@ui["settings.learning.eyebrow"]</span>
        <h1>@ui["settings.learningCourses.title"]</h1>
        <p>@ui["settings.learningCourses.pageDescription"]</p>
    </div>
</header>

<div asp-validation-summary="ModelOnly" class="validation"></div>

@if (Model.Courses.Count == 0)
{
    <div class="empty-state">
        <h3>@ui["settings.learningCourses.empty.title"]</h3>
        <p>@ui["settings.learningCourses.empty.body"]</p>
    </div>
}

<div class="form-stack">
    @foreach (var course in Model.Courses)
    {
        <section class="panel">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">
                        @AniLingo.Web.Pages.Settings.LearningCoursesModel.LanguageName(course.SourceLanguage) → @AniLingo.Web.Pages.Settings.LearningCoursesModel.LanguageName(course.TargetLanguage)
                    </span>
                    <h2>@course.Name</h2>
                </div>
                <div class="inline-actions">
                    <span class="status-pill">@ui.Format("settings.learningCourses.wordCount", ("count", Model.WordCounts.GetValueOrDefault(course.Id)))</span>
                    @if (course.IsPrimary)
                    {
                        <span class="status-pill status-ok">@ui.Format("settings.learningCourses.primaryFor", ("language", course.SourceLanguage))</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Primary">
                            <input type="hidden" name="courseId" value="@course.Id" />
                            <button class="chip" type="submit">@ui.Format("settings.learningCourses.makePrimaryFor", ("language", course.SourceLanguage))</button>
                        </form>
                    }
                </div>
            </div>

            <form method="post" asp-page-handler="Update" class="form-stack">
                <input type="hidden" name="courseId" value="@course.Id" />
                <label>
                    <span>@ui["settings.learningCourses.nameLabel"]</span>
                    <input name="name" value="@course.Name" maxlength="120" />
                </label>

                <label class="checkbox-row">
                    <input type="checkbox" name="isEnabled" value="true" checked="@course.IsEnabled" />
                    @ui["settings.learningCourses.courseEnabled"]
                </label>

                <fieldset class="form-stack">
                    <legend>@ui["settings.learningCourses.practiceModes"]</legend>
                    <label class="checkbox-row">
                        <input type="checkbox" name="recognition" value="true" checked="@course.Options.RecognitionEnabled" />
                        @ui.Format("settings.learningCourses.recognitionMode", ("source", course.SourceLanguage), ("target", course.TargetLanguage))
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" name="production" value="true" checked="@course.Options.ProductionEnabled" />
                        @ui.Format("settings.learningCourses.productionMode", ("source", course.SourceLanguage), ("target", course.TargetLanguage))
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" name="listening" value="true" checked="@course.Options.ListeningEnabled" />
                        @ui.Format("settings.learningCourses.listeningMode", ("source", course.SourceLanguage))
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" name="writing" value="true" checked="@course.Options.WritingEnabled" />
                        @ui.Format("settings.learningCourses.writingMode", ("source", course.SourceLanguage))
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" name="sentencePractice" value="true" checked="@course.Options.SentencePracticeEnabled" />
                        @ui["settings.learningCourses.sentencePracticeMode"]
                    </label>
                    <small class="muted">
                        @ui["settings.learningCourses.modesHint"]
                    </small>
                </fieldset>

                <div class="inline-actions">
                    <button class="button" type="submit">@ui["settings.learningCourses.saveCourse"]</button>
                </div>
            </form>
        </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["settings.learningCourses.newCourse"]</span>
                <h2>@ui["settings.learningCourses.addLanguagePair"]</h2>
            </div>
        </div>

        <form method="post" asp-page-handler="Create" class="form-stack">
            <div class="settings-grid">
                <label>
                    <span>@ui["settings.learningCourses.sourceLanguageLabel"]</span>
                    <input asp-for="NewCourse.SourceLanguage"
                           placeholder="ja"
                           autocomplete="off"
                           autocapitalize="off"
                           spellcheck="false" />
                    <small class="muted">@ui["settings.learningCourses.sourceLanguageHint"]</small>
                    <span asp-validation-for="NewCourse.SourceLanguage" class="validation"></span>
                </label>
                <label>
                    <span>@ui["settings.learningCourses.targetLanguageLabel"]</span>
                    <input asp-for="NewCourse.TargetLanguage"
                           placeholder="de"
                           autocomplete="off"
                           autocapitalize="off"
                           spellcheck="false" />
                    <small class="muted">@ui["settings.learningCourses.targetLanguageHint"]</small>
                    <span asp-validation-for="NewCourse.TargetLanguage" class="validation"></span>
                </label>
            </div>

            <label>
                <span>@ui["settings.learningCourses.nameOptionalLabel"]</span>
                <input asp-for="NewCourse.Name" maxlength="120" />
            </label>

            <fieldset class="form-stack">
                <legend>@ui["settings.learningCourses.practiceModes"]</legend>
                <label class="checkbox-row">
                    <input asp-for="NewCourse.Recognition" type="checkbox" />
                    @ui["settings.learningCourses.recognition"]
                </label>
                <label class="checkbox-row">
                    <input asp-for="NewCourse.Production" type="checkbox" />
                    @ui["settings.learningCourses.production"]
                </label>
                <label class="checkbox-row">
                    <input asp-for="NewCourse.Listening" type="checkbox" />
                    @ui["settings.learningCourses.listening"]
                </label>
                <label class="checkbox-row">
                    <input asp-for="NewCourse.Writing" type="checkbox" />
                    @ui["settings.learningCourses.writing"]
                </label>
                <label class="checkbox-row">
                    <input asp-for="NewCourse.SentencePractice" type="checkbox" />
                    @ui["settings.learningCourses.sentencePracticeMode"]
                </label>
            </fieldset>

            <div class="inline-actions">
                <button class="button button-primary" type="submit">@ui["settings.learningCourses.addCourse"]</button>
            </div>
        </form>
    </section>
</div>
