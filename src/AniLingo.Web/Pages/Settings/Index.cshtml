@page
@model AniLingo.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Personal</span>
        <h1>Settings</h1>
        <p>Your learning and account integrations.</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>Learning</h2>
            <span>Personal</span>
        </div>
        <p class="muted">
            Adjust your desired retention, review batch size and daily new words.
        </p>
        <a class="button" asp-page="/Settings/Learning">Manage learning</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>AniList</h2><span>Personal</span></div>
        <p class="muted">Connect your own AniList account and sync only your progress.</p>
        <a class="button" asp-page="/Settings/AniList">Manage AniList</a>
    </section>
</div>
