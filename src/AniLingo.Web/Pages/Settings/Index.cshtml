@page
@model AniLingo.Web.Pages.Settings.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.title"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["settings.scope.personal"]</span>
        <h1>@ui["settings.title"]</h1>
        <p>@ui["settings.subtitle"]</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.language.title"]</h2>
            <span>@ui["settings.scope.personal"]</span>
        </div>
        <p class="muted">@ui["settings.language.description"]</p>
        <a class="button" asp-page="/Settings/Language">@ui["settings.language.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.learning.title"]</h2>
            <span>@ui["settings.scope.personal"]</span>
        </div>
        <p class="muted">@ui["settings.learning.description"]</p>
        <a class="button" asp-page="/Settings/Learning">@ui["settings.learning.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.ai.title"]</h2>
            <span>@ui["settings.scope.personal"]</span>
        </div>
        <p class="muted">@ui["settings.ai.description"]</p>
        <a class="button" asp-page="/Settings/Ai">@ui["settings.ai.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.anilist.title"]</h2>
            <span>@ui["settings.scope.personal"]</span>
        </div>
        <p class="muted">@ui["settings.anilist.description"]</p>
        <a class="button" asp-page="/Settings/AniList">@ui["settings.anilist.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mappingReview.title"]</h2>
            <span>@ui["settings.scope.owner"]</span>
        </div>
        <p class="muted">@ui["settings.mappingReview.description"]</p>
        <a class="button" asp-page="/Settings/MappingReview">@ui["settings.mappingReview.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mappingSegments.title"]</h2>
            <span>@ui["settings.scope.owner"]</span>
        </div>
        <p class="muted">@ui["settings.mappingSegments.description"]</p>
        <a class="button" asp-page="/Settings/MappingSegments">@ui["settings.mappingSegments.manage"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.offline.title"]</h2>
            <span>@ui["settings.scope.personal"]</span>
        </div>
        <p class="muted">@ui["settings.offline.description"]</p>
        <a class="button" asp-page="/Settings/Offline">@ui["settings.offline.manage"]</a>
    </section>
</div>
