@page
@using AniLingo.Web.Features.Learning
@model AniLingo.Web.Pages.Settings.LearningScopeModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("settings.learningScope.pageTitle", ("label", Model.DisplayLabel));
}

<header class="page-header">
    <div>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl))
        {
            <a class="back-link" href="@Model.ReturnUrl">@ui.Format("settings.learningScope.backTo", ("label", Model.DisplayLabel))</a>
        }
        else
        {
            <a class="back-link" href="/Settings/Learning">@ui["settings.learningCourses.backToLearning"]</a>
        }
        <span class="eyebrow">@Model.MediaType · @Model.Scope</span>
        <h1>@ui["settings.learningScope.title"]</h1>
        <p>
            @ui.Format("settings.learningScope.overrideOnlyFor", ("label", Model.DisplayLabel))
            @ui["settings.learningScope.inheritHint"]
        </p>
    </div>
    <span class="status-pill">@ui.Format("settings.learningScope.effective", ("mode", Model.ModeName(Model.Effective.Mode)))</span>
</header>

<form method="post" class="form-stack">
    <input type="hidden" asp-for="MediaType" />
    <input type="hidden" asp-for="Scope" />
    <input type="hidden" asp-for="WorkKey" />
    <input type="hidden" asp-for="ContentKey" />
    <input type="hidden" asp-for="Label" />
    <input type="hidden" asp-for="ReturnUrl" />

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["settings.learningScope.scopeOverride"]</span>
                <h2>@ui["settings.learningScope.modeHeading"]</h2>
            </div>
            <span>@(Model.Current.ModeOverride is { } modeOverride ? Model.ModeName(modeOverride) : ui["settings.learning.media.inherit"])</span>
        </div>

        <label>
            <span>@ui["settings.learningScope.learningModeLabel"]</span>
            <select asp-for="ModeOverride">
                <option value="inherit">@ui["settings.learning.media.inherit"]</option>
                <option value="Off">@ui["settings.learning.mode.off"]</option>
                <option value="LanguageTools">@ui["settings.learning.mode.languageTools"]</option>
                <option value="Study">@ui["settings.learning.mode.study"]</option>
                <option value="Custom">@ui["settings.learning.mode.custom"]</option>
            </select>
            <small class="muted">
                @ui["settings.learningScope.modeHint"]
            </small>
        </label>
    </section>

    <details class="panel">
        <summary>
            <strong>@ui["settings.learningScope.individualCapabilities"]</strong>
            <span class="muted">@ui["settings.learningScope.inheritOnOff"]</span>
        </summary>

        <div class="form-stack" style="margin-top:1rem;">
            @foreach (var capability in Model.Capabilities)
            {
                var current = Model.Current.GetOverride(capability);
                var effective = Model.Effective.IsEnabled(capability);
                <label>
                    <span>@Model.CapabilityLabel(capability)</span>
                    <select name="cap_@capability">
                        <option value="inherit" selected="@(current is null ? "selected" : null)">
                            @ui.Format("settings.learningScope.inheritCurrently", ("state", effective ? ui["settings.learning.on"] : ui["settings.learning.off"]))
                        </option>
                        <option value="on" selected="@(current == true ? "selected" : null)">@ui["settings.learning.on"]</option>
                        <option value="off" selected="@(current == false ? "selected" : null)">@ui["settings.learning.off"]</option>
                    </select>
                    <small class="muted">@Model.CapabilityDescription(capability)</small>
                </label>
            }
        </div>
    </details>

    <div class="inline-actions">
        <button class="button button-primary" type="submit">@ui["settings.learningScope.saveForScope"]</button>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl))
        {
            <a class="button" href="@Model.ReturnUrl">@ui["common.cancel"]</a>
        }
    </div>
</form>
