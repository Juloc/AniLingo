@page
@using AniLingo.Web.Features.Acquisition.Naming
@model AniLingo.Web.Pages.Settings.NamingModel
@{
    ViewData["Title"] = "Anime naming";
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Admin/Sonarr">&larr; Sonarr</a>
        <span class="eyebrow">Settings &middot; Acquisition</span>
        <h1>Anime naming</h1>
        <p>Sonarr-compatible folder and file templates. Saving a profile never renames existing files; renames are previewed and confirmed per anime.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="metadata-error" style="color:inherit">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>Profiles</h2>
            <span>@Model.State.Profiles.Length</span>
        </div>
        <ul>
            @foreach (var profile in Model.State.Profiles)
            {
                var isDefault = profile.Id.Equals(Model.State.DefaultProfileId, StringComparison.OrdinalIgnoreCase);
                var usage = Model.UsageCount(profile.Id);
                <li>
                    <a asp-page="/Settings/Naming" asp-route-edit="@profile.Id"><strong>@profile.Name</strong></a>
                    <span class="muted">@profile.Id@(isDefault ? " · default" : "")@(usage > 0 ? $" · {usage} assignment(s)" : "")</span>
                </li>
            }
        </ul>
        <div class="inline-actions">
            @foreach (var preset in AnimeNamingPresets.All)
            {
                <a class="button" asp-page="/Settings/Naming" asp-route-preset="@preset.Id">New from “@preset.Name”</a>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Selection</h2>
            <span>Anime &gt; library &gt; default</span>
        </div>
        <form method="post" asp-page-handler="Default" class="form-stack">
            <label>
                <span>Default profile</span>
                <select name="profileId">
                    @foreach (var profile in Model.State.Profiles)
                    {
                        <option value="@profile.Id" selected="@(profile.Id.Equals(Model.State.DefaultProfileId, StringComparison.OrdinalIgnoreCase))">@profile.Name</option>
                    }
                </select>
            </label>
            <div class="inline-actions"><button class="button" type="submit">Set default</button></div>
        </form>

        @foreach (var root in Model.Roots)
        {
            Model.State.LibraryProfileAssignments.TryGetValue(root.Id.ToString("D"), out var assigned);
            <form method="post" asp-page-handler="Library" class="form-stack">
                <input type="hidden" name="rootId" value="@root.Id" />
                <label>
                    <span>Library “@root.Name”</span>
                    <select name="profileId">
                        <option value="" selected="@(assigned is null)">Use default</option>
                        @foreach (var profile in Model.State.Profiles)
                        {
                            <option value="@profile.Id" selected="@(profile.Id.Equals(assigned, StringComparison.OrdinalIgnoreCase))">@profile.Name</option>
                        }
                    </select>
                </label>
                <div class="inline-actions"><button class="button" type="submit">Save</button></div>
            </form>
        }
        <p class="muted">Per-anime profiles and series type are chosen on each anime's rename page.</p>
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@(Model.IsExistingProfile ? $"Edit “{Model.Input.Name}”" : "New profile")</h2>
        <span>@Model.Input.Id</span>
    </div>

    <form method="post" class="form-stack">
        <label>
            <span>Name</span>
            <input asp-for="Input.Name" maxlength="80" required />
        </label>
        @if (Model.IsExistingProfile)
        {
            <input type="hidden" asp-for="Input.Id" />
        }
        else
        {
            <label>
                <span>Profile ID</span>
                <input asp-for="Input.Id" maxlength="64" pattern="[a-z0-9-]+" required />
            </label>
        }
        <label>
            <span>Series folder format</span>
            <input asp-for="Input.SeriesFolderFormat" spellcheck="false" />
        </label>
        <label class="checkbox-row">
            <input type="checkbox" asp-for="Input.UseSeasonFolders" />
            <span>Use season folders</span>
        </label>
        <label>
            <span>Season folder format</span>
            <input asp-for="Input.SeasonFolderFormat" spellcheck="false" />
        </label>
        <label>
            <span>Specials folder format</span>
            <input asp-for="Input.SpecialsFolderFormat" spellcheck="false" />
        </label>
        <label>
            <span>Standard episode format</span>
            <input asp-for="Input.StandardEpisodeFormat" spellcheck="false" />
        </label>
        <label>
            <span>Daily episode format</span>
            <input asp-for="Input.DailyEpisodeFormat" spellcheck="false" />
        </label>
        <label>
            <span>Anime episode format</span>
            <input asp-for="Input.AnimeEpisodeFormat" spellcheck="false" />
            <small class="muted">Used when every episode of the file has an absolute number; otherwise the standard format applies.</small>
        </label>
        <label>
            <span>Multi-episode style</span>
            <select asp-for="Input.MultiEpisodeStyle">
                <option value="@AnimeMultiEpisodeStyle.Extend">Extend (S01E01-02-03)</option>
                <option value="@AnimeMultiEpisodeStyle.Duplicate">Duplicate (S01E01.S01E02)</option>
                <option value="@AnimeMultiEpisodeStyle.Repeat">Repeat (S01E01E02E03)</option>
                <option value="@AnimeMultiEpisodeStyle.Scene">Scene (S01E01-E02-E03)</option>
                <option value="@AnimeMultiEpisodeStyle.Range">Range (S01E01-03)</option>
                <option value="@AnimeMultiEpisodeStyle.PrefixedRange">Prefixed range (S01E01-E03)</option>
            </select>
        </label>
        <label class="checkbox-row">
            <input type="checkbox" asp-for="Input.ReplaceIllegalCharacters" />
            <span>Replace illegal characters (otherwise they are removed)</span>
        </label>
        <label>
            <span>Colon replacement</span>
            <select asp-for="Input.ColonReplacement">
                <option value="@AnimeColonReplacement.Smart">Smart replace (": " → " - ", ":" → "-")</option>
                <option value="@AnimeColonReplacement.Delete">Delete</option>
                <option value="@AnimeColonReplacement.Dash">Dash</option>
                <option value="@AnimeColonReplacement.SpaceDash">Space dash</option>
                <option value="@AnimeColonReplacement.SpaceDashSpace">Space dash space</option>
                <option value="@AnimeColonReplacement.Custom">Custom</option>
            </select>
        </label>
        <label>
            <span>Custom colon replacement</span>
            <input asp-for="Input.CustomColonReplacement" maxlength="10" />
        </label>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="validation">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="inline-actions">
            <button class="button" type="submit" asp-page-handler="Preview">Preview</button>
            <button class="button button-primary" type="submit" asp-page-handler="Save">Save profile</button>
        </div>
    </form>

    @if (Model.IsExistingProfile)
    {
        <form method="post" asp-page-handler="Delete" class="inline-actions">
            <input type="hidden" name="profileId" value="@Model.Input.Id" />
            <button class="button" type="submit">Delete profile</button>
        </form>
    }
</section>

@if (Model.Preview.Count > 0)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>Preview</h2>
            <span>Sonarr sample: The Series Title's! (2010)</span>
        </div>
        <dl class="status-list">
            @foreach (var line in Model.Preview)
            {
                <div><dt class="muted">@line.Label</dt><dd><code>@line.Value</code></dd></div>
            }
        </dl>
    </section>
}

<section class="panel">
    <details>
        <summary>Tokens</summary>
        <p class="muted">Write <code>{Series.Title}</code> or <code>{Series_Title}</code> to change the word separator, all-lowercase or all-uppercase token names to change case, and characters such as <code>{[Release Group]}</code> or <code>{-Release Group}</code> inside the braces to add text only when the value exists.</p>
        <ul>
            <li><strong>Series</strong>: <code>{Series Title}</code> <code>{Series CleanTitle}</code> <code>{Series TitleYear}</code> <code>{Series CleanTitleYear}</code> <code>{Series TitleWithoutYear}</code> <code>{Series CleanTitleWithoutYear}</code> <code>{Series TitleThe}</code> <code>{Series CleanTitleThe}</code> <code>{Series TitleFirstCharacter}</code> <code>{Series Year}</code></li>
            <li><strong>Provider IDs</strong>: <code>{AniListId}</code> <code>{MalId}</code> <code>{TvdbId}</code> <code>{TmdbId}</code> <code>{ImdbId}</code></li>
            <li><strong>Numbering</strong>: <code>{season:00}</code> <code>{episode:00}</code> <code>{absolute:000}</code> <code>{Air-Date}</code></li>
            <li><strong>Episode</strong>: <code>{Episode Title}</code> <code>{Episode CleanTitle}</code></li>
            <li><strong>Quality</strong>: <code>{Quality Full}</code> <code>{Quality Title}</code> <code>{Quality Proper}</code> <code>{Quality Key}</code></li>
            <li><strong>Release</strong>: <code>{Release Group}</code> <code>{MediaInfo VideoCodec}</code> <code>{MediaInfo VideoBitDepth}</code> <code>{MediaInfo VideoDynamicRangeType}</code> <code>{MediaInfo AudioCodec}</code> <code>{MediaInfo AudioChannels}</code> <code>{MediaInfo AudioLanguages}</code> <code>{MediaInfo AudioLanguagesAll}</code> <code>{MediaInfo SubtitleLanguages}</code> <code>{MediaInfo Simple}</code> <code>{MediaInfo Full}</code></li>
        </ul>
        <p class="muted">Release tokens come from the release name (AniLingo's release parser), not from probing the file.</p>
    </details>
</section>
