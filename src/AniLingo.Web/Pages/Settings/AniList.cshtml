@page
@model AniLingo.Web.Pages.Settings.AniListModel
@using AniLingo.Web.Features.Tracking
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.anilist.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">@ui["common.backToSettings"]</a>
        <span class="eyebrow">@ui["settings.anilist.eyebrow"]</span>
        <h1>@ui["settings.anilist.title"]</h1>
        <p>@ui["settings.anilist.pageDescription"]</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.anilist.account.heading"]</h2>
            @if (Model.Account.IsConnected)
            {
                <span class="status-pill @(Model.Account.IsExpired ? "status-error" : "status-ok")">
                    @(Model.Account.IsExpired ? ui["settings.anilist.account.reconnect"] : ui["settings.anilist.account.connected"])
                </span>
            }
            else
            {
                <span class="status-pill">@ui["settings.anilist.account.notConnected"]</span>
            }
        </div>

        @if (Model.Account.IsConnected)
        {
            <div class="status-list">
                <div>
                    <span>@ui["settings.anilist.account.user"]</span>
                    <strong>@Model.Account.ViewerName</strong>
                </div>
                <div>
                    <span>@ui["settings.anilist.account.userId"]</span>
                    <strong>@Model.Account.ViewerId</strong>
                </div>
                <div>
                    <span>@ui["settings.anilist.account.clientId"]</span>
                    <strong>@Model.Account.ClientId</strong>
                </div>
                <div>
                    <span>@ui["settings.anilist.account.connectedAt"]</span>
                    <strong>@Model.Account.ConnectedAt?.ToLocalTime().ToString("g")</strong>
                </div>
                <div>
                    <span>@ui["settings.anilist.account.tokenExpires"]</span>
                    <strong>
                        @(Model.Account.TokenExpiresAt?.ToLocalTime().ToString("g") ?? ui["settings.anilist.account.unknown"])
                    </strong>
                </div>
                <div>
                    <span>@ui["settings.anilist.account.credentialStorage"]</span>
                    <strong>@ui["settings.anilist.account.credentialStorageValue"]</strong>
                </div>
            </div>

            <p class="muted">
                @ui["settings.anilist.account.progressOnlyNote"]
            </p>

            <form method="post" asp-page-handler="Disconnect">
                <button class="button" type="submit">@ui["settings.anilist.account.disconnect"]</button>
            </form>
        }
        else
        {
            <p class="muted">
                @ui["settings.anilist.account.notConnectedNote"]
            </p>
        }
    </section>

    @if (Model.Account.IsConnected)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.anilist.sync.heading"]</h2>
                <span class="status-pill @(Model.Sync.Mode == AniListSyncMode.Off ? "" : "status-ok")">
                    @Model.SyncModeLabel(Model.Sync.Mode)
                </span>
            </div>

            <form method="post" asp-page-handler="SyncMode" class="form-stack">
                @foreach (var mode in Enum.GetValues<AniListSyncMode>())
                {
                    <label>
                        <span>
                            <input type="radio"
                                   name="syncMode"
                                   value="@mode"
                                   checked="@(Model.Sync.Mode == mode)" />
                            <strong>@Model.SyncModeLabel(mode)</strong>
                        </span>
                        <small class="muted">@Model.SyncModeDescription(mode)</small>
                    </label>
                }
                <button class="button button-primary" type="submit">@ui["common.save"]</button>
            </form>

            @if (Model.Sync.EnabledAt is DateTimeOffset enabledAt)
            {
                <p class="muted">
                    @ui.Format("settings.anilist.sync.appliesSince", ("time", enabledAt.ToLocalTime().ToString("g")))
                </p>
            }

            @if (Model.Sync.PausedUntil is DateTimeOffset pausedUntil)
            {
                <p class="validation">
                    @ui.Format("settings.anilist.sync.rateLimited", ("time", pausedUntil.ToLocalTime().ToString("t")))
                </p>
            }
        </section>

        @if (Model.Sync.Mode != AniListSyncMode.Off || Model.Sync.Activity.Count > 0)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>@ui["settings.anilist.sync.recentHeading"]</h2>
                    <span>@ui["settings.anilist.sync.onlyVisibleToYou"]</span>
                </div>

                @if (Model.Sync.Activity.Count == 0)
                {
                    <p class="muted">@ui["settings.anilist.sync.nothingYet"]</p>
                }
                else
                {
                    <div class="status-list">
                        @foreach (var item in Model.Sync.Activity)
                        {
                            var (label, css) = Model.SyncStatus(item.Status);
                            <div>
                                <span>
                                    <a href="@AniLingo.Web.Pages.Settings.AniListModel.LocalWorkUrl(item)">@item.Title</a>
                                    <br />
                                    <small>@item.Message</small>
                                    <br />
                                    <small>
                                        @item.LastAttemptAt.ToLocalTime().ToString("g")
                                        @if (item.NextAttemptAt is DateTimeOffset nextAttemptAt)
                                        {
                                            <text> · @ui.Format("settings.anilist.sync.nextTry", ("time", nextAttemptAt.ToLocalTime().ToString("g")))</text>
                                        }
                                    </small>
                                </span>
                                <strong><span class="status-pill @css">@label</span></strong>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    }

    @if (!Model.Account.IsConnected)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.anilist.step1.heading"]</h2>
                <span>@ui["settings.anilist.step1.oneTime"]</span>
            </div>

            <p class="muted">
                @ui["settings.anilist.step1.instructions"]
            </p>
            <code class="device-code">https://anilist.co/api/v2/oauth/pin</code>

            <div class="inline-actions">
                <a class="button"
                   href="https://anilist.co/settings/developer"
                   target="_blank"
                   rel="noopener noreferrer">
                    @ui["settings.anilist.step1.openDevSettings"]
                </a>
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.anilist.step2.heading"]</h2>
                <span>@ui["settings.anilist.step2.clientIdBadge"]</span>
            </div>

            <form method="post" asp-page-handler="Prepare" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <label>
                    <span>@ui["settings.anilist.step2.clientIdLabel"]</span>
                    <input asp-for="ClientId" inputmode="numeric" autocomplete="off" />
                    <span asp-validation-for="ClientId" class="validation"></span>
                </label>
                <button class="button button-primary" type="submit">@ui["settings.anilist.step2.createLoginLink"]</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.AuthorizationUrl))
            {
                <div class="device-login">
                    <p>@ui["settings.anilist.step2.openLoginInstruction"]</p>
                    <a class="button button-primary"
                       href="@Model.AuthorizationUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @ui["settings.anilist.step2.openLogin"]
                    </a>
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.anilist.step3.heading"]</h2>
                <span>@ui["settings.anilist.step3.accessTokenBadge"]</span>
            </div>

            <form method="post" asp-page-handler="Connect" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <input type="hidden" asp-for="ClientId" />
                <label>
                    <span>@ui["settings.anilist.step3.accessTokenLabel"]</span>
                    <input asp-for="AccessToken"
                           type="password"
                           autocomplete="off"
                           spellcheck="false" />
                    <span asp-validation-for="AccessToken" class="validation"></span>
                </label>
                <button class="button button-primary" type="submit">@ui["settings.anilist.step3.connect"]</button>
            </form>
        </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.anilist.safety.heading"]</h2>
            <span>@ui["settings.anilist.safety.badge"]</span>
        </div>
        <p class="muted">
            @ui["settings.anilist.safety.paragraph1"]
        </p>
        <p class="muted">
            @ui["settings.anilist.safety.paragraph2"]
        </p>
        <p class="muted">
            @ui["settings.anilist.safety.paragraph3"]
        </p>
    </section>
</div>
