@page
@model AniLingo.Web.Pages.Settings.AniListModel
@using AniLingo.Web.Features.Tracking
@{
    ViewData["Title"] = "AniList";
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← Settings</a>
        <span class="eyebrow">Optional integration</span>
        <h1>AniList</h1>
        <p>Connect your personal account for AniLingo's complementary learning workflow.</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>Account</h2>
            @if (Model.Account.IsConnected)
            {
                <span class="status-pill @(Model.Account.IsExpired ? "status-error" : "status-ok")">
                    @(Model.Account.IsExpired ? "Reconnect" : "Connected")
                </span>
            }
            else
            {
                <span class="status-pill">Not connected</span>
            }
        </div>

        @if (Model.Account.IsConnected)
        {
            <div class="status-list">
                <div>
                    <span>User</span>
                    <strong>@Model.Account.ViewerName</strong>
                </div>
                <div>
                    <span>AniList user ID</span>
                    <strong>@Model.Account.ViewerId</strong>
                </div>
                <div>
                    <span>Client ID</span>
                    <strong>@Model.Account.ClientId</strong>
                </div>
                <div>
                    <span>Connected</span>
                    <strong>@Model.Account.ConnectedAt?.ToLocalTime().ToString("g")</strong>
                </div>
                <div>
                    <span>Token expires</span>
                    <strong>
                        @(Model.Account.TokenExpiresAt?.ToLocalTime().ToString("g") ?? "Unknown")
                    </strong>
                </div>
                <div>
                    <span>Credential storage</span>
                    <strong>Protected per AniLingo profile under /data</strong>
                </div>
            </div>

            <p class="muted">
                AniLingo writes progress only: it never sends score, notes, repeat count, list status, custom lists or dates.
            </p>

            <form method="post" asp-page-handler="Disconnect">
                <button class="button" type="submit">Disconnect</button>
            </form>
        }
        else
        {
            <p class="muted">
                AniLingo uses AniList's self-host friendly auth PIN flow. Your access token is protected before it is written to disk.
            </p>
        }
    </section>

    @if (Model.Account.IsConnected)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>Automatic sync</h2>
                <span class="status-pill @(Model.Sync.Mode == AniListSyncMode.Off ? "" : "status-ok")">
                    @AniListModel.SyncModeLabel(Model.Sync.Mode)
                </span>
            </div>

            <form method="post" asp-page-handler="SyncMode" class="form-stack">
                @foreach (var mode in Enum.GetValues<AniListSyncMode>())
                {
                    <label>
                        <span>
                            <input type="radio"
                                   name="syncMode"
                                   value="@mode"
                                   checked="@(Model.Sync.Mode == mode)" />
                            <strong>@AniListModel.SyncModeLabel(mode)</strong>
                        </span>
                        <small class="muted">@AniListModel.SyncModeDescription(mode)</small>
                    </label>
                }
                <button class="button button-primary" type="submit">Save</button>
            </form>

            @if (Model.Sync.EnabledAt is DateTimeOffset enabledAt)
            {
                <p class="muted">
                    Applies to progress made since @enabledAt.ToLocalTime().ToString("g").
                    Use Sync on a detail page for earlier progress.
                </p>
            }

            @if (Model.Sync.PausedUntil is DateTimeOffset pausedUntil)
            {
                <p class="validation">
                    AniList is rate limiting requests. Automatic sync resumes after @pausedUntil.ToLocalTime().ToString("t").
                </p>
            }
        </section>

        @if (Model.Sync.Mode != AniListSyncMode.Off || Model.Sync.Activity.Count > 0)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>Recent sync activity</h2>
                    <span>Only visible to you</span>
                </div>

                @if (Model.Sync.Activity.Count == 0)
                {
                    <p class="muted">Nothing synced automatically yet.</p>
                }
                else
                {
                    <div class="status-list">
                        @foreach (var item in Model.Sync.Activity)
                        {
                            var (label, css) = AniListModel.SyncStatus(item.Status);
                            <div>
                                <span>
                                    <a href="@AniListModel.LocalWorkUrl(item)">@item.Title</a>
                                    <br />
                                    <small>@item.Message</small>
                                    <br />
                                    <small>
                                        @item.LastAttemptAt.ToLocalTime().ToString("g")
                                        @if (item.NextAttemptAt is DateTimeOffset nextAttemptAt)
                                        {
                                            <text> · next try @nextAttemptAt.ToLocalTime().ToString("g")</text>
                                        }
                                    </small>
                                </span>
                                <strong><span class="status-pill @css">@label</span></strong>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    }

    @if (!Model.Account.IsConnected)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>1. Create an AniList app</h2>
                <span>One time</span>
            </div>

            <p class="muted">
                Create an application in AniList Developer Settings and set its redirect URL exactly to:
            </p>
            <code class="device-code">https://anilist.co/api/v2/oauth/pin</code>

            <div class="inline-actions">
                <a class="button"
                   href="https://anilist.co/settings/developer"
                   target="_blank"
                   rel="noopener noreferrer">
                    Open AniList Developer Settings
                </a>
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>2. Authorize AniLingo</h2>
                <span>Client ID</span>
            </div>

            <form method="post" asp-page-handler="Prepare" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <label>
                    <span>AniList client ID</span>
                    <input asp-for="ClientId" inputmode="numeric" autocomplete="off" />
                    <span asp-validation-for="ClientId" class="validation"></span>
                </label>
                <button class="button button-primary" type="submit">Create login link</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.AuthorizationUrl))
            {
                <div class="device-login">
                    <p>Open AniList, approve access, then copy the token shown on the PIN page.</p>
                    <a class="button button-primary"
                       href="@Model.AuthorizationUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        Open AniList login
                    </a>
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>3. Save connection</h2>
                <span>Access token</span>
            </div>

            <form method="post" asp-page-handler="Connect" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <input type="hidden" asp-for="ClientId" />
                <label>
                    <span>AniList access token</span>
                    <input asp-for="AccessToken"
                           type="password"
                           autocomplete="off"
                           spellcheck="false" />
                    <span asp-validation-for="AccessToken" class="validation"></span>
                </label>
                <button class="button button-primary" type="submit">Connect AniList</button>
            </form>
        </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <h2>Safe progress sync</h2>
            <span>Progress only</span>
        </div>
        <p class="muted">
            AniLingo reads the current remote list entry again immediately before every write.
            Progress can only move upward and only for an existing CURRENT (Watching) list entry with an unambiguous AniList match.
            Multi-season local groupings are blocked rather than guessed. The final episode is intentionally not synced because
            AniList may also change completion status/date. Every write gets a local pre-write snapshot with the local AniLingo profile ID under /data/integrations.
        </p>
        <p class="muted">
            Automatic sync uses exactly the same checks as the Sync button. Works whose AniList mapping is ambiguous or waiting
            for review are never written, AniList progress that is already ahead is left alone, and failed requests are retried
            with increasing delays, honoring AniList's rate limit.
        </p>
        <p class="muted">
            AniLingo does not automatically create list entries, change list status, mark entries completed,
            change scores, notes, repeat counts, priorities, privacy, custom lists or dates.
        </p>
    </section>
</div>
