@page
@model AniLingo.Web.Pages.Settings.DownloadClients.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.downloadClients.title"];
}

<h1>@ui["settings.downloadClients.title"]</h1>
<p class="muted">
    @ui["settings.downloadClients.description"]
</p>

@if (Model.Notice is not null)
{
    <p class="metadata-notice">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error">@Model.Error</p>
}

<a class="button" asp-page="/Settings/DownloadClients/Edit">@ui["settings.downloadClients.add"]</a>

<table class="data-table">
    <thead>
        <tr>
            <th>@ui["settings.connectionTable.column.priority"]</th>
            <th>@ui["settings.connectionTable.column.name"]</th>
            <th>@ui["settings.connectionTable.column.type"]</th>
            <th>@ui["settings.connectionTable.column.enabled"]</th>
            <th>@ui["settings.connectionTable.column.health"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Entry.Priority</td>
                <td>@row.Entry.Name</td>
                <td>@row.Entry.Type</td>
                <td>
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@row.Entry.Id">
                        <button type="submit" class="status-pill @(row.Entry.Enabled ? "status-ok" : "status-warn")">
                            @(row.Entry.Enabled ? ui["settings.connectionTable.enabled"] : ui["settings.connectionTable.disabled"])
                        </button>
                    </form>
                </td>
                <td>
                    @if (row.Health is null)
                    {
                        <span class="status-pill status-warn">@ui["settings.connectionTable.notChecked"]</span>
                    }
                    else if (row.Health.IsHealthy)
                    {
                        <span class="status-pill status-ok">@ui["settings.connectionTable.healthy"]</span>
                    }
                    else
                    {
                        <span class="status-pill status-warn" title="@row.Health.LastError">@ui["settings.connectionTable.unhealthy"]</span>
                    }
                    <span class="muted">@(row.Health is null ? "" : row.Health.LastCheckedUtc.ToString("u"))</span>
                </td>
                <td>
                    <a asp-page="/Settings/DownloadClients/Edit" asp-route-id="@row.Entry.Id">@ui["settings.connectionTable.edit"]</a>
                    <form method="post" asp-page-handler="Test" asp-route-id="@row.Entry.Id" style="display:inline">
                        <button type="submit">@ui["settings.connectionTable.test"]</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@row.Entry.Id" style="display:inline">
                        <button type="submit">@ui["common.remove"]</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="6" class="muted">@ui["settings.downloadClients.empty"]</td></tr>
        }
    </tbody>
</table>
