@page
@using AniLingo.Web.Features.Learning
@model AniLingo.Web.Pages.Settings.LearningModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.learning.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">@ui["common.backToSettings"]</a>
        <span class="eyebrow">@ui["settings.learning.eyebrow"]</span>
        <h1>@ui["settings.learning.title"]</h1>
        <p>@ui["settings.learning.pageDescription"]</p>
    </div>
</header>

<form method="post" class="form-stack">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["settings.learning.mode.eyebrow"]</span>
                <h2>@ui["settings.learning.mode.heading"]</h2>
            </div>
            <span>@Model.ModeName(Model.Mode)</span>
        </div>

        <div class="settings-grid">
            @foreach (var mode in Enum.GetValues<LearningMode>())
            {
                <label class="panel">
                    <span>
                        <input asp-for="Mode"
                               type="radio"
                               value="@mode" />
                        <strong>@Model.ModeName(mode)</strong>
                    </span>
                    <small class="muted">@Model.ModeDescription(mode)</small>
                </label>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["settings.learning.courses.eyebrow"]</span>
                <h2>@ui["settings.learning.courses.heading"]</h2>
            </div>
            <a class="button" asp-page="/Settings/LearningCourses">@ui["settings.learning.courses.manage"]</a>
        </div>
        <p class="muted">@ui["settings.learning.courses.description"]</p>
    </section>

    <details class="panel">
        <summary>
            <strong>@ui["settings.learning.customize.heading"]</strong>
            <span class="muted">@ui["settings.learning.customize.subtitle"]</span>
        </summary>
        <div class="form-stack" style="margin-top:1rem;">
            @foreach (var option in LearningModel.CapabilityOptions)
            {
                var current = Model.Global.GetOverride(option.Capability);
                <label>
                    <span>@ui[option.LabelKey]</span>
                    <select name="cap_@option.Capability"
                            asp-items='Model.OverrideOptions(current, ui["settings.learning.useModeDefault"])'></select>
                    <small class="muted">@ui[option.DescriptionKey]</small>
                </label>
            }
        </div>
    </details>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["settings.learning.media.eyebrow"]</span>
                <h2>@ui["settings.learning.media.heading"]</h2>
            </div>
            <span>@ui["settings.learning.media.inheritsByDefault"]</span>
        </div>
        <p class="muted">
            @ui["settings.learning.media.description"]
        </p>

        <div class="form-stack">
            @foreach (var mediaType in LearningModel.MediaTypes)
            {
                var settings = Model.Media[mediaType];
                <details class="panel">
                    <summary>
                        <strong>@mediaType</strong>
                        <span class="muted">@(settings.ModeOverride is { } modeOverride ? Model.ModeName(modeOverride) : ui["settings.learning.media.inherit"])</span>
                    </summary>
                    <div class="form-stack" style="margin-top:1rem;">
                        <label>
                            <span>@ui["settings.learning.media.modeLabel"]</span>
                            <select name="mediaMode_@mediaType"
                                    asp-items="Model.ModeOverrideOptions(settings.ModeOverride)"></select>
                        </label>

                        @foreach (var option in LearningModel.CapabilityOptions)
                        {
                            var current = settings.GetOverride(option.Capability);
                            <label>
                                <span>@ui[option.LabelKey]</span>
                                <select name="@($"media_{mediaType}_{option.Capability}")"
                                        asp-items='Model.OverrideOptions(current, ui["settings.learning.media.inherit"])'></select>
                                <small class="muted">@ui[option.DescriptionKey]</small>
                            </label>
                        }
                    </div>
                </details>
            }
        </div>
    </section>

    <details class="panel">
        <summary>
            <strong>@ui["settings.learning.advanced.heading"]</strong>
            <span class="muted">@ui["settings.learning.advanced.badge"]</span>
        </summary>

        <div class="form-stack" style="margin-top:1rem;">
            <label>
                <span>@ui["settings.learning.advanced.retentionLabel"]</span>
                <input asp-for="DesiredRetentionPercent"
                       type="number"
                       min="80"
                       max="97"
                       step="1" />
                <small class="muted">
                    @ui["settings.learning.advanced.retentionHint"]
                </small>
                <span asp-validation-for="DesiredRetentionPercent" class="validation"></span>
            </label>

            <label>
                <span>@ui["settings.learning.advanced.newWordsLabel"]</span>
                <input asp-for="NewWordsPerDay"
                       type="number"
                       min="0"
                       max="100"
                       step="1" />
                <small class="muted">
                    @ui["settings.learning.advanced.newWordsHint"]
                </small>
                <span asp-validation-for="NewWordsPerDay" class="validation"></span>
            </label>

            <label>
                <span>@ui["settings.learning.advanced.reviewBatchLabel"]</span>
                <input asp-for="ReviewBatchSize"
                       type="number"
                       min="5"
                       max="200"
                       step="5" />
                <small class="muted">@ui["settings.learning.advanced.reviewBatchHint"]</small>
                <span asp-validation-for="ReviewBatchSize" class="validation"></span>
            </label>
        </div>
    </details>

    <button class="button button-primary" type="submit">@ui["settings.learning.save"]</button>
</form>
