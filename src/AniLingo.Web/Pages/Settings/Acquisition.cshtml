@page
@model AniLingo.Web.Pages.Settings.AcquisitionModel
@using AniLingo.Web.Features.Acquisition.Import
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.acquisition.title"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["settings.acquisition.eyebrow"]</span>
        <h1>@ui["settings.acquisition.heading"]</h1>
        <p>@ui["settings.acquisition.pageDescription"]</p>
    </div>
    <a class="button" asp-page="/Acquisition/Index">@ui["settings.acquisition.animeAcquisitionLink"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="muted" role="status">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.importModeHeading"]</h2></div>
        <p class="muted">
            @ui["settings.acquisition.importModeDescription"]
        </p>
        <form method="post" asp-page-handler="ImportMode" class="form-stack">
            <label>
                <span>@ui["settings.acquisition.defaultImportModeLabel"]</span>
                <select name="defaultImportMode">
                    @foreach (var mode in Enum.GetValues<AnimeImportMode>())
                    {
                        <option value="@mode" selected="@(Model.ImportSettings.DefaultImportMode == mode)">@Model.ImportModeLabel(mode)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["settings.acquisition.saveDefault"]</button>
        </form>

        @if (Model.Roots.Count > 0)
        {
            <table>
                <thead><tr><th>@ui["settings.acquisition.libraryRootColumn"]</th><th>@ui["settings.acquisition.importModeOverrideColumn"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var root in Model.Roots)
                    {
                        <tr>
                            <td>@root.Name</td>
                            <td>@(Model.ImportSettings.RootImportModes.TryGetValue(root.Id, out var mode) ? Model.ImportModeLabel(mode) : ui["settings.acquisition.usesDefault"])</td>
                            <td>
                                <form method="post" asp-page-handler="ImportMode" class="acquisition-inline-form">
                                    <input type="hidden" name="defaultImportMode" value="@Model.ImportSettings.DefaultImportMode" />
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <select name="rootImportMode">
                                        <option value="">@ui["settings.acquisition.usesDefault"]</option>
                                        @foreach (var mode in Enum.GetValues<AnimeImportMode>())
                                        {
                                            <option value="@mode" selected="@(Model.ImportSettings.RootImportModes.TryGetValue(root.Id, out var current) && current == mode)">@Model.ImportModeLabel(mode)</option>
                                        }
                                    </select>
                                    <button class="button" type="submit">@ui["settings.acquisition.set"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.remotePathMappingHeading"]</h2></div>
        <p class="muted">
            @ui["settings.acquisition.remotePathMappingDescription"]
        </p>
        @if (Model.ImportSettings.RemotePathMappings.Count > 0)
        {
            <table>
                <thead><tr><th>@ui["settings.acquisition.remotePrefixColumn"]</th><th>@ui["settings.acquisition.localPrefixColumn"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var mapping in Model.ImportSettings.RemotePathMappings)
                    {
                        <tr>
                            <td>@mapping.RemotePrefix</td>
                            <td>@mapping.LocalPrefix</td>
                            <td>
                                <form method="post" asp-page-handler="RemovePathMapping">
                                    <input type="hidden" name="remotePrefix" value="@mapping.RemotePrefix" />
                                    <button class="button" type="submit">@ui["settings.acquisition.remove"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddPathMapping" class="acquisition-inline-form">
            <label><span>@ui["settings.acquisition.remotePrefixLabel"]</span><input type="text" name="remotePrefix" placeholder="/downloads" required /></label>
            <label><span>@ui["settings.acquisition.localPrefixLabel"]</span><input type="text" name="localPrefix" placeholder="/data/downloads" required /></label>
            <button class="button" type="submit">@ui["settings.acquisition.addMapping"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.tagsHeading"]</h2></div>
        @if (Model.Policy.Tags.Count > 0)
        {
            <ul class="acquisition-history-list">
                @foreach (var tag in Model.Policy.Tags)
                {
                    <li>
                        @tag.Name
                        <form method="post" asp-page-handler="RemoveTag" style="display:inline">
                            <input type="hidden" name="tagId" value="@tag.Id" />
                            <button class="button" type="submit">@ui["settings.acquisition.remove"]</button>
                        </form>
                    </li>
                }
            </ul>
        }
        <form method="post" asp-page-handler="AddTag" class="acquisition-inline-form">
            <label><span>@ui["settings.acquisition.newTagLabel"]</span><input type="text" name="name" placeholder="fast-track" required /></label>
            <button class="button" type="submit">@ui["settings.acquisition.addTag"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.delayProfilesHeading"]</h2></div>
        <p class="muted">@ui["settings.acquisition.delayProfilesDescription"]</p>
        @if (Model.Policy.DelayProfiles.Count > 0)
        {
            <table>
                <thead><tr><th>@ui["settings.acquisition.nameColumn"]</th><th>@ui["settings.acquisition.delayColumn"]</th><th>@ui["settings.acquisition.qualityProfileColumn"]</th><th>@ui["settings.acquisition.tagsColumn"]</th><th>@ui["settings.acquisition.defaultColumn"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var profile in Model.Policy.DelayProfiles)
                    {
                        <tr>
                            <td>@profile.Name</td>
                            <td>@ui.Format("settings.acquisition.delayMinutes", ("minutes", profile.DelayMinutes))</td>
                            <td>@(profile.QualityProfileId ?? ui["settings.acquisition.any"])</td>
                            <td>@string.Join(", ", profile.TagIds)</td>
                            <td>@(profile.IsDefault ? ui["settings.acquisition.yes"] : "")</td>
                            <td>
                                <form method="post" asp-page-handler="RemoveDelayProfile">
                                    <input type="hidden" name="profileId" value="@profile.Id" />
                                    <button class="button" type="submit">@ui["settings.acquisition.remove"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddDelayProfile" class="acquisition-inline-form">
            <label><span>@ui["settings.acquisition.nameColumn"]</span><input type="text" name="name" required /></label>
            <label><span>@ui["settings.acquisition.delayMinutesLabel"]</span><input type="number" name="delayMinutes" min="0" value="60" required /></label>
            <label><span>@ui["settings.acquisition.qualityProfileIdLabel"]</span><input type="text" name="qualityProfileId" placeholder="@ui["settings.acquisition.any"]" /></label>
            <label>
                <span>@ui["settings.acquisition.tagsColumn"]</span>
                <select name="tagIds" multiple>
                    @foreach (var tag in Model.Policy.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </label>
            <label class="acquisition-check"><input type="checkbox" name="isDefault" value="true" /><span>@ui["settings.acquisition.defaultCheckboxLabel"]</span></label>
            <button class="button" type="submit">@ui["settings.acquisition.addProfile"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.indexerRestrictionsHeading"]</h2></div>
        <p class="muted">@ui["settings.acquisition.indexerRestrictionsDescription"]</p>
        @if (Model.Policy.IndexerRestrictions.Count > 0)
        {
            <table>
                <thead><tr><th>@ui["settings.acquisition.nameColumn"]</th><th>@ui["settings.acquisition.tagsColumn"]</th><th>@ui["settings.acquisition.allowedIndexersColumn"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var restriction in Model.Policy.IndexerRestrictions)
                    {
                        <tr>
                            <td>@restriction.Name</td>
                            <td>@string.Join(", ", restriction.TagIds)</td>
                            <td>@string.Join(", ", restriction.AllowedIndexerEntryIds.Select(id => Model.IndexerEntries.FirstOrDefault(entry => entry.Id == id)?.Name ?? id.ToString()))</td>
                            <td>
                                <form method="post" asp-page-handler="RemoveIndexerRestriction">
                                    <input type="hidden" name="restrictionId" value="@restriction.Id" />
                                    <button class="button" type="submit">@ui["settings.acquisition.remove"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddIndexerRestriction" class="acquisition-inline-form">
            <label><span>@ui["settings.acquisition.nameColumn"]</span><input type="text" name="name" required /></label>
            <label>
                <span>@ui["settings.acquisition.tagsColumn"]</span>
                <select name="tagIds" multiple required>
                    @foreach (var tag in Model.Policy.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>@ui["settings.acquisition.allowedIndexersColumn"]</span>
                <select name="allowedIndexerEntryIds" multiple required>
                    @foreach (var entry in Model.IndexerEntries)
                    {
                        <option value="@entry.Id">@entry.Name (@entry.Type)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["settings.acquisition.addRestriction"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.autoMonitorHeading"]</h2></div>
        <p class="muted">@ui["settings.acquisition.autoMonitorDescription"]</p>
        <form method="post" asp-page-handler="AniListAutoMonitor" class="acquisition-inline-form">
            <label class="acquisition-check">
                <input type="checkbox" name="enabled" value="true" checked="@Model.AniListAutoMonitorEnabled" />
                <span>@ui["settings.acquisition.autoMonitorCheckbox"]</span>
            </label>
            <button class="button" type="submit">@ui["common.save"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.backupHeading"]</h2></div>
        <p class="muted">
            @ui["settings.acquisition.backupDescription"]
        </p>
        <form method="post" asp-page-handler="ExportBackup">
            <button class="button" type="submit">@ui["settings.acquisition.exportBackup"]</button>
        </form>

        <form method="post" asp-page-handler="PreviewRestore" enctype="multipart/form-data" class="acquisition-inline-form">
            <label><span>@ui["settings.acquisition.backupFileLabel"]</span><input type="file" name="backupFile" accept="application/json" required /></label>
            <button class="button" type="submit">@ui["settings.acquisition.previewRestore"]</button>
        </form>

        @if (Model.RestorePreview is { } preview)
        {
            <table>
                <thead><tr><th>@ui["settings.acquisition.fileColumn"]</th><th>@ui["settings.acquisition.existsNowColumn"]</th><th>@ui["settings.acquisition.secretColumn"]</th><th>@ui["settings.acquisition.validJsonColumn"]</th><th>@ui["settings.acquisition.wouldChangeColumn"]</th></tr></thead>
                <tbody>
                    @foreach (var file in preview.Files)
                    {
                        <tr>
                            <td>@file.FileName</td>
                            <td>@(file.ExistedBefore ? ui["settings.acquisition.yes"] : ui["settings.acquisition.noNew"])</td>
                            <td>@(file.ContainsEncryptedSecret ? ui["settings.acquisition.yes"] : "")</td>
                            <td>@(file.IsValidJson ? ui["settings.acquisition.yes"] : ui["settings.acquisition.invalid"])</td>
                            <td>@(file.WouldChange ? ui["settings.acquisition.yes"] : ui["settings.acquisition.no"])</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (preview.Errors.Count > 0)
            {
                <ul>
                    @foreach (var error in preview.Errors)
                    {
                        <li class="metadata-error">@error</li>
                    }
                </ul>
            }
            @if (preview.CanRestore)
            {
                <form method="post" asp-page-handler="ApplyRestore">
                    <input type="hidden" name="pendingRestoreJson" value="@Model.PendingRestoreJson" />
                    <button class="button button-primary" type="submit">@ui["settings.acquisition.applyRestore"]</button>
                </form>
            }
        }
    </section>
</div>
