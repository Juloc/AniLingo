@page
@model AniLingo.Web.Pages.Settings.AcquisitionModel
@using AniLingo.Web.Features.Acquisition.Import
@{
    ViewData["Title"] = "Acquisition settings";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Settings · Server</span>
        <h1>Import, path mapping &amp; policy</h1>
        <p>Import mode and remote path mapping (also used to match Sonarr paths), library roots, tags, delay profiles, tag-scoped indexer restrictions, AniList auto-monitor and settings backup.</p>
    </div>
    <a class="button" asp-page="/Acquisition/Index">Anime acquisition</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="muted" role="status">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>Import mode</h2></div>
        <p class="muted">
            Hardlink keeps the download seeding while the library sees the file, using no extra disk space, but only
            works when the completed-download folder and the library root are on the same filesystem. Plain Hardlink
            fails the import with a clear reason on a different filesystem; "Hardlink or copy" is the explicit choice
            to fall back to a copy then.
        </p>
        <form method="post" asp-page-handler="ImportMode" class="form-stack">
            <label>
                <span>Default import mode</span>
                <select name="defaultImportMode">
                    @foreach (var mode in Enum.GetValues<AnimeImportMode>())
                    {
                        <option value="@mode" selected="@(Model.ImportSettings.DefaultImportMode == mode)">@mode</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">Save default</button>
        </form>

        @if (Model.Roots.Count > 0)
        {
            <table>
                <thead><tr><th>Library root</th><th>Import mode override</th><th></th></tr></thead>
                <tbody>
                    @foreach (var root in Model.Roots)
                    {
                        <tr>
                            <td>@root.Name</td>
                            <td>@(Model.ImportSettings.RootImportModes.TryGetValue(root.Id, out var mode) ? mode.ToString() : "Uses default")</td>
                            <td>
                                <form method="post" asp-page-handler="ImportMode" class="acquisition-inline-form">
                                    <input type="hidden" name="defaultImportMode" value="@Model.ImportSettings.DefaultImportMode" />
                                    <input type="hidden" name="rootId" value="@root.Id" />
                                    <select name="rootImportMode">
                                        <option value="">Uses default</option>
                                        @foreach (var mode in Enum.GetValues<AnimeImportMode>())
                                        {
                                            <option value="@mode" selected="@(Model.ImportSettings.RootImportModes.TryGetValue(root.Id, out var current) && current == mode)">@mode</option>
                                        }
                                    </select>
                                    <button class="button" type="submit">Set</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Remote path mapping</h2></div>
        <p class="muted">
            Maps a path prefix as reported by the download client (or by Sonarr) to the path AniLingo sees under its
            own mounts. Applied to every completed-download path and to Sonarr's series/episode/queue paths, so
            Sonarr ↔ AniLingo path matching keeps working even when the two containers mount storage differently.
        </p>
        @if (Model.ImportSettings.RemotePathMappings.Count > 0)
        {
            <table>
                <thead><tr><th>Remote prefix</th><th>Local prefix</th><th></th></tr></thead>
                <tbody>
                    @foreach (var mapping in Model.ImportSettings.RemotePathMappings)
                    {
                        <tr>
                            <td>@mapping.RemotePrefix</td>
                            <td>@mapping.LocalPrefix</td>
                            <td>
                                <form method="post" asp-page-handler="RemovePathMapping">
                                    <input type="hidden" name="remotePrefix" value="@mapping.RemotePrefix" />
                                    <button class="button" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddPathMapping" class="acquisition-inline-form">
            <label><span>Remote prefix</span><input type="text" name="remotePrefix" placeholder="/downloads" required /></label>
            <label><span>Local prefix</span><input type="text" name="localPrefix" placeholder="/data/downloads" required /></label>
            <button class="button" type="submit">Add mapping</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Tags</h2></div>
        @if (Model.Policy.Tags.Count > 0)
        {
            <ul class="acquisition-history-list">
                @foreach (var tag in Model.Policy.Tags)
                {
                    <li>
                        @tag.Name
                        <form method="post" asp-page-handler="RemoveTag" style="display:inline">
                            <input type="hidden" name="tagId" value="@tag.Id" />
                            <button class="button" type="submit">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        <form method="post" asp-page-handler="AddTag" class="acquisition-inline-form">
            <label><span>New tag</span><input type="text" name="name" placeholder="fast-track" required /></label>
            <button class="button" type="submit">Add tag</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Delay profiles</h2></div>
        <p class="muted">Waits N minutes after an episode becomes wanted before grabbing a release that does not yet meet the quality profile's upgrade cutoff, so a preferred release has a chance to appear first.</p>
        @if (Model.Policy.DelayProfiles.Count > 0)
        {
            <table>
                <thead><tr><th>Name</th><th>Delay</th><th>Quality profile</th><th>Tags</th><th>Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var profile in Model.Policy.DelayProfiles)
                    {
                        <tr>
                            <td>@profile.Name</td>
                            <td>@profile.DelayMinutes min</td>
                            <td>@(profile.QualityProfileId ?? "Any")</td>
                            <td>@string.Join(", ", profile.TagIds)</td>
                            <td>@(profile.IsDefault ? "Yes" : "")</td>
                            <td>
                                <form method="post" asp-page-handler="RemoveDelayProfile">
                                    <input type="hidden" name="profileId" value="@profile.Id" />
                                    <button class="button" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddDelayProfile" class="acquisition-inline-form">
            <label><span>Name</span><input type="text" name="name" required /></label>
            <label><span>Delay (minutes)</span><input type="number" name="delayMinutes" min="0" value="60" required /></label>
            <label><span>Quality profile ID</span><input type="text" name="qualityProfileId" placeholder="Any" /></label>
            <label>
                <span>Tags</span>
                <select name="tagIds" multiple>
                    @foreach (var tag in Model.Policy.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </label>
            <label class="acquisition-check"><input type="checkbox" name="isDefault" value="true" /><span>Default (applies with no more specific match)</span></label>
            <button class="button" type="submit">Add profile</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Tag-scoped indexer restrictions</h2></div>
        <p class="muted">Restricts anime carrying any of the selected tags to searching only the checked indexers (a whole Prowlarr connection, or a direct Newznab connection). Narrows which indexers are searched at all; never widens it. If a restriction ends up with no enabled indexer allowed, no indexer is searched for that anime — it is never silently searched unrestricted.</p>
        @if (Model.Policy.IndexerRestrictions.Count > 0)
        {
            <table>
                <thead><tr><th>Name</th><th>Tags</th><th>Allowed indexers</th><th></th></tr></thead>
                <tbody>
                    @foreach (var restriction in Model.Policy.IndexerRestrictions)
                    {
                        <tr>
                            <td>@restriction.Name</td>
                            <td>@string.Join(", ", restriction.TagIds)</td>
                            <td>@string.Join(", ", restriction.AllowedIndexerEntryIds.Select(id => Model.IndexerEntries.FirstOrDefault(entry => entry.Id == id)?.Name ?? id.ToString()))</td>
                            <td>
                                <form method="post" asp-page-handler="RemoveIndexerRestriction">
                                    <input type="hidden" name="restrictionId" value="@restriction.Id" />
                                    <button class="button" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddIndexerRestriction" class="acquisition-inline-form">
            <label><span>Name</span><input type="text" name="name" required /></label>
            <label>
                <span>Tags</span>
                <select name="tagIds" multiple required>
                    @foreach (var tag in Model.Policy.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>Allowed indexers</span>
                <select name="allowedIndexerEntryIds" multiple required>
                    @foreach (var entry in Model.IndexerEntries)
                    {
                        <option value="@entry.Id">@entry.Name (@entry.Type)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">Add restriction</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>AniList list auto-monitor</h2></div>
        <p class="muted">When on, every full acquisition run monitors anime on your AniList Current/Planning lists that already exist locally. Never adds a show that is not local yet, and never touches an anime Sonarr manages.</p>
        <form method="post" asp-page-handler="AniListAutoMonitor" class="acquisition-inline-form">
            <label class="acquisition-check">
                <input type="checkbox" name="enabled" value="true" checked="@Model.AniListAutoMonitorEnabled" />
                <span>Auto-monitor from my AniList Current/Planning lists</span>
            </label>
            <button class="button" type="submit">Save</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>Backup &amp; restore</h2></div>
        <p class="muted">
            Exports one JSON bundle of every canonical acquisition settings store. Prowlarr and SABnzbd API keys are
            included encrypted with this installation's Data Protection keys (not in plain text); restoring on a
            different installation keeps everything else but may require re-entering those two API keys if they
            cannot be decrypted there.
        </p>
        <form method="post" asp-page-handler="ExportBackup">
            <button class="button" type="submit">Export backup</button>
        </form>

        <form method="post" asp-page-handler="PreviewRestore" enctype="multipart/form-data" class="acquisition-inline-form">
            <label><span>Backup file</span><input type="file" name="backupFile" accept="application/json" required /></label>
            <button class="button" type="submit">Preview restore</button>
        </form>

        @if (Model.RestorePreview is { } preview)
        {
            <table>
                <thead><tr><th>File</th><th>Exists now</th><th>Secret</th><th>Valid JSON</th><th>Would change</th></tr></thead>
                <tbody>
                    @foreach (var file in preview.Files)
                    {
                        <tr>
                            <td>@file.FileName</td>
                            <td>@(file.ExistedBefore ? "Yes" : "No (new)")</td>
                            <td>@(file.ContainsEncryptedSecret ? "Yes" : "")</td>
                            <td>@(file.IsValidJson ? "Yes" : "Invalid")</td>
                            <td>@(file.WouldChange ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (preview.Errors.Count > 0)
            {
                <ul>
                    @foreach (var error in preview.Errors)
                    {
                        <li class="metadata-error">@error</li>
                    }
                </ul>
            }
            @if (preview.CanRestore)
            {
                <form method="post" asp-page-handler="ApplyRestore">
                    <input type="hidden" name="pendingRestoreJson" value="@Model.PendingRestoreJson" />
                    <button class="button button-primary" type="submit">Apply restore</button>
                </form>
            }
        }
    </section>
</div>
