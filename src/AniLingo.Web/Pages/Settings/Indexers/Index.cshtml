@page
@model AniLingo.Web.Pages.Settings.Indexers.IndexModel
@{
    ViewData["Title"] = "Indexers";
}

<h1>Indexers</h1>
<p class="muted">
    Prowlarr and direct Newznab/Torznab connections used by anime acquisition search, best
    priority first (lower number searched and preferred first). Unhealthy entries are skipped by
    the acquisition pipeline.
</p>

@if (Model.Notice is not null)
{
    <p class="metadata-notice">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error">@Model.Error</p>
}

<a class="button" asp-page="/Settings/Indexers/Edit">Add indexer</a>

<table class="data-table">
    <thead>
        <tr>
            <th>Priority</th>
            <th>Name</th>
            <th>Type</th>
            <th>Enabled</th>
            <th>Health</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Entry.Priority</td>
                <td>@row.Entry.Name</td>
                <td>@row.Entry.Type (@row.Entry.Protocol)</td>
                <td>
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@row.Entry.Id">
                        <button type="submit" class="status-pill @(row.Entry.Enabled ? "status-ok" : "status-warn")">
                            @(row.Entry.Enabled ? "Enabled" : "Disabled")
                        </button>
                    </form>
                </td>
                <td>
                    @if (row.Health is null)
                    {
                        <span class="status-pill status-warn">Not checked</span>
                    }
                    else if (row.Health.IsHealthy)
                    {
                        <span class="status-pill status-ok">Healthy</span>
                    }
                    else
                    {
                        <span class="status-pill status-warn" title="@row.Health.LastError">Unhealthy</span>
                    }
                    <span class="muted">@(row.Health is null ? "" : row.Health.LastCheckedUtc.ToString("u"))</span>
                </td>
                <td>
                    <a asp-page="/Settings/Indexers/Edit" asp-route-id="@row.Entry.Id">Edit</a>
                    <form method="post" asp-page-handler="Test" asp-route-id="@row.Entry.Id" style="display:inline">
                        <button type="submit">Test</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@row.Entry.Id" style="display:inline">
                        <button type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="6" class="muted">No indexer configured yet.</td></tr>
        }
    </tbody>
</table>
