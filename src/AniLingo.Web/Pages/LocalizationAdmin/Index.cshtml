@page "/Admin/Languages"
@using AniLingo.Web.Features.Localization
@model AniLingo.Web.Pages.LocalizationAdmin.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.languages.title"];
    var selected = Model.Locales.FirstOrDefault(x =>
        x.Locale.Equals(Model.SelectedLocale, StringComparison.OrdinalIgnoreCase));
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["admin.languages.eyebrow"]</span>
        <h1>@ui["admin.languages.title"]</h1>
        <p>@ui["admin.languages.subtitle"]</p>
    </div>
    <a class="button" href="/Settings/Language">@ui["admin.languages.personalLink"]</a>
</header>

<div asp-validation-summary="ModelOnly" class="validation"></div>

<section class="panel">
    <div class="panel-heading">
        <div>
            <span class="eyebrow">@ui["admin.languages.addLocale.eyebrow"]</span>
            <h2>@ui["admin.languages.addLocale.heading"]</h2>
        </div>
        <span>@(Model.AiStatus?.IsAuthenticated == true ? ui["admin.languages.aiConnected"] : ui["admin.languages.aiNotConnected"])</span>
    </div>

    <form method="post" asp-page-handler="AddLanguage" class="form-stack">
        <label>
            <span>@ui["admin.languages.localeLabel"]</span>
            <input name="locale" placeholder="@ui["admin.languages.localePlaceholder"]" autocomplete="off" required />
            <small class="muted">@ui["admin.languages.localeHint"]</small>
        </label>
        <label>
            <span>
                <input type="checkbox" name="generateNow" value="true" />
                @ui["admin.languages.generateNowCheckbox"]
            </span>
        </label>
        <button class="button button-primary" type="submit">@ui["admin.languages.add"]</button>
    </form>
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@ui["admin.languages.catalogEyebrow"]</span>
            <h2>@ui["admin.languages.languagesHeading"]</h2>
        </div>
    </div>

    <div class="settings-grid">
        @foreach (var locale in Model.Locales)
        {
            <a class="panel" href="@Url.Page("/LocalizationAdmin/Index", new { locale = locale.Locale })">
                <div class="panel-heading">
                    <div>
                        <strong>@locale.NativeName</strong>
                        <small>@locale.EnglishName · @locale.Locale · @locale.Direction</small>
                    </div>
                    <span>@locale.CoveragePercent%</span>
                </div>
                @if (locale.IsSource)
                {
                    <p class="muted">@ui.Format("admin.languages.sourceCatalog", ("count", locale.Total))</p>
                }
                else
                {
                    <p class="muted">
                        @ui.Format(
                            "admin.languages.coverageSummary",
                            ("ready", locale.Ready),
                            ("missing", locale.Missing),
                            ("outdated", locale.Outdated),
                            ("manual", locale.Manual))
                    </p>
                }
            </a>
        }
    </div>
</section>

@if (selected is not null)
{
    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">@ui["admin.languages.selectedEyebrow"]</span>
                <h2>@selected.NativeName · @selected.Locale</h2>
            </div>
            <span>@ui.Format("admin.languages.readyPercent", ("percent", selected.CoveragePercent))</span>
        </div>

        @if (!selected.IsSource)
        {
            <div class="inline-actions">
                <form method="post" asp-page-handler="GenerateMissing">
                    <input type="hidden" name="locale" value="@selected.Locale" />
                    <button class="button button-primary" type="submit"
                            disabled="@(Model.AiStatus?.IsAuthenticated != true)">
                        @ui["admin.languages.generateMissing"]
                    </button>
                </form>
                <form method="post" asp-page-handler="RegenerateOutdated">
                    <input type="hidden" name="locale" value="@selected.Locale" />
                    <button class="button" type="submit"
                            disabled="@(selected.Outdated == 0 || Model.AiStatus?.IsAuthenticated != true)">
                        @ui["admin.languages.regenerateOutdated"]
                    </button>
                </form>
            </div>
        }

        <form method="get" class="form-stack" style="margin-top:1rem;">
            <input type="hidden" name="locale" value="@selected.Locale" />
            <label>
                <span>@ui["admin.languages.searchLabel"]</span>
                <input name="search" value="@Model.Search" placeholder="@ui["admin.languages.searchPlaceholder"]" />
            </label>
            <button class="button" type="submit">@ui["common.search"]</button>
        </form>
    </section>

    @foreach (var entry in Model.Entries)
    {
        <section class="panel">
            <div class="panel-heading">
                <div>
                    <span class="eyebrow">@entry.Message.Feature · @entry.Message.Surface</span>
                    <h3><code>@entry.Message.Key</code></h3>
                </div>
                <span class="status-pill">@(selected.IsSource ? ui["admin.languages.sourceStatus"] : entry.Status.ToString())</span>
            </div>

            <div class="status-list">
                <div><span>@ui["admin.languages.englishSourceLabel"]</span><strong>@entry.Message.DefaultText</strong></div>
                <div><span>@ui["admin.languages.meaningLabel"]</span><strong>@entry.Message.Description</strong></div>
                <div><span>@ui["admin.languages.toneLabel"]</span><strong>@entry.Message.Tone</strong></div>
                @if (entry.Message.MaxLength is { } max)
                {
                    <div><span>@ui["admin.languages.lengthGuidanceLabel"]</span><strong>@ui.Format("admin.languages.lengthGuidanceValue", ("max", max))</strong></div>
                }
                @if (entry.Message.Placeholders is { Count: > 0 })
                {
                    <div>
                        <span>@ui["admin.languages.placeholdersLabel"]</span>
                        <strong>@string.Join(", ", entry.Message.Placeholders.Select(x => $"{x.Key}: {x.Value}"))</strong>
                    </div>
                }
            </div>

            @if (!selected.IsSource)
            {
                <form method="post" asp-page-handler="SaveManual" class="form-stack">
                    <input type="hidden" name="locale" value="@selected.Locale" />
                    <input type="hidden" name="key" value="@entry.Message.Key" />
                    <label>
                        <span>@ui.Format("admin.languages.translationLabel", ("locale", selected.NativeName))</span>
                        <textarea name="text" rows="2" required>@entry.Text</textarea>
                    </label>
                    <div class="inline-actions">
                        <button class="button" type="submit">@ui["admin.languages.saveManual"]</button>
                    </div>
                </form>

                @if (entry.Status == UiTranslationStatus.Generated)
                {
                    <form method="post" asp-page-handler="MarkReviewed">
                        <input type="hidden" name="locale" value="@selected.Locale" />
                        <input type="hidden" name="key" value="@entry.Message.Key" />
                        <button class="text-link" type="submit">@ui["admin.languages.markReviewed"]</button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(entry.Provider))
                {
                    <small class="muted">
                        @entry.Provider
                        @if (!string.IsNullOrWhiteSpace(entry.Model))
                        {
                            <text> · @entry.Model</text>
                        }
                    </small>
                }
            }
        </section>
    }
}
