@page "/Manga"
@model AniLingo.Web.Pages.Manga.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["reading.manga.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/manga.css" asp-append-version="true" />
}

<header class="manga-library-header">
    <div class="reading-type-switch" aria-label="@ui["manga.nav.readingTypeAria"]">
        <a href="/Novels">@ui["reading.novels.title"]</a>
        <a class="active" href="/Manga">@ui["reading.manga.title"]</a>
    </div>

    @if (Model.IsOwner)
    {
        <details class="manga-import">
            <summary class="button">@ui["manga.import.toggle"]</summary>
            <div class="manga-import-panel">
                <form method="post"
                      asp-page-handler="Upload"
                      enctype="multipart/form-data">
                    <label for="seriesTitle">@ui["manga.upload.seriesName"]</label>
                    <input id="seriesTitle"
                           name="seriesTitle"
                           type="text"
                           placeholder="@ui["manga.upload.seriesNamePlaceholder"]" />

                    <label for="archives">@ui["manga.upload.archivesLabel"]</label>
                    <input id="archives"
                           name="archives"
                           type="file"
                           accept=".cbz,.zip,application/zip"
                           multiple
                           required />
                    <button class="button button-primary" type="submit">@ui["manga.upload.submit"]</button>
                </form>

                <div class="manga-import-divider">@ui["manga.import.serverPathDivider"]</div>

                <form method="post" asp-page-handler="Import">
                    <label for="sourcePath">@ui["manga.import.sourcePathLabel"]</label>
                    <input id="sourcePath"
                           name="sourcePath"
                           type="text"
                           required
                           placeholder="@ui["manga.import.pathPlaceholder"]" />
                    <button class="button" type="submit">@ui["manga.import.pathSubmit"]</button>
                </form>
            </div>
        </details>
    }
</header>

@if (TempData["Status"] is string status)
{
    <div class="manga-message">@status</div>
}

@if (Model.ContinueReading.Count > 0)
{
    <section class="manga-section">
        <h1>@ui["home.continueReading"]</h1>
        <div class="manga-continue-list">
            @foreach (var series in Model.ContinueReading)
            {
                <a class="manga-continue-row" href="/Manga/Read/@series.CurrentChapterId?page=@series.CurrentPageIndex">
                    <div class="manga-thumb">
                        @if (!string.IsNullOrWhiteSpace(series.CoverImageUrl))
                        {
                            <img src="@series.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else if (series.PreviewChapterId is Guid preview)
                        {
                            <img src="/Manga/Read/@preview?handler=Page&page=0" alt="" loading="lazy" />
                        }
                    </div>
                    <div>
                        <strong>@series.Title</strong>
                        <span>@ui.Format("manga.card.chapterPage", ("chapter", series.CurrentChapterNumber), ("page", series.CurrentPageIndex + 1), ("pages", series.CurrentPageCount))</span>
                        <div class="manga-progress"><span style="width:@series.ProgressPercent%"></span></div>
                    </div>
                    <span>@series.ProgressPercent%</span>
                </a>
            }
        </div>
    </section>
}

<section class="manga-section">
    <h1>@ui["reading.manga.title"]</h1>

    @if (Model.Series.Count == 0)
    {
        <div class="manga-empty">@ui["manga.index.empty"]</div>
    }
    else
    {
        <div class="manga-grid">
            @foreach (var series in Model.Series)
            {
                <article class="manga-card">
                    <a class="manga-cover" href="/Manga/Series/@series.Id">
                        @if (!string.IsNullOrWhiteSpace(series.CoverImageUrl))
                        {
                            <img src="@series.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else if (series.PreviewChapterId is Guid preview)
                        {
                            <img src="/Manga/Read/@preview?handler=Page&page=0" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span>M</span>
                        }

                        @if (series.HasProgress)
                        {
                            <div class="manga-cover-progress">
                                <span style="width:@series.ProgressPercent%"></span>
                            </div>
                        }
                    </a>

                    <div class="manga-card-copy">
                        <a href="/Manga/Series/@series.Id">@series.Title</a>
                        <span>@ui.Format("manga.card.chapterCount", ("count", series.ChapterCount))</span>
                        @if (series.HasProgress)
                        {
                            <a class="manga-resume" href="/Manga/Read/@series.CurrentChapterId?page=@series.CurrentPageIndex">
                                @ui.Format("manga.card.continueChapter", ("chapter", series.CurrentChapterNumber))
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
