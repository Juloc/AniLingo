@page "/Learn/Kana"
@model AniLingo.Web.Pages.Kana.IndexModel
@using AniLingo.Web.Features.Kana
@{
    ViewData["Title"] = Model.Ui["learn.hub.kana.title"];
    var scriptKey = Model.SelectedScript == KanaScript.Hiragana ? "hiragana" : "katakana";
    var previousStage = Math.Max(1, Model.Stage - 1);
    var nextStage = Math.Min(KanaCatalog.MaxStage, Model.Stage + 1);
}

@section Head {
    <link rel="stylesheet" href="~/css/kana.css" asp-append-version="true" />
}

<header class="page-header kana-header">
    <div>
        <a class="back-link" href="/Learn">← @Model.Ui["learn.title"]</a>
        <span class="eyebrow">@Model.Ui["learn.kana.eyebrow"]</span>
        <h1>@Model.Ui["learn.hub.kana.title"]</h1>
        <p>@Model.Ui["learn.kana.subtitle"]</p>
    </div>
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["learn.kana.metric.learning"], Model.LearningCount.ToString(), Model.Ui["learn.kana.metric.learningHint"])' />
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["learn.kana.metric.known"], Model.KnownCount.ToString(), Model.Ui["learn.kana.metric.knownHint"])' />
    <partial name="_MetricCard" model='new MetricCardModel(Model.Ui["learn.kana.metric.due"], Model.DueCount.ToString(), Model.Ui["learn.kana.metric.dueHint"])' />
</section>

<section class="kana-toolbar" aria-label="@Model.Ui["learn.kana.selectionAria"]">
    <div class="kana-script-tabs">
        <a class="button @(scriptKey == "hiragana" ? "button-primary" : "")"
           href="/Learn/Kana?script=hiragana&stage=@Model.Stage">@Model.Ui["learn.kana.hiragana"]</a>
        <a class="button @(scriptKey == "katakana" ? "button-primary" : "")"
           href="/Learn/Kana?script=katakana&stage=@Model.Stage">@Model.Ui["learn.kana.katakana"]</a>
    </div>
    <div class="kana-stage-nav">
        <a class="button @(Model.Stage <= 1 ? "disabled" : "")"
           href="/Learn/Kana?script=@scriptKey&stage=@previousStage"
           aria-label="@Model.Ui["learn.kana.previousGroup"]"
           aria-disabled="@(Model.Stage <= 1)">←</a>
        <strong>@Model.Stage / @KanaCatalog.MaxStage</strong>
        <a class="button @(Model.Stage >= KanaCatalog.MaxStage ? "disabled" : "")"
           href="/Learn/Kana?script=@scriptKey&stage=@nextStage"
           aria-label="@Model.Ui["learn.kana.nextGroup"]"
           aria-disabled="@(Model.Stage >= KanaCatalog.MaxStage)">→</a>
    </div>
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@Model.Ui["learn.kana.groupEyebrow"]</span>
            <h2>@Model.StageTitle</h2>
        </div>
        <form method="post" asp-page-handler="StartGroup">
            <input type="hidden" name="script" value="@scriptKey" />
            <input type="hidden" name="stage" value="@Model.Stage" />
            <button class="button button-primary" type="submit">@Model.Ui["learn.kana.startGroup"]</button>
        </form>
    </div>

    <div class="kana-grid">
        @foreach (var card in Model.Cards)
        {
            <article class="kana-card" data-state="@card.State">
                <div class="kana-card-top">
                    <span class="kana-state">@(
                        card.State == "known" ? Model.Ui["learn.kana.state.known"] :
                        card.Due ? Model.Ui["learn.kana.state.due"] :
                        card.State == "learning" ? Model.Ui["learn.kana.state.learning"] : Model.Ui["learn.kana.state.new"])</span>
                    <button class="kana-audio"
                            type="button"
                            data-speak="@card.Symbol"
                            data-rate="0.86"
                            aria-label="@Model.Ui.Format("learn.kana.listen", ("symbol", card.Symbol))">🔊</button>
                </div>
                <div class="kana-symbol" lang="ja">@card.Symbol</div>
                <div class="kana-romaji">@card.Romaji</div>
                @if (card.State != "known")
                {
                    <form method="post" asp-page-handler="Known">
                        <input type="hidden" name="termId" value="@card.TermId" />
                        <input type="hidden" name="script" value="@scriptKey" />
                        <input type="hidden" name="stage" value="@Model.Stage" />
                        <button class="text-link kana-known" type="submit">@Model.Ui["learning.markKnown"]</button>
                    </form>
                }
            </article>
        }
    </div>
</section>

<section class="section kana-practice-section" id="kana-practice">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@Model.Ui["learn.kana.practiceEyebrow"]</span>
            <h2>@Model.Ui["learn.kana.practiceTitle"]</h2>
            <p class="muted">@Model.Ui["learn.kana.practiceBody"]</p>
        </div>
    </div>

    <div class="kana-challenge" data-kana-challenge>
        <div class="challenge-mode" data-challenge-mode>@Model.Ui["learn.kana.ready"]</div>
        <button class="challenge-audio" type="button" data-challenge-audio hidden>🔊 @Model.Ui["learn.kana.listenAgain"]</button>
        <div class="challenge-prompt" data-challenge-prompt>@Model.Ui["learn.kana.practicePrompt"]</div>
        <div class="challenge-choices" data-challenge-choices></div>
        <div class="challenge-feedback" data-challenge-feedback aria-live="polite"></div>
        <button class="button button-primary" type="button" data-challenge-start>@Model.Ui["learn.kana.startPractice"]</button>
        <button class="button button-primary" type="button" data-challenge-next hidden>@Model.Ui["learn.kana.next"]</button>
    </div>
</section>

<form method="post" id="kana-answer-token" hidden>
    @Html.AntiForgeryToken()
</form>
<script id="kana-catalog" type="application/json">@Html.Raw(Model.CatalogJson)</script>

@section Scripts {
    <script src="~/js/kana.js" asp-append-version="true"></script>
}
