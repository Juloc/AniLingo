@page "/Learn/Kana"
@model AniLingo.Web.Pages.Kana.IndexModel
@using AniLingo.Web.Features.Kana
@{
    ViewData["Title"] = "Kana";
    var scriptKey = Model.SelectedScript == KanaScript.Hiragana ? "hiragana" : "katakana";
    var previousStage = Math.Max(1, Model.Stage - 1);
    var nextStage = Math.Min(KanaCatalog.MaxStage, Model.Stage + 1);
}

@section Head {
    <link rel="stylesheet" href="~/css/kana.css" asp-append-version="true" />
}

<header class="page-header kana-header">
    <div>
        <a class="back-link" href="/Learn">← Learning</a>
        <span class="eyebrow">Japanese writing system</span>
        <h1>Kana</h1>
        <p>Practice Hiragana and Katakana in small groups. Sentence practice now has its own Learning module.</p>
    </div>
</header>

<section class="metric-grid">
    <partial name="_MetricCard" model='new MetricCardModel("Learning", Model.LearningCount.ToString(), "Kana in active review")' />
    <partial name="_MetricCard" model='new MetricCardModel("Known", Model.KnownCount.ToString(), "Marked as known")' />
    <partial name="_MetricCard" model='new MetricCardModel("Due", Model.DueCount.ToString(), "Ready to review")' />
</section>

<section class="kana-toolbar" aria-label="Kana selection">
    <div class="kana-script-tabs">
        <a class="button @(scriptKey == "hiragana" ? "button-primary" : "")"
           href="/Learn/Kana?script=hiragana&stage=@Model.Stage">Hiragana</a>
        <a class="button @(scriptKey == "katakana" ? "button-primary" : "")"
           href="/Learn/Kana?script=katakana&stage=@Model.Stage">Katakana</a>
    </div>
    <div class="kana-stage-nav">
        <a class="button @(Model.Stage <= 1 ? "disabled" : "")"
           href="/Learn/Kana?script=@scriptKey&stage=@previousStage"
           aria-disabled="@(Model.Stage <= 1)">←</a>
        <strong>@Model.Stage / @KanaCatalog.MaxStage</strong>
        <a class="button @(Model.Stage >= KanaCatalog.MaxStage ? "disabled" : "")"
           href="/Learn/Kana?script=@scriptKey&stage=@nextStage"
           aria-disabled="@(Model.Stage >= KanaCatalog.MaxStage)">→</a>
    </div>
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Small group</span>
            <h2>@Model.StageTitle</h2>
        </div>
        <form method="post" asp-page-handler="StartGroup">
            <input type="hidden" name="script" value="@scriptKey" />
            <input type="hidden" name="stage" value="@Model.Stage" />
            <button class="button button-primary" type="submit">Start this group</button>
        </form>
    </div>

    <div class="kana-grid">
        @foreach (var card in Model.Cards)
        {
            <article class="kana-card" data-state="@card.State">
                <div class="kana-card-top">
                    <span class="kana-state">@(
                        card.State == "known" ? "Known" :
                        card.Due ? "Due" :
                        card.State == "learning" ? "Learning" : "New")</span>
                    <button class="kana-audio"
                            type="button"
                            data-speak="@card.Symbol"
                            data-rate="0.86"
                            aria-label="Listen to @card.Symbol">🔊</button>
                </div>
                <div class="kana-symbol" lang="ja">@card.Symbol</div>
                <div class="kana-romaji">@card.Romaji</div>
                @if (card.State != "known")
                {
                    <form method="post" asp-page-handler="Known">
                        <input type="hidden" name="termId" value="@card.TermId" />
                        <input type="hidden" name="script" value="@scriptKey" />
                        <input type="hidden" name="stage" value="@Model.Stage" />
                        <button class="text-link kana-known" type="submit">I know this</button>
                    </form>
                }
            </article>
        }
    </div>
</section>

<section class="section kana-practice-section" id="kana-practice">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Active practice</span>
            <h2>Mixed round</h2>
            <p class="muted">Character → sound, sound → character and Romaji → character rotate automatically.</p>
        </div>
    </div>

    <div class="kana-challenge" data-kana-challenge>
        <div class="challenge-mode" data-challenge-mode>Ready</div>
        <button class="challenge-audio" type="button" data-challenge-audio hidden>🔊 Listen again</button>
        <div class="challenge-prompt" data-challenge-prompt>Start a short round with this group.</div>
        <div class="challenge-choices" data-challenge-choices></div>
        <div class="challenge-feedback" data-challenge-feedback aria-live="polite"></div>
        <button class="button button-primary" type="button" data-challenge-start>Start practice</button>
        <button class="button button-primary" type="button" data-challenge-next hidden>Next</button>
    </div>
</section>

<form method="post" id="kana-answer-token" hidden>
    @Html.AntiForgeryToken()
</form>
<script id="kana-catalog" type="application/json">@Html.Raw(Model.CatalogJson)</script>

@section Scripts {
    <script src="~/js/kana.js" asp-append-version="true"></script>
}
