@page "/Books/Read/{id:guid}"
@model AniLingo.Web.Pages.Books.ReadModel
@{
    ViewData["Title"] = Model.Reader.Chapter.Title;
    var sourceIsTarget = Model.Reader.SourceLanguage.Equals(
        Model.Reader.TargetLanguage,
        StringComparison.OrdinalIgnoreCase);
    var translatedParagraphs = sourceIsTarget
        ? Array.Empty<string>()
        : Model.Reader.TranslatedParagraphs;
    var hasAlternate = translatedParagraphs.Count > 0;
    var defaultView = Model.RequestedView switch
    {
        "original" => "original",
        "translated" when hasAlternate => "translated",
        "both" when hasAlternate => "both",
        _ => hasAlternate ? "translated" : "original"
    };
    var initialProgress = Model.RequestedPositionPermille
        ?? Model.Reader.Progress?.PositionPermille
        ?? 0;
    var jsonOptions = new System.Text.Json.JsonSerializerOptions(
        System.Text.Json.JsonSerializerDefaults.Web);
    var settingsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ReaderSettings,
        jsonOptions);
    var highlightsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.CurrentHighlights,
        jsonOptions);
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/books-reader.js" asp-append-version="true"></script>
}

<div class="book-reader-page"
     data-book-reader
     data-view="@defaultView"
     data-target-language="@Model.Reader.TargetLanguage"
     data-chapter-id="@Model.Reader.Chapter.Id"
     data-has-translation="@(hasAlternate ? "true" : "false")"
     data-progress="@initialProgress"
     data-reading-mode="@Model.ReaderSettings.ReadingMode"
     data-paper-style="@Model.ReaderSettings.PaperStyle"
     data-chapter-style="@Model.ReaderSettings.ChapterStyle">

    <script type="application/json" data-book-settings-json>@Html.Raw(settingsJson)</script>
    <script type="application/json" data-book-highlights-json>@Html.Raw(highlightsJson)</script>

    <div class="book-reading-progress" aria-hidden="true">
        <span data-book-progress-bar style="width:@(initialProgress / 10)%"></span>
    </div>

    <nav class="book-reader-toolbar" aria-label="Book reader controls">
        <a class="book-reader-back"
           href="/Books/Library/@Model.Reader.Work.Id?lang=@Model.Reader.TargetLanguage"
           aria-label="Back to book">
            ←
        </a>

        <div class="book-reader-location">
            <strong>@Model.Reader.Chapter.Title</strong>
            <span>@(Model.Reader.Work.MetadataTitle ?? Model.Reader.Work.Title)</span>
        </div>

        <button class="book-reader-navigation"
                type="button"
                data-book-drawer-open
                aria-label="Chapters and annotations"
                title="Chapters and annotations">
            ☰
        </button>

        <div class="book-reader-view-switch" role="group" aria-label="Reading text">
            @if (hasAlternate)
            {
                <button type="button" data-book-view="translated">
                    @AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.Reader.TargetLanguage)
                </button>
            }
            <button type="button" data-book-view="original">Original</button>
            @if (hasAlternate)
            {
                <button type="button" data-book-view="both">Both</button>
            }
        </div>

        <button class="book-reader-bookmark"
                type="button"
                data-bookmark-button
                aria-label="Add bookmark"
                title="Add bookmark">
            ♡
            <span data-bookmark-count>@Model.Reader.Bookmarks.Count</span>
        </button>

        <button class="book-reader-auto"
                type="button"
                data-book-autoscroll
                aria-pressed="false"
                title="Auto-scroll">
            ▶
        </button>

        <details class="book-reader-settings">
            <summary aria-label="Reader settings" title="Reader settings">Aa</summary>
            <div class="book-reader-settings-panel">
                <div class="book-settings-heading">
                    <strong>Reader</strong>
                    <span data-book-override-state>
                        @(Model.ReaderSettings.HasBookOverride ? "Book override" : "My defaults")
                    </span>
                </div>

                <form method="post"
                      asp-page-handler="ReaderSettings"
                      asp-route-id="@Model.Reader.Chapter.Id"
                      data-book-settings-form>
                    <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
                    <input type="hidden" name="scope" value="book" />
                    <input type="hidden" name="changedKey" value="" />

                    <label>
                        Reading mode
                        <select name="Settings.ReadingMode" data-book-setting="readingMode">
                            <option value="continuous">Continuous scroll</option>
                            <option value="paged">Paged</option>
                        </select>
                    </label>

                    <label>
                        Page transition
                        <select name="Settings.PageTransition" data-book-setting="pageTransition">
                            <option value="curl">Book curl</option>
                            <option value="slide">Slide</option>
                            <option value="fade">Fade</option>
                            <option value="none">None</option>
                        </select>
                    </label>

                    <label class="book-settings-check">
                        <input type="checkbox"
                               name="Settings.TwoPageSpread"
                               value="true"
                               data-book-setting="twoPageSpread" />
                        Two-page spread on wide screens
                    </label>

                    <label>
                        Auto-scroll speed
                        <input type="range"
                               name="Settings.AutoScrollSpeed"
                               min="10"
                               max="180"
                               step="5"
                               data-book-setting="autoScrollSpeed" />
                        <output data-book-setting-output="autoScrollSpeed"></output>
                    </label>

                    <label>
                        Font
                        <select name="Settings.FontFamily" data-book-setting="fontFamily">
                            <option value="literary-serif">Literary serif</option>
                            <option value="book-serif">Book serif</option>
                            <option value="system-serif">System serif</option>
                            <option value="system-sans">System sans</option>
                            <option value="atkinson">Atkinson Hyperlegible</option>
                            <option value="noto-serif-jp">Noto Serif JP</option>
                            <option value="noto-sans-jp">Noto Sans JP</option>
                        </select>
                    </label>

                    <label>
                        Text size
                        <input type="range"
                               name="Settings.FontSizeRem"
                               min=".85"
                               max="1.8"
                               step=".05"
                               data-book-setting="fontSizeRem" />
                        <output data-book-setting-output="fontSizeRem"></output>
                    </label>

                    <label>
                        Line height
                        <input type="range"
                               name="Settings.LineHeight"
                               min="1.4"
                               max="2.6"
                               step=".05"
                               data-book-setting="lineHeight" />
                        <output data-book-setting-output="lineHeight"></output>
                    </label>

                    <label>
                        Paragraph spacing
                        <input type="range"
                               name="Settings.ParagraphSpacingEm"
                               min="0"
                               max="2.2"
                               step=".1"
                               data-book-setting="paragraphSpacingEm" />
                        <output data-book-setting-output="paragraphSpacingEm"></output>
                    </label>

                    <label>
                        Text width
                        <input type="range"
                               name="Settings.TextWidthPx"
                               min="520"
                               max="1100"
                               step="20"
                               data-book-setting="textWidthPx" />
                        <output data-book-setting-output="textWidthPx"></output>
                    </label>

                    <label>
                        Alignment
                        <select name="Settings.TextAlignment" data-book-setting="textAlignment">
                            <option value="start">Left</option>
                            <option value="justify">Justified</option>
                        </select>
                    </label>

                    <label>
                        Chapter style
                        <select name="Settings.ChapterStyle" data-book-setting="chapterStyle">
                            <option value="classic">Classic</option>
                            <option value="modern">Modern</option>
                            <option value="light-novel">Light novel</option>
                            <option value="minimal">Minimal</option>
                            <option value="decorative">Decorative</option>
                        </select>
                    </label>

                    <label>
                        Paper
                        <select name="Settings.PaperStyle" data-book-setting="paperStyle">
                            <option value="white">White</option>
                            <option value="cream">Cream</option>
                            <option value="sepia">Sepia</option>
                            <option value="old-paper">Old paper</option>
                            <option value="midnight">Midnight</option>
                            <option value="oled">OLED black</option>
                        </select>
                    </label>

                    <input type="hidden" name="Settings.GenreArtworkEnabled" value="@Model.ReaderSettings.GenreArtworkEnabled.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="Settings.GenreTheme" value="@Model.ReaderSettings.GenreTheme" />
                    <input type="hidden" name="Settings.BackgroundAssetId" value="@Model.ReaderSettings.BackgroundAssetId" />
                    <input type="hidden" name="Settings.BackgroundIntensity" value="@Model.ReaderSettings.BackgroundIntensity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <input type="hidden" name="Settings.BookmarkStyle" value="@Model.ReaderSettings.BookmarkStyle" />
                    <input type="hidden" name="Settings.BookmarkColor" value="@Model.ReaderSettings.BookmarkColor" />

                    <div class="book-settings-actions">
                        <button class="button"
                                type="button"
                                data-book-save-defaults>
                            Save as my defaults
                        </button>
                        <button class="button"
                                type="button"
                                data-book-reset-settings>
                            Reset this book
                        </button>
                    </div>
                </form>

                <form method="post"
                      asp-page-handler="ResetReaderSettings"
                      asp-route-id="@Model.Reader.Chapter.Id"
                      data-book-reset-form
                      hidden>
                    <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
                </form>
            </div>
        </details>
    </nav>

    <header class="book-reader-chapter-title">
        <span>Chapter @Model.Reader.Chapter.Number</span>
        <h1>@Model.Reader.Chapter.Title</h1>
    </header>

    @if (!Model.Reader.SourceLanguage.Equals(
        Model.Reader.TargetLanguage,
        StringComparison.OrdinalIgnoreCase)
        && !hasAlternate)
    {
        <div class="book-translation-slot" data-translation-slot>
            <span data-translation-state>
                @AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.Reader.TargetLanguage)
                translation is not ready yet.
            </span>
            <form method="post"
                  asp-page-handler="Translate"
                  asp-route-id="@Model.Reader.Chapter.Id"
                  data-book-translate-form>
                <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
                <button class="button button-primary" type="submit">
                    Translate this chapter
                </button>
            </form>
        </div>
    }

    <main class="book-reader-content" data-book-reader-content>
        <article class="book-reader-column original"
                 data-book-original
                 data-book-language="original">
            @for (var index = 0; index < Model.Reader.OriginalParagraphs.Count; index++)
            {
                <p data-book-paragraph="@index">@Model.Reader.OriginalParagraphs[index]</p>
            }
        </article>

        <article class="book-reader-column translated"
                 data-book-translated
                 data-book-language="@Model.Reader.TargetLanguage"
                 hidden="@(!hasAlternate || defaultView == "original")">
            @for (var index = 0; index < translatedParagraphs.Count; index++)
            {
                <p data-book-paragraph="@index">@translatedParagraphs[index]</p>
            }
        </article>
    </main>

    <div class="book-page-controls" data-book-page-controls hidden>
        <button type="button" data-book-page-prev aria-label="Previous page">←</button>
        <output data-book-page-number>1 / 1</output>
        <button type="button" data-book-page-next aria-label="Next page">→</button>
    </div>

    <footer class="book-reader-footer">
        @if (Model.Reader.PreviousChapterId is Guid previous)
        {
            <a href="/Books/Read/@previous?lang=@Model.Reader.TargetLanguage">← Previous chapter</a>
        }
        else
        {
            <span></span>
        }

        @if (Model.Reader.NextChapterId is Guid next)
        {
            <a href="/Books/Read/@next?lang=@Model.Reader.TargetLanguage">Next chapter →</a>
        }
    </footer>

    <form method="post"
          asp-page-handler="Progress"
          asp-route-id="@Model.Reader.Chapter.Id"
          data-book-progress-form
          hidden>
        <input type="hidden" name="positionPermille" value="@initialProgress" />
        <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
    </form>

    <form method="post"
          asp-page-handler="Bookmark"
          asp-route-id="@Model.Reader.Chapter.Id"
          data-book-bookmark-form
          hidden>
        <input type="hidden" name="positionPermille" value="@initialProgress" />
        <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
        <input type="hidden" name="anchorLanguage" value="@defaultView" />
    </form>

    <form method="post"
          asp-page-handler="Highlight"
          asp-route-id="@Model.Reader.Chapter.Id"
          data-book-highlight-form
          hidden>
        <input type="hidden" name="lang" value="@Model.Reader.TargetLanguage" />
        <input type="hidden" name="anchorLanguage" value="original" />
        <input type="hidden" name="paragraphIndex" value="0" />
        <input type="hidden" name="startOffset" value="0" />
        <input type="hidden" name="endOffset" value="0" />
        <input type="hidden" name="note" value="" />
    </form>

    <div class="book-selection-toolbar" data-book-selection-toolbar hidden>
        <button type="button" data-book-highlight-button>Highlight</button>
    </div>

    <dialog class="book-reader-drawer" data-book-drawer>
        <div class="book-reader-drawer-shell">
            <header>
                <div>
                    <strong>@(Model.Reader.Work.MetadataTitle ?? Model.Reader.Work.Title)</strong>
                    <span>Chapter @Model.Reader.Chapter.Number · @Model.Reader.Chapter.Title</span>
                </div>
                <button type="button"
                        data-book-drawer-close
                        aria-label="Close">×</button>
            </header>

            <div class="book-reader-drawer-tabs" role="tablist" aria-label="Reader navigation">
                <button type="button" class="active" data-book-drawer-tab="chapters">Chapters</button>
                <button type="button" data-book-drawer-tab="bookmarks">Bookmarks</button>
                <button type="button" data-book-drawer-tab="highlights">Highlights</button>
            </div>

            <section data-book-drawer-panel="chapters">
                <label class="book-reader-drawer-search">
                    <span class="sr-only">Search chapters</span>
                    <input type="search"
                           placeholder="Search chapters"
                           data-book-chapter-search />
                </label>
                <div class="book-reader-drawer-list" data-book-chapter-list>
                    <span class="books-muted">Loading chapters…</span>
                </div>
            </section>

            <section data-book-drawer-panel="bookmarks" hidden>
                <div class="book-reader-drawer-list" data-book-bookmark-list>
                    <span class="books-muted">Loading bookmarks…</span>
                </div>
            </section>

            <section data-book-drawer-panel="highlights" hidden>
                <div class="book-reader-drawer-list" data-book-highlight-list>
                    <span class="books-muted">Loading highlights…</span>
                </div>
            </section>
        </div>
    </dialog>

    <div class="book-reader-toast" data-book-toast hidden role="status" aria-live="polite"></div>
</div>
