@page "/Books/Library/{id:guid}"
@model AniLingo.Web.Pages.Books.LibraryModel
@{
    ViewData["Title"] = Model.Book.Work.MetadataTitle ?? Model.Book.Work.Title;
    var title = Model.Book.Work.MetadataTitle ?? Model.Book.Work.Title;
    var translatedCount = Model.Book.Chapters.Count(x => x.HasTranslation);
    var firstChapter = Model.Book.Progress?.ChapterId
        ?? Model.Book.Chapters.FirstOrDefault()?.Id;
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<a class="books-back" href="/Books?lang=@Model.TargetLanguage">← Books</a>

@if (TempData["Status"] is string status)
{
    <div class="books-message">@status</div>
}

<header class="book-detail-header book-library-header">
    <div class="book-detail-cover">
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.CoverImageUrl))
        {
            <img src="@Model.Book.Work.CoverImageUrl"
                 alt=""
                 referrerpolicy="no-referrer" />
        }
        else
        {
            <span>B</span>
        }
    </div>

    <div class="book-detail-copy">
        <h1>@title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.Author))
        {
            <p class="book-author">@Model.Book.Work.Author</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.Description))
        {
            <p class="book-summary">@Model.Book.Work.Description</p>
        }
        @if (Model.Book.Subjects.Count > 0)
        {
            <div class="book-tags">
                @foreach (var genre in Model.Book.Subjects.Take(8))
                {
                    <span>@genre</span>
                }
            </div>
        }

        <div class="book-language-row">
            <form method="get" class="book-language-form">
                <label>
                    Reading language
                    <input type="text"
                           name="lang"
                           value="@Model.TargetLanguage"
                           list="book-language-options"
                           maxlength="35"
                           spellcheck="false"
                           autocapitalize="none"
                           aria-describedby="book-language-help" />
                </label>
                <datalist id="book-language-options">
                    @foreach (var language in AniLingo.Web.Features.Books.BookLanguageCatalog.Supported)
                    {
                        <option value="@language.Key">@language.Value</option>
                    }
                </datalist>
                <button class="button" type="submit">Use language</button>
                <small id="book-language-help">
                    Choose a suggestion or enter a language tag such as <code>ro</code>, <code>sv</code> or <code>id-modern</code>.
                </small>
            </form>

            @if (!Model.SourceIsTarget && Model.TranslationEnabled)
            {
                <form method="post"
                      asp-page-handler="TranslateBook"
                      asp-route-id="@Model.Book.Work.Id">
                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                    <button class="button button-primary" type="submit">
                        Translate whole book to @AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage)
                    </button>
                </form>
            }
        </div>

        @if (Model.SourceIsTarget || Model.TranslationEnabled)
        {
            <div class="book-translation-summary">
                @if (Model.SourceIsTarget)
                {
                    <span>Original language selected · no translation needed</span>
                }
                else
                {
                    <span>@translatedCount / @Model.Book.Chapters.Count chapters translated</span>
                    <div class="book-card-progress">
                        <span style="width:@(Model.Book.Chapters.Count == 0 ? 0 : translatedCount * 100 / Model.Book.Chapters.Count)%"></span>
                    </div>
                }
            </div>
        }

        <div class="book-actions">
            @if (firstChapter is Guid chapterId)
            {
                <a class="button button-primary"
                   href="/Books/Read/@chapterId?lang=@Model.TargetLanguage">
                    @(Model.Book.Progress is null ? "Start reading" : "Continue reading")
                </a>
            }
            <a class="button"
               href="@Url.Page("/Settings/LearningScope", new {
                   mediaType = AniLingo.Web.Features.Learning.LearningMediaType.Book,
                   scope = "work",
                   workKey = Model.Book.Work.Id.ToString(),
                   label = title,
                   returnUrl = $"/Books/Library/{Model.Book.Work.Id}?lang={Model.TargetLanguage}"
               })">
                Language tools &amp; Learning
            </a>
        </div>

        <partial name="_OfflineLibraryAction" model="new AniLingo.Web.Features.OfflineLibrary.OfflineLibraryActionViewModel(Model.Book.Work.Id, title)" />
    </div>
</header>

@if (Model.IsOwner)
{
    <details class="book-library-management">
        <summary>Manage book</summary>
        <div class="book-library-management-actions">
            @if (!Model.SourceIsTarget && Model.TranslationEnabled)
            {
                <form method="post"
                      asp-page-handler="Regenerate"
                      asp-route-id="@Model.Book.Work.Id"
                      onsubmit="return confirm('Regenerate the @AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage) translation for this book? Existing cached translation text in this language will be replaced.');">
                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                    <button class="button" type="submit">
                        Regenerate @AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage)
                    </button>
                </form>
            }

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Book.Work.Id"
                  onsubmit="return confirm('Remove this book from AniLingo? Reading progress, bookmarks and cached translations for this imported book will be removed. External source/download files will not be deleted.');">
                <button class="button book-danger-button" type="submit">
                    Remove from AniLingo
                </button>
            </form>
        </div>
        <p>
            Removing a book only deletes AniLingo's imported library state.
            The original EPUB or download outside AniLingo is left untouched.
        </p>
    </details>
}

<section class="book-chapter-list">
    <div class="books-results-heading">
        <strong>Chapters</strong>
        <span>@Model.Book.Chapters.Count</span>
    </div>

    @foreach (var chapter in Model.Book.Chapters)
    {
        <a class="book-chapter-row"
           href="/Books/Read/@chapter.Id?lang=@Model.TargetLanguage">
            <span class="book-chapter-number">@chapter.Number</span>
            <strong>@chapter.Title</strong>
            @if (Model.SourceIsTarget)
            {
                <small>Original</small>
            }
            else if (Model.TranslationEnabled && chapter.HasTranslation)
            {
                <small class="ready">Translated</small>
            }
            else
            {
                <small>Original available</small>
            }
        </a>
    }
</section>
