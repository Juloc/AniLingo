@page "/Books"
@model AniLingo.Web.Pages.Books.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["books.index.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<header class="books-header">
    <div>
        <h1>@ui["books.index.title"]</h1>
        <p>@ui["books.index.subtitle"]</p>
        <a class="books-settings-link" href="/Books/ForYou?lang=@Model.TargetLanguage">@ui["books.index.forYouLink"] →</a>
        @if (Model.IsOwner)
        {
            <div class="books-owner-links">
                <a class="books-settings-link" href="/Books/Sources">@ui["books.sources.title"]</a>
                <a class="books-settings-link" href="/Books/Integrations">@ui["books.index.acquisitionLink"]</a>
            </div>
        }
    </div>
    <form method="get" action="/Books" class="books-search" role="search">
        <input type="search"
               name="q"
               value="@Model.Query"
               placeholder="@ui["books.index.searchPlaceholder"]"
               aria-label="@ui["books.index.searchAria"]" />
        <input type="hidden" name="lang" value="@Model.TargetLanguage" />
        <button class="button button-primary" type="submit">@ui["common.search"]</button>
    </form>
</header>

@if (TempData["Status"] is string status)
{
    <div class="books-message">@status</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="books-message">@Model.Error</div>
}

<section class="books-library-section">
    <div class="books-results-heading">
        <strong>@ui["books.index.myBooksHeading"]</strong>
        <span>@Model.Library.Count</span>
    </div>

    @if (Model.Library.Count == 0)
    {
        <div class="books-empty">
            <p>@ui["books.index.emptyTitle"]</p>
            @if (Model.IsOwner)
            {
                <span>@ui["books.index.emptyHint"]</span>
            }
        </div>
    }
    else
    {
        <div class="books-grid">
            @foreach (var book in Model.Library)
            {
                <a class="book-card"
                   href="/Books/Library/@book.WorkId?lang=@Model.TargetLanguage">
                    <div class="book-cover">
                        @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl"
                                 alt=""
                                 loading="lazy"
                                 referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span>B</span>
                        }
                    </div>
                    <div class="book-card-copy">
                        <strong>@book.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(book.Author))
                        {
                            <span>@book.Author</span>
                        }
                        <small>
                            @ui.Format("books.index.chapterSummary", ("count", book.ChapterCount), ("translated", book.TranslatedChapterCount))
                        </small>
                        @if (book.ProgressPermille > 0)
                        {
                            <div class="book-card-progress">
                                <span style="width:@(book.ProgressPermille / 10)%"></span>
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    }
</section>

@if (Model.IsOwner)
{
    <section class="books-tools">
        <div>
            <h2>@ui["books.index.importEpubTitle"]</h2>
            <p>@ui["books.index.importEpubDescription"]</p>
            <form method="post"
                  asp-page-handler="Upload"
                  enctype="multipart/form-data"
                  class="books-inline-form">
                <input type="file"
                       name="epub"
                       accept=".epub,application/epub+zip"
                       required />
                <button class="button button-primary" type="submit">@ui["books.index.importFileButton"]</button>
            </form>
            <form method="post"
                  asp-page-handler="RemoteEpub"
                  class="books-stack-form">
                <input type="url"
                       name="epubUrl"
                       placeholder="https://publisher.example/book.epub"
                       inputmode="url"
                       required />
                <button class="button" type="submit">@ui["books.index.importEpubUrlButton"]</button>
            </form>
        </div>

        @if (Model.IsInboxConfigured)
        {
            <div>
                <h2>@ui["books.index.inboxTitle"]</h2>
                <p>@ui["books.index.inboxDescription"]</p>
                <form method="post" asp-page-handler="ImportInbox">
                    <button class="button" type="submit">@ui["books.index.importInboxButton"]</button>
                </form>
            </div>
        }

        @if (Model.IsSabnzbdConfigured)
        {
            <div>
                <h2>@ui["books.index.sabTransportTitle"]</h2>
                <p>@ui["books.index.sabDescription"]</p>
                <form method="post"
                      asp-page-handler="SabUrl"
                      class="books-stack-form">
                    <input type="url"
                           name="nzbUrl"
                           placeholder="https://…/book.nzb"
                           required />
                    <input type="text"
                           name="displayName"
                           placeholder="@ui["books.index.sabQueueNamePlaceholder"]" />
                    <button class="button" type="submit">@ui["books.index.sabSendUrlButton"]</button>
                </form>
                <form method="post"
                      asp-page-handler="SabFile"
                      enctype="multipart/form-data"
                      class="books-inline-form">
                    <input type="file"
                           name="nzb"
                           accept=".nzb,application/x-nzb"
                           required />
                    <button class="button" type="submit">@ui["books.index.sabSendFileButton"]</button>
                </form>
            </div>
        }
        else
        {
            <div>
                <h2>@ui["books.index.sabTransportTitle"]</h2>
                <p>@ui["books.index.sabNotConfigured"]</p>
                <a class="button" href="/Settings/Sabnzbd">@ui["books.index.sabConfigureLink"]</a>
            </div>
        }
    </section>
}

@if (Model.Query.Length > 0 && string.IsNullOrWhiteSpace(Model.Error))
{
    <section class="books-search-results">
        <div class="books-results-heading">
            <strong>@ui["books.index.resultsForPrefix"] “@Model.Query”</strong>
            <span>@ui.Format("books.index.resultsShown", ("count", Model.Results.Count))</span>
        </div>

        @if (Model.Results.Count == 0)
        {
            <div class="books-empty">@ui["books.index.noResults"]</div>
        }
        else
        {
            <div class="books-grid">
                @foreach (var book in Model.Results)
                {
                    <a class="book-card" href="/Books/@book.Id">
                        <div class="book-cover">
                            @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                     alt=""
                                     loading="lazy"
                                     referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span>B</span>
                            }
                        </div>
                        <div class="book-card-copy">
                            <strong>@book.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <span>@book.Author</span>
                            }
                            @if (book.FirstPublishYear is not null)
                            {
                                <small>@book.FirstPublishYear</small>
                            }
                            else
                            {
                                <small>@book.SourceName</small>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </section>
}
