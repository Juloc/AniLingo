@page "/Books/Integrations"
@model AniLingo.Web.Pages.Books.IntegrationsModel
@{
    ViewData["Title"] = "Books acquisition settings";
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<a class="books-back" href="/Books">← Books</a>

<header class="books-settings-header">
    <h1>Acquisition settings</h1>
    <p>Configure your own download transport and the folder AniLingo checks for completed EPUB files.</p>
</header>

@if (TempData["Status"] is string status)
{
    <div class="books-message">@status</div>
}

<form method="post"
      asp-page-handler="Save"
      class="books-integration-settings">

    <section>
        <h2>SABnzbd</h2>
        <p>
            AniLingo can send an NZB URL or file you selected to your SABnzbd instance.
            The SABnzbd connection is shared with Anime and is configured once under
            <a href="/Settings/Sabnzbd">Settings → SABnzbd</a>, including the category used for Books.
        </p>

        <div class="books-integration-status">
            <span class="@(Model.SabConfigured ? "ready" : "")">
                @(Model.SabConfigured ? "Configured" : "Not configured")
            </span>
            @if (Model.SabConfigured)
            {
                <span>Books category: @(Model.SabBooksCategory ?? "SABnzbd default")</span>
            }
            <a class="button" href="/Settings/Sabnzbd">Manage SABnzbd</a>
        </div>
    </section>

    <section>
        <h2>Completed-books inbox</h2>
        <p>
            Point this at a folder visible inside the AniLingo container.
            Completed <code>.epub</code> files are imported automatically when a Books SABnzbd download finishes.
            Files placed there by other tools are imported with <em>Import inbox now</em> on the Books page.
        </p>

        @if (Model.InboxEnvironmentOverride)
        {
            <div class="books-setting-note">
                The inbox path is currently supplied by environment configuration and overrides the saved path.
            </div>
        }

        <label>
            Inbox path
            <input type="text"
                   name="inboxPath"
                   value="@Model.Settings.InboxPath"
                   placeholder="/books-inbox" />
        </label>

        <span class="@(Model.InboxConfigured ? "ready" : "")">
            @(Model.InboxConfigured ? "Configured" : "Not configured")
        </span>
    </section>

    <div class="books-settings-save">
        <button class="button button-primary" type="submit">Save settings</button>
    </div>
</form>
