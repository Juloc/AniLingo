@page "/Books/TranslationMemory/{id:guid}"
@model AniLingo.Web.Pages.Books.TranslationMemoryModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["books.bible.title"];
}
@section Head {
    <link rel="stylesheet"
          href="~/css/book-translation-memory.css"
          asp-append-version="true" />
}

<div class="book-bible-page">
    <a class="book-bible-back"
       href="/Books/Library/@Model.WorkId?lang=@Model.TargetLanguage">
        ← @ui["books.read.backToBook"]
    </a>

    <header class="book-bible-header">
        <div>
            <span class="book-bible-kicker">@ui["books.bible.kicker"]</span>
            <h1>@Model.WorkTitle</h1>
            <p>
                @ui["books.bible.forLanguage"]
                <strong>@AniLingo.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage)</strong>.
                @ui["books.bible.glossaryNote"]
            </p>
        </div>
    </header>

    @if (TempData["Status"] is string status)
    {
        <div class="book-bible-message">@status</div>
    }

    @if (Model.Bible is null)
    {
        <section class="book-bible-empty">
            <h2>@ui["books.bible.emptyTitle"]</h2>
            <p>
                @ui["books.bible.emptyBody"]
            </p>
        </section>
    }
    else
    {
        <section class="book-bible-section">
            <div class="book-bible-section-heading">
                <div>
                    <h2>@ui["books.bible.styleGuideTitle"]</h2>
                    <p>@ui["books.bible.styleGuideDescription"]</p>
                </div>
                <span>@ui.Format("books.bible.updatedAt", ("date", Model.Bible.UpdatedAt.ToLocalTime().ToString("g")))</span>
            </div>

            <form method="post"
                  asp-page-handler="Overview"
                  class="book-bible-form">
                <input type="hidden" name="id" value="@Model.WorkId" />
                <input type="hidden" name="lang" value="@Model.TargetLanguage" />

                <label>
                    @ui["books.bible.narrativePerspective"]
                    <textarea name="narrativePerspective"
                              rows="2"
                              maxlength="800">@Model.Bible.NarrativePerspective</textarea>
                </label>

                <label>
                    @ui["books.bible.overallStyle"]
                    <textarea name="overallStyle"
                              rows="4"
                              maxlength="1600">@Model.Bible.OverallStyle</textarea>
                </label>

                <div class="book-bible-grid two">
                    <label>
                        @ui["books.bible.register"]
                        <textarea name="register"
                                  rows="3"
                                  maxlength="800">@Model.Bible.Register</textarea>
                    </label>
                    <label>
                        @ui["books.bible.audience"]
                        <textarea name="audience"
                                  rows="3"
                                  maxlength="800">@Model.Bible.Audience</textarea>
                    </label>
                </div>

                @if (Model.Bible.Themes.Count > 0)
                {
                    <div class="book-bible-tags">
                        @foreach (var theme in Model.Bible.Themes)
                        {
                            <span>@theme</span>
                        }
                    </div>
                }

                <div>
                    <button class="button button-primary" type="submit">
                        @ui["books.bible.saveStyleGuide"]
                    </button>
                </div>
            </form>
        </section>

        <section class="book-bible-section">
            <div class="book-bible-section-heading">
                <div>
                    <h2>@ui["books.bible.glossaryTitle"]</h2>
                    <p>
                        @ui["books.bible.glossaryDescription"]
                    </p>
                </div>
                <span>@ui.Format("books.bible.termsCount", ("count", Model.Bible.Terms.Count))</span>
            </div>

            <details class="book-bible-add">
                <summary>@ui["books.bible.addTermSummary"]</summary>
                <form method="post"
                      asp-page-handler="Term"
                      class="book-bible-form compact">
                    <input type="hidden" name="id" value="@Model.WorkId" />
                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />

                    <div class="book-bible-grid two">
                        <label>
                            @ui["books.bible.source"]
                            <input type="text"
                                   name="source"
                                   maxlength="240"
                                   required />
                        </label>
                        <label>
                            @ui["books.bible.target"]
                            <input type="text"
                                   name="target"
                                   maxlength="240"
                                   required />
                        </label>
                    </div>

                    <div class="book-bible-grid two">
                        <label>
                            @ui["books.bible.category"]
                            <input type="text"
                                   name="category"
                                   maxlength="120"
                                   placeholder="@ui["books.bible.categoryPlaceholder"]" />
                        </label>
                        <label class="book-bible-check">
                            <input type="checkbox"
                                   name="locked"
                                   value="true" />
                            @ui["books.bible.lockTranslation"]
                        </label>
                    </div>

                    <label>
                        @ui["books.bible.notes"]
                        <textarea name="notes"
                                  rows="2"
                                  maxlength="1000"></textarea>
                    </label>

                    <div>
                        <button class="button button-primary" type="submit">@ui["books.bible.addTerm"]</button>
                    </div>
                </form>
            </details>

            <div class="book-bible-list">
                @foreach (var term in Model.Bible.Terms
                    .OrderByDescending(x => x.Locked)
                    .ThenBy(x => x.Source))
                {
                    <article class="book-bible-item @(term.Locked ? "locked" : "")">
                        <form method="post"
                              asp-page-handler="Term"
                              class="book-bible-form compact">
                            <input type="hidden" name="id" value="@Model.WorkId" />
                            <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                            <input type="hidden" name="source" value="@term.Source" />

                            <div class="book-bible-item-title">
                                <strong>@term.Source</strong>
                                @if (term.Locked)
                                {
                                    <span class="book-bible-lock">@ui["books.bible.lockedBadge"]</span>
                                }
                            </div>

                            <div class="book-bible-grid two">
                                <label>
                                    @ui["books.bible.target"]
                                    <input type="text"
                                           name="target"
                                           maxlength="240"
                                           value="@term.Target"
                                           required />
                                </label>
                                <label>
                                    @ui["books.bible.category"]
                                    <input type="text"
                                           name="category"
                                           maxlength="120"
                                           value="@term.Category" />
                                </label>
                            </div>

                            <label>
                                @ui["books.bible.notes"]
                                <textarea name="notes"
                                          rows="2"
                                          maxlength="1000">@term.Notes</textarea>
                            </label>

                            <div class="book-bible-item-actions">
                                <label class="book-bible-check">
                                    <input type="checkbox"
                                           name="locked"
                                           value="true"
                                           checked="@term.Locked" />
                                    @ui["books.bible.lockedBadge"]
                                </label>
                                <button class="button" type="submit">@ui["common.save"]</button>
                            </div>
                        </form>

                        <form method="post"
                              asp-page-handler="RemoveTerm"
                              class="book-bible-remove"
                              onsubmit="return confirm('@ui["books.bible.confirmRemoveTerm"]');">
                            <input type="hidden" name="id" value="@Model.WorkId" />
                            <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                            <input type="hidden" name="source" value="@term.Source" />
                            <button type="submit">@ui["books.bible.remove"]</button>
                        </form>
                    </article>
                }

                @if (Model.Bible.Terms.Count == 0)
                {
                    <p class="book-bible-muted">@ui["books.bible.noTerms"]</p>
                }
            </div>
        </section>

        <section class="book-bible-section">
            <div class="book-bible-section-heading">
                <div>
                    <h2>@ui["books.bible.entitiesTitle"]</h2>
                    <p>@ui["books.bible.entitiesDescription"]</p>
                </div>
                <span>@ui.Format("books.bible.entitiesCount", ("count", Model.Bible.Entities.Count))</span>
            </div>

            <details class="book-bible-add">
                <summary>@ui["books.bible.addEntitySummary"]</summary>
                <form method="post"
                      asp-page-handler="Entity"
                      class="book-bible-form compact">
                    <input type="hidden" name="id" value="@Model.WorkId" />
                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />

                    <div class="book-bible-grid three">
                        <label>
                            @ui["books.bible.sourceName"]
                            <input type="text"
                                   name="sourceName"
                                   maxlength="240"
                                   required />
                        </label>
                        <label>
                            @ui["books.bible.targetName"]
                            <input type="text"
                                   name="targetName"
                                   maxlength="240"
                                   required />
                        </label>
                        <label>
                            @ui["books.bible.type"]
                            <input type="text"
                                   name="type"
                                   maxlength="120"
                                   placeholder="@ui["books.bible.typePlaceholder"]" />
                        </label>
                    </div>

                    <label>
                        @ui["books.bible.description"]
                        <textarea name="description" rows="2" maxlength="1200"></textarea>
                    </label>

                    <div class="book-bible-grid two">
                        <label>
                            @ui["books.bible.pronouns"]
                            <textarea name="pronouns" rows="2" maxlength="300"></textarea>
                        </label>
                        <label>
                            @ui["books.bible.relationships"]
                            <textarea name="relationships" rows="2" maxlength="1200"></textarea>
                        </label>
                    </div>

                    <label>
                        @ui["books.bible.voiceNotes"]
                        <textarea name="voiceNotes" rows="2" maxlength="1200"></textarea>
                    </label>

                    <div>
                        <button class="button button-primary" type="submit">@ui["books.bible.addEntity"]</button>
                    </div>
                </form>
            </details>

            <div class="book-bible-list">
                @foreach (var entity in Model.Bible.Entities
                    .OrderBy(x => x.Type)
                    .ThenBy(x => x.SourceName))
                {
                    <article class="book-bible-item">
                        <form method="post"
                              asp-page-handler="Entity"
                              class="book-bible-form compact">
                            <input type="hidden" name="id" value="@Model.WorkId" />
                            <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                            <input type="hidden" name="sourceName" value="@entity.SourceName" />
                            <input type="hidden" name="type" value="@entity.Type" />

                            <div class="book-bible-item-title">
                                <strong>@entity.SourceName</strong>
                                <span>@entity.Type</span>
                            </div>

                            <label>
                                @ui["books.bible.targetName"]
                                <input type="text"
                                       name="targetName"
                                       maxlength="240"
                                       value="@entity.TargetName"
                                       required />
                            </label>

                            <label>
                                @ui["books.bible.description"]
                                <textarea name="description"
                                          rows="2"
                                          maxlength="1200">@entity.Description</textarea>
                            </label>

                            <div class="book-bible-grid two">
                                <label>
                                    @ui["books.bible.pronouns"]
                                    <textarea name="pronouns"
                                              rows="2"
                                              maxlength="300">@entity.Pronouns</textarea>
                                </label>
                                <label>
                                    @ui["books.bible.relationships"]
                                    <textarea name="relationships"
                                              rows="2"
                                              maxlength="1200">@entity.Relationships</textarea>
                                </label>
                            </div>

                            <label>
                                @ui["books.bible.voiceNotes"]
                                <textarea name="voiceNotes"
                                          rows="2"
                                          maxlength="1200">@entity.VoiceNotes</textarea>
                            </label>

                            <div class="book-bible-item-actions">
                                <button class="button" type="submit">@ui["common.save"]</button>
                            </div>
                        </form>

                        <form method="post"
                              asp-page-handler="RemoveEntity"
                              class="book-bible-remove"
                              onsubmit="return confirm('@ui["books.bible.confirmRemoveEntity"]');">
                            <input type="hidden" name="id" value="@Model.WorkId" />
                            <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                            <input type="hidden" name="sourceName" value="@entity.SourceName" />
                            <input type="hidden" name="type" value="@entity.Type" />
                            <button type="submit">@ui["books.bible.remove"]</button>
                        </form>
                    </article>
                }

                @if (Model.Bible.Entities.Count == 0)
                {
                    <p class="book-bible-muted">@ui["books.bible.noEntities"]</p>
                }
            </div>
        </section>

        <section class="book-bible-section">
            <div class="book-bible-section-heading">
                <div>
                    <h2>@ui["books.bible.chapterMemoryTitle"]</h2>
                    <p>@ui["books.bible.chapterMemoryDescription"]</p>
                </div>
                <span>@ui.Format("books.bible.chaptersCount", ("count", Model.Bible.Chapters.Count))</span>
            </div>

            <div class="book-bible-list">
                @foreach (var chapter in Model.Bible.Chapters
                    .OrderByDescending(x => x.ChapterNumber))
                {
                    <article class="book-bible-chapter">
                        <div>
                            <strong>@ui.Format("books.chapter.number", ("number", chapter.ChapterNumber)) · @chapter.ChapterTitle</strong>
                            <span>@chapter.UpdatedAt.ToLocalTime().ToString("g")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(chapter.Summary))
                        {
                            <p>@chapter.Summary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(chapter.ContinuityNotes))
                        {
                            <small>@chapter.ContinuityNotes</small>
                        }
                    </article>
                }

                @if (Model.Bible.Chapters.Count == 0)
                {
                    <p class="book-bible-muted">@ui["books.bible.noChapterMemory"]</p>
                }
            </div>
        </section>

        <section class="book-bible-danger">
            <div>
                <h2>@ui["books.bible.resetTitle"]</h2>
                <p>
                    @ui["books.bible.resetDescription"]
                </p>
            </div>
            <form method="post"
                  asp-page-handler="Reset"
                  onsubmit="return confirm('@ui["books.bible.confirmReset"]');">
                <input type="hidden" name="id" value="@Model.WorkId" />
                <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                <button class="button book-bible-danger-button" type="submit">@ui["books.bible.resetButton"]</button>
            </form>
        </section>
    }
</div>
