@page "/Books/{id}"
@model AniLingo.Web.Pages.Books.DetailsModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.Book?.Title ?? ui["books.details.fallbackTitle"];
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<a class="books-back" href="/Books">← @ui["nav.books"]</a>

@if (TempData["Status"] is string status)
{
    <div class="books-message">@status</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="books-message">@Model.Error</div>
}

@if (Model.Book is not null)
{
    <header class="book-detail-header">
        <div class="book-detail-cover">
            @if (!string.IsNullOrWhiteSpace(Model.Book.CoverImageUrl))
            {
                <img src="@Model.Book.CoverImageUrl"
                     alt=""
                     referrerpolicy="no-referrer" />
            }
            else
            {
                <span>B</span>
            }
        </div>

        <div class="book-detail-copy">
            <h1>@Model.Book.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Book.Author))
            {
                <p class="book-author">@Model.Book.Author</p>
            }
            @if (Model.Book.FirstPublishYear is not null)
            {
                <p class="book-meta">@ui.Format("books.details.firstPublished", ("year", Model.Book.FirstPublishYear))</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Book.Summary))
            {
                <p class="book-summary">@Model.Book.Summary</p>
            }
            @if (Model.Book.Subjects.Count > 0)
            {
                <div class="book-tags">
                    @foreach (var subject in Model.Book.Subjects.Take(8))
                    {
                        <span>@subject</span>
                    }
                </div>
            }

            <div class="book-actions">
                @if (Model.IsOwner)
                {
                    <form method="post"
                          asp-page-handler="Acquire"
                          asp-route-id="@Model.Book.Id">
                        <button class="button button-primary" type="submit">
                            @(!string.IsNullOrWhiteSpace(Model.Book.EpubUrl)
                                ? ui["books.details.addEpub"]
                                : Model.Book.CanAcquire
                                    ? ui["books.details.addToLibrary"]
                                    : ui["books.details.findFreeEdition"])
                        </button>
                    </form>
                }
                <a class="button"
                   href="@Model.Book.SourceUrl"
                   target="_blank"
                   rel="noopener noreferrer">@Model.Book.SourceName</a>
            </div>

            @if (!Model.Book.CanAcquire)
            {
                <p class="book-meta">
                    @ui["books.details.acquireNote"]
                </p>
            }

            @if (Model.IsOwner && Model.Book.SourceName != "Project Gutenberg")
            {
                <details class="book-sab-panel">
                    <summary>@ui["books.details.sendNzbSummary"]</summary>
                    <form method="post"
                          asp-page-handler="SabUrl"
                          asp-route-id="@Model.Book.Id"
                          class="books-inline-form">
                        <input type="url"
                               name="nzbUrl"
                               placeholder="https://…/book.nzb"
                               required />
                        <button class="button" type="submit">@ui["books.details.send"]</button>
                    </form>
                </details>
            }
        </div>
    </header>
}
