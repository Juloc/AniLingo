@page "/Books/Sources"
@model AniLingo.Web.Pages.Books.SourcesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["books.sources.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<a class="books-back" href="/Books">← @ui["nav.books"]</a>

<header class="books-settings-header">
    <h1>@ui["books.sources.title"]</h1>
    <p>@ui["books.sources.description"]</p>
</header>

@if (TempData["Status"] is string status)
{
    <div class="books-message">@status</div>
}

<section class="book-source-builtins">
    <div>
        <strong>@ui["books.sources.builtIn"]</strong>
        <span>@ui["books.sources.builtInList"]</span>
    </div>
</section>

<div class="book-source-layout">
    <section class="book-source-panel">
        <h2>@ui["books.sources.catalogsTitle"]</h2>

        @if (Model.Sources.Count == 0)
        {
            <p class="books-muted">@ui["books.sources.noneConfigured"]</p>
        }
        else
        {
            <div class="book-source-list">
                @foreach (var source in Model.Sources)
                {
                    <article class="book-source-row">
                        <div>
                            <strong>@source.Name</strong>
                            <span>@source.Url</span>
                            <small>
                                @(source.IsEnabled ? ui["books.sources.statusEnabled"] : ui["books.sources.statusDisabled"])
                                @if (source.HasCredentials)
                                {
                                    <text> · @ui["books.sources.basicAuthConfigured"]</text>
                                }
                            </small>
                        </div>
                        <div class="book-source-actions">
                            <form method="post" asp-page-handler="Test">
                                <input type="hidden" name="sourceId" value="@source.Id" />
                                <button class="button" type="submit">@ui["books.sources.test"]</button>
                            </form>
                            <form method="post" asp-page-handler="Toggle">
                                <input type="hidden" name="sourceId" value="@source.Id" />
                                <input type="hidden" name="enabled" value="@(!source.IsEnabled ? "true" : "false")" />
                                <button class="button" type="submit">
                                    @(source.IsEnabled ? ui["books.sources.disable"] : ui["books.sources.enable"])
                                </button>
                            </form>
                            <form method="post"
                                  asp-page-handler="Remove"
                                  onsubmit="return confirm('@ui["books.sources.confirmRemove"]');">
                                <input type="hidden" name="sourceId" value="@source.Id" />
                                <button class="button book-danger-button" type="submit">@ui["books.sources.remove"]</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }

        <details class="book-source-add">
            <summary>@ui["books.sources.addSourceSummary"]</summary>
            <form method="post" asp-page-handler="Save" class="books-stack-form">
                <label>
                    @ui["books.sources.nameLabel"]
                    <input type="text"
                           name="name"
                           maxlength="120"
                           placeholder="Standard Ebooks"
                           required />
                </label>
                <label>
                    @ui["books.sources.feedUrlLabel"]
                    <input type="url"
                           name="url"
                           placeholder="https://example.org/opds"
                           required />
                </label>
                <label>
                    @ui["books.sources.usernameLabel"] <small>@ui["books.sources.optional"]</small>
                    <input type="text"
                           name="username"
                           autocomplete="username"
                           maxlength="256" />
                </label>
                <label>
                    @ui["books.sources.passwordLabel"] <small>@ui["books.sources.passwordHint"]</small>
                    <input type="password"
                           name="password"
                           autocomplete="new-password"
                           maxlength="512" />
                </label>
                <button class="button button-primary" type="submit">@ui["books.sources.addSourceButton"]</button>
            </form>
        </details>
    </section>

    <section class="book-source-panel">
        <h2>@ui["books.sources.searchCatalogsTitle"]</h2>
        <form method="get" class="book-source-search">
            <input type="hidden" name="search" value="true" />
            <select name="source">
                <option value="">@ui["books.sources.allEnabledSources"]</option>
                @foreach (var source in Model.Sources.Where(x => x.IsEnabled))
                {
                    <option value="@source.Id"
                            selected="@(source.Id == Model.SelectedSourceId)">
                        @source.Name
                    </option>
                }
            </select>
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="@ui["books.sources.searchPlaceholder"]" />
            <button class="button button-primary" type="submit">@ui["common.search"]</button>
        </form>

        @if (Model.Results.Count > 0)
        {
            <div class="book-opds-results">
                @foreach (var book in Model.Results)
                {
                    <article class="book-opds-card">
                        @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl"
                                 alt=""
                                 loading="lazy"
                                 referrerpolicy="no-referrer" />
                        }
                        <div>
                            <small>@book.SourceName</small>
                            <strong>@book.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <span>@book.Author</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(book.Language))
                            {
                                <small>@ui["books.sources.languageLabel"] @book.Language</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(book.Description))
                            {
                                <p>@book.Description</p>
                            }
                            <form method="post" asp-page-handler="Import">
                                <input type="hidden" name="sourceId" value="@book.SourceId" />
                                <input type="hidden" name="bookKey" value="@book.Key" />
                                <input type="hidden" name="q" value="@Model.Query" />
                                <button class="button button-primary" type="submit">@ui["books.sources.importEpub"]</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else if (Request.Query["search"] == "true")
        {
            <div class="books-empty">@ui["books.sources.noResults"]</div>
        }
        else
        {
            <p class="books-muted">
                @ui["books.sources.searchHint"]
            </p>
        }
    </section>
</div>
