@using AniLingo.Web.Data
@using AniLingo.Web.Features.Auth
@using AniLingo.Web.Features.Appearance
@using AniLingo.Web.Features.Localization
@inject AppDbContext LocalizationDb
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var profileId = isAuthenticated
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        : null;
    var ui = await UiRequestLocalization.GetBundleAsync(Context, LocalizationDb);
    var appTheme = AppTheme.System;
    if (isAuthenticated && !string.IsNullOrWhiteSpace(profileId))
    {
        appTheme = await new UiTranslationCatalogStore(LocalizationDb).GetProfileThemeAsync(
            profileId,
            Context.RequestAborted);
    }

    ViewData["UiTextBundle"] = ui;
    ViewData["AppThemeMode"] = appTheme;
    ViewData["AppBuildVersion"] = AppBuildInfo.Version;
}
<!DOCTYPE html>
<html lang="@ui.Locale" dir="@ui.Direction" data-app-theme="@appTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090b0f" data-app-theme-color />
    <meta name="application-name" content="AniLingo" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AniLingo" />
    <title>@ViewData["Title"] - AniLingo</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/anilingo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/json" id="app-shell-text">@Json.Serialize(ui.WithPrefix("pwa."))</script>
    <script src="~/js/app-theme.js" asp-append-version="true" defer></script>
    <script src="~/js/pwa.js" asp-append-version="true" defer></script>
    @if (isAuthenticated)
    {
        @* Offline library (#221): loaded on every authenticated page (not just Settings/Offline and
           the "Save offline" action) because the compact global download indicator in
           _AppAccountFooter.cshtml needs the manager everywhere. Previously duplicated per-page;
           see _OfflineLibraryAction.cshtml and Settings/Offline.cshtml. *@
        <script type="application/json" id="offline-library-text">@Json.Serialize(ui.WithPrefix("offlineLibrary."))</script>
        <script src="~/js/offline-library.js" asp-append-version="true" defer></script>
        <script src="~/js/offline-library-storage.js" asp-append-version="true" defer></script>
        <script src="~/js/offline-library-manager.js" asp-append-version="true" defer></script>
        <script src="~/js/offline-library-ui.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(isAuthenticated ? "" : "auth-page")"
      data-profile-id="@profileId">
    <a class="skip-link" href="#main-content">@ui["shell.skipToContent"]</a>
    <div class="app-shell @(isAuthenticated ? "" : "auth-shell")">
        @if (isAuthenticated)
        {
            <partial name="_AppNavigation" />
        }
        <main id="main-content" tabindex="-1" class="@(isAuthenticated ? "app-main" : "auth-main")">
            @if (TempData["Status"] is string status)
            {
                <div class="toast" role="status">@status</div>
            }
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
