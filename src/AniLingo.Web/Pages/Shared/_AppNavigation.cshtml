@{
    var path = Context.Request.Path;
}
<aside class="sidebar">
    <a class="brand" href="/">
        <span class="brand-mark">A</span>
        <span>AniLingo</span>
    </a>

    <nav class="nav-list" aria-label="Primary">
        <a class="nav-item @(path == "/" ? "active" : "")" href="/">
            <span class="nav-glyph">H</span><span>Home</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Library") ? "active" : "")" href="/Library">
            <span class="nav-glyph">L</span><span>Library</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Learn") ? "active" : "")" href="/Learn">
            <span class="nav-glyph">R</span><span>Learn</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Settings") ? "active" : "")" href="/Settings">
            <span class="nav-glyph">S</span><span>Settings</span>
        </a>
    </nav>

    <div class="sidebar-footer">v0.1</div>
</aside>

<nav class="mobile-nav" aria-label="Primary mobile">
    <a class="@(path == "/" ? "active" : "")" href="/">Home</a>
    <a class="@(path.StartsWithSegments("/Library") ? "active" : "")" href="/Library">Library</a>
    <a class="@(path.StartsWithSegments("/Learn") ? "active" : "")" href="/Learn">Learn</a>
    <a class="@(path.StartsWithSegments("/Settings") ? "active" : "")" href="/Settings">Settings</a>
</nav>
