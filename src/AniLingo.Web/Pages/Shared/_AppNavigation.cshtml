@{
    var path = Context.Request.Path;
    var isReading =
        path.StartsWithSegments("/Reading")
        || path.StartsWithSegments("/Novels")
        || path.StartsWithSegments("/Manga");
}
<aside class="sidebar">
    <a class="brand" href="/">
        <span class="brand-mark">A</span>
        <span>AniLingo</span>
    </a>

    <nav class="nav-list" aria-label="Primary">
        <a class="nav-item @(path == "/" ? "active" : "")" href="/">
            <span class="nav-glyph">H</span><span>Home</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Discover") ? "active" : "")" href="/Discover">
            <span class="nav-glyph">D</span><span>Discover</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Library") ? "active" : "")" href="/Library">
            <span class="nav-glyph">L</span><span>Library</span>
        </a>
        <a class="nav-item @(isReading ? "active" : "")" href="/Reading">
            <span class="nav-glyph">R</span><span>Reading</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Books") ? "active" : "")" href="/Books">
            <span class="nav-glyph">B</span><span>Books</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Learn") ? "active" : "")" href="/Learn">
            <span class="nav-glyph">V</span><span>Learn</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Statistics") ? "active" : "")" href="/Statistics">
            <span class="nav-glyph">P</span><span>Progress</span>
        </a>
        <a class="nav-item @(path.StartsWithSegments("/Settings") ? "active" : "")" href="/Settings">
            <span class="nav-glyph">S</span><span>Settings</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <span class="sidebar-user">@User.Identity?.Name</span>
        <form method="post" asp-page="/Account/Logout" data-offline-logout>
            <button class="sidebar-logout" type="submit">Sign out</button>
        </form>
        <span>v0.1</span>
    </div>
</aside>

<nav class="mobile-nav" aria-label="Primary mobile">
    <a class="@(path == "/" ? "active" : "")" href="/">Home</a>
    <a class="@(path.StartsWithSegments("/Discover") ? "active" : "")" href="/Discover">Discover</a>
    <a class="@(path.StartsWithSegments("/Library") ? "active" : "")" href="/Library">Library</a>
    <a class="@(isReading ? "active" : "")" href="/Reading">Reading</a>
    <a class="@(path.StartsWithSegments("/Learn") ? "active" : "")" href="/Learn">Learn</a>
    <a class="@(path.StartsWithSegments("/Statistics") ? "active" : "")" href="/Statistics">Progress</a>
    <a class="@(path.StartsWithSegments("/Settings") ? "active" : "")" href="/Settings">Settings</a>
    <form method="post" asp-page="/Account/Logout" data-offline-logout>
        <button type="submit">Sign out</button>
    </form>
</nav>
