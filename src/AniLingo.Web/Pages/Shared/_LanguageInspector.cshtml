@*
    Shared word/sentence inspector (issue #233). Hosts render it with one line:
        <partial name="_LanguageInspector" model="LanguageInspectorHost.ForBookChapter(...)" />
    It renders nothing unless the resolved Learning scope enables language tools
    (and PlayerTools/ReaderTools for the hosting surface). The script exposes
    window.AniLingoLanguageInspector; see docs/LEARNING_V2.md for the contract.
*@
@using AniLingo.Web.Data
@using AniLingo.Web.Features.Auth
@using AniLingo.Web.Features.Learning.LanguageAssistance
@using AniLingo.Web.Features.Localization
@using Microsoft.AspNetCore.Antiforgery
@model LanguageInspectorHost
@inject AppDbContext InspectorDb
@inject CurrentAccountContext InspectorAccount
@inject IAntiforgery InspectorAntiforgery
@{
    var availability = await new LearningModuleResolver(InspectorDb).ResolveAssistanceAsync(
        InspectorAccount.ProfileId,
        Model.Scope,
        Model.SourceType,
        Context.RequestAborted);
}
@if (availability.ShowInspector)
{
    var ui = await UiRequestLocalization.GetBundleAsync(Context, InspectorDb);
    var config = new
    {
        endpoint = LanguageInspectorEndpoints.BasePath,
        requestToken = InspectorAntiforgery.GetAndStoreTokens(Context).RequestToken,
        context = Model.SourceType is { } sourceType
            ? new
            {
                sourceType = LanguageSourceAnchor.SourceTypeKey(sourceType),
                contentKey = Model.ContentId?.ToString("D"),
                language = Model.Language
            }
            : null,
        selection = Model.SelectionSurface is null
            ? null
            : new
            {
                surface = Model.SelectionSurface,
                paragraphAttribute = Model.ParagraphAttribute
            },
        text = ui.WithPrefix("languageInspector.")
    };
    var configJson = System.Text.Json.JsonSerializer.Serialize(
        config,
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));

    <link rel="stylesheet" href="~/css/language-inspector.css" asp-append-version="true" />
    <section class="language-inspector"
             data-language-inspector
             role="dialog"
             aria-modal="false"
             aria-label="@ui["languageInspector.aria"]"
             aria-describedby="language-inspector-word language-inspector-meaning"
             hidden>
        <header class="language-inspector-header">
            <div class="language-inspector-heading">
                <span class="language-inspector-kicker" data-li-kicker>@ui["languageInspector.word"]</span>
                <h2 class="language-inspector-word" id="language-inspector-word" data-li-word></h2>
                <span class="language-inspector-reading" data-li-reading hidden></span>
            </div>
            <button class="language-inspector-close"
                    type="button"
                    data-li-close
                    aria-label="@ui["languageInspector.close"]"
                    title="@ui["languageInspector.close"]">×</button>
        </header>

        <p class="language-inspector-meaning" id="language-inspector-meaning" data-li-meaning></p>

        <div class="language-inspector-tokens"
             data-li-tokens
             role="group"
             aria-label="@ui["languageInspector.wordsAria"]"
             hidden></div>

        <div class="language-inspector-row">
            <button class="chip" type="button" data-li-speak hidden>@ui["languageInspector.listen"]</button>
            <span class="status-pill language-inspector-state" data-li-state hidden></span>
        </div>

        <div class="language-inspector-actions"
             data-li-actions
             role="group"
             aria-label="@ui["languageInspector.actionsAria"]"
             hidden>
            <button class="chip" type="button" data-li-action="saved">@ui["languageInspector.action.save"]</button>
            <button class="chip" type="button" data-li-action="learning" hidden>@ui["languageInspector.action.learn"]</button>
            <button class="chip" type="button" data-li-action="known">@ui["languageInspector.action.known"]</button>
            <button class="chip" type="button" data-li-action="ignored">@ui["languageInspector.action.ignore"]</button>
        </div>

        <div class="language-inspector-explanation" data-li-explanation-block hidden>
            <button class="button" type="button" data-li-explain>@ui["languageInspector.explain"]</button>
            <div class="language-inspector-explanation-body" data-li-explanation hidden>
                <p><strong>@ui["languageInspector.translation"]</strong> <span data-li-translation></span></p>
                <div data-li-grammar-block hidden>
                    <strong>@ui["languageInspector.grammar"]</strong>
                    <ul data-li-grammar></ul>
                </div>
                <div data-li-colloquial-block hidden>
                    <strong>@ui["languageInspector.colloquial"]</strong>
                    <ul data-li-colloquial></ul>
                </div>
            </div>
        </div>

        <p class="language-inspector-status" data-li-status role="status" aria-live="polite"></p>
    </section>
    <button class="language-inspector-lookup" type="button" data-li-lookup hidden>@ui["languageInspector.lookUp"]</button>
    <script type="application/json" data-language-inspector-config>@Html.Raw(configJson)</script>
    <script src="~/js/language-inspector.js" asp-append-version="true"></script>
}
