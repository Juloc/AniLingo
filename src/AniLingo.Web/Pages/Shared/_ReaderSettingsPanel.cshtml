@model AniLingo.Web.Features.ReaderCore.ReaderSettingsPanelModel
@using AniLingo.Web.Features.ReaderPreferences
@using AniLingo.Web.Features.Speech
@{
    var capabilities = Model.Document.Capabilities;
}
@if (capabilities.SupportsTts)
{
    @* Read-aloud entry point; reader-tts.js reveals it only when the device can speak. *@
    <button class="reader-tts-toggle"
            type="button"
            data-reader-tts-toggle
            aria-pressed="false"
            aria-label="Vorlesen"
            title="Vorlesen"
            hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
            <path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
        </svg>
    </button>
}
<details class="reader-settings"
         data-reader-settings-panel
         data-reader-settings-container>
    <summary class="reader-settings-trigger"
             aria-label="Leseeinstellungen"
             title="Leseeinstellungen">Aa</summary>

    <form class="reader-settings-panel"
          method="post"
          asp-page-handler="ReaderSettings"
          asp-route-id="@Model.ChapterId"
          data-reader-settings-form
          data-book-settings-form>
        @if (!string.IsNullOrWhiteSpace(Model.Language))
        {
            <input type="hidden" name="lang" value="@Model.Language" />
        }
        <input type="hidden" name="scope" value="work" />
        <input type="hidden" name="changedKey" value="" />
        <input type="hidden" name="genre" value="" />
        <input type="hidden" name="genrePriority" value="500" />

        <header class="reader-settings-heading">
            <div>
                <strong>Lesen</strong>
                <small>@Model.Document.Title</small>
            </div>
            <span data-reader-override-state data-book-override-state>
                @(Model.Settings.HasBookOverride
                    ? "Für dieses Buch angepasst"
                    : Model.Settings.HasGenreOverride
                        ? "Genre-Standard"
                        : Model.Settings.HasTypeOverride
                            ? "Typ-Standard"
                            : "Mein Standard")
            </span>
        </header>

        <div class="reader-settings-fields">
            @if (capabilities.SupportsContinuous || capabilities.SupportsPaged)
            {
                <label>
                    <span>Lesemodus</span>
                    <select name="ReadingMode"
                            data-reader-setting
                            data-setting-key="readingMode"
                            data-book-setting="readingMode">
                        @if (capabilities.SupportsContinuous)
                        {
                            <option value="continuous">Scrollen</option>
                        }
                        @if (capabilities.SupportsPaged)
                        {
                            <option value="paged">Seiten</option>
                        }
                    </select>
                </label>
            }

            @if (capabilities.SupportsPageCurl || capabilities.SupportsPaged)
            {
                <label>
                    <span>Seitenanimation</span>
                    <select name="PageTransition"
                            data-reader-setting
                            data-setting-key="pageTransition"
                            data-book-setting="pageTransition">
                        @if (capabilities.SupportsPageCurl)
                        {
                            <option value="curl">Umblättern</option>
                        }
                        <option value="slide">Schieben</option>
                        <option value="fade">Überblenden</option>
                        <option value="none">Keine</option>
                    </select>
                </label>
            }

            @if (capabilities.SupportsTwoPage)
            {
                <label class="reader-settings-check">
                    <input type="checkbox"
                           name="TwoPageSpread"
                           value="true"
                           data-reader-setting
                           data-setting-key="twoPageSpread"
                           data-book-setting="twoPageSpread" />
                    <span>Doppelseite auf breiten Displays</span>
                </label>
            }

            @if (capabilities.SupportsAutoScroll)
            {
                <label>
                    <span>
                        Auto-Scroll
                        <output data-setting-output="autoScrollSpeed"
                                data-book-setting-output="autoScrollSpeed"></output>
                    </span>
                    <input type="range"
                           name="AutoScrollSpeed"
                           min="10"
                           max="180"
                           step="5"
                           data-reader-setting
                           data-setting-key="autoScrollSpeed"
                           data-book-setting="autoScrollSpeed" />
                </label>
            }

            @if (capabilities.SupportsTypography)
            {
                <label>
                    <span>Schrift</span>
                    <select name="FontFamily"
                            data-reader-setting
                            data-setting-key="fontFamily"
                            data-book-setting="fontFamily">
                        <option value="literary-serif">Literary Serif</option>
                        <option value="book-serif">Book Serif</option>
                        <option value="system-serif">System Serif</option>
                        <option value="system-sans">System Sans</option>
                        <option value="atkinson">Atkinson Hyperlegible</option>
                        <option value="noto-serif-jp">Noto Serif JP</option>
                        <option value="noto-sans-jp">Noto Sans JP</option>
                        <option value="google:Literata">Literata</option>
                        <option value="google:Lora">Lora</option>
                        <option value="google:Merriweather">Merriweather</option>
                    </select>
                </label>

                <div class="novel-google-font reader-google-font">
                    <input type="search"
                           data-reader-google-font
                           list="reader-google-fonts"
                           placeholder="Weitere Google Font" />
                    <datalist id="reader-google-fonts">
                        <option value="Source Serif 4"></option>
                        <option value="Crimson Pro"></option>
                        <option value="EB Garamond"></option>
                        <option value="Noto Serif JP"></option>
                        <option value="Noto Sans JP"></option>
                    </datalist>
                    <button type="button"
                            class="button"
                            data-reader-apply-google-font>Anwenden</button>
                </div>

                <label>
                    <span>
                        Textgröße
                        <output data-setting-output="fontSizeRem"
                                data-book-setting-output="fontSizeRem"></output>
                    </span>
                    <input type="range"
                           name="FontSizeRem"
                           min=".85"
                           max="1.8"
                           step=".05"
                           data-reader-setting
                           data-setting-key="fontSizeRem"
                           data-book-setting="fontSizeRem" />
                </label>

                <label>
                    <span>
                        Zeilenhöhe
                        <output data-setting-output="lineHeight"
                                data-book-setting-output="lineHeight"></output>
                    </span>
                    <input type="range"
                           name="LineHeight"
                           min="1.4"
                           max="2.6"
                           step=".05"
                           data-reader-setting
                           data-setting-key="lineHeight"
                           data-book-setting="lineHeight" />
                </label>

                <label>
                    <span>
                        Absatzabstand
                        <output data-setting-output="paragraphSpacingEm"
                                data-book-setting-output="paragraphSpacingEm"></output>
                    </span>
                    <input type="range"
                           name="ParagraphSpacingEm"
                           min="0"
                           max="2.2"
                           step=".1"
                           data-reader-setting
                           data-setting-key="paragraphSpacingEm"
                           data-book-setting="paragraphSpacingEm" />
                </label>

                <label>
                    <span>
                        Textbreite
                        <output data-setting-output="textWidthPx"
                                data-book-setting-output="textWidthPx"></output>
                    </span>
                    <input type="range"
                           name="TextWidthPx"
                           min="520"
                           max="1100"
                           step="20"
                           data-reader-setting
                           data-setting-key="textWidthPx"
                           data-book-setting="textWidthPx" />
                </label>

                <label>
                    <span>Ausrichtung</span>
                    <select name="TextAlignment"
                            data-reader-setting
                            data-setting-key="textAlignment"
                            data-book-setting="textAlignment">
                        <option value="start">Links</option>
                        <option value="justify">Blocksatz</option>
                    </select>
                </label>

                <label>
                    <span>Kapitelstil</span>
                    <select name="ChapterStyle"
                            data-reader-setting
                            data-setting-key="chapterStyle"
                            data-book-setting="chapterStyle">
                        <option value="classic">Classic</option>
                        <option value="modern">Modern</option>
                        <option value="light-novel">Light Novel</option>
                        <option value="minimal">Minimal</option>
                        <option value="decorative">Decorative</option>
                    </select>
                </label>
            }

            <label>
                <span>Papier</span>
                <select name="PaperStyle"
                        data-reader-setting
                        data-setting-key="paperStyle"
                        data-book-setting="paperStyle">
                    <option value="white">White</option>
                    <option value="cream">Cream</option>
                    <option value="sepia">Sepia</option>
                    <option value="old-paper">Old Paper</option>
                    <option value="midnight">Midnight</option>
                    <option value="oled">OLED Black</option>
                </select>
            </label>

            @if (capabilities.SupportsThemeArtwork)
            {
                <label class="reader-settings-check">
                    <input type="checkbox"
                           name="GenreArtworkEnabled"
                           value="true"
                           data-reader-setting
                           data-setting-key="genreArtworkEnabled"
                           data-book-setting="genreArtworkEnabled" />
                    <span>Genre-Hintergrund</span>
                </label>

                <label>
                    <span>Genre / Stimmung</span>
                    <select name="GenreTheme"
                            data-reader-setting
                            data-setting-key="genreTheme"
                            data-book-setting="genreTheme"
                            data-reader-genre-select>
                        <option value="auto">Automatisch</option>
                    </select>
                </label>

                <label>
                    <span>Hintergrund</span>
                    <select name="BackgroundAssetId"
                            data-reader-setting
                            data-setting-key="backgroundAssetId"
                            data-book-setting="backgroundAssetId"
                            data-reader-background-select>
                        <option value="auto">Automatisch</option>
                    </select>
                </label>

                <label>
                    <span>
                        Hintergrundstärke
                        <output data-setting-output="backgroundIntensity"
                                data-book-setting-output="backgroundIntensity"></output>
                    </span>
                    <input type="range"
                           name="BackgroundIntensity"
                           min="0"
                           max=".12"
                           step=".005"
                           data-reader-setting
                           data-setting-key="backgroundIntensity"
                           data-book-setting="backgroundIntensity" />
                </label>

                <label>
                    <span>Bewegung</span>
                    <select name="BackgroundMotionMode"
                            data-reader-setting
                            data-setting-key="backgroundMotionMode"
                            data-book-setting="backgroundMotionMode">
                        <option value="auto">Automatisch</option>
                        <option value="static">Statisch</option>
                        <option value="parallax">2.5D / Parallax</option>
                    </select>
                </label>

                <details class="reader-theme-advanced">
                    <summary>Theme fein einstellen</summary>
                    <div class="reader-theme-advanced-grid">
                        @foreach (var item in new[]
                        {
                            ("ThemeEffectStrength", "themeEffectStrength", "Effekte", "0", "2", ".05"),
                            ("ThemeBrightness", "themeBrightness", "Helligkeit", ".65", "1.35", ".05"),
                            ("ThemeContrast", "themeContrast", "Kontrast", ".7", "1.3", ".05"),
                            ("ThemeSaturation", "themeSaturation", "Sättigung", "0", "1.5", ".05"),
                            ("ThemeBlurPx", "themeBlurPx", "Blur", "0", "8", ".5"),
                            ("ThemeVignetteStrength", "themeVignetteStrength", "Vignette", "0", "2", ".05"),
                            ("ThemeGrainStrength", "themeGrainStrength", "Körnung", "0", "2", ".05"),
                            ("ThemeTextBackdropStrength", "themeTextBackdropStrength", "Textfläche", "0", "2", ".05"),
                            ("ThemeParallaxStrength", "themeParallaxStrength", "Parallax", "0", "2", ".05"),
                            ("ThemeTintStrength", "themeTintStrength", "Tönung", "0", "2", ".05")
                        })
                        {
                            <label>
                                <span>
                                    @item.Item3
                                    <output data-setting-output="@item.Item2"
                                            data-book-setting-output="@item.Item2"></output>
                                </span>
                                <input type="range"
                                       name="@item.Item1"
                                       min="@item.Item4"
                                       max="@item.Item5"
                                       step="@item.Item6"
                                       data-reader-setting
                                       data-setting-key="@item.Item2"
                                       data-book-setting="@item.Item2" />
                            </label>
                        }
                    </div>
                </details>
            }

            <label>
                <span>Lesezeichen-Stil</span>
                <select name="BookmarkStyle"
                        data-reader-setting
                        data-setting-key="bookmarkStyle"
                        data-book-setting="bookmarkStyle">
                    <option value="fabric">Stoffband</option>
                    <option value="paper">Papier</option>
                    <option value="leather">Leder</option>
                    <option value="cord">Schnur</option>
                    <option value="minimal">Minimal</option>
                </select>
            </label>

            <label>
                <span>Lesezeichen-Farbe</span>
                <input type="color"
                       name="BookmarkColor"
                       data-reader-setting
                       data-setting-key="bookmarkColor"
                       data-book-setting="bookmarkColor" />
            </label>
        </div>

        @if (capabilities.SupportsTts)
        {
            var tts = Model.Settings;
            <section class="reader-tts-settings" data-reader-tts-settings aria-label="Vorlesen">
                <input type="hidden"
                       name="TtsVoiceIds"
                       value="@(SpeechVoiceMap.Serialize(tts.TtsVoiceIds) ?? "")"
                       data-reader-tts-voice-map />

                <p class="reader-tts-status" data-reader-tts-status role="status"></p>

                <label data-reader-tts-field="ttsProviderId">
                    <span>Sprachausgabe</span>
                    <select name="TtsProviderId" data-reader-tts-setting="ttsProviderId">
                        <option value="auto" selected="@(tts.TtsProviderId == "auto")">Automatisch</option>
                        <option value="device" selected="@(tts.TtsProviderId == "device")">Gerätestimme</option>
                    </select>
                </label>

                @foreach (var language in Model.Document.Languages)
                {
                    var voiceKey = ReaderPreferenceRules.TtsVoiceFieldKey(language.Tag);
                    var storedVoice = SpeechVoiceMap.VoiceIdFor(tts.TtsVoiceIds, language.Tag);
                    <label data-reader-tts-field="@voiceKey">
                        <span>Stimme @language.Label</span>
                        <select data-reader-tts-voice="@language.Tag"
                                data-reader-tts-voice-label="@language.Label">
                            <option value="auto">Automatisch</option>
                            @if (storedVoice is not null)
                            {
                                <option value="@storedVoice" selected>@storedVoice</option>
                            }
                        </select>
                        <small data-reader-tts-voice-status="@language.Tag"></small>
                    </label>
                }

                @foreach (var item in new[]
                {
                    ("TtsRate", "ttsRate", "Tempo", "0.5", "2.5", tts.TtsRate),
                    ("TtsPitch", "ttsPitch", "Tonhöhe", "0.5", "2", tts.TtsPitch),
                    ("TtsVolume", "ttsVolume", "Lautstärke", "0", "1", tts.TtsVolume)
                })
                {
                    <label data-reader-tts-field="@item.Item2">
                        <span>
                            @item.Item3
                            <output data-reader-tts-output="@item.Item2"></output>
                        </span>
                        <input type="range"
                               name="@item.Item1"
                               min="@item.Item4"
                               max="@item.Item5"
                               step="0.05"
                               value="@item.Item6.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               data-reader-tts-setting="@item.Item2" />
                    </label>
                }

                <label class="reader-settings-check" data-reader-tts-field="ttsAutoContinueChapters">
                    <input type="checkbox"
                           name="TtsAutoContinueChapters"
                           value="true"
                           checked="@tts.TtsAutoContinueChapters"
                           data-reader-tts-setting="ttsAutoContinueChapters" />
                    <span>Am Kapitelende automatisch weiterlesen</span>
                </label>

                <p class="reader-tts-privacy">
                    Gerätestimmen: AniLingo sendet keinen Text an den Server.
                    Als „Online“ markierte Stimmen verarbeitet der Browser-Anbieter.
                </p>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AdditionalActionUrl)
             && !string.IsNullOrWhiteSpace(Model.AdditionalActionLabel))
        {
            <div class="reader-settings-extra-action">
                <a class="button" href="@Model.AdditionalActionUrl">
                    @Model.AdditionalActionLabel
                </a>
            </div>
        }
    </form>
</details>

@if (capabilities.SupportsTts)
{
    @* reader-tts.js moves the player bar out of the auto-hiding toolbar. *@
    <div class="reader-tts-bar" data-reader-tts-bar role="region" aria-label="Vorlesen" hidden>
        <span class="reader-tts-bar-status" data-reader-tts-bar-status aria-live="polite"></span>
        <button type="button" data-reader-tts-pause>Pause</button>
        <button type="button" data-reader-tts-stop>Stopp</button>
    </div>
}
