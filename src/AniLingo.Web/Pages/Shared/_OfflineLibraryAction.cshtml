@using AniLingo.Web.Data
@using AniLingo.Web.Features.Localization
@model AniLingo.Web.Features.OfflineLibrary.OfflineLibraryActionViewModel
@inject AppDbContext OfflineActionDb
@*
    Reusable "Offline speichern" action (#221 part 1/2). Include on a
    book/novel detail page with:

        <partial name="_OfflineLibraryAction" model="new OfflineLibraryActionViewModel(work.Id, title)" />

    Whole-book download only for now; per-chapter selection is a future
    extension of this same manager (window.AniLingoOfflineLibraryManager)
    rather than a second component. The offline-library-*.js scripts
    themselves are loaded once, globally, from _Layout.cshtml (#221 part 2)
    for every authenticated page, not from this partial.
*@
@{
    var ui = await UiRequestLocalization.GetBundleAsync(Context, OfflineActionDb);
}
<div class="offline-library-action" data-offline-save="@Model.WorkId">
    <button type="button" class="button" data-offline-save-button disabled>@ui["offlineLibrary.action.saveButton"]</button>
    <span class="muted" data-offline-save-status>@ui["offlineLibrary.action.checking"]</span>
</div>
