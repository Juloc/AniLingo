@using AniLingo.Web.Features.Localization
@using AniLingo.Web.Features.Tracking
@model ExternalProgressRemoteView
@*
    Remote half of the AniList progress card. Rendered by a page handler after
    first paint. The state comes from the same canonical resolver that sync uses.
    Ui defaults to English on pages not yet migrated to the per-request UI
    catalog (issue #185); a migrated caller passes its own Model.Ui.
*@
@{
    var ui = Model.Ui ?? UiTextBundle.English;
    var state = Model.State;
    var (label, css) = state.Kind switch
    {
        AniListExternalProgressStateKind.Synced => (ui["library.externalProgress.state.synced"], "status-ok"),
        AniListExternalProgressStateKind.LocalAhead => (ui["library.externalProgress.state.localAhead"], "status-warn"),
        AniListExternalProgressStateKind.AniListAhead => (ui["library.externalProgress.state.aniListAhead"], "status-warn"),
        AniListExternalProgressStateKind.NotOnList => (ui["library.externalProgress.state.notOnList"], "status-warn"),
        AniListExternalProgressStateKind.MappingNeedsReview => (ui["library.externalProgress.basis.needsReview"], "status-warn"),
        AniListExternalProgressStateKind.NotConnected => (ui["library.externalProgress.state.notConnected"], ""),
        AniListExternalProgressStateKind.NoLocalProgress => (ui["library.externalProgress.state.noLocalProgress"], ""),
        AniListExternalProgressStateKind.RemoteUnavailable => (ui["library.externalProgress.unavailable"], "status-error"),
        _ => (ui["library.externalProgress.state.syncBlocked"], "status-error")
    };
    var unit = Model.MediaKind is ExternalProgressMediaKind.Anime or ExternalProgressMediaKind.Episode
        ? ui["library.externalProgress.unit.episode"]
        : ui["library.externalProgress.unit.chapter"];
    var showVolumes = state.LocalVolumeProgress is not null && state.RemoteVolumeProgress is not null;
    var showLocalUnit = state.LocalProgress > 0 &&
        state.Kind is not (AniListExternalProgressStateKind.MappingNeedsReview
            or AniListExternalProgressStateKind.NoLocalProgress);
}
<div class="external-progress-state" data-external-progress-state="@state.Kind">
    <div class="external-progress-state-heading">
        <span class="status-pill @css">@label</span>
        @if (!string.IsNullOrWhiteSpace(state.MediaTitle) && state.MediaId is int mediaId)
        {
            <a class="muted"
               href="@ExternalProgressSummary.AniListMediaUrl(Model.MediaKind, mediaId)"
               target="_blank"
               rel="noopener noreferrer">@state.MediaTitle</a>
        }
    </div>

    @if (state.RemoteProgress is not null || showLocalUnit)
    {
        <dl class="external-progress-compare">
            @if (showLocalUnit)
            {
                <div>
                    <dt>AniLingo</dt>
                    <dd>
                        @unit @state.LocalProgress
                        @if (showVolumes)
                        {
                            <text> · @ui.Format("library.externalProgress.volume", ("number", state.LocalVolumeProgress))</text>
                        }
                    </dd>
                </div>
            }
            @if (state.RemoteProgress is int remote)
            {
                <div>
                    <dt>AniList</dt>
                    <dd>
                        @unit @remote
                        @if (showVolumes)
                        {
                            <text> · @ui.Format("library.externalProgress.volume", ("number", state.RemoteVolumeProgress))</text>
                        }
                        @if (!string.IsNullOrWhiteSpace(state.RemoteStatus))
                        {
                            <small>@state.RemoteStatus</small>
                        }
                    </dd>
                </div>
            }
        </dl>
    }

    @if (!state.IsSynced)
    {
        <p class="muted">@state.Message</p>
    }

    @if (state.CanSync && !string.IsNullOrWhiteSpace(Model.SyncHandler))
    {
        <form method="post" asp-page-handler="@Model.SyncHandler">
            <button class="button button-primary" type="submit">
                @ui.Format("library.externalProgress.syncButton", ("unit", unit), ("progress", state.LocalProgress))
            </button>
        </form>
    }
    else if (state.Kind == AniListExternalProgressStateKind.NotConnected)
    {
        <a class="button" href="/Settings/AniList">@ui["library.externalProgress.aniListSettings"]</a>
    }
</div>
