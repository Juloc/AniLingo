@page "/Novels/Work/{id:guid}"
@model AniLingo.Web.Pages.Novels.WorkModel
@{
    var detail = Model.Detail!;
    var work = detail.Work;
    var description = work.MetadataDescription ?? work.Description;
    var currentChapter = Model.Progress is null
        ? null
        : detail.Chapters.FirstOrDefault(x => x.Id == Model.Progress.ChapterId);
    ViewData["Title"] = work.MetadataTitle ?? work.Title;
}
@section Head {
    <link rel="stylesheet" href="~/css/novels.css" asp-append-version="true" />
}

<a class="back-link" href="/Novels">← Novels</a>

<header class="novel-work-header">
    <div class="novel-work-cover">
        @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
        {
            <img src="@work.CoverImageUrl" alt="" referrerpolicy="no-referrer" />
        }
        else
        {
            <span>文</span>
        }
    </div>

    <div class="novel-work-copy">
        <h1>@(work.MetadataTitle ?? work.Title)</h1>

        <div class="novel-meta">
            @if (!string.IsNullOrWhiteSpace(work.MetadataNativeTitle))
            {
                <span lang="ja">@work.MetadataNativeTitle</span>
            }
            @if (!string.IsNullOrWhiteSpace(work.Author))
            {
                <span>@work.Author</span>
            }
            @if (work.MetadataVolumeCount is int volumes)
            {
                <span>@volumes volumes</span>
            }
            <span>@(work.MetadataChapterCount ?? detail.Chapters.Count) chapters</span>
            @if (!string.IsNullOrWhiteSpace(work.MetadataStatus))
            {
                <span>@work.MetadataStatus.Replace("_", " ").ToLowerInvariant()</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="novel-work-description">@description</p>
        }

        <div class="novel-work-actions">
            @if (currentChapter is not null)
            {
                <a class="button button-primary novel-primary-action" href="/Novels/Read/@currentChapter.Id">
                    Continue ch. @currentChapter.Number
                </a>
                <span class="novel-progress-label">@(Model.Progress!.PositionPermille / 10)% through chapter</span>
            }
            else if (detail.Chapters.FirstOrDefault() is { } firstChapter)
            {
                <a class="button button-primary novel-primary-action" href="/Novels/Read/@firstChapter.Id">Start reading</a>
            }

            <a class="button"
               href="@Url.Page("/Settings/LearningScope", new {
                   mediaType = AniLingo.Web.Features.Learning.LearningMediaType.Novel,
                   scope = "work",
                   workKey = work.Id.ToString(),
                   label = work.MetadataTitle ?? work.Title,
                   returnUrl = $"/Novels/Work/{work.Id}"
               })">
                Language tools &amp; Learning
            </a>

            <a class="novel-source-link" href="@work.SourceUrl" target="_blank" rel="noreferrer">
                Source ↗
            </a>
        </div>
    </div>
</header>

@if (Model.AniListProgress is { } aniListProgress)
{
    <section class="novel-panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">My AniList</span>
                <h2>Reading progress</h2>
            </div>
            @if (aniListProgress.RemoteProgress is not null)
            {
                <span class="status-pill">
                    @aniListProgress.RemoteProgress chapters
                    @if (!string.IsNullOrWhiteSpace(aniListProgress.RemoteStatus))
                    {
                        <text> · @aniListProgress.RemoteStatus</text>
                    }
                </span>
            }
        </div>

        <p class="novel-muted">@aniListProgress.Message</p>

        @if (aniListProgress.CanSync)
        {
            <form method="post"
                  asp-page-handler="SyncAniListProgress"
                  asp-route-id="@work.Id">
                <button class="button button-primary" type="submit">
                    Sync chapter @aniListProgress.RequestedProgress
                </button>
            </form>
        }
        else if (aniListProgress.IsNoOp)
        {
            <span class="status-pill status-ok">Already up to date</span>
        }
    </section>
}

@if (Model.IsOwner)
{
    <details class="novel-panel novel-admin-panel">
        <summary><strong>Manage novel</strong></summary>

        <div class="novel-admin-content">
            <div class="novel-inline-form">
                <form method="post" asp-page-handler="Refresh" asp-route-id="@work.Id">
                    <button class="button" type="submit">Refresh chapters</button>
                </form>
                <form method="post" asp-page-handler="LoadAll" asp-route-id="@work.Id">
                    <button class="button" type="submit">Cache all Japanese text</button>
                </form>
            </div>

            <section class="novel-admin-section">
                <div class="panel-heading">
                    <h2>@(string.IsNullOrWhiteSpace(work.MetadataExternalId) ? "Match AniList novel" : "AniList novel")</h2>
                    @if (!string.IsNullOrWhiteSpace(work.MetadataExternalId))
                    {
                        <form method="post" asp-page-handler="RemoveMetadata" asp-route-id="@work.Id">
                            <button class="button" type="submit">Remove match</button>
                        </form>
                    }
                </div>

                <form method="get" class="novel-inline-form">
                    <input type="search" name="q" value="@Model.SearchQuery" placeholder="Search AniList light novel" />
                    <button class="button button-primary" type="submit">Search</button>
                </form>

                @if (Model.SearchResults.Count > 0)
                {
                    <div class="novel-results">
                        @foreach (var candidate in Model.SearchResults)
                        {
                            <article class="novel-result">
                                @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                                {
                                    <img src="@candidate.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <div></div>
                                }
                                <div>
                                    <strong>@candidate.PreferredTitle</strong>
                                    @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                                    {
                                        <div lang="ja">@candidate.NativeTitle</div>
                                    }
                                    <small class="novel-muted">
                                        @candidate.Format
                                        @if (candidate.VolumeCount is int candidateVolumes)
                                        {
                                            <text> · @candidateVolumes volumes</text>
                                        }
                                        @if (candidate.ChapterCount is int candidateChapters)
                                        {
                                            <text> · @candidateChapters chapters</text>
                                        }
                                    </small>
                                </div>
                                <form method="post" asp-page-handler="MatchMetadata" asp-route-id="@work.Id">
                                    <input type="hidden" name="provider" value="@candidate.Provider" />
                                    <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                    <button class="button" type="submit">Use</button>
                                </form>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="novel-admin-section">
                <div class="panel-heading">
                    <h2>Anime episode matching</h2>
                </div>

                @if (Model.AnimeChoices.Count == 0)
                {
                    <p class="novel-muted">Match a local anime to AniList first, then it becomes available here.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="AddMapping" asp-route-id="@work.Id" class="novel-mapping-form">
                        <select name="animeId" required>
                            @foreach (var anime in Model.AnimeChoices)
                            {
                                <option value="@anime.AnimeId">@anime.Title</option>
                            }
                        </select>
                        <input name="chapterStart" type="number" min="1" placeholder="Ch. from" required />
                        <input name="chapterEnd" type="number" min="1" placeholder="Ch. to" required />
                        <input name="seasonNumber" type="number" min="0" value="1" aria-label="Season" required />
                        <input name="episodeStart" type="number" min="1" placeholder="Ep. from" required />
                        <input name="episodeEnd" type="number" min="1" placeholder="Ep. to" required />
                        <input name="label" type="text" maxlength="200" placeholder="Optional note" />
                        <button class="button" type="submit">Add mapping</button>
                    </form>

                    <form method="post" asp-page-handler="SuggestMappings" asp-route-id="@work.Id" class="novel-inline-form">
                        <select name="animeId" required>
                            @foreach (var anime in Model.AnimeChoices)
                            {
                                <option value="@anime.AnimeId">@anime.Title</option>
                            }
                        </select>
                        <button class="button" type="submit">Suggest mappings with AI</button>
                    </form>
                }

                @if (detail.Mappings.Count > 0)
                {
                    <div class="novel-mapping-list">
                        @foreach (var mapping in detail.Mappings)
                        {
                            <div class="novel-mapping-row">
                                <div>
                                    <strong>Ch. @mapping.ChapterStart–@mapping.ChapterEnd → S@(mapping.SeasonNumber.ToString("00")) E@(mapping.EpisodeStart.ToString("00"))–E@(mapping.EpisodeEnd.ToString("00"))</strong>
                                    <div class="novel-muted">@mapping.AnimeProvider · @mapping.AnimeExternalId @mapping.Label</div>
                                </div>
                                <span class="novel-source-pill @(mapping.Source == "ai" ? "ai" : "")">@mapping.Source</span>
                                <form method="post" asp-page-handler="RemoveMapping" asp-route-id="@work.Id">
                                    <input type="hidden" name="mappingId" value="@mapping.Id" />
                                    <button class="button" type="submit">Remove</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </details>
}

<section class="novel-chapters-section">
    <div class="novel-chapters-heading">
        <h2>Chapters</h2>
    </div>

    <div class="novel-chapter-list">
        @foreach (var chapter in detail.Chapters)
        {
            var isCurrent = Model.Progress?.ChapterId == chapter.Id;
            var isEarlier = currentChapter is not null && chapter.Number < currentChapter.Number;
            <a class="novel-chapter-row @(isCurrent ? "current" : isEarlier ? "earlier" : "")" href="/Novels/Read/@chapter.Id">
                <span class="novel-chapter-number">@chapter.Number</span>
                <div class="novel-chapter-copy">
                    <strong lang="ja">@chapter.Title</strong>
                    <div class="novel-chapter-subline">
                        @if (isCurrent)
                        {
                            <span>@(Model.Progress!.PositionPermille / 10)% read</span>
                        }
                        else if (chapter.PublishedAt is DateTime published)
                        {
                            <span>@published.ToString("yyyy-MM-dd")</span>
                        }
                    </div>
                    @if (isCurrent)
                    {
                        <div class="novel-progress-track compact">
                            <span style="width:@(Model.Progress!.PositionPermille / 10)%"></span>
                        </div>
                    }
                </div>
                <div class="novel-chapter-badges">
                    @if (chapter.HasTranslation)
                    {
                        <span>DE</span>
                    }
                    @if (isCurrent)
                    {
                        <span class="current-dot" title="Current chapter"></span>
                    }
                </div>
            </a>
        }
    </div>
</section>
