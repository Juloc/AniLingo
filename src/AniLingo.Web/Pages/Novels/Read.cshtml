@page "/Novels/Read/{id:guid}"
@model AniLingo.Web.Pages.Novels.ReadModel
@{
    ViewData["Title"] = $"{Model.Chapter.Number}. {Model.Chapter.Title}";
    var hasTranslation = Model.Translation is not null;
    var initialBookmark = Model.JumpBookmark;
    var initialLanguage = initialBookmark?.Language
        ?? Model.Progress?.AnchorLanguage
        ?? (hasTranslation ? "de" : "ja");
    var initialParagraph = initialBookmark?.ParagraphIndex
        ?? Model.Progress?.AnchorParagraphIndex;
    var initialOffset = initialBookmark?.CharacterOffset
        ?? Model.Progress?.AnchorOffset
        ?? 0;
    var initialPermille = initialBookmark?.PositionPermille
        ?? Model.Progress?.PositionPermille
        ?? 0;
    var initialAnchorText = initialBookmark?.AnchorText
        ?? Model.Progress?.AnchorText;
    var currentBookmarks = Model.Bookmarks
        .Where(x => x.ChapterId == Model.Chapter.Id)
        .ToArray();
    var currentHighlights = Model.Highlights
        .Where(x => x.ChapterId == Model.Chapter.Id)
        .ToArray();
    var noteCount = Model.Bookmarks.Count + Model.Highlights.Count;
    var pairCount = Math.Max(Model.JapaneseParagraphs.Count, Model.GermanParagraphs.Count);
    var chapterDataJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Chapters.Select(chapter => new
        {
            id = chapter.Id,
            number = chapter.Number,
            title = chapter.Title,
            hasTranslation = chapter.HasTranslation,
            isCurrent = chapter.Id == Model.Chapter.Id,
            isEarlier = chapter.Number < Model.Chapter.Number
        }));
}
@section Head {
    <link rel="stylesheet" href="~/css/novels.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/novel-reader.js" asp-append-version="true"></script>
    <script src="~/js/reader-personalization.js" asp-append-version="true"></script>
}

<div class="novel-reading-progress" aria-hidden="true">
    <span data-reading-progress style="width:@(initialPermille / 10)%"></span>
    <div class="novel-mobile-bookmark-track"
         data-bookmark-track
         data-orientation="horizontal"></div>
</div>

<div class="novel-reader-shell"
     data-novel-reader
     data-work-id="@Model.Work.Id"
     data-chapter-id="@Model.Chapter.Id"
     data-view="@initialLanguage"
     data-has-translation="@hasTranslation.ToString().ToLowerInvariant()"
     data-progress-permille="@initialPermille"
     data-anchor-language="@initialLanguage"
     data-anchor-paragraph="@initialParagraph"
     data-anchor-offset="@initialOffset"
     data-anchor-text="@initialAnchorText"
     data-force-anchor="@((initialBookmark is not null).ToString().ToLowerInvariant())"
     data-reader-personalization
     data-reading-mode="@Model.ReaderSettings.ReadingMode"
     data-page-transition="@Model.ReaderSettings.PageTransition"
     data-chapter-style="@Model.ReaderSettings.ChapterStyle"
     data-paper-style="@Model.ReaderSettings.PaperStyle"
     data-genre-theme="@Model.ReaderSettings.ResolvedGenreTheme"
     data-genre-artwork="@Model.ReaderSettings.GenreArtworkEnabled.ToString().ToLowerInvariant()"
     data-two-page="@Model.ReaderSettings.TwoPageSpread.ToString().ToLowerInvariant()">

    <nav class="novel-reader-toolbar" aria-label="Reader controls">
        <div class="novel-toolbar-start">
            <button class="novel-icon-button"
                    type="button"
                    data-reader-chapters-toggle
                    aria-label="Kapitel öffnen"
                    title="Kapitel">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <div class="novel-toolbar-location">
                <strong>@Model.Chapter.Number · @Model.Chapter.Title</strong>
            </div>
        </div>

        <div class="novel-view-switch" role="group" aria-label="Lesesprache">
            <button type="button" data-reader-view="ja" aria-label="Japanisch">JP</button>
            <button type="button"
                    data-reader-view="de"
                    aria-label="Deutsch"
                    disabled="@(!hasTranslation)">DE</button>
            <button type="button"
                    data-reader-view="both"
                    aria-label="Japanisch und Deutsch"
                    disabled="@(!hasTranslation)">JP+DE</button>
        </div>

        <div class="novel-toolbar-end">
            <button class="novel-icon-button @(currentBookmarks.Length > 0 ? "has-bookmarks" : "")"
                    type="button"
                    data-reader-bookmark
                    aria-label="Lesezeichen setzen"
                    title="Lesezeichen setzen">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 4.5h10v15l-5-3-5 3z" />
                </svg>
                <span class="novel-bookmark-button-count"
                      data-current-bookmark-count
                      hidden="@(currentBookmarks.Length == 0)">@currentBookmarks.Length</span>
            </button>

            <button class="novel-icon-button"
                    type="button"
                    data-reader-notes-toggle
                    aria-label="Lesezeichen und Markierungen"
                    title="Lesezeichen und Markierungen">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 19l1-4L15.5 5.5a2.1 2.1 0 0 1 3 3L9 18zM13.5 7.5l3 3" />
                </svg>
                <span class="novel-toolbar-count"
                      data-reader-note-count
                      hidden="@(noteCount == 0)">@noteCount</span>
            </button>

            <button class="novel-icon-button"
                    type="button"
                    data-reader-autoscroll-toggle
                    aria-pressed="false"
                    aria-label="Auto-Scroll starten"
                    title="Auto-Scroll">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 7 8 5-8 5z" />
                </svg>
            </button>

            <details class="novel-reader-settings" data-reader-settings-panel>
                <summary class="novel-icon-button" aria-label="Leseeinstellungen" title="Leseeinstellungen">Aa</summary>
                <form class="novel-settings-popover"
                      method="post"
                      asp-page-handler="ReaderSettings"
                      asp-route-id="@Model.Chapter.Id"
                      data-reader-settings-form>
                    <div class="novel-settings-heading">
                        <strong>Leseeinstellungen</strong>
                        <span data-reader-override-state>
                            @(Model.ReaderSettings.HasBookOverride ? "Buch-Override" : "User-Standard")
                        </span>
                    </div>

                    <section class="novel-settings-group">
                        <label>
                            <span>Lesemodus</span>
                            <select name="ReadingMode" data-reader-setting data-setting-key="readingMode">
                                <option value="continuous">Scrollen</option>
                                <option value="paged">Seiten</option>
                            </select>
                        </label>
                        <label>
                            <span>Seitenanimation</span>
                            <select name="PageTransition" data-reader-setting data-setting-key="pageTransition">
                                <option value="curl">Umblättern</option>
                                <option value="slide">Schieben</option>
                                <option value="fade">Überblenden</option>
                                <option value="none">Keine</option>
                            </select>
                        </label>
                        <label class="novel-setting-check">
                            <input type="checkbox" name="TwoPageSpread" value="true"
                                   data-reader-setting data-setting-key="twoPageSpread" />
                            <span>Doppelseite auf breiten Displays</span>
                        </label>
                        <label>
                            <span>Auto-Scroll <output data-setting-output="autoScrollSpeed"></output></span>
                            <input type="range" name="AutoScrollSpeed" min="10" max="180" step="5"
                                   data-reader-setting data-setting-key="autoScrollSpeed" />
                        </label>
                    </section>

                    <section class="novel-settings-group">
                        <label>
                            <span>Schrift</span>
                            <select name="FontFamily" data-reader-setting data-setting-key="fontFamily">
                                <option value="literary-serif">Literary Serif</option>
                                <option value="book-serif">Book Serif</option>
                                <option value="system-serif">System Serif</option>
                                <option value="system-sans">System Sans</option>
                                <option value="atkinson">Atkinson Hyperlegible</option>
                                <option value="noto-serif-jp">Noto Serif JP</option>
                                <option value="noto-sans-jp">Noto Sans JP</option>
                                <option value="google:Literata">Literata</option>
                                <option value="google:Lora">Lora</option>
                                <option value="google:Merriweather">Merriweather</option>
                            </select>
                        </label>
                        <div class="novel-google-font">
                            <input type="search"
                                   data-reader-google-font
                                   list="reader-google-fonts"
                                   placeholder="Weitere Google Font" />
                            <datalist id="reader-google-fonts">
                                <option value="Source Serif 4"></option>
                                <option value="Crimson Pro"></option>
                                <option value="EB Garamond"></option>
                                <option value="Noto Serif JP"></option>
                                <option value="Noto Sans JP"></option>
                            </datalist>
                            <button type="button" class="button" data-reader-apply-google-font>Anwenden</button>
                        </div>
                        <label>
                            <span>Textgröße <output data-setting-output="fontSizeRem"></output></span>
                            <input type="range" name="FontSizeRem" min="0.85" max="1.8" step="0.05"
                                   data-reader-setting data-setting-key="fontSizeRem" />
                        </label>
                        <label>
                            <span>Zeilenhöhe <output data-setting-output="lineHeight"></output></span>
                            <input type="range" name="LineHeight" min="1.4" max="2.6" step="0.05"
                                   data-reader-setting data-setting-key="lineHeight" />
                        </label>
                        <label>
                            <span>Absatzabstand <output data-setting-output="paragraphSpacingEm"></output></span>
                            <input type="range" name="ParagraphSpacingEm" min="0" max="2.2" step="0.1"
                                   data-reader-setting data-setting-key="paragraphSpacingEm" />
                        </label>
                        <label>
                            <span>Textbreite <output data-setting-output="textWidthPx"></output></span>
                            <input type="range" name="TextWidthPx" min="520" max="1100" step="20"
                                   data-reader-setting data-setting-key="textWidthPx" />
                        </label>
                        <label>
                            <span>Ausrichtung</span>
                            <select name="TextAlignment" data-reader-setting data-setting-key="textAlignment">
                                <option value="start">Links</option>
                                <option value="justify">Blocksatz</option>
                            </select>
                        </label>
                    </section>

                    <section class="novel-settings-group">
                        <label>
                            <span>Kapitelstil</span>
                            <select name="ChapterStyle" data-reader-setting data-setting-key="chapterStyle">
                                <option value="classic">Classic</option>
                                <option value="modern">Modern</option>
                                <option value="light-novel">Light Novel</option>
                                <option value="minimal">Minimal</option>
                                <option value="decorative">Decorative</option>
                            </select>
                        </label>
                        <label>
                            <span>Papier</span>
                            <select name="PaperStyle" data-reader-setting data-setting-key="paperStyle">
                                <option value="white">White</option>
                                <option value="cream">Cream</option>
                                <option value="sepia">Sepia</option>
                                <option value="old-paper">Old Paper</option>
                                <option value="midnight">Midnight</option>
                                <option value="oled">OLED Black</option>
                            </select>
                        </label>
                        <label class="novel-setting-check">
                            <input type="checkbox" name="GenreArtworkEnabled" value="true"
                                   data-reader-setting data-setting-key="genreArtworkEnabled" />
                            <span>Genre-Hintergrund</span>
                        </label>
                        <label>
                            <span>Genre / Stimmung</span>
                            <select name="GenreTheme" data-reader-setting data-setting-key="genreTheme">
                                <option value="auto">Automatisch</option>
                                <option value="neutral">Neutral</option>
                                <option value="horror">Horror</option>
                                <option value="romance">Romance</option>
                                <option value="fantasy">Fantasy</option>
                                <option value="sci-fi">Sci-Fi</option>
                                <option value="mystery">Mystery</option>
                                <option value="adventure">Adventure</option>
                                <option value="slice-of-life">Slice of Life</option>
                                <option value="psychological">Psychological</option>
                                <option value="dark-fantasy">Dark Fantasy</option>
                                <option value="urban-fantasy">Urban Fantasy</option>
                                <option value="isekai">Isekai</option>
                                <option value="supernatural">Supernatural</option>
                                <option value="gothic">Gothic</option>
                            </select>
                        </label>
                        <label>
                            <span>Hintergrundstärke <output data-setting-output="backgroundIntensity"></output></span>
                            <input type="range" name="BackgroundIntensity" min="0" max="0.12" step="0.005"
                                   data-reader-setting data-setting-key="backgroundIntensity" />
                        </label>
                    </section>

                    <section class="novel-settings-group">
                        <label>
                            <span>Lesezeichen-Stil</span>
                            <select name="BookmarkStyle" data-reader-setting data-setting-key="bookmarkStyle">
                                <option value="fabric">Stoffband</option>
                                <option value="paper">Papier</option>
                                <option value="leather">Leder</option>
                                <option value="cord">Schnur</option>
                                <option value="minimal">Minimal</option>
                            </select>
                        </label>
                        <label>
                            <span>Lesezeichen-Farbe</span>
                            <input type="color" name="BookmarkColor"
                                   data-reader-setting data-setting-key="bookmarkColor" />
                        </label>
                    </section>

                    <div class="novel-settings-actions">
                        <button type="button" class="button" data-reader-save-defaults>
                            Als User-Standard speichern
                        </button>
                        <button type="button" class="button" data-reader-reset-book>
                            Buch zurücksetzen
                        </button>
                    </div>
                </form>
            </details>
        </div>
    </nav>

    <aside class="novel-reader-progress-rail" aria-label="Lesefortschritt">
        <div class="novel-reader-progress-track">
            <span class="novel-reader-progress-fill"
                  data-reader-rail-fill
                  style="height:@(initialPermille / 10)%"></span>
            <div data-bookmark-track data-orientation="vertical"></div>
        </div>
        <output data-reader-percent>@(initialPermille / 10)%</output>
    </aside>

    <header class="novel-reader-title">
        <span class="novel-chapter-label">Kapitel @Model.Chapter.Number</span>
        <h1>@Model.Chapter.Title</h1>
        @if (Model.AnimeMappings.Count > 0)
        {
            <div class="novel-reader-related">
                @foreach (var mapping in Model.AnimeMappings)
                {
                    <span>
                        Anime S@(mapping.SeasonNumber.ToString("00"))
                        E@(mapping.EpisodeStart.ToString("00"))@(mapping.EpisodeEnd == mapping.EpisodeStart ? "" : $"–E{mapping.EpisodeEnd:00}")
                    </span>
                }
            </div>
        }
    </header>

    <div class="novel-translation-slot" data-translation-slot>
        @if (hasTranslation)
        {
            <span class="novel-translation-state ready">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>
                Deutsch bereit
            </span>
        }
        else
        {
            <span class="novel-translation-state">Deutsch noch nicht vorbereitet</span>
            @if (Model.IsOwner)
            {
                <form method="post"
                      asp-page-handler="Translate"
                      asp-route-id="@Model.Chapter.Id"
                      data-translate-form>
                    <button class="novel-text-action" type="submit">Übersetzen</button>
                </form>
            }
        }
    </div>

    <main class="novel-reader-content" data-reader-content>
        @for (var index = 0; index < pairCount; index++)
        {
            <section class="novel-reader-segment" data-reader-segment="@index">
                @if (index < Model.JapaneseParagraphs.Count)
                {
                    <p class="novel-reader-paragraph ja"
                       lang="ja"
                       data-reader-paragraph
                       data-language="ja"
                       data-index="@index">@Model.JapaneseParagraphs[index]</p>
                }

                @if (index < Model.GermanParagraphs.Count)
                {
                    <p class="novel-reader-paragraph de"
                       lang="de"
                       data-reader-paragraph
                       data-language="de"
                       data-index="@index">@Model.GermanParagraphs[index]</p>
                }
            </section>
        }
    </main>

    <nav class="novel-page-controls"
         data-reader-page-controls
         hidden
         aria-label="Seitennavigation">
        <button type="button" class="novel-page-button" data-reader-page-prev aria-label="Vorherige Seite">←</button>
        <output data-reader-page-number>1 / 1</output>
        <button type="button" class="novel-page-button" data-reader-page-next aria-label="Nächste Seite">→</button>
    </nav>
    <div class="novel-page-bookmarks" data-page-bookmarks aria-label="Lesezeichen auf dieser Seite"></div>

    <footer class="novel-reader-footer">
        @if (Model.PreviousChapterId is Guid previousFooter)
        {
            <a href="/Novels/Read/@previousFooter">← Vorheriges Kapitel</a>
        }
        else
        {
            <span></span>
        }

        @if (Model.NextChapterId is Guid nextFooter)
        {
            <a href="/Novels/Read/@nextFooter">Nächstes Kapitel →</a>
        }
    </footer>

    <div class="novel-drawer-backdrop"
         data-chapter-drawer-backdrop
         hidden></div>
    <aside class="novel-chapter-drawer"
           data-chapter-drawer
           hidden
           aria-label="Kapitel">
        <header class="novel-drawer-header">
            <strong>@(Model.Work.MetadataTitle ?? Model.Work.Title)</strong>
            <button class="novel-icon-button"
                    type="button"
                    data-chapter-drawer-close
                    aria-label="Kapitel schließen">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </header>

        <div class="novel-drawer-current">
            @if (Model.PreviousChapterId is Guid drawerPrevious)
            {
                <a href="/Novels/Read/@drawerPrevious" aria-label="Vorheriges Kapitel">←</a>
            }
            else
            {
                <span aria-hidden="true"></span>
            }

            <strong>@Model.Chapter.Number. @Model.Chapter.Title</strong>

            @if (Model.NextChapterId is Guid drawerNext)
            {
                <a href="/Novels/Read/@drawerNext" aria-label="Nächstes Kapitel">→</a>
            }
            else
            {
                <span aria-hidden="true"></span>
            }
        </div>

        <label class="novel-chapter-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="6" />
                <path d="m16 16 4 4" />
            </svg>
            <input type="search"
                   data-chapter-filter
                   placeholder="Kapitel suchen"
                   autocomplete="off" />
        </label>

        <nav class="novel-drawer-list" data-chapter-list></nav>
        <script type="application/json" data-chapter-data>@Html.Raw(chapterDataJson)</script>
    </aside>

    <aside class="novel-reader-notes" data-reader-notes hidden aria-label="Lesezeichen und Markierungen">
        <div class="novel-notes-header">
            <strong>Lesezeichen & Markierungen</strong>
            <button class="novel-icon-button" type="button" data-reader-notes-close aria-label="Schließen">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </div>

        <section>
            <h3>Lesezeichen</h3>
            <p class="novel-muted @(Model.Bookmarks.Count == 0 ? "" : "is-hidden")" data-empty-bookmarks>Noch keine Lesezeichen.</p>
            <div class="novel-note-list" data-bookmark-list>
                @foreach (var bookmark in Model.Bookmarks.OrderByDescending(x => x.CreatedAt))
                {
                    <article class="novel-note-card"
                             data-bookmark-card
                             data-bookmark-id="@bookmark.Id"
                             data-bookmark-chapter-id="@bookmark.ChapterId"
                             data-bookmark-style="@(bookmark.Style ?? Model.ReaderSettings.BookmarkStyle)"
                             data-bookmark-color="@(bookmark.Color ?? Model.ReaderSettings.BookmarkColor)">
                        <a href="/Novels/Read/@bookmark.ChapterId?bookmark=@bookmark.Id">
                            <strong>@(bookmark.Label ?? $"Lesezeichen · {bookmark.PositionPermille / 10}%")</strong>
                            @if (!string.IsNullOrWhiteSpace(bookmark.AnchorText))
                            {
                                <span>@bookmark.AnchorText</span>
                            }
                        </a>
                        <div class="novel-bookmark-appearance">
                            <select data-bookmark-style-control
                                    aria-label="Lesezeichen-Stil">
                                <option value="fabric">Stoff</option>
                                <option value="paper">Papier</option>
                                <option value="leather">Leder</option>
                                <option value="cord">Schnur</option>
                                <option value="minimal">Minimal</option>
                            </select>
                            <input type="color"
                                   data-bookmark-color-control
                                   aria-label="Lesezeichen-Farbe"
                                   value="@(bookmark.Color ?? Model.ReaderSettings.BookmarkColor)" />
                        </div>
                        <form method="post"
                              asp-page-handler="RemoveBookmark"
                              asp-route-id="@Model.Chapter.Id"
                              data-remove-bookmark-form>
                            <input type="hidden" name="bookmarkId" value="@bookmark.Id" />
                            <button class="novel-note-remove" type="submit">Entfernen</button>
                        </form>
                    </article>
                }
            </div>
        </section>

        <section>
            <h3>Markierungen</h3>
            <p class="novel-muted @(Model.Highlights.Count == 0 ? "" : "is-hidden")" data-empty-highlights>Text auswählen, um ihn zu markieren.</p>
            <div class="novel-note-list" data-highlight-list>
                @foreach (var highlight in Model.Highlights.OrderByDescending(x => x.CreatedAt))
                {
                    <article class="novel-note-card" data-highlight-card data-highlight-id="@highlight.Id">
                        <a href="/Novels/Read/@highlight.ChapterId">
                            <strong>@highlight.Text</strong>
                            @if (!string.IsNullOrWhiteSpace(highlight.Note))
                            {
                                <span>@highlight.Note</span>
                            }
                        </a>
                        <form method="post"
                              asp-page-handler="RemoveHighlight"
                              asp-route-id="@Model.Chapter.Id"
                              data-remove-highlight-form>
                            <input type="hidden" name="highlightId" value="@highlight.Id" />
                            <button class="novel-note-remove" type="submit">Entfernen</button>
                        </form>
                    </article>
                }
            </div>
        </section>
    </aside>

    <div class="novel-selection-menu" data-selection-menu hidden>
        <button type="button" data-save-highlight>Markieren</button>
        <button type="button" data-save-highlight-note>Markieren + Notiz</button>
    </div>

    @foreach (var bookmark in currentBookmarks)
    {
        <span hidden
              data-saved-bookmark
              data-bookmark-id="@bookmark.Id"
              data-chapter-id="@bookmark.ChapterId"
              data-position="@bookmark.PositionPermille"
              data-language="@bookmark.Language"
              data-paragraph="@bookmark.ParagraphIndex"
              data-offset="@bookmark.CharacterOffset"
              data-anchor-text="@bookmark.AnchorText"
              data-bookmark-style="@(bookmark.Style ?? Model.ReaderSettings.BookmarkStyle)"
              data-bookmark-color="@(bookmark.Color ?? Model.ReaderSettings.BookmarkColor)"></span>
    }

    @foreach (var highlight in currentHighlights)
    {
        <span hidden
              data-saved-highlight
              data-highlight-id="@highlight.Id"
              data-language="@highlight.Language"
              data-paragraph="@highlight.ParagraphIndex"
              data-start="@highlight.StartOffset"
              data-end="@highlight.EndOffset"></span>
    }

    <form method="post"
          asp-page-handler="Progress"
          asp-route-id="@Model.Chapter.Id"
          data-progress-form
          hidden>
        <input type="hidden" name="positionPermille" value="@initialPermille" />
        <input type="hidden" name="anchorLanguage" value="@initialLanguage" />
        <input type="hidden" name="anchorParagraphIndex" value="@initialParagraph" />
        <input type="hidden" name="anchorOffset" value="@initialOffset" />
    </form>

    <form method="post"
          asp-page-handler="Bookmark"
          asp-route-id="@Model.Chapter.Id"
          data-bookmark-form
          hidden>
        <input type="hidden" name="positionPermille" value="@initialPermille" />
        <input type="hidden" name="language" value="@initialLanguage" />
        <input type="hidden" name="paragraphIndex" value="@initialParagraph" />
        <input type="hidden" name="characterOffset" value="@initialOffset" />
        <input type="hidden" name="label" value="" />
        <input type="hidden" name="style" value="@Model.ReaderSettings.BookmarkStyle" />
        <input type="hidden" name="color" value="@Model.ReaderSettings.BookmarkColor" />
    </form>

    <form method="post"
          asp-page-handler="Highlight"
          asp-route-id="@Model.Chapter.Id"
          data-highlight-form
          hidden>
        <input type="hidden" name="language" value="ja" />
        <input type="hidden" name="paragraphIndex" value="0" />
        <input type="hidden" name="startOffset" value="0" />
        <input type="hidden" name="endOffset" value="0" />
        <input type="hidden" name="note" value="" />
    </form>

    <form method="post"
          asp-page-handler="RemoveBookmark"
          asp-route-id="@Model.Chapter.Id"
          data-remove-bookmark-endpoint
          hidden>
        <input type="hidden" name="bookmarkId" value="" />
    </form>

    <form method="post"
          asp-page-handler="RemoveHighlight"
          asp-route-id="@Model.Chapter.Id"
          data-remove-highlight-endpoint
          hidden>
        <input type="hidden" name="highlightId" value="" />
    </form>

    <form method="post"
          asp-page-handler="ResetReaderSettings"
          asp-route-id="@Model.Chapter.Id"
          data-reader-reset-form
          hidden></form>

    <form method="post"
          asp-page-handler="BookmarkAppearance"
          asp-route-id="@Model.Chapter.Id"
          data-bookmark-appearance-endpoint
          hidden>
        <input type="hidden" name="bookmarkId" value="" />
        <input type="hidden" name="style" value="" />
        <input type="hidden" name="color" value="" />
    </form>

    <script type="application/json" data-reader-settings-json>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ReaderSettings,
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>

    <div class="novel-reader-toast" data-reader-toast hidden role="status" aria-live="polite"></div>
</div>
