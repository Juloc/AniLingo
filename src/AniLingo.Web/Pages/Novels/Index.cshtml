@page "/Novels"
@model AniLingo.Web.Pages.Novels.IndexModel
@{
    ViewData["Title"] = "Novels";
}
@section Head {
    <link rel="stylesheet" href="~/css/novels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
}

<header class="novel-library-header">
    <div class="novel-library-title-block">
        <div class="reading-type-switch" aria-label="Reading type">
            <a class="active" href="/Novels">Novels</a>
            <a href="/Manga">Manga</a>
        </div>
        <h1>Light novels</h1>
    </div>

    @if (Model.IsOwner)
    {
        <details class="novel-import-popover">
            <summary class="novel-add-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                Add novel
            </summary>
            <form method="post" asp-page-handler="Import" class="novel-import-form">
                <label for="sourceUrl">Narou / Ncode URL</label>
                <input id="sourceUrl"
                       type="url"
                       name="sourceUrl"
                       required
                       inputmode="url"
                       placeholder="https://ncode.syosetu.com/n9669bk/" />
                <button class="button button-primary" type="submit">Import</button>
            </form>
        </details>
    }
</header>

@if (Model.ContinueReading.Count > 0)
{
    <section class="novel-shelf" aria-labelledby="continue-reading-heading">
        <div class="novel-section-heading">
            <h2 id="continue-reading-heading">Continue reading</h2>
        </div>

        <div class="novel-continue-list">
            @foreach (var work in Model.ContinueReading)
            {
                <a class="novel-continue-row" href="/Novels/Read/@work.CurrentChapterId">
                    <div class="novel-continue-cover">
                        @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
                        {
                            <img src="@work.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span>文</span>
                        }
                    </div>
                    <div class="novel-continue-copy">
                        <strong>@work.Title</strong>
                        <span>Ch. @work.CurrentChapterNumber · @work.CurrentChapterTitle</span>
                        <div class="novel-progress-track" aria-label="Chapter progress">
                            <span style="width:@(work.ProgressPermille / 10)%"></span>
                        </div>
                    </div>
                    <span class="novel-continue-percent">@(work.ProgressPermille / 10)%</span>
                    <svg class="novel-row-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </a>
            }
        </div>
    </section>
}

<section class="novel-shelf" aria-labelledby="library-heading">
    <div class="novel-section-heading">
        <h2 id="library-heading">Library</h2>
    </div>

    @if (Model.Works.Count == 0)
    {
        <div class="novel-empty">No novels yet.</div>
    }
    else
    {
        <div class="novel-library-grid">
            @foreach (var work in Model.Works)
            {
                <article class="novel-library-card">
                    <a class="novel-library-cover" href="/Novels/Work/@work.Id" aria-label="@work.Title">
                        @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
                        {
                            <img src="@work.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span>文</span>
                        }

                        @if (work.HasProgress)
                        {
                            <div class="novel-cover-progress">
                                <span style="width:@(work.ProgressPermille / 10)%"></span>
                            </div>
                        }
                    </a>

                    <div class="novel-library-copy">
                        <a href="/Novels/Work/@work.Id" class="novel-library-title">@work.Title</a>

                        <div class="novel-library-meta">
                            @if (work.MetadataVolumeCount is int volumes)
                            {
                                <span>@volumes vol.</span>
                            }
                            <span>@work.ChapterCount ch.</span>
                            @if (!string.IsNullOrWhiteSpace(work.MetadataStatus))
                            {
                                <span>@work.MetadataStatus.Replace("_", " ").ToLowerInvariant()</span>
                            }
                        </div>

                        @if (work.HasProgress)
                        {
                            <a class="novel-resume-link" href="/Novels/Read/@work.CurrentChapterId">
                                Continue ch. @work.CurrentChapterNumber
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
