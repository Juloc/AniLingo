@page "/Novels"
@model AniLingo.Web.Pages.Novels.IndexModel
@{
    ViewData["Title"] = "Novels";
}
@section Head {
    <link rel="stylesheet" href="~/css/novels.css" asp-append-version="true" />
}

<section class="novel-page-header">
    <div>
        <span class="eyebrow">Japanese reading</span>
        <h1>Novels</h1>
        <p>Import a supported Japanese web novel once, then read chapters directly in AniLingo.</p>
    </div>
</section>

<section class="novel-import-card">
    <div>
        <strong>Import from Narou</strong>
        <span>Paste a ncode.syosetu.com work or chapter URL. The table of contents is stored immediately; chapter text loads when you open it.</span>
    </div>
    <form method="post" asp-page-handler="Import" class="novel-import-form">
        <input type="url"
               name="sourceUrl"
               required
               inputmode="url"
               placeholder="https://ncode.syosetu.com/n9669bk/" />
        <button class="button button-primary" type="submit">Import</button>
    </form>
</section>

@if (Model.Works.Count == 0)
{
    <section class="novel-empty">
        <strong>No novels imported yet.</strong>
        <span>Narou/Ncode is supported first.</span>
    </section>
}
else
{
    <section class="novel-grid">
        @foreach (var work in Model.Works)
        {
            <a class="novel-card" href="/Novels/Work/@work.Id">
                <div class="novel-cover">
                    @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
                    {
                        <img src="@work.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <span>文</span>
                    }
                </div>
                <div class="novel-card-copy">
                    <strong>@work.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(work.Author))
                    {
                        <span>@work.Author</span>
                    }
                    <small>
                        @work.ChapterCount chapters · @work.LoadedChapterCount loaded · @work.TranslatedChapterCount translated
                    </small>
                </div>
            </a>
        }
    </section>
}
