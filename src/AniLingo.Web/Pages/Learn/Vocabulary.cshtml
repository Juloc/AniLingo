@page
@using AniLingo.Web.Features.Learning
@model AniLingo.Web.Pages.Learn.VocabularyModel
@{
    ViewData["Title"] = Model.Ui["learn.vocabulary.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/learn.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Learn">← @Model.Ui["learn.title"]</a>
        <span class="eyebrow">@Model.Ui["learn.hub.vocabulary.title"]</span>
        <h1>@Model.Ui["learn.vocabulary.title"]</h1>
        <p>@Model.Ui["learn.vocabulary.subtitle"]</p>
    </div>
</header>

<section class="panel learn-lifecycle" aria-label="@Model.Ui["learn.vocabulary.lifecycle.aria"]">
    <ol class="learn-lifecycle-steps">
        <li><span class="status-pill">@Model.Ui["learn.vocabulary.state.untracked"]</span></li>
        <li><span class="status-pill">@Model.Ui["learn.vocabulary.state.saved"]</span></li>
        @if (Model.ShowReviewActions)
        {
            <li><span class="status-pill status-warn">@Model.Ui["learn.vocabulary.state.learning"]</span></li>
        }
        <li><span class="status-pill status-ok">@Model.Ui["learn.vocabulary.state.known"]</span></li>
    </ol>
    <p class="muted">
        @(Model.ShowReviewActions
            ? Model.Ui["learn.vocabulary.lifecycle.body"]
            : Model.Ui["learn.vocabulary.lifecycle.noReviews"])
    </p>
</section>

<section class="panel">
    <form method="get" class="form-stack learn-filter">
        <label>
            <span>@Model.Ui["learn.vocabulary.search"]</span>
            <input name="search"
                   value="@Model.Search"
                   placeholder="@Model.Ui["learn.vocabulary.searchPlaceholder"]" />
        </label>
        <label>
            <span>@Model.Ui["learn.vocabulary.state"]</span>
            <select name="state">
                <option value="all" selected="@(Model.StateFilter == "all" ? "selected" : null)">
                    @Model.Ui["learn.vocabulary.filter.all"]
                </option>
                @foreach (var state in Enum.GetValues<UserTermState>())
                {
                    if (!Model.ShowReviewActions
                        && state is UserTermState.Learning or UserTermState.Suspended)
                    {
                        continue;
                    }

                    var key = state.ToString().ToLowerInvariant();
                    <option value="@key"
                            selected="@(Model.StateFilter == key ? "selected" : null)">
                        @Model.Ui[VocabularyModel.StateKey(state)]
                    </option>
                }
            </select>
        </label>
        @if (Model.Courses.Count > 1)
        {
            <label>
                <span>@Model.Ui["learn.vocabulary.course"]</span>
                <select name="course">
                    <option value="" selected="@(Model.CourseFilter is null ? "selected" : null)">@Model.Ui["learn.vocabulary.allCourses"]</option>
                    @foreach (var course in Model.Courses)
                    {
                        <option value="@course.Id"
                                selected="@(Model.CourseFilter == course.Id ? "selected" : null)">
                            @course.Name
                        </option>
                    }
                </select>
            </label>
        }
        <button class="button" type="submit">@Model.Ui["common.search"]</button>
    </form>
</section>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <h3>@Model.Ui["learn.vocabulary.empty.title"]</h3>
        <p>@Model.Ui["learn.vocabulary.empty.body"]</p>
    </div>
}
else
{
    <div class="term-table learn-vocabulary">
        <div class="term-table-head">
            <span>@Model.Ui["learn.vocabulary.term"]</span>
            <span>@Model.Ui["learn.vocabulary.course"]</span>
            <span>@Model.Ui["learn.vocabulary.state"]</span>
        </div>

        @foreach (var item in Model.Items)
        {
            var pillClass = item.Due
                ? "status-warn"
                : item.State == UserTermState.Known
                    ? "status-ok"
                    : "";
            <div class="term-row">
                <div class="term-word">
                    <strong lang="@item.Language">@item.Text</strong>
                    @if (!string.IsNullOrWhiteSpace(item.Reading))
                    {
                        <span>@item.Reading</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Meaning))
                    {
                        <small>@item.Meaning</small>
                    }
                </div>

                <span class="occurrence">@item.CourseName</span>

                <div class="term-actions">
                    <span class="status-pill @pillClass">
                        @Model.Ui[VocabularyModel.StateKey(item.State)]@(item.Due ? " · " + Model.Ui["learn.vocabulary.due"] : "")
                    </span>
                    @foreach (var card in item.OtherCards)
                    {
                        <span class="status-pill">@Model.ModeLabel(card.Mode) · @Model.Ui[VocabularyModel.StateKey(card.State)]</span>
                    }

                    @if (item.State != UserTermState.Saved)
                    {
                        <form method="post" asp-page-handler="Save">
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <input type="hidden" name="unitId" value="@item.UnitId" />
                            <button class="chip" type="submit">@Model.Ui["learning.saveWord"]</button>
                        </form>
                    }
                    @if (Model.ShowReviewActions && item.State != UserTermState.Learning)
                    {
                        <form method="post" asp-page-handler="Learn">
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <input type="hidden" name="unitId" value="@item.UnitId" />
                            <button class="chip" type="submit">
                                @(item.State == UserTermState.Suspended
                                    ? Model.Ui["learn.vocabulary.resume"]
                                    : Model.Ui["learn.vocabulary.startLearning"])
                            </button>
                        </form>
                    }
                    @if (item.State != UserTermState.Known)
                    {
                        <form method="post" asp-page-handler="Known">
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <input type="hidden" name="unitId" value="@item.UnitId" />
                            <button class="chip" type="submit">@Model.Ui["learning.markKnown"]</button>
                        </form>
                    }
                    @if (Model.ShowReviewActions && item.State == UserTermState.Learning)
                    {
                        <form method="post" asp-page-handler="Suspend">
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <input type="hidden" name="unitId" value="@item.UnitId" />
                            <button class="chip" type="submit">@Model.Ui["learn.vocabulary.suspend"]</button>
                        </form>
                    }
                    @if (item.State != UserTermState.Ignored)
                    {
                        <form method="post" asp-page-handler="Ignore">
                            <input type="hidden" name="courseId" value="@item.CourseId" />
                            <input type="hidden" name="unitId" value="@item.UnitId" />
                            <button class="chip" type="submit">@Model.Ui["learning.ignoreWord"]</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
