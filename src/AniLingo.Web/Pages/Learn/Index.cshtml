@page
@using AniLingo.Web.Features.Learning
@model AniLingo.Web.Pages.Learn.IndexModel
@{
    ViewData["Title"] = Model.Ui["learn.title"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@Model.Ui["learn.hub.eyebrow"]</span>
        <h1>@Model.Ui["learn.title"]</h1>
        <p>@Model.Ui["learn.hub.subtitle"]</p>
    </div>
    @if (Model.LearningEnabled)
    {
        <span class="status-pill">@Model.Mode</span>
    }
</header>

@if (!Model.LearningEnabled)
{
    <div class="empty-state centered">
        <h3>@Model.Ui["learn.hub.off.title"]</h3>
        <p>@Model.Ui["learn.hub.off.body"]</p>
        <a class="button" href="/Settings/Learning">@Model.Ui["learn.hub.settings"]</a>
    </div>
}
else
{
    <section class="metric-grid">
        <partial name="_MetricCard"
                 model='new MetricCardModel(
                     Model.Ui["learn.hub.metric.due"],
                     Model.DueReviews.ToString(),
                     Model.Ui["learn.hub.metric.dueHint"])' />
        <partial name="_MetricCard"
                 model='new MetricCardModel(
                     Model.Ui["learn.hub.metric.saved"],
                     Model.SavedTerms.ToString(),
                     Model.Ui["learn.hub.metric.savedHint"])' />
        <partial name="_MetricCard"
                 model='new MetricCardModel(
                     Model.Ui["learn.hub.metric.learning"],
                     Model.LearningTerms.ToString(),
                     Model.Ui["learn.hub.metric.learningHint"])' />
    </section>

    <div class="settings-grid">
        @if (Model.ShowReviews)
        {
            <a class="panel" href="/Learn/Review">
                <div class="panel-heading">
                    <h2>@Model.Ui["learn.hub.reviews.title"]</h2>
                    <span>@Model.DueReviews</span>
                </div>
                <p class="muted">@Model.Ui["learn.hub.reviews.body"]</p>
            </a>
        }

        @if (Model.ShowVocabulary)
        {
            <a class="panel" href="/Learn/Vocabulary">
                <div class="panel-heading">
                    <h2>@Model.Ui["learn.hub.vocabulary.title"]</h2>
                    <span>@(Model.SavedTerms + Model.LearningTerms + Model.KnownTerms)</span>
                </div>
                <p class="muted">@Model.Ui["learn.hub.vocabulary.body"]</p>
            </a>
        }

        @if (Model.ShowSentences)
        {
            <a class="panel" href="/Learn/Sentences">
                <div class="panel-heading">
                    <h2>@Model.Ui["learn.hub.sentences.title"]</h2>
                </div>
                <p class="muted">@Model.Ui["learn.hub.sentences.body"]</p>
            </a>
        }

        @if (Model.ShowKana)
        {
            <a class="panel" href="/Learn/Kana">
                <div class="panel-heading">
                    <h2>@Model.Ui["learn.hub.kana.title"]</h2>
                </div>
                <p class="muted">@Model.Ui["learn.hub.kana.body"]</p>
            </a>
        }

        @if (Model.ShowProgress)
        {
            <a class="panel" href="/Learn/Progress">
                <div class="panel-heading">
                    <h2>@Model.Ui["learn.hub.progress.title"]</h2>
                </div>
                <p class="muted">@Model.Ui["learn.hub.progress.body"]</p>
            </a>
        }
    </div>

    @if (!Model.ShowReviews
         && !Model.ShowVocabulary
         && !Model.ShowSentences
         && !Model.ShowKana
         && !Model.ShowProgress)
    {
        <div class="empty-state">
            <h3>@Model.Ui["learn.hub.scoped.title"]</h3>
            <p>@Model.Ui["learn.hub.scoped.body"]</p>
            <a class="button" href="/Settings/Learning">@Model.Ui["learn.hub.settings"]</a>
        </div>
    }
}
