@page
@model AniLingo.Web.Pages.Learn.IndexModel
@using AniLingo.Web.Features.Ai
@using AniLingo.Web.Features.Learning
@{
    ViewData["Title"] = "Learn";
    var current = Model.Due.FirstOrDefault();
}

<header class="page-header">
    <div>
        <span class="eyebrow">Review</span>
        <h1>Learn</h1>
        <p>@Model.Due.Count due now.</p>
    </div>
</header>

@if (current is null)
{
    <div class="empty-state centered">
        <div class="empty-symbol">✓</div>
        <h3>Nothing due</h3>
        <p>Add terms from an episode or return later.</p>
        <a class="button" href="/Library">Open library</a>
    </div>
}
else
{
    <section class="review-stage">
        <div class="review-card">
            <span class="review-counter">@Model.Due.Count due</span>
            <div class="review-term" lang="ja">@current.Canonical</div>
            @if (!string.IsNullOrWhiteSpace(current.Reading))
            {
                <div class="review-reading">@current.Reading</div>
            }
            <div class="review-answer">
                @(string.IsNullOrWhiteSpace(current.Meaning)
                    ? "No local dictionary meaning available."
                    : current.Meaning)
            </div>
        </div>

        @if (Model.Context is { } context)
        {
            <div class="panel">
                <span class="eyebrow">Anime context</span>
                <p lang="ja">@context.Sentence</p>

                @if (Model.LocalHints.Count > 0)
                {
                    <p class="muted">
                        Local: @string.Join(" · ", Model.LocalHints)
                    </p>
                }

                @if (Model.AiExplanation is { } explanation)
                {
                    <div>
                        <strong>@explanation.Translation</strong>

                        @if (explanation.Grammar.Count > 0)
                        {
                            <p class="muted">Grammar: @string.Join(" · ", explanation.Grammar)</p>
                        }

                        @if (explanation.Colloquial.Count > 0)
                        {
                            <p class="muted">Speech: @string.Join(" · ", explanation.Colloquial)</p>
                        }
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="Explain">
                        <input type="hidden" name="termId" value="@current.TermId" />
                        <button class="button" type="submit">Explain with AI</button>
                    </form>
                }

                <a class="text-link" href="/Library/Episode/@context.EpisodeId">
                    @context.AnimeTitle · S@(context.SeasonNumber.ToString("00")) E@(context.EpisodeNumber.ToString("00"))
                    · @context.EpisodeTitle · @context.TimestampLabel
                </a>
            </div>
        }

        <form method="post" asp-page-handler="Review" class="review-actions">
            <input type="hidden" name="termId" value="@current.TermId" />
            <button name="rating" value="Again" class="review-button">
                <strong>Again</strong><span>@Model.Interval(ReviewRating.Again)</span>
            </button>
            <button name="rating" value="Hard" class="review-button">
                <strong>Hard</strong><span>@Model.Interval(ReviewRating.Hard)</span>
            </button>
            <button name="rating" value="Good" class="review-button primary">
                <strong>Good</strong><span>@Model.Interval(ReviewRating.Good)</span>
            </button>
            <button name="rating" value="Easy" class="review-button">
                <strong>Easy</strong><span>@Model.Interval(ReviewRating.Easy)</span>
            </button>
        </form>
    </section>
}
