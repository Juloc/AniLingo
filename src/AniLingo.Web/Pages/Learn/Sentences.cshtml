@page
@model AniLingo.Web.Pages.Learn.SentencesModel
@{
    ViewData["Title"] = Model.Ui["learn.sentences.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/kana.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Learn">← @Model.Ui["learn.title"]</a>
        <span class="eyebrow">@Model.Ui["learn.hub.sentences.title"]</span>
        <h1>@Model.Ui["learn.sentences.title"]</h1>
        <p>@Model.Ui["learn.sentences.subtitle"]</p>
    </div>
</header>

@if (Model.Sentences.Count == 0)
{
    <div class="empty-state">
        <h3>@Model.Ui["learn.sentences.empty.title"]</h3>
        <p>@Model.Ui["learn.sentences.empty.body"]</p>
    </div>
}
else
{
    <div class="sentence-list">
        @foreach (var sentence in Model.Sentences)
        {
            <article class="sentence-card">
                <div class="sentence-meta">
                    <span>
                        @sentence.AnimeTitle ·
                        S@(sentence.SeasonNumber.ToString("00"))
                        E@(sentence.EpisodeNumber.ToString("00")) ·
                        @sentence.TimestampLabel
                    </span>
                    <a class="text-link"
                       href="@($"/Library/Episode/{sentence.EpisodeId}?at={sentence.CueStartMs}")">
                        @Model.Ui["learn.sentences.openScene"]
                    </a>
                </div>

                @if (!string.IsNullOrWhiteSpace(sentence.Cloze))
                {
                    <div class="sentence-cloze" lang="ja">@sentence.Cloze</div>
                    <button class="button sentence-reveal"
                            type="button"
                            data-reveal-sentence>
                        @Model.Ui["learn.sentences.showAnswer"]
                    </button>
                    <div class="sentence-answer" hidden>
                        <strong lang="ja">@sentence.Text</strong>
                        @if (!string.IsNullOrWhiteSpace(sentence.TargetCanonical))
                        {
                            <span class="muted">
                                @sentence.TargetCanonical ·
                                @sentence.TargetReading ·
                                @sentence.TargetMeaning
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="sentence-full" lang="ja">@sentence.Text</div>
                }

                <div class="sentence-audio-row">
                    <button class="button"
                            type="button"
                            data-speak="@sentence.Text"
                            data-rate="1">
                        🔊 @Model.Ui["learn.sentences.audioNormal"]
                    </button>
                    <button class="button"
                            type="button"
                            data-speak="@sentence.Text"
                            data-rate="0.72">
                        🐢 @Model.Ui["learn.sentences.audioSlow"]
                    </button>
                </div>

                <div class="sentence-tokens" lang="ja">
                    @foreach (var token in sentence.Tokens)
                    {
                        if (token.Interactive)
                        {
                            <button class="sentence-token @(token.IsTarget ? "target" : "")"
                                    type="button"
                                    data-token-surface="@token.Surface"
                                    data-token-reading="@token.Reading"
                                    data-token-meaning="@token.Meaning">
                                @token.Surface
                            </button>
                        }
                        else
                        {
                            <span>@token.Surface</span>
                        }
                    }
                </div>

                <div class="token-details muted" data-token-details>
                    @Model.Ui["learn.sentences.tapWord"]
                </div>
            </article>
        }
    </div>
}

@section Scripts {
    <script src="~/js/kana.js" asp-append-version="true"></script>
}
