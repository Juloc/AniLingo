@page
@using AniLingo.Web.Features.Learning.LanguageAssistance
@using AniLingo.Web.Features.Learning.Sentences
@model AniLingo.Web.Pages.Learn.SentencesModel
@{
    ViewData["Title"] = Model.Ui["learn.sentences.title"];
    var modes = new[]
    {
        (Mode: SentencePracticeMode.Cloze, Label: Model.Ui["learn.sentences.mode.cloze"]),
        (Mode: SentencePracticeMode.Comprehension, Label: Model.Ui["learn.sentences.mode.comprehension"]),
        (Mode: SentencePracticeMode.Listening, Label: Model.Ui["learn.sentences.mode.listening"])
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/learn.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Learn">← @Model.Ui["learn.title"]</a>
        <span class="eyebrow">@Model.Ui["learn.hub.sentences.title"]</span>
        <h1>@Model.Ui["learn.sentences.title"]</h1>
        <p>@Model.Ui["learn.sentences.subtitle"]</p>
    </div>
</header>

<nav class="sentence-modes" aria-label="@Model.Ui["learn.sentences.modesAria"]">
    @foreach (var mode in modes)
    {
        var current = mode.Mode == Model.Mode;
        <a class="button @(current ? "button-primary" : "")"
           href="/Learn/Sentences?mode=@SentencePracticeModes.Key(mode.Mode)"
           aria-current="@(current ? "page" : null)">@mode.Label</a>
    }
</nav>

@if (Model.Sentences.Count == 0)
{
    <div class="empty-state">
        <h3>@Model.Ui["learn.sentences.empty.title"]</h3>
        <p>@Model.Ui["learn.sentences.empty.body"]</p>
        @if (Model.Mode != SentencePracticeMode.Comprehension)
        {
            <p>
                <a class="text-link" href="/Learn/Sentences?mode=comprehension">@Model.Ui["learn.sentences.empty.otherMode"]</a>
            </p>
        }
    </div>
}
else
{
    <div class="sentence-list">
        @foreach (var sentence in Model.Sentences)
        {
            var source = sentence.Source;
            var isAnime = source.Type == LanguageSourceType.Anime;
            <article class="sentence-card"
                     data-language-context
                     data-source-type="@LanguageSourceAnchor.SourceTypeKey(source.Type)"
                     data-content-key="@source.ContentId"
                     data-language="@sentence.Language"
                     data-sentence="@sentence.Text"
                     data-cue-start-ms="@source.Position.CueStartMs"
                     data-paragraph="@source.Position.Paragraph"
                     data-page="@source.Position.Page"
                     data-region="@source.Position.Region">
                <div class="sentence-meta">
                    <span>
                        @source.Title
                        @if (!string.IsNullOrWhiteSpace(source.Location))
                        {
                            <text> · @source.Location</text>
                        }
                    </span>
                    <a class="text-link" href="@source.Url">
                        @(isAnime ? Model.Ui["learn.sentences.openScene"] : Model.Ui["learn.sentences.openSource"])
                    </a>
                </div>

                @if (Model.Mode == SentencePracticeMode.Cloze)
                {
                    <div class="sentence-cloze" lang="@sentence.Language">@sentence.Cloze</div>
                }
                else if (Model.Mode == SentencePracticeMode.Comprehension)
                {
                    RenderSentence(sentence);
                }

                <div class="sentence-audio-row">
                    <button class="button"
                            type="button"
                            data-language-speak="@sentence.Text"
                            data-speak-language="@sentence.Language"
                            data-speak-rate="1">
                        @Model.Ui["learn.sentences.audioNormal"]
                    </button>
                    <button class="button"
                            type="button"
                            data-language-speak="@sentence.Text"
                            data-speak-language="@sentence.Language"
                            data-speak-rate="0.72">
                        @Model.Ui["learn.sentences.audioSlow"]
                    </button>
                </div>

                <details class="sentence-reveal">
                    <summary>
                        @(Model.Mode switch
                        {
                            SentencePracticeMode.Comprehension => Model.Ui["learn.sentences.showMeaning"],
                            SentencePracticeMode.Listening => Model.Ui["learn.sentences.showSentence"],
                            _ => Model.Ui["learn.sentences.showAnswer"]
                        })
                    </summary>
                    <div class="sentence-answer">
                        @if (Model.Mode != SentencePracticeMode.Comprehension)
                        {
                            RenderSentence(sentence);
                        }
                        @if (!string.IsNullOrWhiteSpace(sentence.TargetCanonical))
                        {
                            <span class="muted">
                                <span lang="@sentence.Language">@sentence.TargetCanonical</span>
                                @if (!string.IsNullOrWhiteSpace(sentence.TargetReading))
                                {
                                    <text> · </text><span lang="@sentence.Language">@sentence.TargetReading</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(sentence.TargetMeaning))
                                {
                                    <text> · @sentence.TargetMeaning</text>
                                }
                            </span>
                        }
                        @if (sentence.Explanation is { } explanation)
                        {
                            <div class="sentence-explanation">
                                <div><strong>@Model.Ui["languageInspector.translation"]</strong> @explanation.Translation</div>
                                @if (explanation.Grammar.Count > 0)
                                {
                                    <div>
                                        <strong>@Model.Ui["languageInspector.grammar"]</strong>
                                        <ul>@foreach (var note in explanation.Grammar) { <li>@note</li> }</ul>
                                    </div>
                                }
                                @if (explanation.Colloquial.Count > 0)
                                {
                                    <div>
                                        <strong>@Model.Ui["languageInspector.colloquial"]</strong>
                                        <ul>@foreach (var note in explanation.Colloquial) { <li>@note</li> }</ul>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </details>
            </article>
        }
    </div>

    <partial name="_LanguageInspector" model="LanguageInspectorHost.LearningHub()" />
}

@functions {
    /// <summary>The full sentence; with language tools each word opens the shared inspector.</summary>
    private void RenderSentence(SentencePracticeItem sentence)
    {
        if (!Model.ShowInspector)
        {
            <div class="sentence-full" lang="@sentence.Language">@sentence.Text</div>
            return;
        }

        <div class="sentence-full sentence-tokens"
             lang="@sentence.Language"
             role="group"
             aria-label="@Model.Ui["learn.sentences.tapWord"]">
            @foreach (var token in sentence.Tokens)
            {
                if (token.Interactive)
                {
                    var isTarget = token.Canonical is not null && token.Canonical == sentence.TargetCanonical;
                    <button class="sentence-token @(isTarget ? "target" : "")"
                            type="button"
                            data-language-inspect="@token.Surface">@token.Surface</button>
                }
                else
                {
                    <span>@token.Surface</span>
                }
            }
        </div>
    }
}

@section Scripts {
    <script src="~/js/tts.js" asp-append-version="true"></script>
    <script src="~/js/language-inspector.js" asp-append-version="true"></script>
}
