@page
@model AniLingo.Web.Pages.Learn.ProgressModel
@{
    ViewData["Title"] = Model.Ui["learn.progress.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Learn">← @Model.Ui["learn.title"]</a>
        <span class="eyebrow">@Model.Ui["learn.hub.progress.title"]</span>
        <h1>@Model.Ui["learn.progress.title"]</h1>
        <p>@Model.Ui["learn.progress.subtitle"]</p>
    </div>
</header>

<section class="metric-grid">
    <partial name="_MetricCard"
             model='new MetricCardModel(
                 Model.Ui["learn.progress.known"],
                 Model.Statistics.KnownTerms.ToString(),
                 Model.Ui["learn.progress.knownHint"])' />
    <partial name="_MetricCard"
             model='new MetricCardModel(
                 Model.Ui["learn.progress.learning"],
                 Model.Statistics.LearningTerms.ToString(),
                 Model.Ui.Format("learn.progress.dueHint", ("count", Model.Statistics.DueReviews)))' />
    <partial name="_MetricCard"
             model='new MetricCardModel(
                 Model.Ui["learn.progress.prepared"],
                 $"{Model.Statistics.PreparedCoveragePercent}%",
                 Model.Ui["learn.progress.preparedHint"])' />
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@Model.Ui["learn.progress.activity"]</h2>
        <span>FSRS</span>
    </div>
    <div class="status-list">
        <div>
            <span>@Model.Ui["learn.progress.totalReviews"]</span>
            <strong>@Model.Statistics.TotalReviews</strong>
        </div>
        <div>
            <span>@Model.Ui["learn.progress.last24h"]</span>
            <strong>@Model.Statistics.ReviewsLast24Hours</strong>
        </div>
        <div>
            <span>@Model.Ui["learn.progress.last7d"]</span>
            <strong>@Model.Statistics.ReviewsLast7Days</strong>
        </div>
        <div>
            <span>@Model.Ui["learn.progress.preparedOccurrences"]</span>
            <strong>
                @Model.Statistics.PreparedOccurrences /
                @Model.Statistics.TotalOccurrences
            </strong>
        </div>
    </div>
    <p class="muted">@Model.Ui["learn.progress.coverageNote"]</p>
</section>
