@page "/Discover/MangaImport"
@model AniLingo.Web.Pages.Discover.MangaImportModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("discover.mangaImport.titleTemplate", ("title", Model.Title));
}

@section Head {
    <link rel="stylesheet" href="~/css/discover.css" asp-append-version="true" />
}

<div class="discover-manga-import">
    <a class="discover-import-back" href="/Discover?category=manga">← @ui["discover.mangaImport.backLink"]</a>

    <header class="discover-manga-import-header">
        <div>
            <span class="eyebrow">@ui["discover.mangaImport.eyebrow"]</span>
            <h1>@Model.Title</h1>
            <p>
                @ui["discover.mangaImport.intro"]
            </p>
        </div>

        <a class="button"
           href="@Model.AniListUrl"
           target="_blank"
           rel="noopener noreferrer">
            @ui["discover.mangaImport.openAniList"]
        </a>
    </header>

    @if (TempData["Status"] is string status)
    {
        <div class="discover-warning">@status</div>
    }

    <div class="discover-manga-import-grid">
        <section class="discover-manga-import-card">
            <div>
                <span class="eyebrow">@ui["discover.mangaImport.recommended"]</span>
                <h2>@ui["discover.mangaImport.uploadHeading"]</h2>
                <p>
                    @ui["discover.mangaImport.uploadBody"]
                </p>
            </div>

            <form method="post"
                  asp-page-handler="Upload"
                  enctype="multipart/form-data"
                  class="discover-manga-import-form">
                <input type="hidden" name="anilistId" value="@Model.AniListId" />
                <input type="hidden" name="title" value="@Model.Title" />

                <label>
                    <span>@ui["manga.upload.seriesName"]</span>
                    <input type="text"
                           name="seriesTitle"
                           value="@Model.Title"
                           maxlength="200" />
                </label>

                <label>
                    <span>@ui["manga.upload.archivesLabel"]</span>
                    <input type="file"
                           name="archives"
                           accept=".cbz,.zip,application/zip"
                           multiple
                           required />
                </label>

                <button class="button button-primary" type="submit">
                    @ui["discover.mangaImport.uploadSubmit"]
                </button>
            </form>
        </section>

        <section class="discover-manga-import-card">
            <div>
                <span class="eyebrow">@ui["discover.mangaImport.serverStorage"]</span>
                <h2>@ui["discover.mangaImport.pathHeading"]</h2>
                <p>
                    @ui["discover.mangaImport.pathBody"]
                </p>
            </div>

            <form method="post"
                  asp-page-handler="ImportPath"
                  class="discover-manga-import-form">
                <input type="hidden" name="anilistId" value="@Model.AniListId" />
                <input type="hidden" name="title" value="@Model.Title" />

                <label>
                    <span>@ui["discover.mangaImport.sourcePathLabel"]</span>
                    <input type="text"
                           name="sourcePath"
                           required
                           autocomplete="off"
                           placeholder="/media/manga/@Model.Title" />
                </label>

                <button class="button button-primary" type="submit">
                    @ui["discover.mangaImport.pathSubmit"]
                </button>
            </form>
        </section>
    </div>

    <p class="discover-manga-import-note">
        @ui["discover.mangaImport.footerNote"]
    </p>
</div>
