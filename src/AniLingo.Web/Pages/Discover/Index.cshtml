@page "/Discover"
@model AniLingo.Web.Pages.Discover.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["discover.index.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/discover.css" asp-append-version="true" />
}

<div class="discover-shell"
     data-discover
     data-is-owner="@Model.IsOwner.ToString().ToLowerInvariant()">
    <header class="discover-header">
        <div>
            <span class="eyebrow">@ui["discover.index.eyebrow"]</span>
            <h1>@ui["discover.index.title"]</h1>
            <p>@ui["discover.index.subtitle"]</p>
        </div>

        <div class="discover-library-links" aria-label="@ui["discover.index.librariesAria"]">
            <a href="/Library">@ui["discover.index.animeLibraryLink"]</a>
            <a href="/Novels">@ui["discover.index.readingLibraryLink"]</a>
            <a href="/Books">@ui["nav.books"]</a>
        </div>
    </header>

    <section class="discover-controls" aria-label="@ui["discover.index.controlsAria"]">
        <div class="discover-search-row">
            <label class="discover-search">
                <span class="sr-only">@ui["discover.search.srLabel"]</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m21 21-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" />
                </svg>
                <input type="search"
                       data-discover-search
                       autocomplete="off"
                       spellcheck="false"
                       placeholder="@ui["discover.search.placeholder"]" />
                <kbd>/</kbd>
            </label>
        </div>

        <div class="discover-filter-row">
            <div class="discover-tabs" role="tablist" aria-label="@ui["discover.tabs.browseModeAria"]">
                <button type="button" data-discover-mode="trending">@ui["discover.tabs.trending"]</button>
                <button type="button" data-discover-mode="top">@ui["discover.tabs.top"]</button>
                <button type="button" data-discover-mode="my-list">@ui["discover.tabs.myAniList"]</button>
            </div>

            <div class="discover-categories" aria-label="@ui["discover.categories.aria"]">
                <button type="button" data-discover-category="all">@ui["discover.categories.all"]</button>
                <button type="button" data-discover-category="anime">@ui["discover.categories.anime"]</button>
                <button type="button" data-discover-category="light-novel">@ui["discover.categories.lightNovel"]</button>
                <button type="button" data-discover-category="manga">@ui["reading.manga.title"]</button>
                <button type="button" data-discover-category="book">@ui["nav.books"]</button>
            </div>
        </div>
    </section>

    <div class="discover-summary">
        <strong data-discover-title>@ui["discover.tabs.trending"]</strong>
        <span data-discover-count>@ui["discover.results.loading"]</span>
    </div>

    <div class="discover-warning" data-discover-warning hidden></div>

    <section class="discover-grid"
             data-discover-results
             aria-live="polite"
             aria-busy="true">
        @for (var i = 0; i < 10; i++)
        {
            <div class="discover-card discover-card-skeleton" aria-hidden="true">
                <div class="discover-cover"></div>
                <div class="discover-card-copy">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        }
    </section>

    <div class="discover-empty" data-discover-empty hidden>
        <strong>@ui["discover.results.emptyTitle"]</strong>
        <span>@ui["discover.results.emptyBody"]</span>
    </div>

    @if (Model.IsOwner)
    {
        <details class="discover-import" data-discover-import>
            <summary>@ui["discover.import.toggle"]</summary>
            <form method="post"
                  asp-page-handler="ImportSource"
                  class="discover-import-form"
                  data-discover-import-form>
                <div>
                    <strong data-import-title>@ui["discover.import.sourceUrlHeading"]</strong>
                    <span>
                        @ui["discover.import.sourceHint"]
                    </span>
                </div>
                <input type="hidden"
                       name="metadataProvider"
                       data-import-provider />
                <input type="hidden"
                       name="metadataExternalId"
                       data-import-external-id />
                <label>
                    <span>@ui["discover.import.sourceUrlHeading"]</span>
                    <input type="url"
                           name="sourceUrl"
                           required
                           inputmode="url"
                           autocomplete="url"
                           data-import-url
                           placeholder="https://ncode.syosetu.com/…" />
                </label>
                <div class="discover-import-actions">
                    <button class="button button-primary" type="submit">@ui["discover.import.submit"]</button>
                    <button class="button"
                            type="button"
                            data-import-clear>@ui["discover.import.clearMatch"]</button>
                </div>
            </form>
        </details>
    }
</div>

@section Scripts {
    <script src="~/js/discover.js" asp-append-version="true"></script>
}
