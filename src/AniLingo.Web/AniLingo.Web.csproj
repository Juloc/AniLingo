<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0-alpha.35</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetG2P.MeCab" Version="1.10.0" />
    <PackageReference Include="Fsrs.Sharp" Version="2.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- design/player is the single source for web and Android player design inputs. -->
    <EmbeddedResource Include="..\..\design\player\player-tokens.json" LogicalName="AniLingo.Design.Player.player-tokens.json" Link="Design\player-tokens.json" />
    <EmbeddedResource Include="..\..\design\player\player-icons.json" LogicalName="AniLingo.Design.Player.player-icons.json" Link="Design\player-icons.json" />
  </ItemGroup>

</Project>
