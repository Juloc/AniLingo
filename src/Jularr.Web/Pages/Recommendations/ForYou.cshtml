@page "/Recommendations"
@model Jularr.Web.Pages.Recommendations.ForYouModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["recommendations.pageTitle"];
}
@section Head {
    <link rel="stylesheet" href="~/css/media-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-shelves.css" asp-append-version="true" />
}

<header class="discover-header">
    <h1 id="recommendations-heading">@ui["recommendations.heading"]</h1>
    <p>@ui["recommendations.subtitle"]</p>
</header>

@if (Model.Board.HasShelves)
{
    <section class="discover-shelves-board" aria-labelledby="recommendations-heading">
        <partial name="_MediaShelfBoard" model="Model.Board" />
    </section>
}
else
{
    <div class="discover-empty">
        <p>@ui["recommendations.empty"]</p>
    </div>
}
