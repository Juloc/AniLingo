@page
@model Jularr.Web.Pages.Profile.AccountModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.nav.account"];
}
@section Head {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<a class="back-link profile-phone-only" href="/Profile">← @ui["nav.profile"]</a>
<header class="page-header profile-header">
    <h1>@ui["settings.nav.account"]</h1>
</header>

<section class="panel profile-account">
    <dl class="profile-facts">
        <dt>@ui["profile.account.name"]</dt>
        <dd>@Model.DisplayName</dd>
    </dl>
    <form method="post" asp-page="/Account/Logout" data-offline-logout>
        <button class="button" type="submit">
            <partial name="_AppIcon" model="@("signOut")" />
            <span>@ui["nav.signOut"]</span>
        </button>
    </form>
</section>
