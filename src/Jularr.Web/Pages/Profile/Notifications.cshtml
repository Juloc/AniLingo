@page
@model Jularr.Web.Pages.Profile.NotificationsModel
@using Jularr.Web.Features.Events
@using Jularr.Web.Features.Notifications
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["notifications.settings.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Notifications">@ui["notifications.settings.backToInbox"]</a>
        <h1>@ui["notifications.settings.title"]</h1>
        <p>@ui["notifications.settings.description"]</p>
    </div>
</header>

<form method="post" class="panel">
    <div class="notification-settings-grid">
        @foreach (var category in Model.VisibleCategories)
        {
            var meta = JularrEventCategories.Of(category);
            var current = Model.Preferences.TryGetValue(category, out var mode) ? mode : NotificationSubscription.DefaultMode;
            <div class="notification-settings-row">
                <div class="notification-settings-copy">
                    <strong>@ui[meta.LabelKey]</strong>
                    @if (meta.Audience == JularrEventAudience.Admin)
                    {
                        <small>@ui["notifications.settings.adminNote"]</small>
                    }
                </div>
                <select name="mode.@category">
                    <option value="@NotificationMode.Off" selected="@(current == NotificationMode.Off)">@ui["notifications.settings.modeOff"]</option>
                    <option value="@NotificationMode.InApp" selected="@(current == NotificationMode.InApp)">@ui["notifications.settings.modeInApp"]</option>
                </select>
            </div>
        }
    </div>

    <button class="button button-primary" type="submit" style="margin-top:14px;">@ui["notifications.settings.save"]</button>
</form>
