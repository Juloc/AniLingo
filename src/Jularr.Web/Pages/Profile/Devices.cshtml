@page
@model Jularr.Web.Pages.Profile.DevicesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["profile.devices.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">@ui["common.backToSettings"]</a>
        <h1>@ui["profile.devices.title"]</h1>
        <p>@ui["profile.devices.subtitle"]</p>
    </div>
</header>

@if (Model.Sessions.Count == 0)
{
    <p class="muted">@ui["profile.devices.empty"]</p>
}
@if (Model.Sessions.Count > 0)
{
    <div class="sessions-table-wrap">
        <table class="sessions-table">
            <thead>
                <tr>
                    <th>@ui["admin.sessions.column.title"]</th>
                    <th>@ui["admin.sessions.column.client"]</th>
                    <th>@ui["playback.diagnostics.mode"]</th>
                    <th>@ui["playback.diagnostics.source"]</th>
                    <th>@ui["playback.diagnostics.delivered"]</th>
                    <th>@ui["admin.sessions.column.reason"]</th>
                    <th>@ui["admin.sessions.column.started"]</th>
                    <th>@ui["admin.sessions.column.lastSeen"]</th>
                    <th>@ui["admin.sessions.column.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr class="@(session.IsTranscoding ? "session-row-transcoding" : "")">
                        <td data-label="@ui["admin.sessions.column.title"]">@session.Title</td>
                        <td data-label="@ui["admin.sessions.column.client"]">@session.ClientKind</td>
                        <td data-label="@ui["playback.diagnostics.mode"]">
                            <span class="status-pill @(session.IsTranscoding ? "status-warning" : "status-info")">@ui[session.PlaybackMethodKey]</span>
                        </td>
                        <td data-label="@ui["playback.diagnostics.source"]">@session.SourceSummary(ui)</td>
                        <td data-label="@ui["playback.diagnostics.delivered"]">@session.DeliveredSummary(ui)</td>
                        <td data-label="@ui["admin.sessions.column.reason"]">@(session.TranscodeReason(ui) ?? "—")</td>
                        <td data-label="@ui["admin.sessions.column.started"]">@session.StartedAtUtc.ToLocalTime().ToString("g")</td>
                        <td data-label="@ui["admin.sessions.column.lastSeen"]">@session.LastSeenUtc.ToLocalTime().ToString("g")</td>
                        <td data-label="@ui["admin.sessions.column.actions"]">
                            <form method="post" asp-page-handler="Stop" asp-route-id="@session.SessionId">
                                <button class="button" type="submit">@ui["profile.devices.stop"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
