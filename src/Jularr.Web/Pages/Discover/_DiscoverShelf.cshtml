@using Jularr.Web.Features.Discovery
@using Jularr.Web.Features.Localization
@model (DiscoverShelfView Shelf, UiTextBundle Ui)
@* One Discover row: a heading, an optional "see all" link to the filtered result page and a horizontally
   scrolling track of cards. Styles: wwwroot/css/discover-browse.css. *@
@{
    var shelf = Model.Shelf;
    var ui = Model.Ui;
}
<section class="dc-shelf" aria-labelledby="dc-shelf-@shelf.Id">
    <div class="dc-shelf-head">
        <h2 id="dc-shelf-@shelf.Id">@shelf.Heading</h2>
        @if (shelf.SeeAllUrl is { Length: > 0 } seeAll)
        {
            <a class="dc-shelf-more" href="@seeAll">@ui["discover.shelf.seeAll"]</a>
        }
    </div>
    <ul class="dc-track">
        @foreach (var card in shelf.Cards)
        {
            <li class="dc-track-item"><partial name="_DiscoverCard" model="(card, ui)" /></li>
        }
    </ul>
</section>
