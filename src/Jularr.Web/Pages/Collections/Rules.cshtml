@page "/Collections/{id:guid}/Rules"
@model Jularr.Web.Pages.Collections.RulesModel
@using System.Text.Json
@{
    ViewData["Title"] = "Rules · " + Model.Collection.Name;
    var fieldsJson = JsonSerializer.Serialize(Jularr.Web.Pages.Collections.RulesModel.Fields,
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

@section Head {
    <link rel="stylesheet" href="~/css/collections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collection-rules.css" asp-append-version="true" />
}

<div class="collections-page">
    <p><a href="@Url.Page("/Collections/Detail", new { id = Model.Collection.Id })">&larr; Back to collection</a></p>
    <header class="collections-head">
        <h1>Rules</h1>
        <p class="collections-lead">
            Build a nested ALL / ANY rule over media facts and franchises. Works matching it become the
            shelf; each match explains itself.
        </p>
    </header>

    <form method="post" id="rules-form" class="rules-form">
        <label class="rules-name">
            <span>Name</span>
            <input type="text" name="name" value="@Model.Collection.Name" maxlength="200" />
        </label>
        <label class="rules-name">
            <span>Description</span>
            <input type="text" name="description" value="@Model.Collection.Description" maxlength="2000" />
        </label>

        <div id="rules-builder"
             class="rules-builder"
             data-fields='@fieldsJson'
             data-rule='@Model.RuleJson'></div>

        <input type="hidden" name="rulesJson" id="rules-json" />
        <div class="collections-item-actions">
            <button type="submit" class="collections-primary">Save rule</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/collection-rules.js" asp-append-version="true"></script>
}
