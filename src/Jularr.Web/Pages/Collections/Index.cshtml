@page "/Collections"
@model Jularr.Web.Pages.Collections.IndexModel
@{
    ViewData["Title"] = "Collections";
}

@section Head {
    <link rel="stylesheet" href="~/css/collections.css" asp-append-version="true" />
}

<div class="collections-page">
    <header class="collections-head">
        <h1>Collections</h1>
        <p class="collections-lead">Curated and rule-driven shelves across every media type.</p>
    </header>

    @if (Model.Collections.Count == 0)
    {
        <p class="collections-empty">No collections yet. Create your first one below.</p>
    }
    else
    {
        <ul class="collections-list">
            @foreach (var collection in Model.Collections)
            {
                <li class="collections-item">
                    <a class="collections-item-main" href="@Url.Page("/Collections/Detail", new { id = collection.Id })">
                        <span class="collections-item-name">@collection.Name</span>
                        <span class="collections-badge collections-badge-@collection.Kind.ToString().ToLowerInvariant()">
                            @(collection.Kind == Jularr.Web.Features.Collections.CollectionKind.Smart ? "Smart" : "Manual")
                        </span>
                        <span class="collections-item-count">@collection.ItemCount works</span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(collection.Description))
                    {
                        <p class="collections-item-desc">@collection.Description</p>
                    }
                    <div class="collections-item-actions">
                        @if (collection.Kind == Jularr.Web.Features.Collections.CollectionKind.Smart)
                        {
                            <a href="@Url.Page("/Collections/Rules", new { id = collection.Id })">Edit rules</a>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@collection.Id"
                              onsubmit="return confirm('Delete this collection?');">
                            <button type="submit" class="collections-link-button">Delete</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }

    <section class="collections-create">
        <h2>New collection</h2>
        <form method="post" asp-page-handler="Create" class="collections-create-form">
            <label>
                <span>Name</span>
                <input type="text" name="name" maxlength="200" required />
            </label>
            <label>
                <span>Description</span>
                <input type="text" name="description" maxlength="2000" />
            </label>
            <fieldset class="collections-kind">
                <legend>Kind</legend>
                <label class="collections-kind-option">
                    <input type="radio" name="kind" value="manual" checked />
                    <span>Manual — pick works by hand</span>
                </label>
                <label class="collections-kind-option">
                    <input type="radio" name="kind" value="smart" />
                    <span>Smart — build a rule</span>
                </label>
            </fieldset>
            <button type="submit" class="collections-primary">Create</button>
        </form>
    </section>
</div>
