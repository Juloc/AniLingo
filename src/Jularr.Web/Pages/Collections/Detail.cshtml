@page "/Collections/{id:guid}"
@model Jularr.Web.Pages.Collections.DetailModel
@{
    ViewData["Title"] = Model.View.Name;
}

@section Head {
    <link rel="stylesheet" href="~/css/media-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-shelves.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collections.css" asp-append-version="true" />
}

<div class="collections-page">
    <p><a href="@Url.Page("/Collections/Index")">&larr; All collections</a></p>
    <header class="collections-head">
        <h1>@Model.View.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.View.Description))
        {
            <p class="collections-lead">@Model.View.Description</p>
        }
        @if (Model.IsSmart)
        {
            <div class="collections-item-actions">
                <a href="@Url.Page("/Collections/Rules", new { id = Model.View.Id })">Edit rules</a>
                <form method="post" asp-page-handler="Refresh" asp-route-id="@Model.View.Id">
                    <button type="submit" class="collections-link-button">Rebuild now</button>
                </form>
                @if (Model.View.LastMaterializedAt is { } materialized)
                {
                    <span class="collections-muted">Last rebuilt @materialized.ToString("u")</span>
                }
            </div>
        }
    </header>

    @if (Model.View.Shelf.Cards.Count == 0)
    {
        <p class="collections-empty">
            @(Model.IsSmart ? "No works match this rule yet." : "This collection is empty.")
        </p>
    }
    else
    {
        <partial name="_MediaShelf" model="Model.View.Shelf" />
    }

    @if (Model.IsSmart)
    {
        var explained = Model.View.Items.Where(x => x.Reasons.Count > 0).ToList();
        if (explained.Count > 0)
        {
            <section class="collections-why">
                <h2>Why these matched</h2>
                <ul class="collections-why-list">
                    @foreach (var item in explained)
                    {
                        <li>
                            <span class="collections-why-title">@item.Card.Title</span>
                            <span class="collections-why-reasons">@string.Join(" · ", item.Reasons)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
    else
    {
        <section class="collections-manage"
                 data-search-url="@Url.Page("/Collections/Detail", "Search", new { id = Model.View.Id })">
            <h2>Manage works</h2>
            <div class="collections-add">
                <input type="text" id="collection-work-search" placeholder="Search works to add…" autocomplete="off" />
                <ul id="collection-work-results" class="collections-search-results"></ul>
            </div>
            @if (Model.View.Items.Count > 0)
            {
                <ul class="collections-manage-list">
                    @foreach (var item in Model.View.Items)
                    {
                        <li>
                            <span>@item.Card.Title</span>
                            <form method="post" asp-page-handler="Remove" asp-route-id="@Model.View.Id">
                                <input type="hidden" name="workId" value="@item.WorkId" />
                                <button type="submit" class="collections-link-button">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            <form method="post" asp-page-handler="Add" asp-route-id="@Model.View.Id" id="collection-add-form">
                <input type="hidden" name="workId" id="collection-add-workid" />
            </form>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/collections.js" asp-append-version="true"></script>
}
