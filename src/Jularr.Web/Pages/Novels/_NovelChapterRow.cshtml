@model Jularr.Web.Pages.Novels.NovelChapterRowModel
@{
    var chapter = Model.Chapter;
    var ui = Model.Ui;
    var isCurrent = Model.Progress?.ChapterId == chapter.Id;
    var isEarlier = Model.CurrentChapter is not null && chapter.Number < Model.CurrentChapter.Number;
}
<a class="novel-chapter-row @(isCurrent ? "current" : isEarlier ? "earlier" : "")" href="/Novels/Read/@chapter.Id">
    <span class="novel-chapter-number">@chapter.Number</span>
    <div class="novel-chapter-copy">
        <strong lang="ja">@chapter.Title</strong>
        <div class="novel-chapter-subline">
            @if (isCurrent)
            {
                <span>@ui.Format("novels.work.percentRead", ("percent", Model.Progress!.PositionPermille / 10))</span>
            }
            else if (chapter.PublishedAt is DateTime published)
            {
                <span>@published.ToString("yyyy-MM-dd")</span>
            }
        </div>
        @if (isCurrent)
        {
            <div class="novel-progress-track compact">
                <span style="width:@(Model.Progress!.PositionPermille / 10)%"></span>
            </div>
        }
    </div>
    <div class="novel-chapter-badges">
        @* Reflects the cache only: reading an already
           available German chapter is core reader
           behaviour and must not depend on the Learning
           Translation capability (#369). *@
        @if (chapter.HasTranslation)
        {
            <span>DE</span>
        }
        @if (isCurrent)
        {
            <span class="current-dot" title="@ui["novels.work.currentChapterTitle"]"></span>
        }
    </div>
</a>
