@model Jularr.Web.Pages.Novels.ReadModel
@* Chapter navigation is loaded on demand in bounded windows (see ReadModel.OnGetChaptersAsync);
   the reader response never embeds the work's full chapter index. Rendered as the "Contents"
   tab of the reader frame's contents panel. *@
@{
    var ui = Model.Ui;
}
<section class="reader-contents-panel novel-chapter-drawer"
         id="novel-chapter-drawer"
         role="tabpanel"
         aria-labelledby="novel-tab-chapters"
         data-reader-contents-panel="chapters"
         data-chapter-drawer>
    <input class="reader-contents-search"
           type="search"
           data-chapter-filter
           placeholder="@ui["manga.reader.chapterSearchPlaceholder"]"
           aria-label="@ui["novels.read.drawer.searchAria"]"
           autocomplete="off" />

    <div class="novel-drawer-list" data-chapter-list-scroll>
        <button type="button" class="novel-drawer-more" data-chapter-load-before hidden>@ui["novels.read.drawer.loadEarlier"]</button>
        <nav data-chapter-list aria-label="@ui["novels.read.drawer.listAria"]"></nav>
        <button type="button" class="novel-drawer-more" data-chapter-load-after hidden>@ui["novels.read.drawer.loadMore"]</button>
        <p class="novel-drawer-status" data-chapter-status role="status" aria-live="polite"></p>
    </div>
</section>
