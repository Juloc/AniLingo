@model Jularr.Web.Pages.Novels.NovelVolumeGroupModel
@{
    var volume = Model.Volume;
    var volumeCurrent = volume is not null && Model.CurrentChapter?.VolumeId == volume.Id;
    var chapterCount = Model.Chapters.Count == 1
        ? Model.Ui["novels.work.oneChapterInline"]
        : Model.Ui.Format("novels.work.chaptersCountInline", ("count", Model.Chapters.Count));
    static IReadOnlyList<(string? GroupTitle, List<Jularr.Web.Features.Novels.NovelChapterItem> Chapters)> GroupRuns(IReadOnlyList<Jularr.Web.Features.Novels.NovelChapterItem> chapters)
    {
        var runs = new List<(string? GroupTitle, List<Jularr.Web.Features.Novels.NovelChapterItem> Chapters)>();
        foreach (var chapter in chapters)
        {
            if (runs.Count > 0 && runs[^1].GroupTitle == chapter.GroupTitle)
            {
                runs[^1].Chapters.Add(chapter);
            }
            else
            {
                runs.Add((chapter.GroupTitle, [chapter]));
            }
        }

        return runs;
    }
}
<div class="novel-volume-group @(volumeCurrent ? "current" : "")">
    @if (volume is not null)
    {
        <header class="novel-volume-header" id="volume-@volume.Number">
            <div class="novel-volume-cover">
                @if (volume.CoverUrl is not null)
                {
                    <img src="@volume.CoverUrl" alt="" loading="lazy" />
                }
                else
                {
                    <span>@volume.Number</span>
                }
            </div>
            <div class="novel-volume-copy">
                <strong>@Model.Ui.Format("novels.work.volumeLabel", ("number", volume.Number))</strong>
                @if (!string.IsNullOrWhiteSpace(volume.Title))
                {
                    <span lang="ja">@volume.Title</span>
                }
                <small>@chapterCount@(volumeCurrent ? $" · {Model.Ui["novels.work.readingIndicator"]}" : "")</small>
            </div>
            @if (Model.Chapters.FirstOrDefault() is { } volumeStart)
            {
                <a class="button novel-volume-open" href="/Novels/Read/@(volumeCurrent ? Model.CurrentChapter!.Id : volumeStart.Id)">
                    @(volumeCurrent ? Model.Ui["novels.work.continueVolumeAction"] : Model.Ui["novels.work.readVolumeAction"])
                </a>
            }
        </header>
    }

    <div class="novel-chapter-list">
        @foreach (var run in GroupRuns(Model.Chapters))
        {
            if (run.GroupTitle is null)
            {
                @foreach (var chapter in run.Chapters)
                {
                    <partial name="_NovelChapterRow" model="new Jularr.Web.Pages.Novels.NovelChapterRowModel(chapter, Model.CurrentChapter, Model.Progress, Model.Ui)" />
                }
            }
            else
            {
                <details class="novel-chapter-group" open>
                    <summary class="novel-chapter-group-heading">@run.GroupTitle</summary>
                    <div class="novel-chapter-group-list">
                        @foreach (var chapter in run.Chapters)
                        {
                            <partial name="_NovelChapterRow" model="new Jularr.Web.Pages.Novels.NovelChapterRowModel(chapter, Model.CurrentChapter, Model.Progress, Model.Ui)" />
                        }
                    </div>
                </details>
            }
        }
    </div>
</div>
