@page "/Novels/Work/{id:guid}"
@model Jularr.Web.Pages.Novels.WorkModel
@{
    var ui = Model.Ui;
    var detail = Model.Detail!;
    var work = detail.Work;
    var description = work.MetadataDescription ?? work.Description;
    var currentChapter = Model.Progress is null
        ? null
        : detail.Chapters.FirstOrDefault(x => x.Id == Model.Progress.ChapterId);
    var epubVolumes = detail.Volumes.Where(x => x.IsEpub).ToArray();
    var currentVolume = currentChapter is null
        ? null
        : epubVolumes.FirstOrDefault(x => x.Id == currentChapter.VolumeId);
    // Series → volume → chapter; web novels and books have one implicit volume
    // that is not shown as a group.
    var chapterGroups = epubVolumes.Length > 0
        ? epubVolumes
            .Select(volume => (Volume: (Jularr.Web.Features.Novels.NovelVolumeItem?)volume,
                Chapters: (IReadOnlyList<Jularr.Web.Features.Novels.NovelChapterItem>)detail.Chapters
                    .Where(x => x.VolumeId == volume.Id)
                    .ToArray()))
            .ToArray()
        : [(Volume: null, Chapters: detail.Chapters)];
    ViewData["Title"] = work.MetadataTitle ?? work.Title;
}
@section Head {
    <link rel="stylesheet" href="~/css/novel-library.css" asp-append-version="true" />
}

<a class="back-link" href="/Novels">@ui["novels.work.backToNovels"]</a>

<header class="novel-work-header">
    <div class="novel-work-cover">
        @if (!string.IsNullOrWhiteSpace(detail.CoverUrl))
        {
            <img src="@detail.CoverUrl" alt="" referrerpolicy="no-referrer" />
        }
        else
        {
            <span>文</span>
        }
    </div>

    <div class="novel-work-copy">
        <h1>@(work.MetadataTitle ?? work.Title)</h1>

        <div class="novel-meta">
            @if (!string.IsNullOrWhiteSpace(work.MetadataNativeTitle))
            {
                <span lang="ja">@work.MetadataNativeTitle</span>
            }
            @if (!string.IsNullOrWhiteSpace(work.Author))
            {
                <span>@work.Author</span>
            }
            @if (epubVolumes.Length > 0)
            {
                <span>@(work.MetadataVolumeCount is int totalVolumes
                    ? ui.Format("novels.work.volumesOfTotalInline", ("count", epubVolumes.Length), ("total", totalVolumes))
                    : ui.Format("novels.work.volumesCountInline", ("count", epubVolumes.Length)))</span>
            }
            else if (work.MetadataVolumeCount is int volumes)
            {
                <span>@ui.Format("novels.work.volumesCountInline", ("count", volumes))</span>
            }
            <span>@ui.Format("novels.work.chaptersCountInline", ("count", work.MetadataChapterCount ?? detail.Chapters.Count))</span>
            @if (!string.IsNullOrWhiteSpace(work.MetadataStatus))
            {
                <span>@work.MetadataStatus.Replace("_", " ").ToLowerInvariant()</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="novel-work-description">@description</p>
        }

        <div class="novel-work-actions">
            @if (currentChapter is not null)
            {
                <a class="button button-primary novel-primary-action" href="/Novels/Read/@currentChapter.Id">
                    @(currentVolume is null
                        ? ui.Format("manga.card.continueChapter", ("chapter", currentChapter.Number))
                        : ui.Format("novels.work.continueReadingVolume", ("volume", currentVolume.Number), ("chapter", currentChapter.Number)))
                </a>
                <span class="novel-progress-label">@ui.Format("novels.work.progressThroughChapter", ("percent", Model.Progress!.PositionPermille / 10))</span>
            }
            else if (detail.Chapters.FirstOrDefault() is { } firstChapter)
            {
                <a class="button button-primary novel-primary-action" href="/Novels/Read/@firstChapter.Id">@ui["manga.series.startReading"]</a>
            }

            <a class="button"
               href="@Url.Page("/Settings/LearningScope", new {
                   mediaType = Jularr.Web.Features.Learning.LearningMediaType.Novel,
                   scope = "work",
                   workKey = work.Id.ToString(),
                   label = work.MetadataTitle ?? work.Title,
                   returnUrl = $"/Novels/Work/{work.Id}"
               })">
                @ui["manga.series.languageToolsLink"]
            </a>

            @if (!detail.IsEpubSeries)
            {
                <a class="novel-source-link" href="@work.SourceUrl" target="_blank" rel="noreferrer">
                    @ui["novels.work.sourceLink"]
                </a>
            }
        </div>

        <partial name="_OfflineLibraryAction" model="new Jularr.Web.Features.OfflineLibrary.OfflineLibraryActionViewModel(work.Id, work.MetadataTitle ?? work.Title)" />
    </div>
</header>

@if (Model.ExternalProgress is { } externalProgress)
{
    var externalPanel = new Jularr.Web.Features.Tracking.ExternalProgressPanel(
        externalProgress,
        Url.Page(null, "ExternalProgress", new { id = work.Id })!,
        // Segment mappings can point at another AniList part than the work match.
        externalProgress.MappingBasis == Jularr.Web.Features.Tracking.ExternalMappingBasis.Matched
            ? work.CoverImageUrl
            : null,
        MatchUrl: $"/Novels/Work/{work.Id}?q={Uri.EscapeDataString(work.MetadataTitle ?? work.Title)}#novel-manage",
        MappingUrl: $"/Settings/MappingSegments?mediaType=novel&localId={work.Id}",
        CanManageMapping: Model.IsOwner,
        Ui: ui);
    <partial name="_ExternalProgress" model="externalPanel" />
}

@if (Model.IsOwner)
{
    <details class="novel-panel novel-admin-panel" id="novel-manage" open="@Model.IsSearching">
        <summary><strong>@ui["novels.work.manageNovel"]</strong></summary>

        <div class="novel-admin-content">
            <a class="button" href="/Books/ChapterArt/@work.Id">@ui["chapterArt.title"]</a>
            @if (detail.IsEpubSeries)
            {
                <section class="novel-admin-section">
                    <div class="panel-heading">
                        <h2>@ui["novels.work.epubVolumesHeading"]</h2>
                    </div>

                    <form method="post"
                          asp-page-handler="UploadVolume"
                          asp-route-id="@work.Id"
                          enctype="multipart/form-data"
                          class="novel-inline-form">
                        <input type="file"
                               name="epubs"
                               accept=".epub,application/epub+zip"
                               multiple
                               required
                               aria-label="@ui["novels.work.epubVolumesHeading"]" />
                        <button class="button button-primary" type="submit">@ui["novels.work.addOrReplaceVolumes"]</button>
                    </form>

                    @if (epubVolumes.Length > 0)
                    {
                        <div class="novel-mapping-list">
                            @foreach (var volume in epubVolumes)
                            {
                                <div class="novel-mapping-row">
                                    <div>
                                        <strong>@ui.Format("novels.work.volumeLabel", ("number", volume.Number))</strong>
                                        <div class="novel-muted">@volume.SourceFileName · @volume.UpdatedAt.ToString("yyyy-MM-dd")</div>
                                    </div>
                                    <span></span>
                                    <form method="post" asp-page-handler="RemoveVolume" asp-route-id="@work.Id">
                                        <input type="hidden" name="volumeId" value="@volume.Id" />
                                        <button class="button" type="submit">@ui["common.remove"]</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
            else
            {
                <div class="novel-inline-form">
                    <form method="post" asp-page-handler="Refresh" asp-route-id="@work.Id">
                        <button class="button" type="submit">@ui["novels.work.refreshChapters"]</button>
                    </form>
                    <form method="post" asp-page-handler="LoadAll" asp-route-id="@work.Id">
                        <button class="button" type="submit">@ui["novels.work.cacheAllJapanese"]</button>
                    </form>
                </div>
            }

            <section class="novel-admin-section">
                <div class="panel-heading">
                    <h2>@(string.IsNullOrWhiteSpace(work.MetadataExternalId) ? ui["novels.work.matchAniListHeading"] : ui["novels.work.aniListNovelHeading"])</h2>
                    @if (!string.IsNullOrWhiteSpace(work.MetadataExternalId))
                    {
                        <form method="post" asp-page-handler="RemoveMetadata" asp-route-id="@work.Id">
                            <button class="button" type="submit">@ui["library.anime.removeMatch"]</button>
                        </form>
                    }
                </div>

                <form method="get" class="novel-inline-form">
                    <input type="search" name="q" value="@Model.SearchQuery" placeholder="@ui["novels.work.searchAniListPlaceholder"]" />
                    <button class="button button-primary" type="submit">@ui["common.search"]</button>
                </form>

                @if (Model.SearchResults.Count > 0)
                {
                    <div class="novel-results">
                        @foreach (var candidate in Model.SearchResults)
                        {
                            <article class="novel-result">
                                @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                                {
                                    <img src="@candidate.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <div></div>
                                }
                                <div>
                                    <strong>@candidate.PreferredTitle</strong>
                                    @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                                    {
                                        <div lang="ja">@candidate.NativeTitle</div>
                                    }
                                    <small class="novel-muted">
                                        @candidate.Format
                                        @if (candidate.VolumeCount is int candidateVolumes)
                                        {
                                            <text> · @ui.Format("novels.work.volumesCountInline", ("count", candidateVolumes))</text>
                                        }
                                        @if (candidate.ChapterCount is int candidateChapters)
                                        {
                                            <text> · @ui.Format("novels.work.chaptersCountInline", ("count", candidateChapters))</text>
                                        }
                                    </small>
                                </div>
                                <form method="post" asp-page-handler="MatchMetadata" asp-route-id="@work.Id">
                                    <input type="hidden" name="provider" value="@candidate.Provider" />
                                    <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                    <button class="button" type="submit">@ui["manga.series.useCandidate"]</button>
                                </form>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="novel-admin-section">
                <div class="panel-heading">
                    <h2>@ui["novels.work.animeMappingHeading"]</h2>
                </div>

                @if (Model.AnimeChoices.Count == 0)
                {
                    <p class="novel-muted">@ui["novels.work.noAnimeChoices"]</p>
                }
                else
                {
                    <form method="post" asp-page-handler="AddMapping" asp-route-id="@work.Id" class="novel-mapping-form">
                        <select name="animeId" required>
                            @foreach (var anime in Model.AnimeChoices)
                            {
                                <option value="@anime.AnimeId">@anime.Title</option>
                            }
                        </select>
                        <input name="chapterStart" type="number" min="1" placeholder="@ui["novels.work.chapterFromPlaceholder"]" required />
                        <input name="chapterEnd" type="number" min="1" placeholder="@ui["novels.work.chapterToPlaceholder"]" required />
                        <input name="seasonNumber" type="number" min="0" value="1" aria-label="@ui["novels.work.seasonAria"]" required />
                        <input name="episodeStart" type="number" min="1" placeholder="@ui["novels.work.episodeFromPlaceholder"]" required />
                        <input name="episodeEnd" type="number" min="1" placeholder="@ui["novels.work.episodeToPlaceholder"]" required />
                        <input name="label" type="text" maxlength="200" placeholder="@ui["novels.work.optionalNotePlaceholder"]" />
                        <button class="button" type="submit">@ui["novels.work.addMapping"]</button>
                    </form>

                    <form method="post" asp-page-handler="SuggestMappings" asp-route-id="@work.Id" class="novel-inline-form">
                        <select name="animeId" required>
                            @foreach (var anime in Model.AnimeChoices)
                            {
                                <option value="@anime.AnimeId">@anime.Title</option>
                            }
                        </select>
                        <button class="button" type="submit">@ui["novels.work.suggestMappingsAi"]</button>
                    </form>
                }

                @if (detail.Mappings.Count > 0)
                {
                    <div class="novel-mapping-list">
                        @foreach (var mapping in detail.Mappings)
                        {
                            <div class="novel-mapping-row">
                                <div>
                                    <strong>Ch. @mapping.ChapterStart–@mapping.ChapterEnd → S@(mapping.SeasonNumber.ToString("00")) E@(mapping.EpisodeStart.ToString("00"))–E@(mapping.EpisodeEnd.ToString("00"))</strong>
                                    <div class="novel-muted">@mapping.AnimeProvider · @mapping.AnimeExternalId @mapping.Label</div>
                                </div>
                                <span class="novel-source-pill @(mapping.Source == "ai" ? "ai" : "")">@mapping.Source</span>
                                <form method="post" asp-page-handler="RemoveMapping" asp-route-id="@work.Id">
                                    <input type="hidden" name="mappingId" value="@mapping.Id" />
                                    <button class="button" type="submit">@ui["common.remove"]</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </details>
}

<section class="novel-chapters-section">
    <div class="novel-chapters-heading">
        <h2>@(epubVolumes.Length > 0 ? ui["novels.work.volumesHeading"] : ui["manga.chapters.title"])</h2>
        @if (epubVolumes.Length > 0)
        {
            <span>@ui.Format("novels.work.volumesCountInline", ("count", epubVolumes.Length)) · @ui.Format("novels.work.chaptersCountInline", ("count", detail.Chapters.Count))</span>
        }
    </div>

    @foreach (var group in chapterGroups)
    {
        var volume = group.Volume;
        var volumeCurrent = volume is not null && currentChapter?.VolumeId == volume.Id;
        <div class="novel-volume-group @(volumeCurrent ? "current" : "")">
            @if (volume is not null)
            {
                <header class="novel-volume-header" id="volume-@volume.Number">
                    <div class="novel-volume-cover">
                        @if (volume.CoverUrl is not null)
                        {
                            <img src="@volume.CoverUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span>@volume.Number</span>
                        }
                    </div>
                    <div class="novel-volume-copy">
                        <strong>@ui.Format("novels.work.volumeLabel", ("number", volume.Number))</strong>
                        @if (!string.IsNullOrWhiteSpace(volume.Title))
                        {
                            <span lang="ja">@volume.Title</span>
                        }
                        <small>@ui.Format("novels.work.chaptersCountInline", ("count", group.Chapters.Count))@(volumeCurrent ? $" · {ui["novels.work.readingIndicator"]}" : "")</small>
                    </div>
                    @if (group.Chapters.FirstOrDefault() is { } volumeStart)
                    {
                        <a class="button novel-volume-open" href="/Novels/Read/@(volumeCurrent ? currentChapter!.Id : volumeStart.Id)">
                            @(volumeCurrent ? ui["novels.work.continueVolumeAction"] : ui["novels.work.readVolumeAction"])
                        </a>
                    }
                </header>
            }

            <div class="novel-chapter-list">
                @foreach (var chapter in group.Chapters)
                {
                    var isCurrent = Model.Progress?.ChapterId == chapter.Id;
                    var isEarlier = currentChapter is not null && chapter.Number < currentChapter.Number;
                    <a class="novel-chapter-row @(isCurrent ? "current" : isEarlier ? "earlier" : "")" href="/Novels/Read/@chapter.Id">
                        <span class="novel-chapter-number">@chapter.Number</span>
                        <div class="novel-chapter-copy">
                            <strong lang="ja">@chapter.Title</strong>
                            <div class="novel-chapter-subline">
                                @if (isCurrent)
                                {
                                    <span>@ui.Format("novels.work.percentRead", ("percent", Model.Progress!.PositionPermille / 10))</span>
                                }
                                else if (chapter.PublishedAt is DateTime published)
                                {
                                    <span>@published.ToString("yyyy-MM-dd")</span>
                                }
                            </div>
                            @if (isCurrent)
                            {
                                <div class="novel-progress-track compact">
                                    <span style="width:@(Model.Progress!.PositionPermille / 10)%"></span>
                                </div>
                            }
                        </div>
                        <div class="novel-chapter-badges">
                            @* Reflects the cache only: reading an already
                               available German chapter is core reader
                               behaviour and must not depend on the Learning
                               Translation capability (#369). *@
                            @if (chapter.HasTranslation)
                            {
                                <span>DE</span>
                            }
                            @if (isCurrent)
                            {
                                <span class="current-dot" title="@ui["novels.work.currentChapterTitle"]"></span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</section>
