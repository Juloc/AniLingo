@model Jularr.Web.Pages.Novels.ReadModel
@* Notes panel: the current chapter's annotations render with the page; notes from other
   chapters load on demand in bounded pages (ReadModel.OnGetWorkNotesAsync). *@
@{
    var ui = Model.Ui;
    var annotations = Model.Annotations;
    var settings = Model.ReaderSettings;
}
<section class="reader-contents-panel novel-reader-notes"
         id="novel-reader-notes"
         role="tabpanel"
         data-reader-contents-panel="bookmarks notes"
         data-reader-notes
         aria-label="@ui["novels.read.bookmarksAndHighlights"]"
         hidden>
    <div class="novel-notes-header">
        <div class="novel-notes-nav">
            <button class="reader-frame-icon"
                    type="button"
                    data-bookmark-nav="prev"
                    aria-label="@ui["novels.read.notes.prevBookmarkAria"]"
                    title="@ui["novels.read.notes.prevBookmarkTitle"]">
                <partial name="_ReaderIcon" model="@("back")" />
            </button>
            <button class="reader-frame-icon"
                    type="button"
                    data-bookmark-nav="next"
                    aria-label="@ui["novels.read.notes.nextBookmarkAria"]"
                    title="@ui["novels.read.notes.nextBookmarkTitle"]">
                <partial name="_ReaderIcon" model="@("forward")" />
            </button>
        </div>
        <input type="search"
               class="reader-contents-search"
               data-notes-search
               placeholder="@ui["novels.read.notes.searchPlaceholder"]"
               aria-label="@ui["novels.read.notes.searchAria"]" />
    </div>

    <section data-notes-search-section hidden aria-labelledby="novel-notes-search-heading">
        <h3 id="novel-notes-search-heading">@ui["novels.read.notes.searchResultsHeading"]</h3>
        <p class="novel-notes-status" data-search-status role="status" aria-live="polite"></p>
        <div class="novel-note-list" data-search-list></div>
        <button type="button" class="novel-drawer-more" data-search-more hidden>@ui["novels.read.notes.loadMore"]</button>
    </section>

    <section data-notes-section="bookmarks" aria-labelledby="novel-notes-bookmarks-heading">
        <h3 id="novel-notes-bookmarks-heading">@ui["novels.read.notes.tabBookmarks"]</h3>
        <p class="novel-notes-empty @(annotations.Bookmarks.Count == 0 ? "" : "is-hidden")" data-empty-bookmarks>@ui["novels.read.notes.noBookmarksInChapter"]</p>
        <div class="novel-note-list" data-bookmark-list>
            @foreach (var bookmark in annotations.Bookmarks.OrderByDescending(x => x.CreatedAt))
            {
                <article class="novel-note-card"
                         data-bookmark-card
                         data-bookmark-id="@bookmark.Id"
                         data-bookmark-chapter-id="@bookmark.ChapterId"
                         data-bookmark-style="@(bookmark.Style ?? settings.BookmarkStyle)"
                         data-bookmark-color="@(bookmark.Color ?? settings.BookmarkColor)"
                         data-note-kind="bookmarks"
                         data-note-id="@bookmark.Id"
                         data-bookmark-label="@bookmark.Label"
                         data-position-permille="@bookmark.PositionPermille">
                    <a href="/Novels/Read/@bookmark.ChapterId?bookmark=@bookmark.Id"
                       data-local-bookmark-id="@bookmark.Id">
                        <small class="novel-note-chapter">@(Model.Chapter.IsEpubVolume
                            ? ui.Format("novels.read.notes.volumeChapterWithTitle", ("volume", Model.Chapter.VolumeNumber), ("number", Model.Chapter.Number), ("title", Model.Chapter.Title))
                            : ui.Format("novels.read.notes.chapterWithTitle", ("number", Model.Chapter.Number), ("title", Model.Chapter.Title)))</small>
                        <strong>@(bookmark.Label ?? ui.Format("novels.read.notes.bookmarkPositionLabel", ("percent", bookmark.PositionPermille / 10)))</strong>
                        @if (!string.IsNullOrWhiteSpace(bookmark.AnchorText))
                        {
                            <span>@bookmark.AnchorText</span>
                        }
                    </a>
                    <div class="novel-note-actions">
                        <button class="novel-note-edit"
                                type="button"
                                data-edit-bookmark-button
                                data-bookmark-id="@bookmark.Id"
                                aria-label="@ui["novels.read.notes.renameBookmarkAria"]">@ui["novels.read.notes.edit"]</button>
                        <button class="novel-note-remove"
                                type="button"
                                data-remove-bookmark-button
                                data-bookmark-id="@bookmark.Id"
                                aria-label="@ui["novels.read.notes.removeBookmarkAria"]">@ui["common.remove"]</button>
                    </div>
                </article>
            }
        </div>
        @if (annotations.OtherChapterBookmarkCount > 0)
        {
            <div class="novel-other-notes" data-other-notes="bookmarks">
                <button type="button"
                        class="novel-other-notes-toggle"
                        data-other-notes-toggle="bookmarks"
                        aria-expanded="false">
                    @ui["novels.read.notes.otherChapters"] · <span data-other-notes-count="bookmarks">@annotations.OtherChapterBookmarkCount</span>
                </button>
                <div class="novel-note-list" data-other-note-list="bookmarks" hidden></div>
                <button type="button" class="novel-drawer-more" data-other-notes-more="bookmarks" hidden>@ui["novels.read.notes.loadMore"]</button>
            </div>
        }
    </section>

    <section data-notes-section="highlights" aria-labelledby="novel-notes-highlights-heading">
        <h3 id="novel-notes-highlights-heading">@ui["novels.read.notes.tabHighlights"]</h3>
        <p class="novel-notes-empty @(annotations.Highlights.Count == 0 ? "" : "is-hidden")" data-empty-highlights>@ui["novels.read.notes.noHighlightsYet"]</p>
        <div class="novel-note-list" data-highlight-list>
            @foreach (var highlight in annotations.Highlights.OrderByDescending(x => x.CreatedAt))
            {
                <article class="novel-note-card"
                         data-highlight-card
                         data-highlight-id="@highlight.Id"
                         data-note-kind="highlights"
                         data-note-id="@highlight.Id"
                         data-highlight-note="@highlight.Note">
                    <a href="/Novels/Read/@highlight.ChapterId?highlight=@highlight.Id"
                       data-local-highlight-id="@highlight.Id">
                        <small class="novel-note-chapter">@(Model.Chapter.IsEpubVolume
                            ? ui.Format("novels.read.notes.volumeChapterWithTitle", ("volume", Model.Chapter.VolumeNumber), ("number", Model.Chapter.Number), ("title", Model.Chapter.Title))
                            : ui.Format("novels.read.notes.chapterWithTitle", ("number", Model.Chapter.Number), ("title", Model.Chapter.Title)))</small>
                        <strong>@highlight.Text</strong>
                        @if (!string.IsNullOrWhiteSpace(highlight.Note))
                        {
                            <span>@highlight.Note</span>
                        }
                    </a>
                    <div class="novel-note-actions">
                        <button class="novel-note-edit"
                                type="button"
                                data-edit-highlight-button
                                data-highlight-id="@highlight.Id"
                                aria-label="@ui["novels.read.notes.editHighlightNoteAria"]">@ui["novels.read.notes.edit"]</button>
                        <button class="novel-note-remove"
                                type="button"
                                data-remove-highlight-button
                                data-highlight-id="@highlight.Id"
                                aria-label="@ui["novels.read.notes.removeHighlightAria"]">@ui["common.remove"]</button>
                    </div>
                </article>
            }
        </div>
        @if (annotations.OtherChapterHighlightCount > 0)
        {
            <div class="novel-other-notes" data-other-notes="highlights">
                <button type="button"
                        class="novel-other-notes-toggle"
                        data-other-notes-toggle="highlights"
                        aria-expanded="false">
                    @ui["novels.read.notes.otherChapters"] · <span data-other-notes-count="highlights">@annotations.OtherChapterHighlightCount</span>
                </button>
                <div class="novel-note-list" data-other-note-list="highlights" hidden></div>
                <button type="button" class="novel-drawer-more" data-other-notes-more="highlights" hidden>@ui["novels.read.notes.loadMore"]</button>
            </div>
        }
    </section>

    <p class="novel-notes-status" data-other-notes-status role="status" aria-live="polite"></p>
</section>
