@page "/Pair"
@model Jularr.Web.Pages.Pair.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["pairing.approve.title"];
}

<div class="page-shell">
    <section class="panel">
        <span class="eyebrow">@ui["pairing.approve.eyebrow"]</span>
        <h1>@ui["pairing.approve.title"]</h1>
        <p class="muted">@ui["pairing.approve.description"]</p>

        @if (Model.Submitted && Model.Approved)
        {
            <p class="status-pill status-ok">@ui["pairing.approve.success"]</p>
        }
        else
        {
            <form method="post" asp-page-handler="Approve" class="form-stack">
                <label>
                    <span>@ui["pairing.approve.codeLabel"]</span>
                    <input name="Code"
                           value="@Model.Code"
                           inputmode="text"
                           autocomplete="one-time-code"
                           maxlength="9"
                           placeholder="K7M4-P2Q9"
                           autofocus />
                </label>
                <button class="button button-primary" type="submit">
                    @ui["pairing.approve.submit"]
                </button>
            </form>

            @if (Model.Submitted && !Model.Approved)
            {
                <p class="validation">@Model.ErrorMessage</p>
            }
        }
    </section>
</div>
