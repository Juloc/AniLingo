@page "/Books/ChapterArt/{id:guid}"
@model Jularr.Web.Pages.Books.ChapterArtModel
@using Jularr.Web.Features.ChapterArtwork
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["chapterArt.title"];
    var styles = Enum.GetValues<ChapterArtworkStyle>();
}
@section Head {
    <link rel="stylesheet" href="~/css/chapter-artwork.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" href="@Model.BackUrl">← @Model.WorkTitle</a>
        <h1>@ui["chapterArt.title"]</h1>
    </div>
</header>

@if (TempData["Status"] is string status)
{
    <p class="chapter-art-message">@status</p>
}

@if (!Model.Availability.CanGenerate)
{
    <p class="muted">@Jularr.Web.Pages.Books.ChapterArtModel.ReasonText(ui, Model.Availability.Reason)</p>
}

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["chapterArt.bookSettings"]</h2>
    </div>
    <form method="post" asp-page-handler="Settings" asp-route-id="@Model.WorkId" class="form-stack">
        <label>
            <span>@ui["chapterArt.title"]</span>
            <select name="enabled">
                <option value="" selected="@(Model.Settings.Enabled is null)">@ui["chapterArt.inherit"]</option>
                <option value="on" selected="@(Model.Settings.Enabled == true)">@ui["chapterArt.on"]</option>
                <option value="off" selected="@(Model.Settings.Enabled == false)">@ui["chapterArt.off"]</option>
            </select>
        </label>
        <label>
            <span>@ui["chapterArt.style"]</span>
            <select name="style">
                <option value="" selected="@(Model.Settings.Style is null)">@ui["chapterArt.inherit"]</option>
                @foreach (var style in styles)
                {
                    <option value="@ChapterArtworkNames.Style(style)" selected="@(Model.Settings.Style == style)">@ui[$"chapterArt.style.{ChapterArtworkNames.Style(style)}"]</option>
                }
            </select>
        </label>
        <label>
            <span>@ui["chapterArt.seriesStyle"]</span>
            <textarea name="seriesStyle" rows="2" maxlength="@ChapterArtworkWorkSettings.SeriesStyleLength">@Model.Settings.SeriesStyle</textarea>
        </label>
        <label class="chapter-art-check">
            <input type="checkbox" name="useChapterTitles" value="true" checked="@Model.Settings.UseChapterTitles" />
            <span>@ui["chapterArt.useChapterTitles"]</span>
        </label>
        <div class="inline-actions">
            <button class="button button-primary" type="submit">@ui["chapterArt.save"]</button>
        </div>
    </form>
</section>

<section class="chapter-art-list">
    @foreach (var chapter in Model.Chapters)
    {
        <article class="chapter-art-row">
            <div class="chapter-art-heading">
                <strong>@ui.Format("books.chapter.number", ("number", chapter.Number))</strong>
                <span class="muted">@chapter.Title</span>
            </div>

            <div class="chapter-art-images">
                @if (chapter.Accepted is { } accepted)
                {
                    <figure class="chapter-art-image">
                        <img src="@Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(accepted, 640)" alt="" loading="lazy" />
                        <figcaption>@ui["chapterArt.aiGenerated"]</figcaption>
                        <div class="inline-actions">
                            <form method="post" asp-page-handler="Remove" asp-route-id="@Model.WorkId">
                                <input type="hidden" name="artworkId" value="@accepted.Id" />
                                <button class="button" type="submit">@ui["chapterArt.remove"]</button>
                            </form>
                        </div>
                    </figure>
                }

                @foreach (var preview in chapter.Previews)
                {
                    <figure class="chapter-art-image chapter-art-preview">
                        <img src="@Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(preview, 640)" alt="" loading="lazy" />
                        <figcaption>@ui["chapterArt.aiGenerated"]</figcaption>
                        <div class="inline-actions">
                            <form method="post" asp-page-handler="Accept" asp-route-id="@Model.WorkId">
                                <input type="hidden" name="artworkId" value="@preview.Id" />
                                <button class="button button-primary" type="submit">@ui["chapterArt.accept"]</button>
                            </form>
                            <form method="post" asp-page-handler="Remove" asp-route-id="@Model.WorkId">
                                <input type="hidden" name="artworkId" value="@preview.Id" />
                                <button class="button" type="submit">@ui["chapterArt.discard"]</button>
                            </form>
                        </div>
                    </figure>
                }
            </div>

            <div class="inline-actions">
                @if (chapter.Active is { } active)
                {
                    <span class="muted">@(active.Status == ChapterArtworkStatus.Queued ? ui["chapterArt.status.queued"] : ui["chapterArt.status.generating"])</span>
                    <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.WorkId">
                        <input type="hidden" name="artworkId" value="@active.Id" />
                        <button class="button" type="submit">@ui["chapterArt.cancel"]</button>
                    </form>
                }
                else
                {
                    @if (chapter.Failed is { } failed && chapter.Accepted is null && chapter.Previews.Count == 0)
                    {
                        <span class="muted" title="@failed.Error">@(failed.Status == ChapterArtworkStatus.Failed ? ui["chapterArt.status.failed"] : ui["chapterArt.status.cancelled"])</span>
                    }

                    @if (Model.Availability.CanGenerate)
                    {
                        var hasImage = chapter.Accepted is not null || chapter.Previews.Count > 0;
                        <form method="post" asp-page-handler="Generate" asp-route-id="@Model.WorkId">
                            <input type="hidden" name="chapter" value="@chapter.Number" />
                            <input type="hidden" name="regenerate" value="@(hasImage ? "true" : "false")" />
                            <button class="button" type="submit">@(hasImage ? ui["chapterArt.regenerate"] : chapter.Failed is not null ? ui["chapterArt.retry"] : ui["chapterArt.generate"])</button>
                        </form>
                    }
                }
            </div>
        </article>
    }
</section>
