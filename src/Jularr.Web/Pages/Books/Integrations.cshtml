@page "/Books/Integrations"
@model Jularr.Web.Pages.Books.IntegrationsModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["books.integrations.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<a class="books-back" href="/Books">← @ui["nav.books"]</a>

<header class="books-settings-header">
    <h1>@ui["books.integrations.heading"]</h1>
    <p>@(Model.IsOwner ? ui["books.integrations.subtitle"] : ui["books.integrations.subtitleProfile"])</p>
</header>

<section class="books-integration-settings">
    <section>
        <h2>@ui["books.integrations.hardcoverTitle"]</h2>
        <p>@ui["books.integrations.hardcoverDescription"]</p>

        @if (Model.HardcoverAccount is not null)
        {
            <div class="books-integration-status">
                <span class="ready">@ui.Format("books.integrations.hardcoverConnectedAs", ("username", Model.HardcoverAccount.Username))</span>
                <form method="post" asp-page-handler="DisconnectHardcover">
                    <button class="button" type="submit">@ui["books.integrations.hardcoverDisconnect"]</button>
                </form>
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="ConnectHardcover" class="books-stack-form">
                <label>
                    @ui["books.integrations.hardcoverTokenLabel"]
                    <input type="password"
                           name="HardcoverAccessToken"
                           autocomplete="off"
                           spellcheck="false"
                           required
                           aria-describedby="hardcover-token-help" />
                </label>
                <small id="hardcover-token-help">
                    <a href="@Jularr.Web.Features.Books.BookCatalogService.HardcoverNewTokenUrl"
                       target="_blank"
                       rel="noopener noreferrer">@ui["books.integrations.hardcoverTokenLink"]</a>
                </small>
                <div>
                    <button class="button button-primary" type="submit">@ui["books.integrations.hardcoverConnect"]</button>
                </div>
            </form>
        }
    </section>
</section>

@if (Model.IsOwner)
{
<form method="post"
      asp-page-handler="Save"
      class="books-integration-settings">

    <section>
        <h2>SABnzbd</h2>
        <p>
            @ui["books.integrations.sabDescription"]
            <a href="/Admin/Usenet">@ui["books.integrations.sabSettingsLink"]</a>@ui["books.integrations.sabSettingsSuffix"]
        </p>

        <div class="books-integration-status">
            <span class="@(Model.SabConfigured ? "ready" : "")">
                @(Model.SabConfigured ? ui["books.integrations.configured"] : ui["books.integrations.notConfigured"])
            </span>
            @if (Model.SabConfigured)
            {
                <span>@ui.Format("books.integrations.booksCategory", ("category", Model.SabBooksCategory ?? ui["books.integrations.sabDefaultCategory"]))</span>
            }
            <a class="button" href="/Admin/Usenet">@ui["books.integrations.manageSab"]</a>
        </div>
    </section>

    <section>
        <h2>@ui["books.integrations.inboxTitle"]</h2>
        <p>
            @ui["books.integrations.inboxDescription1"]
            @ui["books.integrations.inboxDescription2a"] <code>.epub</code> @ui["books.integrations.inboxDescription2b"]
            @ui["books.integrations.inboxDescription3a"] <em>@ui["books.index.importInboxButton"]</em> @ui["books.integrations.inboxDescription3b"]
        </p>

        @if (Model.InboxEnvironmentOverride)
        {
            <div class="books-setting-note">
                @ui["books.integrations.envOverrideNote"]
            </div>
        }

        <label>
            @ui["books.integrations.inboxPathLabel"]
            <input type="text"
                   name="inboxPath"
                   value="@Model.Settings.InboxPath"
                   placeholder="/books-inbox" />
        </label>

        <span class="@(Model.InboxConfigured ? "ready" : "")">
            @(Model.InboxConfigured ? ui["books.integrations.configured"] : ui["books.integrations.notConfigured"])
        </span>
    </section>

    <div class="books-settings-save">
        <button class="button button-primary" type="submit">@ui["books.integrations.saveSettings"]</button>
    </div>
</form>

}
