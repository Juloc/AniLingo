@page
@model Jularr.Web.Pages.Settings.Prefetch.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.prefetch.title"];
}

<header class="page-header">
    <div>
        <h1>@ui["settings.prefetch.title"]</h1>
        <p>@ui["settings.prefetch.pageDescription"]</p>
    </div>
</header>

@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<form method="post" class="panel form-stack">
    <label>
        <input asp-for="Input.Enabled" type="checkbox" />
        <span>@ui["settings.prefetch.enabled"]</span>
    </label>

    <label>
        <span>@ui["settings.prefetch.cap"]</span>
        <select asp-for="Input.CapBytes">
            @foreach (var choice in Model.CapChoices)
            {
                <option value="@choice">@Jularr.Web.Pages.Settings.Prefetch.IndexModel.FormatCap(choice)</option>
            }
        </select>
    </label>

    <label>
        <input asp-for="Input.IncludeEpisodes" type="checkbox" />
        <span>@ui["settings.prefetch.episodes"]</span>
    </label>
    <label>
        <span>@ui["settings.prefetch.episodesAhead"]</span>
        <input asp-for="Input.EpisodesAhead" type="number" min="1" max="@Model.MaxEpisodesAhead" />
    </label>

    <label>
        <input asp-for="Input.IncludeChapters" type="checkbox" />
        <span>@ui["settings.prefetch.chapters"]</span>
    </label>
    <label>
        <span>@ui["settings.prefetch.chaptersAhead"]</span>
        <input asp-for="Input.ChaptersAhead" type="number" min="1" max="@Model.MaxChaptersAhead" />
    </label>

    <label>
        <input asp-for="Input.AllowMetered" type="checkbox" />
        <span>@ui["settings.prefetch.allowMetered"]</span>
    </label>

    <button class="button button-primary" type="submit">@ui["common.save"]</button>
</form>
