@page
@model Jularr.Web.Pages.Settings.OfflineModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.offline.title"];
}

<header class="page-header">
    <div>
        <h1>@ui["settings.offline.title"]</h1>
        <p>@ui["settings.offline.pageDescription"]</p>
    </div>
</header>

<div class="settings-grid" data-offline-settings-page>
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.offline.storageTitle"]</h2>
        </div>
        <p data-offline-usage class="muted">…</p>
        <p data-offline-degraded class="metadata-error" hidden>@ui["settings.offline.degraded"]</p>
        <label class="offline-wifi-toggle">
            <input type="checkbox" data-offline-wifi-only />
            @ui["settings.offline.wifiOnly"]
        </label>
        <div class="inline-actions">
            <a class="button" asp-page="/Settings/Prefetch/Index">@ui["settings.offline.prefetchManage"]</a>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.offline.booksTitle"]</h2>
        </div>
        <div data-offline-list class="muted">…</div>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.offline.mediaTitle"]</h2></div>
        <p class="muted">@ui["settings.offline.mediaDescription"]</p>
        <div class="settings-list">
            @foreach (var item in Model.Media)
            {
                <div class="settings-row">
                    <span>@item.Title</span>
                    @if (item.Kind == "episode")
                    {
                        <button class="button" type="button" data-offline-episode-save="@item.Id">@ui["offlineLibrary.action.saveButton"]</button>
                    }
                    else
                    {
                        <button class="button" type="button" data-offline-media-save="@item.Id" data-offline-media-kind="@item.Kind">@ui["offlineLibrary.action.saveButton"]</button>
                    }
                    <small data-offline-media-status></small>
                </div>
            }
        </div>
    </section>
</div>

@* offline-library-*.js are loaded once, globally, from _Layout.cshtml (#221 part 2). *@
