@page
@model Jularr.Web.Pages.Settings.AiModel
@using System.Text.Json
@using Jularr.Web.Features.Ai
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.ai.title"];
    var isServer = Model.ProviderId == AiProviderIds.Server;
    var serverCatalog = Model.ServerCatalog;
    var personalCatalog = Model.PersonalCatalog;
    var efforts = Model.ReasoningOptionsFor(Model.ServerModel);
    var tiers = Model.ServiceTierOptionsFor(Model.ServerModel);
    var allEfforts = AiOptionResolver.AllReasoningOptions(serverCatalog);
    var effortMap = serverCatalog.Models.ToDictionary(x => x.Id, x => x.ReasoningEfforts.Select(e => e.Effort).ToArray());
    var connection = Model.Connection;
    var preset = Model.BookPreset;
    var modes = new[]
    {
        (AiTranslationMode.Efficient, ui["settings.ai.efficient"], ui["settings.ai.efficientHint"]),
        (AiTranslationMode.Quality, ui["settings.ai.quality"], ui["settings.ai.qualityHint"]),
        (AiTranslationMode.Maximum, ui["settings.ai.maximum"], ui["settings.ai.maximumHint"])
    };
    var discoverUrl = Url.Page("/Settings/Ai", "DiscoverModels");
}
@section Head {
    <link rel="stylesheet" href="~/css/ai.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← @ui["nav.settings"]</a>
        <h1>@ui["settings.ai.title"]</h1>
        <p>@ui["settings.ai.description"]</p>
    </div>
</header>

<div class="settings-grid ai-settings-layout">
    <section class="panel">
        <form method="post" class="form-stack" data-ai-settings
              data-saved-provider="@Model.SavedProviderId"
              data-discover-url="@(Model.DiscoverOnLoad ? discoverUrl : null)"
              data-label-loading="@ui["ai.models.loading"]"
              data-label-failed="@ui["ai.models.refreshFailed"]"
              data-label-show="@ui["ai.models.show"]">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="ai-provider-row">
                <label>
                    <span>@ui["settings.ai.provider"]</span>
                    <select asp-for="ProviderId" data-ai-provider>
                        <option value="@AiProviderIds.Server">@ui["settings.ai.server"]</option>
                        <option value="@AiProviderIds.OpenAiCompatible">@ui["settings.ai.openaiCompatible"]</option>
                    </select>
                </label>
                <span class="ai-connection" data-ai-saved-only>
                    @if (Model.SavedProviderId == AiProviderIds.OpenAiCompatible)
                    {
                        <span class="status-pill @(connection?.IsAuthenticated == true ? "status-ok" : "status-warn")">
                            @(connection?.IsAuthenticated == true ? ui["settings.ai.status.configured"] : ui["settings.ai.status.incomplete"])
                        </span>
                    }
                    else if (connection is null)
                    {
                        <span class="status-pill">@ui["settings.ai.status.notChecked"]</span>
                    }
                    else if (connection.IsAuthenticated)
                    {
                        <span class="status-pill status-ok">@ui["settings.ai.status.connected"]</span>
                    }
                    else
                    {
                        <span class="status-pill status-error">@(connection.IsAvailable ? ui["settings.ai.status.notConnected"] : ui["settings.ai.status.unavailable"])</span>
                    }
                </span>
            </div>

            <div class="form-stack" data-ai-provider-fields="@AiProviderIds.Server" hidden="@(!isServer)">
                <div class="ai-model-field">
                    <label>
                        <span>@ui["settings.ai.model"]</span>
                        @if (serverCatalog.HasModels)
                        {
                            <select asp-for="ServerModel" data-ai-model>
                                @foreach (var entry in serverCatalog.Models)
                                {
                                    <option value="@entry.Id">@AiViewFormat.ModelOption(ui, entry)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input asp-for="ServerModel" autocomplete="off" spellcheck="false" placeholder="@ui["ai.models.manualPlaceholder"]" />
                        }
                    </label>
                    <div class="ai-model-status">
                        <small class="muted" data-ai-catalog-status="@AiProviderIds.Server">@AiViewFormat.CatalogStatus(ui, serverCatalog, Model.Now)</small>
                        <button class="button ai-button-small" type="submit" asp-page-handler="RefreshModels" formnovalidate>@ui["ai.models.refresh"]</button>
                    </div>
                    @if (Model.UnavailableServerModel is { } unavailable)
                    {
                        <small class="ai-note">@ui.Format("ai.models.replaced", ("model", unavailable), ("default", serverCatalog.Find(Model.ServerModel)?.DisplayName ?? Model.ServerModel ?? "—"))</small>
                    }
                    @if (Model.ServerModelMissing)
                    {
                        <small class="ai-note ai-note-warn" data-ai-model-warning hidden="@Model.DiscoverOnLoad">@ui["ai.models.required"]</small>
                    }
                </div>

                <label data-ai-effort-field hidden="@(allEfforts.Count == 0 || efforts.Count == 0)">
                    <span>@ui["ai.settings.reasoning"]</span>
                    <select asp-for="ReasoningEffort" data-ai-effort data-efforts="@JsonSerializer.Serialize(effortMap)">
                        <option value="">@ui["ai.settings.reasoningAuto"]</option>
                        @foreach (var option in allEfforts)
                        {
                            <option value="@option.Effort" hidden="@(!efforts.Any(x => x.Effort == option.Effort))">@AiViewFormat.Effort(ui, option.Effort)</option>
                        }
                    </select>
                </label>
            </div>

            <div class="form-stack" data-ai-provider-fields="@AiProviderIds.OpenAiCompatible" hidden="@isServer">
                <label>
                    <span>@ui["settings.ai.baseUrl"]</span>
                    <input asp-for="BaseUrl" type="url" autocomplete="url" placeholder="https://api.openai.com/v1" />
                </label>

                <label>
                    <span>@ui["settings.ai.apiKey"]</span>
                    <input asp-for="ApiKey" type="password" autocomplete="new-password" />
                    @if (Model.HasStoredApiKey)
                    {
                        <small class="muted">@ui["settings.ai.apiKeyKeep"]</small>
                    }
                </label>

                <div class="ai-model-field">
                    <label>
                        <span>@ui["settings.ai.model"]</span>
                        <input asp-for="ModelName" autocomplete="off" spellcheck="false" list="ai-personal-models" placeholder="@ui["ai.models.manualPlaceholder"]" />
                        <datalist id="ai-personal-models">
                            @foreach (var entry in personalCatalog.Models)
                            {
                                <option value="@entry.Id"></option>
                            }
                        </datalist>
                    </label>
                    <div class="ai-model-status">
                        <small class="muted" data-ai-catalog-status="@AiProviderIds.OpenAiCompatible">@AiViewFormat.CatalogStatus(ui, personalCatalog, Model.Now)</small>
                        <button class="button ai-button-small" type="submit" asp-page-handler="RefreshModels">@ui["ai.models.refresh"]</button>
                    </div>
                </div>
            </div>

            <fieldset class="ai-mode">
                <legend>@ui["settings.ai.translationMode"]</legend>
                <div class="ai-mode-options">
                    @foreach (var (mode, name, hint) in modes)
                    {
                        <label class="ai-mode-option">
                            <input type="radio" name="TranslationMode" value="@mode" checked="@(Model.TranslationMode == mode)" />
                            <strong>@name</strong>
                            <span>@hint</span>
                        </label>
                    }
                </div>
                <small class="muted">@ui["settings.ai.translationModeHint"]</small>
            </fieldset>

            <div class="ai-preset" data-ai-saved-only>
                <div>
                    <strong>@ui["settings.ai.bookPreset.title"]</strong>
                    @if (preset is null)
                    {
                        <span class="muted">@ui["settings.ai.bookPreset.unavailable"]</span>
                    }
                    else
                    {
                        <span class="muted">
                            @ui.Format("settings.ai.bookPreset.summary", ("model", serverCatalog.Find(preset.Model)?.DisplayName ?? preset.Model))
                            @if (preset.TranslationEffort is not null || preset.LightEffort is not null)
                            {
                                @ui.Format(
                                    "settings.ai.bookPreset.reasoning",
                                    ("translation", preset.TranslationEffort is { } heavy ? AiViewFormat.Effort(ui, heavy) : ui["ai.settings.reasoningAuto"]),
                                    ("light", preset.LightEffort is { } light ? AiViewFormat.Effort(ui, light) : ui["ai.settings.reasoningAuto"]))
                            }
                        </span>
                    }
                </div>
                @if (Model.BookPresetActive)
                {
                    <span class="status-pill status-ok">@ui["settings.ai.bookPreset.active"]</span>
                }
                else if (preset is not null)
                {
                    <button class="button" type="submit" asp-page-handler="ApplyBookPreset">@ui["settings.ai.bookPreset.apply"]</button>
                }
            </div>

            <div class="inline-actions">
                <button class="button button-primary" type="submit" asp-page-handler="Save">
                    @ui["settings.ai.save"]
                </button>
                <button class="button" type="submit" asp-page-handler="Test">
                    @ui["settings.ai.test"]
                </button>
            </div>

            <details class="ai-advanced">
                <summary>@ui["ai.settings.advanced"]</summary>

                @if (isServer && tiers.Count > 0)
                {
                    <label data-ai-provider-fields="@AiProviderIds.Server">
                        <span>@ui["ai.settings.serviceTier"]</span>
                        <select asp-for="ServiceTier">
                            <option value="">@ui["ai.settings.modelDefault"]</option>
                            @foreach (var tier in tiers)
                            {
                                <option value="@tier.Id">@tier.Name</option>
                            }
                        </select>
                    </label>
                }

                <label data-ai-provider-fields="@AiProviderIds.OpenAiCompatible" hidden="@isServer">
                    <span>@ui["ai.settings.maxOutputTokens"]</span>
                    <input asp-for="MaxOutputTokens" type="number" min="1" max="@AiProfileSettings.MaxOutputTokensLimit" placeholder="@ui["ai.settings.providerLimit"]" />
                </label>

                <label data-ai-provider-fields="@AiProviderIds.OpenAiCompatible" hidden="@isServer">
                    <span>@ui["settings.ai.imageModel"]</span>
                    <input asp-for="ImageModel" autocomplete="off" spellcheck="false" />
                </label>

                <div class="ai-overrides-block">
                    <p class="muted" data-ai-saved-only>@ui["ai.settings.overridesIntro"]</p>
                    <p class="muted" data-ai-switched-only hidden>@ui["ai.settings.overridesAfterSave"]</p>
                    <table class="ai-table ai-overrides" data-ai-saved-only>
                        <thead>
                            <tr>
                                <th scope="col">@ui["ai.settings.operation"]</th>
                                <th scope="col">@ui["settings.ai.model"]</th>
                                @if (isServer && allEfforts.Count > 0)
                                {
                                    <th scope="col">@ui["ai.settings.reasoning"]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var operation in AiOperations.ProfileConfigurable)
                            {
                                var selectedModel = Model.OverrideModels.GetValueOrDefault(operation);
                                var selectedEffort = Model.OverrideEfforts.GetValueOrDefault(operation);
                                var operationName = AiViewFormat.Operation(ui, operation);
                                <tr>
                                    <th scope="row">@operationName</th>
                                    <td data-label="@ui["settings.ai.model"]">
                                        @if (isServer && serverCatalog.HasModels)
                                        {
                                            <select name="OverrideModels[@operation]" aria-label="@operationName: @ui["settings.ai.model"]">
                                                <option value="">@ui["ai.settings.inherit"]</option>
                                                @foreach (var entry in serverCatalog.Models)
                                                {
                                                    <option value="@entry.Id" selected="@(entry.Id == selectedModel)">@entry.DisplayName</option>
                                                }
                                                @if (selectedModel is not null && serverCatalog.Find(selectedModel) is null)
                                                {
                                                    <option value="@selectedModel" selected>@ui.Format("ai.models.notInCatalog", ("model", selectedModel))</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input name="OverrideModels[@operation]" value="@selectedModel" autocomplete="off" spellcheck="false"
                                                   list="@(isServer ? null : "ai-personal-models")" placeholder="@ui["ai.settings.inherit"]" aria-label="@operationName: @ui["settings.ai.model"]" />
                                        }
                                    </td>
                                    @if (isServer && allEfforts.Count > 0)
                                    {
                                        <td data-label="@ui["ai.settings.reasoning"]">
                                            <select name="OverrideEfforts[@operation]" aria-label="@operationName: @ui["ai.settings.reasoning"]">
                                                <option value="">@ui["ai.settings.inherit"]</option>
                                                @foreach (var option in allEfforts)
                                                {
                                                    <option value="@option.Effort" selected="@(option.Effort == selectedEffort)">@AiViewFormat.Effort(ui, option.Effort)</option>
                                                }
                                            </select>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="inline-actions">
                    <button class="button" type="submit" asp-page-handler="Reset" formnovalidate>
                        @ui["settings.ai.reset"]
                    </button>
                </div>
            </details>
        </form>
    </section>

    <div class="form-stack ai-settings-side">
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.ai.usageTitle"]</h2>
            </div>
            <partial name="_AiUsage" model="new AiUsagePanel(ui, Model.Usage, false, "/Settings/Ai", Sections: AiUsageSections.Totals)" />
        </section>

        @if (Model.SavedProviderId == AiProviderIds.Server)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>@ui["ai.quota.title"]</h2>
                </div>
                <partial name="_AiQuota" model="new AiQuotaPanel(ui, Model.Quota, false)" />
            </section>
        }

        @if (Model.IsOwner)
        {
            <section class="panel">
                <p class="muted">@ui["settings.ai.serverDescription"]</p>
                <a class="button" asp-page="/Admin/Ai">@ui["settings.ai.serverManage"]</a>
            </section>
        }
    </div>
</div>

<section class="panel ai-section">
    <div class="panel-heading">
        <h2>@ui["settings.ai.recentUsage"]</h2>
    </div>
    <partial name="_AiActivity" model="Model.Activity" />
</section>

@if (!Model.Usage.Selected.IsEmpty)
{
    <details class="panel ai-section ai-usage-details">
        <summary>@ui["ai.usage.details"]</summary>
        <partial name="_AiUsage" model="new AiUsagePanel(ui, Model.Usage, false, "/Settings/Ai", Sections: AiUsageSections.Breakdown)" />
    </details>
}

<partial name="_ChapterArtworkPreferences" model="Model.Ui" />

@section Scripts {
    <script src="~/js/ai-settings.js" asp-append-version="true"></script>
    <script src="~/js/ai-activity.js" asp-append-version="true"></script>
}
