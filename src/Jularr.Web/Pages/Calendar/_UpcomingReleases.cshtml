@using Jularr.Web.Features.Calendar
@model UpcomingReleasesModel
@{
    var ui = Model.Ui;
}
<link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
<section class="panel calendar-upcoming">
    <div class="panel-heading">
        <h2>@(Model.Events.Count == 1 ? ui["calendar.upcoming.next"] : ui["calendar.upcoming.heading"])</h2>
        <a class="text-link" href="@Model.CalendarHref">@ui["calendar.upcoming.open"]</a>
    </div>
    <ul class="calendar-events">
        @foreach (var release in Model.Events)
        {
            <partial name="/Pages/Calendar/_ReleaseEventRow.cshtml" model="new ReleaseEventRowModel(release, Model.Presenter, ShowDate: true, Compact: true)" />
        }
    </ul>
</section>
