@page "/Calendar"
@using Jularr.Web.Features.Calendar
@model Jularr.Web.Pages.Calendar.IndexModel
@{
    var ui = Model.Ui;
    var presenter = Model.Presenter;
    ViewData["Title"] = ui["calendar.title"];
    const int monthCellLimit = 3;
    var views = new[]
    {
        (View: CalendarView.Month, Label: ui["calendar.view.month"]),
        (View: CalendarView.Week, Label: ui["calendar.view.week"]),
        (View: CalendarView.Agenda, Label: ui["calendar.view.agenda"])
    };
    var weekdays = Enumerable.Range(0, 7).Select(offset => (DayOfWeek)(((int)presenter.FirstDayOfWeek + offset) % 7)).ToArray();
    var imprecise = Model.Imprecise;
}
@section Head {
    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
}

<div class="calendar-page" data-calendar-zone="@Model.ZoneId">
    <header class="calendar-header">
        <h1>@ui["calendar.title"]</h1>
        <nav class="calendar-views" aria-label="@ui["calendar.viewsAria"]">
            @foreach (var item in views)
            {
                <a class="@(Model.View == item.View ? "active" : null)"
                   aria-current="@(Model.View == item.View ? "page" : null)"
                   href="@Model.Link(view: item.View)">@item.Label</a>
            }
        </nav>
    </header>

    <div class="calendar-toolbar">
        <div class="calendar-period">
            <a class="calendar-step" href="@Model.Link(date: Model.Previous)" aria-label="@ui["calendar.previous"]">&lsaquo;</a>
            <a class="calendar-step" href="@Model.Link(date: Model.Next)" aria-label="@ui["calendar.next"]">&rsaquo;</a>
            <h2>@Model.Title</h2>
            @if (!Model.ShowsToday)
            {
                <a class="chip" href="@Model.Link(today: true)">@ui["calendar.today"]</a>
            }
        </div>
        <div class="calendar-filters">
            <nav class="calendar-filter-row" aria-label="@ui["calendar.filter.typeAria"]">
                <a class="chip@(Model.MediaType is null ? " selected" : "")" href="@Model.Link(allTypes: true)">@ui["calendar.filter.all"]</a>
                @foreach (var type in Model.MediaTypes)
                {
                    <a class="chip@(Model.MediaType == type ? " selected" : "")" href="@Model.Link(type: type)">@presenter.FilterLabel(type)</a>
                }
            </nav>
            <nav class="calendar-filter-row" aria-label="@ui["calendar.filter.stateAria"]">
                @foreach (var state in Enum.GetValues<ReleaseStateFilter>())
                {
                    <a class="chip@(Model.State == state ? " selected" : "")" href="@Model.Link(state: state)">@presenter.StateFilterLabel(state)</a>
                }
            </nav>
        </div>
    </div>

    @if (Model.Result.FailedSources.Count > 0)
    {
        <p class="calendar-notice" role="status">@ui["calendar.sourceUnavailable"]</p>
    }

    @switch (Model.View)
    {
        case CalendarView.Month:
            <div class="calendar-month">
                <div class="calendar-weekdays" aria-hidden="true">
                    @foreach (var weekday in weekdays)
                    {
                        <span>@presenter.WeekdayShort(weekday)</span>
                    }
                </div>
                <ol class="calendar-month-grid">
                    @foreach (var day in Model.Result.Days)
                    {
                        var outside = day.Date < Model.PeriodStart || day.Date > Model.PeriodEnd;
                        var classes = "calendar-cell"
                            + (outside ? " is-outside" : "")
                            + (day.Date == presenter.Today ? " is-today" : "")
                            + (day.Events.Count == 0 ? " is-empty" : "");
                        <li class="@classes">
                            <a class="calendar-cell-date" href="@Model.Link(view: CalendarView.Week, date: day.Date)" aria-label="@presenter.DayHeading(day.Date)">
                                <span class="calendar-cell-weekday">@presenter.WeekdayShort(day.Date.DayOfWeek)</span>
                                <span>@day.Date.Day</span>
                            </a>
                            @if (day.Events.Count > 0)
                            {
                                <ul class="calendar-cell-events">
                                    @foreach (var release in day.Events.Take(monthCellLimit))
                                    {
                                        var href = ReleaseCalendarPresenter.Href(release);
                                        var unit = presenter.UnitLabel(release);
                                        var time = presenter.TimeLabel(release.Date);
                                        <li class="calendar-pill calendar-type-@ReleaseCalendarPresenter.FilterValue(release.MediaType).ToLowerInvariant()">
                                            <a href="@(href ?? Model.Link(view: CalendarView.Week, date: day.Date))" title="@release.Title · @unit">
                                                @if (time is not null)
                                                {
                                                    <span class="calendar-pill-time">@time</span>
                                                }
                                                <span class="calendar-pill-title">@release.Title</span>
                                                @if (!string.IsNullOrEmpty(unit))
                                                {
                                                    <span class="calendar-pill-unit">@unit</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                </ul>
                                @if (day.Events.Count > monthCellLimit)
                                {
                                    <a class="calendar-more" href="@Model.Link(view: CalendarView.Week, date: day.Date)">@ui.Format("calendar.more", ("count", day.Events.Count - monthCellLimit))</a>
                                }
                            }
                        </li>
                    }
                </ol>
            </div>
            break;

        case CalendarView.Week:
            <ol class="calendar-week">
                @foreach (var day in Model.Result.Days)
                {
                    <li class="calendar-week-day@(day.Date == presenter.Today ? " is-today" : "")@(day.Events.Count == 0 ? " is-empty" : "")">
                        <h3>@presenter.DayHeading(day.Date)</h3>
                        @if (day.Events.Count > 0)
                        {
                            <ul class="calendar-events">
                                @foreach (var release in day.Events)
                                {
                                    <partial name="_ReleaseEventRow" model="new ReleaseEventRowModel(release, presenter, ShowDate: false)" />
                                }
                            </ul>
                        }
                    </li>
                }
            </ol>
            break;

        default:
            var agendaDays = Model.Result.Days.Where(day => day.Events.Count > 0).ToArray();
            if (agendaDays.Length == 0 && imprecise.Count == 0)
            {
                <p class="calendar-empty">@ui["calendar.empty"]</p>
            }
            <div class="calendar-agenda">
                @foreach (var day in agendaDays)
                {
                    <section class="calendar-day@(day.Date == presenter.Today ? " is-today" : "")">
                        <h3>@presenter.DayHeading(day.Date)</h3>
                        <ul class="calendar-events">
                            @foreach (var release in day.Events)
                            {
                                <partial name="_ReleaseEventRow" model="new ReleaseEventRowModel(release, presenter, ShowDate: false)" />
                            }
                        </ul>
                    </section>
                }
            </div>
            break;
    }

    @if (Model.View != CalendarView.Agenda && Model.Result.IsEmpty)
    {
        <p class="calendar-empty">@ui["calendar.empty"]</p>
    }

    @if (imprecise.Count > 0)
    {
        <section class="calendar-imprecise">
            <h2>@ui["calendar.imprecise.heading"]</h2>
            <ul class="calendar-events">
                @foreach (var release in imprecise)
                {
                    <partial name="_ReleaseEventRow" model="new ReleaseEventRowModel(release, presenter, ShowDate: true)" />
                }
            </ul>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/calendar.js" asp-append-version="true" defer></script>
}
