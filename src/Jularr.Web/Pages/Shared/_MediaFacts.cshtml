@model Jularr.Web.Features.MediaFacts.MediaFactsStripModel
@using Jularr.Web.Features.MediaFacts
@* Unified media-facts + language-availability strip (#426), shared by Library/Anime,
   Manga/Series, Novels/Work and Books/Details. Built with MediaFactsStripModel.Create so this
   partial only ever renders what that model already decided is present; it never invents a
   value or a heading. Styles: wwwroot/css/media-facts.css. *@
@if (Model.HasFacts || Model.HasLanguages)
{
    <div class="media-facts">
        @if (Model.HasFacts)
        {
            <div class="media-facts-row" role="group" aria-label="@Model.FactsAriaLabel">
                @if (Model.Status is { } status)
                {
                    <span class="media-facts-status media-facts-status-@status.CssModifier">
                        <span class="media-facts-status-dot" aria-hidden="true"></span>
                        @status.Label
                    </span>
                }
                @foreach (var chip in Model.Chips)
                {
                    <span class="media-facts-chip">@chip</span>
                }
            </div>
        }

        @if (Model.HasLanguages)
        {
            <ul class="media-facts-languages" aria-label="@Model.LanguagesAriaLabel">
                @foreach (var group in Model.LanguageGroups)
                {
                    <li>
                        <span class="media-facts-lang-icon" role="img" aria-label="@group.Label">
                            <partial name="_MediaFactsLanguageIcon" model="group.Usage" />
                        </span>
                        @foreach (var chip in group.Chips)
                        {
                            <span class="media-facts-lang-chip@(chip.IsPartial ? " is-partial" : "")"
                                  title="@chip.PartialLabel">
                                @chip.Code
                                @if (chip.Fraction is not null)
                                {
                                    <text> @chip.Fraction</text>
                                }
                                @if (chip.PartialLabel is not null)
                                {
                                    <span class="sr-only"> (@chip.PartialLabel)</span>
                                }
                            </span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}
