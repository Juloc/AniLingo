@*
    One path text field of a settings form (#604). A browsable field gets the Browse button of the
    shared folder browser (_FolderBrowser, once per page) and a live check of what the Jularr
    container sees at the typed path; the text field itself always stays editable. Behaviour lives
    in wwwroot/js/folder-browser.js; without JavaScript this is a plain text field.
*@
@using Jularr.Web.Features.Storage.FolderBrowse
@model PathFieldModel
@{
    var ui = Model.Ui;
    var browsable = Model.Browsable && !Model.Disabled;
    var inputId = $"path-{Model.Id}";
}
<div class="path-field" data-path-field="@(browsable ? "browse" : "plain")" data-pair-group="@Model.PairGroup">
    <label for="@inputId"><span>@Model.Label</span></label>
    <div class="path-field-row">
        <input id="@inputId" type="text" name="@Model.Name" value="@Model.Value" placeholder="@Model.Placeholder"
               required="@Model.Required" disabled="@Model.Disabled" autocomplete="off" spellcheck="false" />
        @if (browsable)
        {
            <button type="button" class="button" data-path-browse aria-haspopup="dialog">@ui["storage.folderBrowser.browse"]</button>
        }
    </div>
    @if (browsable)
    {
        <ul class="folder-checks" data-path-checks aria-live="polite"></ul>
    }
</div>
