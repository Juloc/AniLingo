@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider FileVersions
@model string
@{
    var iconName = Model?.Trim();
    if (string.IsNullOrWhiteSpace(iconName)
        || iconName.Any(character => !char.IsAsciiLetterOrDigit(character) && character != '-'))
    {
        throw new ArgumentException("Icon names may contain only ASCII letters, digits, and hyphens.", nameof(Model));
    }

    var spriteUrl = FileVersions.AddFileVersionToPath(
        ViewContext.HttpContext.Request.PathBase,
        "/build/icons.svg");
}
<svg class="icon icon--@iconName" aria-hidden="true" focusable="false">
    <use href="@spriteUrl#app-@iconName"></use>
</svg>
