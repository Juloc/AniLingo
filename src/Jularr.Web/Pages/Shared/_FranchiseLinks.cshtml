@model Jularr.Web.Features.Franchises.FranchiseLinksViewModel
@using Jularr.Web.Features.Watchlist
@* No visible heading (#519): the section's aria-label already names it for assistive tech, and
   an uppercase "Franchise" label above one or two links is unnecessary. The per-group headings
   below name a specific relation (Sequels, Spin-offs, ...), so they are not a repeat of it. *@
@if (Model.Franchises.Count > 0)
{
    <section class="franchise-links-panel" aria-label="@Model.Ui["franchise.sectionTitle"]">
        <div class="franchise-links-list">
            @foreach (var franchise in Model.Franchises)
            {
                <a href="/Franchises/@franchise.Id">
                    <span>@Jularr.Web.Features.Franchises.FranchiseLabels.Title(Model.Ui, franchise.Title)</span>
                    <small>@Model.Ui.Format("franchise.memberCount", ("count", franchise.MemberCount))</small>
                </a>
            }
        </div>

        @if (Model.Groups.Count > 0)
        {
            <div class="franchise-related-groups">
                @foreach (var group in Model.Groups)
                {
                    <div class="franchise-related-group">
                        <h3>@Model.Ui[group.GroupKey]</h3>
                        <ul class="franchise-related-items">
                            @foreach (var item in group.Items)
                            {
                                <li>
                                    <a href="/Franchises/@Model.Franchises[0].Id">
                                        <span>@item.Title</span>
                                        <small>@Model.Ui[$"watchlist.type.{WatchlistMediaTypeNames.ToCategory(item.Identity.MediaType)}"]</small>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </section>
}
