@*
    Durable AI usage (#422): today / 7 / 30 day totals and per-feature, per-model (and, for the
    owner, per-profile) breakdowns. Values prefixed with "~" include estimates.
*@
@using Jularr.Web.Features.Ai
@model AiUsagePanel
@{
    var ui = Model.Ui;
    var report = Model.Report;
    var selected = report.Selected;
    var periods = new[]
    {
        (AiUsagePeriod.Today, "today", ui["ai.usage.today"], report.Today),
        (AiUsagePeriod.Last7Days, "7d", ui["ai.usage.last7Days"], report.Last7Days),
        (AiUsagePeriod.Last30Days, "30d", ui["ai.usage.last30Days"], report.Last30Days)
    };
    var showTotals = Model.Sections != AiUsageSections.Breakdown;
    var showBreakdown = Model.Sections != AiUsageSections.Totals;
}
@if (showTotals)
{
    <nav class="ai-period-tabs" aria-label="@ui["ai.usage.periodAria"]">
        @foreach (var (period, value, label, totals) in periods)
        {
            <a href="@(Model.PagePath)?period=@value" aria-current="@(period == report.Period ? "page" : null)">
                <span>@label</span>
                <strong>@AiViewFormat.Tokens(totals.InputTokens + totals.OutputTokens, totals.EstimatedInputTokens + totals.EstimatedOutputTokens)</strong>
            </a>
        }
    </nav>
}

@if (selected.IsEmpty)
{
    <p class="muted">@ui["ai.usage.empty"]</p>
}
else
{
    if (showTotals)
    {
    <div class="status-list">
        <div><span>@ui["settings.ai.requests"]</span><strong>@AiViewFormat.Tokens(selected.Requests)</strong></div>
        <div><span>@ui["settings.ai.inputTokens"]</span><strong>@AiViewFormat.Tokens(selected.InputTokens, selected.EstimatedInputTokens)</strong></div>
        <div><span>@ui["ai.usage.cachedInput"]</span><strong>@AiViewFormat.Tokens(selected.CachedInputTokens)</strong></div>
        <div><span>@ui["settings.ai.outputTokens"]</span><strong>@AiViewFormat.Tokens(selected.OutputTokens, selected.EstimatedOutputTokens)</strong></div>
        @if (selected.ReasoningOutputTokens > 0)
        {
            <div><span>@ui["ai.usage.reasoningOutput"]</span><strong>@AiViewFormat.Tokens(selected.ReasoningOutputTokens)</strong></div>
        }
        @if (selected.ContextTokens > 0)
        {
            <div>
                <span>@ui["ai.usage.sharedContext"]</span>
                <strong>@(selected.FullContextTokens > selected.ContextTokens
                    ? ui.Format("ai.usage.contextOfFull", ("count", AiViewFormat.Tokens(selected.ContextTokens)), ("full", AiViewFormat.Tokens(selected.FullContextTokens)))
                    : "~" + AiViewFormat.Tokens(selected.ContextTokens))</strong>
            </div>
        }
        <div><span>@ui["settings.ai.cacheHits"]</span><strong>@AiViewFormat.Tokens(selected.CacheHits + selected.ResumedChunks)</strong></div>
        @if (selected.Failures + selected.Cancellations + selected.Retries > 0)
        {
            <div>
                <span>@ui["ai.usage.failures"]</span>
                <strong>@ui.Format("ai.usage.failureCounts", ("failed", selected.Failures), ("cancelled", selected.Cancellations), ("retries", selected.Retries))</strong>
            </div>
        }
    </div>

    @if (selected.HasEstimates)
    {
        <p class="muted">@ui["settings.ai.usageNote"]</p>
    }
    }

    if (showBreakdown)
    {
    <table class="ai-table">
        <thead>
            <tr>
                <th scope="col">@ui["ai.usage.byFeature"]</th>
                <th scope="col">@ui["settings.ai.requests"]</th>
                <th scope="col">@ui["settings.ai.inputTokens"]</th>
                <th scope="col">@ui["settings.ai.outputTokens"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in report.ByOperation)
            {
                <tr>
                    <th scope="row">@AiViewFormat.Operation(ui, group.Key)</th>
                    <td>@AiViewFormat.Tokens(group.Totals.Requests)</td>
                    <td>@AiViewFormat.Tokens(group.Totals.InputTokens, group.Totals.EstimatedInputTokens)</td>
                    <td>@AiViewFormat.Tokens(group.Totals.OutputTokens, group.Totals.EstimatedOutputTokens)</td>
                </tr>
            }
        </tbody>
    </table>

    <table class="ai-table">
        <thead>
            <tr>
                <th scope="col">@ui["ai.usage.byModel"]</th>
                <th scope="col">@ui["settings.ai.requests"]</th>
                <th scope="col">@ui["settings.ai.inputTokens"]</th>
                <th scope="col">@ui["settings.ai.outputTokens"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in report.ByModel)
            {
                var model = group.Key[(group.Key.IndexOf('\u001f') + 1)..];
                <tr>
                    <th scope="row">
                        @(string.IsNullOrEmpty(model) ? ui["ai.usage.defaultModel"] : model)
                        <small class="muted">@AiViewFormat.Provider(ui, group.Detail ?? "")</small>
                    </th>
                    <td>@AiViewFormat.Tokens(group.Totals.Requests)</td>
                    <td>@AiViewFormat.Tokens(group.Totals.InputTokens, group.Totals.EstimatedInputTokens)</td>
                    <td>@AiViewFormat.Tokens(group.Totals.OutputTokens, group.Totals.EstimatedOutputTokens)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.ShowProfiles)
    {
        <table class="ai-table">
            <thead>
                <tr>
                    <th scope="col">@ui["ai.usage.byProfile"]</th>
                    <th scope="col">@ui["settings.ai.requests"]</th>
                    <th scope="col">@ui["settings.ai.inputTokens"]</th>
                    <th scope="col">@ui["settings.ai.outputTokens"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in report.ByProfile)
                {
                    <tr>
                        <th scope="row">@(Model.ProfileNames?.GetValueOrDefault(group.Key) ?? group.Key)</th>
                        <td>@AiViewFormat.Tokens(group.Totals.Requests)</td>
                        <td>@AiViewFormat.Tokens(group.Totals.InputTokens, group.Totals.EstimatedInputTokens)</td>
                        <td>@AiViewFormat.Tokens(group.Totals.OutputTokens, group.Totals.EstimatedOutputTokens)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    }
}
