@model MediaShelfModel
@* One discovery shelf (#595): a heading, an optional "see all" deep link, and a horizontal row of
   shared _MediaBannerCard cards. Styles: wwwroot/css/discover-shelves.css + media-card.css. Reusable
   by the later shelf surfaces (#427/#428/#434). *@
<section class="media-shelf" aria-labelledby="shelf-@Model.Id">
    <div class="media-shelf-head">
        <h2 class="media-shelf-title" id="shelf-@Model.Id">@Model.Heading</h2>
        @if (Model.DeepLinkUrl is { Length: > 0 } deepLink && Model.SeeAllLabel is { Length: > 0 } seeAll)
        {
            <a class="media-shelf-more" href="@deepLink">@seeAll</a>
        }
    </div>
    <div class="media-shelf-track">
        @foreach (var card in Model.Cards)
        {
            <div class="media-shelf-item">
                <partial name="_MediaBannerCard" model="card" />
            </div>
        }
    </div>
</section>
