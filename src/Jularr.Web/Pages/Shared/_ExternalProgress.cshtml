@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Tracking
@model ExternalProgressPanel
@*
    Shared AniList progress card for Anime, Episode, Manga and Novel detail pages: consumer-safe
    only. Everything rendered here is local. The profile's remote AniList state is fetched after
    first paint from RemoteStateUrl (a page handler that returns the _ExternalProgressState
    fragment), so page GETs never wait on AniList.

    Mapping state (matched/needs review/ranges/...), the review reason and the owner's
    change-match/review/edit-mapping links are owner-only diagnostics and never render here
    (#519, part of epic #510: "a normal user must not see mapping state at all"). They render in
    _ExternalProgressManage inside the page's owner-only Manage sheet instead.

    Ui defaults to English on pages not yet migrated to the per-request UI
    catalog (issue #185); a migrated caller passes its own Model.Ui.
*@
@{
    var ui = Model.Ui ?? UiTextBundle.English;
    var summary = Model.Summary;
}
<section class="panel external-progress"
         data-external-progress
         data-src="@Model.RemoteStateUrl">
    <div class="external-progress-summary">
        <div class="external-progress-local">
            <strong>@summary.LocalProgressText</strong>
        </div>
        <div class="external-progress-match">
            @if (summary.IsMatched && !string.IsNullOrWhiteSpace(Model.MatchedCoverUrl))
            {
                <img src="@Model.MatchedCoverUrl"
                     alt=""
                     loading="lazy"
                     referrerpolicy="no-referrer" />
            }
            @if (summary.IsMatched)
            {
                <a href="@summary.AniListUrl"
                   target="_blank"
                   rel="noopener noreferrer">@summary.MatchedTitle</a>
            }
            else
            {
                <span class="muted">@ui["library.externalProgress.noEntry"]</span>
            }
        </div>
    </div>

    <div class="external-progress-remote" data-external-progress-remote aria-live="polite">
        <span class="status-pill">@ui["library.externalProgress.checking"]</span>
    </div>
    <template data-external-progress-failed>
        <div class="external-progress-state">
            <span class="status-pill status-error">@ui["library.externalProgress.unavailable"]</span>
            <p class="muted">@ui["library.externalProgress.unaffectedNotice"]</p>
        </div>
    </template>
</section>
<script>
    (() => {
        const panel = document.currentScript?.previousElementSibling;
        if (!panel || !panel.matches("[data-external-progress]")) {
            return;
        }

        const slot = panel.querySelector("[data-external-progress-remote]");
        const failed = panel.querySelector("template[data-external-progress-failed]");
        fetch(panel.dataset.src, {
            credentials: "same-origin",
            headers: { Accept: "text/html" }
        })
            .then(response => response.ok ? response.text() : Promise.reject(response.status))
            .then(html => {
                slot.innerHTML = html;
                // The local half already shows the mapping status and its reason; drop
                // the remote copy of the same pill and sentence instead of showing both.
                const same = (a, b) => a && b && a.textContent.trim() === b.textContent.trim();
                const localPill = panel.querySelector(".external-progress-match .status-pill");
                const localReason = panel.querySelector(":scope > p.muted");
                slot.querySelectorAll(".external-progress-state-heading .status-pill").forEach(pill => {
                    if (same(pill, localPill)) pill.remove();
                });
                slot.querySelectorAll(".external-progress-state > p.muted").forEach(reason => {
                    if (same(reason, localReason)) reason.remove();
                });
            })
            .catch(() => slot.replaceChildren(failed.content.cloneNode(true)));
    })();
</script>
