@*
    The one folder browser dialog of Jularr (#604), shared by every Browse button (_PathField). Render
    it once per page, outside any form, for an Owner. It lists folders only, as the Jularr container
    sees them, through /api/storage/folders; behaviour lives in wwwroot/js/folder-browser.js.
*@
@using System.Text.Json
@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Storage.FolderBrowse
@using Microsoft.AspNetCore.Antiforgery
@model UiTextBundle
@inject IAntiforgery FolderBrowserAntiforgery
@{
    var ui = Model;
    var config = new
    {
        endpoint = FolderBrowseEndpoints.BasePath,
        token = FolderBrowserAntiforgery.GetAndStoreTokens(Context).RequestToken,
        labels = ui.WithPrefix("storage.")
    };
}
<dialog class="folder-browser" data-folder-browser aria-labelledby="folder-browser-title">
    <script type="application/json" data-folder-browser-config>@Html.Raw(JsonSerializer.Serialize(config))</script>
    <header class="folder-browser-head">
        <h2 id="folder-browser-title">@ui["storage.folderBrowser.title"]</h2>
        <p class="muted">@ui["storage.folderBrowser.subtitle"]</p>
    </header>
    <nav class="folder-browser-crumbs" aria-label="@ui["storage.folderBrowser.crumbsAria"]" data-fb-crumbs></nav>
    <div class="folder-browser-bar">
        <button type="button" class="button" data-fb-up>@ui["storage.folderBrowser.up"]</button>
        <button type="button" class="button" data-fb-new>@ui["storage.folderBrowser.newFolder"]</button>
        <ul class="folder-checks" data-fb-access></ul>
    </div>
    <div class="folder-browser-create" data-fb-create hidden>
        <label for="folder-browser-name"><span>@ui["storage.folderBrowser.folderName"]</span></label>
        <div class="path-field-row">
            <input id="folder-browser-name" type="text" data-fb-name maxlength="255" autocomplete="off" spellcheck="false" />
            <button type="button" class="button" data-fb-create-submit>@ui["storage.folderBrowser.create"]</button>
        </div>
    </div>
    <p class="validation" role="alert" data-fb-error hidden></p>
    <ul class="folder-browser-list" data-fb-list></ul>
    <p class="muted folder-browser-note" data-fb-note hidden></p>
    <footer class="folder-browser-foot">
        <button type="button" class="button" data-fb-cancel>@ui["common.cancel"]</button>
        <button type="button" class="button button-primary" data-fb-select>@ui["storage.folderBrowser.select"]</button>
    </footer>
</dialog>
