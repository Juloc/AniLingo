@model Jularr.Web.Features.ChapterArtwork.ChapterArtworkSlot
@inject Jularr.Web.Features.ChapterArtwork.ChapterArtworkService Artwork
@inject Jularr.Web.Features.Auth.CurrentAccountContext Account
@{
    // Reader hook: an accepted, AI-generated header image for the chapter, or nothing.
    var item = await Artwork.GetReaderArtworkAsync(Model.WorkId, Model.ChapterNumber, Account.ProfileId, Context.RequestAborted);
}
@if (item is not null)
{
    <link rel="stylesheet" href="~/css/chapter-artwork.css" asp-append-version="true" />
    <figure class="chapter-artwork" data-chapter-artwork="@item.Id">
        <img src="@Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(item, 1280)"
             srcset="@Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(item, 640) 640w, @Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(item, 1280) 1280w, @Jularr.Web.Pages.Books.ChapterArtModel.ImageUrl(item, 1920) 1920w"
             sizes="(max-width: 760px) 100vw, 900px"
             alt=""
             decoding="async" />
        <figcaption>@Model.Label</figcaption>
    </figure>
}
