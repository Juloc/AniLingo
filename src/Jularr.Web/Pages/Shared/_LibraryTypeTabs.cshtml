@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Shell
@model UiTextBundle
@inject IAppShellService AppShell
@{
    var ui = Model;
    var media = await AppShell.GetMediaAccessAsync(User, Context.RequestAborted);
    var tabs = UiShellNavigation.BuildLibraryTabs(Context.Request.Path, media.VisibleMediaTypes);
}
@* Library media types: Anime, Manga and light novels, Books, limited to what the profile may browse (#598). Tabs come from UiNavigationCatalog.LibraryTabs; a single visible type has nothing to switch to. *@
@if (tabs.Count > 1)
{
    <nav class="library-type-tabs" aria-label="@ui["nav.libraryTabsAria"]">
        @foreach (var tab in tabs)
        {
            <a class="library-type-tab @(tab.IsActive ? "active" : "")"
               href="@tab.Href"
               aria-current="@(tab.IsActive ? "page" : null)">@ui[tab.LabelKey]</a>
        }
    </nav>
}
