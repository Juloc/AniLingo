@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Reading
@model ContinueReadingItem
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var kind = Model.Kind switch
    {
        ContinueReadingKind.Book => ui["home.continueReading.kind.book"],
        ContinueReadingKind.Manga => ui["home.continueReading.kind.manga"],
        _ => ui["home.continueReading.kind.novel"]
    };
    var chapter = Model.PageNumber is { } page && Model.PageCount is { } pages
        ? ui.Format("home.continueReading.chapterPage", ("chapter", Model.ChapterLabel), ("page", page), ("pages", pages))
        : ui.Format("home.continueReading.chapter", ("chapter", Model.ChapterLabel));
}
@* The open book, novel or manga with its saved progress, shown inside the readers. *@
<section class="sidebar-current" aria-labelledby="sidebar-current-title">
    <p class="nav-group-title" id="sidebar-current-title">@ui["nav.current"]</p>
    <a class="sidebar-current-card" href="@Model.ResumeUrl">
        <span class="sidebar-current-cover">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="" loading="lazy" decoding="async" />
            }
        </span>
        <span class="sidebar-current-copy">
            <strong>@Model.Title</strong>
            <span>@kind</span>
            <span class="sidebar-current-progress" role="img" aria-label="@ui.Format("home.continueReading.progressAria", ("percent", Model.ProgressPercent))">
                <span style="width: @(Math.Clamp(Model.ProgressPercent, 0, 100))%"></span>
            </span>
            <span>@chapter</span>
        </span>
    </a>
</section>
