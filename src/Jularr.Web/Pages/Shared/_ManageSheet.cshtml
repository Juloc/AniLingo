@model Jularr.Web.Ui.ManageSheetModel
@*
    Shared owner-only management sheet (#519, part of epic #510). Every owner-only action on a
    consumer detail page (metadata match/refresh/remove, mapping, rename, repair, volume
    upload/remove, acquire, SAB URL, reading direction, subtitle source, ...) lives inside one of
    these instead of mixed into the media layout everyone sees. The caller only renders this
    partial when the current account is the owner.

    Desktop: a "Manage" button in the page's action row opens this as a dialog/popover.
    Narrow screens: the same &lt;dialog&gt; is styled as a bottom sheet (manage-sheet.css).
    Both use the platform &lt;dialog&gt; element already used by the episode "Sources & mapping"
    dialog; manage-sheet.js only adds the open/auto-open wiring. A closed &lt;dialog&gt; has no box
    (default browser style), so the trigger button and dialog below can sit directly inside a
    page's existing action row without their own wrapper.
*@
<button type="button"
        class="button manage-sheet-trigger"
        data-manage-sheet-open="@Model.Id"
        aria-haspopup="dialog"
        aria-controls="@Model.Id">
    @Model.TriggerLabel
    @if (Model.ReviewBadge is not null)
    {
        <a class="manage-sheet-review-dot"
           href="@Model.ReviewBadge.Url"
           title="@Model.ReviewBadge.Text"
           aria-label="@Model.ReviewBadge.Text"
           onclick="event.stopPropagation()"></a>
    }
</button>

<dialog class="manage-sheet-dialog"
        id="@Model.Id"
        aria-labelledby="@(Model.Id)-title"
        data-open-on-load="@(Model.OpenOnLoad ? "true" : "false")">
    <div class="manage-sheet-header">
        <h2 id="@(Model.Id)-title">@Model.Title</h2>
        <form method="dialog"><button class="button" type="submit">@Model.Ui["manage.close"]</button></form>
    </div>

    @if (Model.ReviewBadge is not null)
    {
        <a class="manage-sheet-review-link" href="@Model.ReviewBadge.Url">@Model.ReviewBadge.Text</a>
    }

    <div class="manage-sheet-body">
        @foreach (var group in Model.Groups)
        {
            <section class="manage-sheet-group">
                <h3>@group.Heading</h3>
                @group.Content
            </section>
        }
    </div>
</dialog>
