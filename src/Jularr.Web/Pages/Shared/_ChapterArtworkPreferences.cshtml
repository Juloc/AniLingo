@model Jularr.Web.Features.Localization.UiTextBundle
@using Jularr.Web.Features.Ai
@using Jularr.Web.Features.ChapterArtwork
@inject ChapterArtworkStore Store
@inject ChapterArtworkGlobalSettingsStore GlobalSettings
@inject Jularr.Web.Features.Auth.CurrentAccountContext Account
@{
    var ui = Model;
    var preferences = await Store.GetPreferencesAsync(Account.ProfileId, Context.RequestAborted);
    var global = GlobalSettings.Load();
}
<section class="panel">
    <div class="panel-heading">
        <h2>@ui["chapterArt.title"]</h2>
    </div>
    <form method="post" asp-page="/Settings/ChapterArtwork" class="form-stack">
        <label>
            <input type="checkbox" name="enabled" value="true" checked="@preferences.Enabled" />
            <span>@ui["chapterArt.prefs.show"]</span>
        </label>

        @if (Account.IsOwner)
        {
            <label>
                <input type="checkbox" name="autoGenerate" value="true" checked="@preferences.AutoGenerate" />
                <span>@ui["chapterArt.prefs.auto"]</span>
            </label>
            <label>
                <span>@ui["chapterArt.style"]</span>
                <select name="style">
                    @foreach (var style in Enum.GetValues<ChapterArtworkStyle>())
                    {
                        var value = ChapterArtworkNames.Style(style);
                        <option value="@value" selected="@(preferences.Style == style)">@ui[$"chapterArt.style.{value}"]</option>
                    }
                </select>
            </label>
            <label>
                <span>@ui["chapterArt.prefs.quality"]</span>
                <select name="quality">
                    <option value="standard" selected="@(preferences.Quality == AiImageQuality.Standard)">@ui["chapterArt.quality.standard"]</option>
                    <option value="high" selected="@(preferences.Quality == AiImageQuality.High)">@ui["chapterArt.quality.high"]</option>
                </select>
            </label>
            <label>
                <span>@ui["chapterArt.prefs.variations"]</span>
                <input type="number" name="variations" min="1" max="@ChapterArtworkPreferences.MaxVariations" value="@preferences.Variations" />
            </label>
            <label>
                <input type="checkbox" name="globalEnabled" value="true" checked="@global.Enabled" />
                <span>@ui["chapterArt.global.enabled"]</span>
            </label>
            <label>
                <span>@ui["chapterArt.global.storageRoot"]</span>
                <input name="storageRoot" value="@global.StorageRoot" autocomplete="off" placeholder="/media/books" />
            </label>
        }

        <div class="inline-actions">
            <button class="button button-primary" type="submit">@ui["chapterArt.save"]</button>
        </div>
    </form>
</section>
