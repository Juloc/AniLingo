@model Jularr.Web.Features.MediaFacts.MediaFactsLanguageUsage
@using Jularr.Web.Features.MediaFacts
@* Same stroke-icon language as _MediaBannerCard's audio/subtitle icons, reused here instead of
   inventing new artwork for the same two concepts; Text (reading/original content language) adds
   one small book glyph in the same style. *@
@switch (Model)
{
    case MediaFactsLanguageUsage.Audio:
        <svg class="media-facts-lang-svg" viewBox="0 0 24 24" focusable="false"
             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
            <rect x="3.5" y="14" width="4" height="6" rx="1.5" />
            <rect x="16.5" y="14" width="4" height="6" rx="1.5" />
        </svg>
        break;
    case MediaFactsLanguageUsage.Subtitle:
        <svg class="media-facts-lang-svg" viewBox="0 0 24 24" focusable="false"
             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 12h3M13 12h4M7 15.5h7M16.5 15.5h.5" />
        </svg>
        break;
    default:
        <svg class="media-facts-lang-svg" viewBox="0 0 24 24" focusable="false"
             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 5.5A2 2 0 0 1 6 3.5h5.5v17H6a2 2 0 0 1-2-2z" />
            <path d="M20 5.5A2 2 0 0 0 18 3.5h-5.5v17H18a2 2 0 0 0 2-2z" />
        </svg>
        break;
}
