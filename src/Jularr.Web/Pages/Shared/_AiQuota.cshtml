@*
    Provider quota buckets exactly as Codex app-server reports them (#422). Missing data is shown as
    unavailable; a bucket is only tied to a model when the protocol names that model.
*@
@using Jularr.Web.Features.Ai
@model AiQuotaPanel
@{
    var ui = Model.Ui;
    var quota = Model.Quota;
}
@if (quota is null || quota.Buckets.Count == 0)
{
    <p class="muted">@ui["ai.quota.unavailable"]</p>
}
else
{
    @if (Model.Detailed)
    {
        <div class="status-list">
            <div>
                <span>@ui["ai.quota.plan"]</span>
                <strong>@(quota.PlanType ?? ui["ai.quota.unavailableValue"])</strong>
            </div>
            <div>
                <span>@ui["ai.quota.ordinaryUsage"]</span>
                <strong>@(quota.OrdinaryUsageAllowed switch { true => ui["ai.quota.allowed"], false => ui["ai.quota.blocked"], null => ui["ai.quota.unavailableValue"] })</strong>
            </div>
            <div>
                <span>@ui["ai.quota.refreshed"]</span>
                <strong>@AiViewFormat.Timestamp(quota.UpdatedAt ?? quota.RefreshedAt)</strong>
            </div>
        </div>
    }

    <ul class="ai-quota-list">
        @foreach (var bucket in quota.Buckets)
        {
            <li>
                <div class="ai-quota-heading">
                    <strong>@(bucket.LimitName ?? bucket.LimitId ?? ui["ai.quota.defaultBucket"])</strong>
                    <span class="muted">@(bucket.ModelSlug is { } slug ? slug : ui["ai.quota.unmapped"])</span>
                    @if (bucket.SpendControlReached == true || bucket.ReachedType is not null)
                    {
                        <span class="status-pill status-error">@ui["ai.quota.reached"]</span>
                    }
                </div>
                @foreach (var (label, window) in new[] { (ui["ai.quota.primary"], bucket.Primary), (ui["ai.quota.secondary"], bucket.Secondary) })
                {
                    if (window is null)
                    {
                        continue;
                    }

                    <div class="ai-quota-window">
                        <span>@label · @AiViewFormat.Window(ui, window.WindowDurationMinutes)</span>
                        <span>@ui.Format("ai.quota.used", ("percent", AiViewFormat.Percent(window.UsedPercent)))</span>
                        <span class="muted">@(window.ResetsAt is { } reset ? ui.Format("ai.quota.resets", ("time", AiViewFormat.Timestamp(reset))) : ui["ai.quota.resetUnknown"])</span>
                        <div class="progress-track" role="presentation"><span style="width: @(Math.Clamp(window.UsedPercent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                    </div>
                }
                @if (Model.Detailed && bucket.Credits is { } credits)
                {
                    <p class="muted">
                        @(credits.Unlimited
                            ? ui["ai.quota.creditsUnlimited"]
                            : credits.HasCredits
                                ? ui.Format("ai.quota.credits", ("balance", credits.Balance ?? ui["ai.quota.unavailableValue"]))
                                : ui["ai.quota.noCredits"])
                    </p>
                }
                @if (Model.Detailed && bucket.IndividualLimit is { } spend)
                {
                    <p class="muted">@ui.Format("ai.quota.spendLimit", ("used", spend.Used), ("limit", spend.Limit), ("percent", AiViewFormat.Percent(spend.RemainingPercent)))</p>
                }
            </li>
        }
    </ul>
}
