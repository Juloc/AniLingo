@*
    Live AI activity (#422). Server-rendered first, then kept current by wwwroot/js/ai-activity.js
    over server-sent events. Shows operational state and token counts only — never prompts,
    responses or reasoning text.
*@
@using System.Text.Json
@using Jularr.Web.Features.Ai
@using Microsoft.AspNetCore.Antiforgery
@model AiActivityPanel
@inject IAntiforgery ActivityAntiforgery
@{
    var ui = Model.Ui;
    var scope = Model.AllProfiles ? "?scope=all" : "";
    var config = new
    {
        stream = AiActivityEndpoints.BasePath + "/stream" + scope,
        cancel = AiActivityEndpoints.BasePath + "/{id}/cancel",
        token = ActivityAntiforgery.GetAndStoreTokens(Context).RequestToken,
        profiles = Model.ProfileNames,
        labels = new
        {
            states = AiActivityStates.All.ToDictionary(AiActivityStates.Name, x => ui["ai.state." + AiActivityStates.Name(x)]),
            operations = AiOperations.All.ToDictionary(x => x, x => ui["ai.operation." + x]),
            tokens = ui["ai.activity.tokens"],
            cached = ui["ai.activity.cached"],
            reasoning = ui["ai.activity.reasoning"],
            context = ui["ai.activity.context"],
            sharedContext = ui["ai.activity.sharedContext"],
            sharedContextOf = ui["ai.activity.sharedContextOf"],
            retries = ui["ai.activity.retries"],
            progress = ui["ai.activity.progress"],
            profile = ui["ai.activity.profile"],
            cancel = ui["common.cancel"],
            cancelFailed = ui["ai.activity.cancelFailed"]
        }
    };
}
<div class="ai-activity" data-ai-activity>
    <script type="application/json" data-ai-activity-config>@Html.Raw(JsonSerializer.Serialize(config))</script>
    <p class="muted" data-ai-activity-empty hidden="@(Model.Items.Count > 0)">@ui["ai.activity.empty"]</p>
    <ul class="ai-activity-list" data-ai-activity-list>
        @foreach (var item in Model.Items)
        {
            <li class="ai-activity-item" data-active="@(item.Active ? "true" : "false")">
                <div class="ai-activity-line">
                    <strong>@AiViewFormat.Operation(ui, item.Operation)</strong>
                    <span class="status-pill ai-state-@item.State">@AiViewFormat.State(ui, item.State)</span>
                    <span class="ai-activity-elapsed">@AiViewFormat.Duration(TimeSpan.FromMilliseconds(item.ElapsedMs))</span>
                </div>
                <div class="ai-activity-meta muted">
                    @if (item.ProfileId is not null)
                    {
                        <span>@ui["ai.activity.profile"] @(Model.ProfileNames?.GetValueOrDefault(item.ProfileId) ?? item.ProfileId)</span>
                    }
                    <span>@(item.Model ?? AiViewFormat.Provider(ui, item.ProviderId))@(item.ReasoningEffort is null ? "" : " · " + item.ReasoningEffort)</span>
                    @if (item.Usage is { } usage)
                    {
                        <span>@ui.Format("ai.activity.tokens", ("input", (usage.Estimated ? "~" : "") + AiViewFormat.Tokens(usage.Input)), ("output", AiViewFormat.Tokens(usage.Output)))</span>
                        @if (usage.Cached > 0)
                        {
                            <span>@ui.Format("ai.activity.cached", ("count", AiViewFormat.Tokens(usage.Cached)))</span>
                        }
                    }
                    @if (item.ContextWindowPercent is { } percent)
                    {
                        <span>@ui.Format("ai.activity.context", ("percent", AiViewFormat.Percent(percent)))</span>
                    }
                    @if (item.ContextTokens > 0)
                    {
                        <span>@(item.FullContextTokens > item.ContextTokens
                            ? ui.Format("ai.activity.sharedContextOf", ("count", AiViewFormat.Tokens(item.ContextTokens)), ("full", AiViewFormat.Tokens(item.FullContextTokens)))
                            : ui.Format("ai.activity.sharedContext", ("count", AiViewFormat.Tokens(item.ContextTokens))))</span>
                    }
                    @if (item.ProgressTotal is > 0)
                    {
                        <span>@ui.Format("ai.activity.progress", ("current", item.ProgressCurrent ?? 0), ("total", item.ProgressTotal))</span>
                    }
                    @if (item.Retries > 0)
                    {
                        <span>@ui.Format("ai.activity.retries", ("count", item.Retries))</span>
                    }
                </div>
                @if (item.Error is not null)
                {
                    <p class="validation">@item.Error</p>
                }
            </li>
        }
    </ul>
</div>
