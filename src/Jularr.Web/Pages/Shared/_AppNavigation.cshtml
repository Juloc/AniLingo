@using Jularr.Web.Data
@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Learning
@using Jularr.Web.Features.Shell
@inject AppDbContext LearningNavigationDb
@inject IAppShellService AppShell
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var profileId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var learningVisible = false;
    if (!string.IsNullOrWhiteSpace(profileId))
    {
        learningVisible = await new LearningConfigurationStore(LearningNavigationDb)
            .HasAnyLearningEnabledAsync(profileId, Context.RequestAborted);
    }

    // Hidden media types are absent from the shell, not greyed out (#598).
    var media = await AppShell.GetMediaAccessAsync(User, Context.RequestAborted);
    var nav = UiShellNavigation.Build(
        Context.Request.Path,
        learningVisible,
        policy => Jularr.Web.Features.Auth.JularrPolicies.Allows(User, policy),
        media.VisibleMediaTypes);

    // Discover has its own search field; the shell search would repeat it.
    var showSearch = !Context.Request.Path.StartsWithSegments("/Discover", StringComparison.OrdinalIgnoreCase);

    // Inside a reader the sidebar shows the work that is open, never another one.
    Jularr.Web.Features.Reading.ContinueReadingItem? current = null;
    var readerChapter = Context.Request.Path.Value?.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(2);
    if (nav.ShowCurrentReading && !string.IsNullOrWhiteSpace(profileId) && Guid.TryParse(readerChapter, out var chapterId))
    {
        var recent = await new Jularr.Web.Features.Reading.ContinueReadingQuery(LearningNavigationDb)
            .GetAsync(profileId, cancellationToken: Context.RequestAborted);
        var workId = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
            LearningNavigationDb.NovelChapters.Where(chapter => chapter.Id == chapterId).Select(chapter => (Guid?)chapter.WorkId),
            Context.RequestAborted);
        current = recent.FirstOrDefault(item => item.ChapterId == chapterId || (workId is { } id && item.WorkId == id));
    }
}
<aside class="sidebar">
    <a class="brand" href="/">
        <partial name="_AppBrandMark" />
    </a>

    @if (showSearch)
    {
        <partial name="_AppSearch" />
    }
    <partial name="_NotificationBell" />

    <nav class="nav-list" aria-label="@ui["nav.primaryAria"]">
        @foreach (var item in nav.Primary)
        {
            <partial name="_AppNavLink" model="item" />
        }
    </nav>

    @if (current is not null)
    {
        <partial name="_AppCurrentReading" model="current" />
    }

    <nav class="nav-list nav-list-secondary @(nav.Expanded is not null ? "nav-list-expanded" : "")" aria-label="@ui["nav.secondaryAria"]">
        @foreach (var item in nav.Secondary)
        {
            @if (item.Groups is { } groups)
            {
                <div class="nav-section" data-nav-section="@item.Id">
                    <partial name="_AppNavLink" model="item" />
                    <div class="nav-children" role="group" aria-label="@ui[item.LabelKey]">
                        @foreach (var group in groups)
                        {
                            <p class="nav-group-title">@ui[group.TitleKey]</p>
                            @foreach (var child in group.Items)
                            {
                                <partial name="_AppNavLink" model="child" />
                            }
                        }
                    </div>
                </div>
            }
            @if (item.Groups is null)
            {
                <partial name="_AppNavLink" model="item" />
            }
        }
    </nav>

    <div class="sidebar-footer">
        <partial name="_AppAccountFooter" />
    </div>
</aside>

@if (showSearch)
{
    <header class="mobile-topbar">
        <a class="mobile-topbar-brand" href="/" aria-label="@ui["nav.home"]">
            <partial name="_AppBrandMark" />
        </a>
        <partial name="_AppSearch" />
        <partial name="_NotificationBell" />
    </header>
}

<nav class="mobile-nav" aria-label="@ui["nav.primaryAria"]">
    @foreach (var item in nav.MobilePrimary)
    {
        <a class="mobile-nav-item @(item.IsActive ? "active" : "")"
           href="@item.Href"
           aria-current="@(item.IsCurrentPage ? "page" : null)">
            <partial name="_AppIcon" model="item.Icon" />
            <span class="mobile-nav-label">@ui[item.LabelKey]</span>
        </a>
    }
</nav>
