@using Jularr.Web.Features.Appearance
@using Jularr.Web.Features.Localization
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var appVersion = ViewData["AppBuildVersion"] as string ?? AppBuildInfo.Version;
    var isOwner = User.IsInRole(Jularr.Web.Features.Auth.AccountRoles.Owner);
}
@* Shared by the desktop sidebar footer and the phone Profile page. *@
<partial name="_AppThemeControl" />
@if (User.Identity?.IsAuthenticated == true)
{
    @* Compact global offline-download indicator (#221): hidden by default, shown by
       offline-library-ui.js only while something is downloading. *@
    <a class="sidebar-offline-indicator" href="/Settings/Offline" data-offline-download-indicator hidden></a>
}
<div class="sidebar-account">
    <span class="sidebar-user">@User.Identity?.Name</span>
    <form method="post" asp-page="/Account/Logout" data-offline-logout>
        <button class="sidebar-logout" type="submit">
            <partial name="_AppIcon" model="@("signOut")" />
            <span>@ui["nav.signOut"]</span>
        </button>
    </form>
</div>
@if (isOwner)
{
    <span class="sidebar-version" title="@appVersion">@ui["shell.version"] @appVersion</span>
}
