@using Jularr.Web.Features.Localization
@model UiNavigationItem
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    // An open section (Admin, Settings) anchors its child pages; the current child is the highlight.
    var state = Model.IsExpanded ? "nav-section-anchor" : Model.IsActive ? "active" : "";
}
<a class="nav-item @state"
   href="@Model.Href"
   aria-current="@(Model.IsCurrentPage ? "page" : null)">
    <partial name="_AppIcon" model="Model.Icon" />
    <span class="nav-label">@ui[Model.LabelKey]</span>
</a>
