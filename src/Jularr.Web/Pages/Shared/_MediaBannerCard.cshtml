@model MediaBannerCardModel
@* "Media Banner" card (#395): banner art fading into the card, next unit, progress and local facts.
   Every block renders only when the model carries that fact. Styles: wwwroot/css/media-card.css. *@
<article class="banner-card@(Model.BackdropUrl is null ? " banner-card-plain" : "")">
    @* Makes the whole card open the title; the real, focusable link is the title below. *@
    <a class="banner-card-cover-link" href="@Model.Href" tabindex="-1" aria-hidden="true"></a>
    <div class="banner-card-art" aria-hidden="true">
        @if (Model.BackdropUrl is not null)
        {
            <img src="@Model.BackdropUrl" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        }
    </div>

    @if (Model.Status is { } status)
    {
        <span class="banner-card-status banner-card-status-@status.CssModifier">
            <span class="banner-card-status-dot" aria-hidden="true"></span>
            @status.Label
        </span>
    }

    @if (Model.Availability is { } availability)
    {
        @* Availability (#597): requested / in the library / available. A small dot and label, no accent bar. *@
        <span class="banner-card-status banner-card-availability banner-card-availability-@availability.CssModifier">
            <span class="banner-card-status-dot" aria-hidden="true"></span>
            @availability.Label
        </span>
    }

    <div class="banner-card-body">
        <h3 class="banner-card-title"><a href="@Model.Href">@Model.Title</a></h3>
        <p class="banner-card-meta">@Model.Meta</p>

        @if (Model.Action is { } action)
        {
            <a class="banner-card-action" href="@action.Url">
                <span class="banner-card-play" aria-hidden="true"><partial name="_PlayerIcon" model='"play"' /></span>
                <span class="banner-card-action-copy">
                    <strong>@action.Label</strong>
                    <span>@action.UnitLabel</span>
                </span>
            </a>
        }

        @if (Model.Progress is { } progress)
        {
            <div class="banner-card-progress">
                <div class="progress-track" role="progressbar" aria-label="@progress.AriaLabel"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.Percent">
                    <span style="width:@progress.Percent%"></span>
                </div>
                <span aria-hidden="true">@progress.Text</span>
            </div>
        }

        @if (Model.HasFacts)
        {
            <ul class="banner-card-facts">
                @if (Model.Audio is { } audio)
                {
                    <li>
                        <svg class="banner-card-icon" viewBox="0 0 24 24" role="img" aria-label="@audio.Label" focusable="false"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <title>@audio.Label</title>
                            <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
                            <rect x="3.5" y="14" width="4" height="6" rx="1.5" />
                            <rect x="16.5" y="14" width="4" height="6" rx="1.5" />
                        </svg>
                        @foreach (var chip in audio.Chips)
                        {
                            <span class="banner-card-chip">@chip</span>
                        }
                    </li>
                }
                @if (Model.Subtitles is { } subtitles)
                {
                    <li>
                        <svg class="banner-card-icon" viewBox="0 0 24 24" role="img" aria-label="@subtitles.Label" focusable="false"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <title>@subtitles.Label</title>
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="M7 12h3M13 12h4M7 15.5h7M16.5 15.5h.5" />
                        </svg>
                        @foreach (var chip in subtitles.Chips)
                        {
                            <span class="banner-card-chip">@chip</span>
                        }
                    </li>
                }
                @if (Model.Groups is { } groups)
                {
                    <li>
                        <svg class="banner-card-icon" viewBox="0 0 24 24" role="img" aria-label="@groups.Label" focusable="false"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <title>@groups.Label</title>
                            <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2.5h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" />
                        </svg>
                        <span class="banner-card-value">@groups.Value</span>
                    </li>
                }
                @if (Model.Rating is { } rating)
                {
                    <li>
                        <svg class="banner-card-icon" viewBox="0 0 24 24" role="img" aria-label="@rating.Label" focusable="false"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <title>@rating.Label</title>
                            <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                        </svg>
                        <span class="banner-card-value">@rating.Value</span>
                    </li>
                }
            </ul>
        }
    </div>
</article>
