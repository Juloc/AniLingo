@model Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender
@using Jularr.Web.Features.Storage.Reconciliation
@{
    var node = Model.Node;
    var isSelected = Model.SelectedPath == node.Item.RelativePath;
    var selectedClass = isSelected ? " selected" : "";
    var stateClass = node.Item.State.ToString().ToLowerInvariant();
    var expandsForSelection = Model.SelectedPath?.StartsWith(node.Item.RelativePath + "/", StringComparison.Ordinal) == true;
    var shouldExpand = node.Item.State != LibraryReconciliationItemState.Recognized || expandsForSelection || isSelected;
}
<li>
    @if (node.Children.Count > 0)
    {
        <details open="@shouldExpand">
            <summary>
                <a class="admrec-tree-entry@(selectedClass)" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@node.Item.RelativePath" asp-route-step="2">
                    <span class="admrec-tree-kind" aria-hidden="true">▸</span>@node.Item.RelativePath.Split('/').Last()
                </a>
                <span class="admrec-state @stateClass">@node.Item.State</span>
            </summary>
            <ul>
                @foreach (var child in node.Children)
                {
                    <partial name="_ReconciliationTreeNode" model="new Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender(child, Model.PlanId, Model.SelectedPath)" />
                }
            </ul>
        </details>
    }
    else
    {
        <a class="admrec-tree-entry@(selectedClass)" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@node.Item.RelativePath" asp-route-step="2">
            <span class="admrec-tree-kind" aria-hidden="true">@(node.Item.IsDirectory ? "□" : "•")</span>@node.Item.RelativePath.Split('/').Last()
        </a>
        <span class="admrec-state @stateClass">@node.Item.State</span>
    }
</li>
