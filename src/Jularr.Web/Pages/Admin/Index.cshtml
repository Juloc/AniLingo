@page
@model Jularr.Web.Pages.Admin.IndexModel
@using Jularr.Web.Features.Operations
@section Head {
    <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["nav.admin"];
    var overview = Model.Overview;

    string OperationStatusLabel(OperationStatus status) => status switch
    {
        OperationStatus.Queued => ui["admin.operations.status.queued"],
        OperationStatus.Running => ui["admin.operations.status.running"],
        OperationStatus.Succeeded => ui["admin.operations.status.succeeded"],
        OperationStatus.Failed => ui["admin.operations.status.failed"],
        OperationStatus.Cancelled => ui["admin.operations.status.cancelled"],
        OperationStatus.Interrupted => ui["admin.operations.status.interrupted"],
        _ => status.ToString()
    };

    string CountValue(int count) => count == 0 ? ui["admin.overview.ok"] : count.ToString("N0");
    string Pill(int count, string problemClass) => count == 0 ? "status-ok" : problemClass;

    string FormatBytes(long? bytes)
    {
        if (bytes is not { } value || value < 0)
        {
            return ui["admin.overview.unknown"];
        }

        double size = value;
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return ui.Format("admin.overview.serverLoad.size", ("value", Math.Round(size, size < 10 ? 1 : 0)), ("unit", units[unit]));
    }

    var freeDiskText = overview.DataVolumeFreeBytes is { } free
        ? ui.Format("admin.overview.serverLoad.free", ("free", FormatBytes(free)))
        : ui["admin.overview.unknown"];
    var serverLoadValue = ui.Format(
        "admin.overview.serverLoad.value",
        ("cpu", Math.Round(overview.ProcessCpuPercent)),
        ("workingSet", FormatBytes(overview.ProcessWorkingSetBytes)),
        ("free", freeDiskText));
}

<header class="page-header">
    <div>
        <h1>@ui["nav.admin"]</h1>
        <p>@ui["admin.index.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="status-list admin-overview-list" aria-label="@ui["admin.overview.title"]">
    <a asp-page="/Admin/Operations" asp-route-view="history" asp-route-status="Failed">
        <span>@ui["admin.overview.broken.label"]</span>
        <strong class="status-pill @Pill(overview.FailedOperations, "status-error")">@CountValue(overview.FailedOperations)</strong>
    </a>
    <a asp-page="/Admin/Operations" asp-route-view="downloads">
        <span>@ui["admin.overview.downloading.label"]</span>
        <strong class="status-pill @Pill(overview.ActiveDownloads, "status-info")">@CountValue(overview.ActiveDownloads)</strong>
    </a>
    <a asp-page="/Admin/Operations" asp-route-view="active">
        <span>@ui["admin.overview.processing.label"]</span>
        <strong class="status-pill @Pill(overview.ActiveProcessing, "status-info")">@CountValue(overview.ActiveProcessing)</strong>
    </a>
    <a asp-page="/Admin/Requests">
        <span>@ui["admin.overview.missing.label"]</span>
        <strong class="status-pill @Pill(overview.OpenAcquisitionRequests, "status-warning")">@CountValue(overview.OpenAcquisitionRequests)</strong>
    </a>
    <a asp-page="/Settings/MappingReview">
        <span>@ui["admin.overview.mapping.label"]</span>
        <strong class="status-pill @Pill(overview.UnresolvedMappings, "status-warning")">@CountValue(overview.UnresolvedMappings)</strong>
    </a>
    <a asp-page="/Admin/Subtitles">
        <span>@ui["admin.overview.subtitles.label"]</span>
        <strong class="status-pill @Pill(overview.MissingLearningText, "status-warning")">@CountValue(overview.MissingLearningText)</strong>
    </a>
    <a asp-page="/Admin/System">
        <span>@ui["admin.overview.storage.label"]</span>
        <strong class="status-pill @Pill(overview.StorageRootsOffline, "status-error")">@CountValue(overview.StorageRootsOffline)</strong>
    </a>
    <a asp-page="/Admin/Operations" asp-route-view="history" asp-route-status="Interrupted">
        <span>@ui["admin.overview.blocked.label"]</span>
        <strong class="status-pill @Pill(overview.BlockedJobs, "status-error")">@CountValue(overview.BlockedJobs)</strong>
    </a>
    <a asp-page="/Admin/Sessions">
        <span>@ui["admin.overview.watching.label"]</span>
        <strong class="status-pill @Pill(overview.WatchingNow, "status-info")">@CountValue(overview.WatchingNow)</strong>
    </a>
    <a asp-page="/Admin/Sessions">
        <span>@ui["admin.overview.transcoding.label"]</span>
        <strong class="status-pill @Pill(overview.TranscodingNow, "status-info")">@CountValue(overview.TranscodingNow)</strong>
    </a>
    <a asp-page="/Admin/Users">
        <span>@ui["admin.overview.accounts.label"]</span>
        <strong class="status-pill status-info">@Model.UserCount.ToString("N0")</strong>
    </a>
    <a asp-page="/Admin/System">
        <span>@ui["admin.overview.serverLoad.label"]</span>
        <strong class="status-pill status-info">@serverLoadValue</strong>
    </a>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.index.recentOperations.title"]</h2>
            <div class="inline-actions">
                <a class="button" asp-page="/Admin/Activity/Index">@ui["admin.activity.title"]</a>
                <a class="button" asp-page="/Admin/Operations">@ui["admin.index.viewAll"]</a>
            </div>
        </div>

        @if (Model.Recent.Count == 0)
        {
            <p class="muted">@ui["admin.index.noOperations"]</p>
        }
        else
        {
            <div class="operation-list">
                @foreach (var operation in Model.Recent)
                {
                    <a class="operation-row" asp-page="/Admin/Operation" asp-route-id="@operation.Id">
                        <div class="operation-copy">
                            <strong>@operation.Title</strong>
                            <span>@operation.Category · @OperationStatusLabel(operation.Status) · @operation.UpdatedAtUtc.ToLocalTime().ToString("g")</span>
                        </div>
                        <span class="status-pill operation-status-@operation.Status.ToString().ToLowerInvariant()">
                            @OperationStatusLabel(operation.Status)
                        </span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.index.server.title"]</h2></div>
        <p class="muted">
            @ui["admin.index.server.description"]
        </p>
        <a class="button button-primary" asp-page="/Admin/System">@ui["admin.index.server.open"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.index.storage.title"]</h2></div>
        <p class="muted">@ui["admin.index.storage.description"]</p>
        <a class="button" asp-page="/Admin/Storage/Index">@ui["admin.index.storage.open"]</a>
    </section>
</div>
