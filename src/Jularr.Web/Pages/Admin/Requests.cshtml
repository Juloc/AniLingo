@page
@model Jularr.Web.Pages.Admin.RequestsModel
@using Jularr.Web.Features.Acquisition.Access
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.requests.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.requests.title"]</h1>
        <p>@ui["admin.requests.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<section class="panel access-policies">
    <div class="panel-heading">
        <h2>@ui["admin.requests.policiesHeading"]</h2>
    </div>
    <p class="muted">@ui["admin.requests.policiesHelp"]</p>
    <form method="post" asp-page-handler="Policies">
        <table class="access-policy-table">
            <thead>
                <tr>
                    <th scope="col">@ui["admin.requests.column.media"]</th>
                    <th scope="col">@ui["admin.requests.column.userAdd"]</th>
                    <th scope="col">@ui["admin.requests.column.manual"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in Model.Policies)
                {
                    var name = AcquisitionAccessNames.Kind(policy.Kind);
                    <tr>
                        <th scope="row">@ui["admin.requests.kind." + name]</th>
                        <td>
                            <select name="userAdd.@name" aria-label="@ui["admin.requests.column.userAdd"]">
                                @foreach (var mode in Enum.GetValues<UserAddMode>())
                                {
                                    var value = AcquisitionAccessNames.UserAdd(mode);
                                    <option value="@value" selected="@(mode == policy.UserAdd)">@ui["admin.requests.userAdd." + value]</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="manual.@name" aria-label="@ui["admin.requests.column.manual"]">
                                @foreach (var mode in Enum.GetValues<ManualAddMode>())
                                {
                                    var value = AcquisitionAccessNames.Manual(mode);
                                    <option value="@value" selected="@(mode == policy.Manual)">@ui["admin.requests.manual." + value]</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
    </form>
</section>

<section class="panel access-requests">
    <div class="panel-heading">
        <h2>@ui["admin.requests.queueHeading"]</h2>
        <a class="text-link" href="@(Model.ShowAll ? "/Admin/Requests" : "/Admin/Requests?all=true")">
            @(Model.ShowAll ? ui["admin.requests.showOpen"] : ui["admin.requests.showAll"])
        </a>
    </div>
    @if (Model.Requests.Count == 0)
    {
        <p class="muted">@ui["admin.requests.empty"]</p>
    }
    else
    {
        <ul class="request-list">
            @foreach (var request in Model.Requests)
            {
                var status = AcquisitionAccessNames.Status(request.Status);
                <li class="request-row">
                    <div class="request-cover">
                        @if (!string.IsNullOrWhiteSpace(request.CoverImageUrl))
                        {
                            <img src="@request.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                    </div>
                    <div class="request-copy">
                        <strong>@request.Title</strong>
                        <span>
                            @ui["admin.requests.kind." + AcquisitionAccessNames.Kind(request.Kind)]
                            @if (!string.IsNullOrWhiteSpace(request.Subtitle))
                            {
                                <text> · @request.Subtitle</text>
                            }
                            · @ui.Format("admin.requests.requestedBy", ("user", Model.ProfileNames.GetValueOrDefault(request.RequestedByProfileId) ?? request.RequestedByProfileId))
                        </span>
                        @if (!string.IsNullOrWhiteSpace(request.StatusMessage))
                        {
                            <small>@request.StatusMessage</small>
                        }
                    </div>
                    <span class="status-pill request-status-@status">@ui["requests.status." + status]</span>
                    <div class="request-actions">
                        @if (request.ResultUrl is { } resultUrl)
                        {
                            <a class="button" href="@resultUrl">@ui["requests.open"]</a>
                        }
                        @if (request.Status is AcquisitionRequestStatus.Pending or AcquisitionRequestStatus.Failed)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                <button class="button button-primary" type="submit">
                                    @(request.Status == AcquisitionRequestStatus.Failed ? ui["admin.requests.retry"] : ui["admin.requests.approve"])
                                </button>
                            </form>
                        }
                        @if (request.Status == AcquisitionRequestStatus.Approved &&
                             request.Kind is MediaAcquisitionKind.Book or MediaAcquisitionKind.Manga or MediaAcquisitionKind.LightNovel)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                <button class="button button-primary" type="submit">@ui["admin.requests.searchNow"]</button>
                            </form>
                        }
                        @if (request.Status == AcquisitionRequestStatus.Pending)
                        {
                            <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id">
                                <button class="button" type="submit">@ui["admin.requests.reject"]</button>
                            </form>
                        }
                        @if (request.Status is AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Failed)
                        {
                            <form method="post" asp-page-handler="Complete" asp-route-id="@request.Id">
                                <button class="button" type="submit">@ui["admin.requests.markDone"]</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>
