@model string
@* A short history line under a figure; decorative, because the figure beside it carries the value. *@
<svg class="admdash-spark" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polyline points="@Model" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
</svg>
