@model string
@* Small decorative glyph of a history category, result or actor; the name always sits next to it. *@
<svg class="admhist-icon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "acquisition":
            <path d="M8 2.75v7.5M4.75 7.5 8 10.75l3.25-3.25M3 13.25h10" />
            break;
        case "imports":
            <path d="M2.75 9.5h3l.75 1.75h3L10.25 9.5h3M2.75 9.5V12a1 1 0 0 0 1 1h8.5a1 1 0 0 0 1-1V9.5M8 2.75v5M5.75 5.75 8 8l2.25-2.25" />
            break;
        case "remux":
            <path d="M2.75 5.25h8.5M8.75 2.75l2.5 2.5-2.5 2.5M13.25 10.75h-8.5M7.25 8.25l-2.5 2.5 2.5 2.5" />
            break;
        case "subtitle":
            <rect x="2.25" y="3.25" width="11.5" height="8" rx="1.5" />
            <path d="M5 6.75h3M9.5 6.75H11M5 9h1.5M8 9h3M5.5 13.25h5" />
            break;
        case "translation":
            <path d="M2.75 4.25h6.5M6 2.75v1.5M4 4.25c.4 2.4 1.9 4 4 4.9M8.25 4.25C7.6 6.7 5.6 8.6 3 9.4M9.25 13.25l2.25-5.5 2.25 5.5M9.9 11.75h3.2" />
            break;
        case "metadata":
            <path d="M2.75 8.5V3.75a1 1 0 0 1 1-1H8.5l4.75 4.75-5.5 5.5z" />
            <circle cx="5.75" cy="5.75" r=".6" />
            break;
        case "ai":
            <path d="M8 2.5 9.25 6.75 13.5 8 9.25 9.25 8 13.5 6.75 9.25 2.5 8l4.25-1.25z" />
            break;
        case "maintenance":
            <path d="M10.5 2.75a3 3 0 0 0-2.9 3.9L2.75 11.5a1.4 1.4 0 0 0 2 2l4.85-4.85a3 3 0 0 0 3.9-2.9l-1.9 1.9-1.6-.4-.4-1.6z" />
            break;
        case "success":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.5 8.25 1.75 1.75 3.25-3.5" />
            break;
        case "warning":
            <path d="M8 2.75 14 13H2z" />
            <path d="M8 6.75v3M8 11.5v.01" />
            break;
        case "failed":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.75 5.75 4.5 4.5M10.25 5.75l-4.5 4.5" />
            break;
        case "cancelled":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m4 12 8-8" />
            break;
        case "user":
            <circle cx="8" cy="5.5" r="2.5" />
            <path d="M3 13.5c.6-2.4 2.5-3.5 5-3.5s4.4 1.1 5 3.5" />
            break;
        default:
            <circle cx="8" cy="8" r="2.25" />
            <path d="M8 2v1.6M8 12.4V14M2 8h1.6M12.4 8H14M3.8 3.8l1.1 1.1M11.1 11.1l1.1 1.1M12.2 3.8l-1.1 1.1M4.9 11.1l-1.1 1.1" />
            break;
    }
</svg>
