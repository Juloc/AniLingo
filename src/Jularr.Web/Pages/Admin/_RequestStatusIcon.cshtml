@model string
@* Small decorative status glyph of a request state pill; the state name always sits next to it. *@
<svg class="admreq-state-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "pending":
            <circle cx="8" cy="8" r="5.75" />
            <path d="M8 4.75V8l2.25 1.5" />
            break;
        case "approved":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.5 8.25 1.75 1.75 3.25-3.5" />
            break;
        case "searching":
            <circle cx="7" cy="7" r="4" />
            <path d="m10 10 3.5 3.5" />
            break;
        case "downloading":
            <path d="M8 2.75v7.5M4.75 7.5 8 10.75l3.25-3.25M3 13.25h10" />
            break;
        case "importing":
            <path d="M2.75 9.5h3l.75 1.75h3L10.25 9.5h3M2.75 9.5V12a1 1 0 0 0 1 1h8.5a1 1 0 0 0 1-1V9.5M8 2.75v5M5.75 5.75 8 8l2.25-2.25" />
            break;
        case "completed":
            <path d="m3.5 8.5 3 3 6-7" />
            break;
        case "rejected":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.75 5.75 4.5 4.5M10.25 5.75l-4.5 4.5" />
            break;
        default:
            <path d="M8 2.75 14 13H2z" />
            <path d="M8 6.75v3M8 11.5v.01" />
            break;
    }
</svg>
