@page "/Admin/ReadingSources"
@model Jularr.Web.Pages.Admin.ReadingSourcesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = "Reading sources";
}

<header class="page-header">
    <div>
        <a class="muted" asp-page="/Admin/Index">← @ui["common.back"]</a>
        <h1>Reading sources</h1>
        <p>Control which Light Novel sources appear in manual search and their order.</p>
    </div>
</header>

@if (TempData["Status"] is string status)
{
    <div class="panel" role="status">@status</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="panel" role="alert">@Model.LoadError</div>
}

<form method="post" asp-page-handler="Save">
    <div class="settings-grid">
        @foreach (var source in Model.Sources)
        {
            <section class="panel">
                <div class="panel-heading">
                    <div>
                        <h2>@source.Definition.Name</h2>
                        <p class="muted">@source.Definition.Description</p>
                    </div>
                    <label>
                        @if (source.Preference.Enabled)
                        {
                            <input type="checkbox"
                                   name="enabledProviders"
                                   value="@source.Definition.Key"
                                   checked />
                        }
                        else
                        {
                            <input type="checkbox"
                                   name="enabledProviders"
                                   value="@source.Definition.Key" />
                        }
                        Enabled
                    </label>
                </div>

                <div class="form-field">
                    <label for="priority-@source.Definition.Key">Priority</label>
                    <input id="priority-@source.Definition.Key"
                           type="number"
                           min="1"
                           max="999"
                           name="priority[@source.Definition.Key]"
                           value="@source.Preference.Priority" />
                    <span class="muted">Lower numbers are shown first when matches are equally relevant.</span>
                </div>

                <div class="muted">
                    @(source.Definition.SupportsDirectImport
                        ? "Can be imported directly when the account has direct-add permission."
                        : "Used for metadata and the normal acquisition/request flow.")
                </div>

                @if (ViewData.ModelState.TryGetValue(source.Definition.Key, out var errorState) &&
                     errorState.Errors.Count > 0)
                {
                    <div role="alert">@errorState.Errors[0].ErrorMessage</div>
                }
            </section>
        }
    </div>

    <div class="form-actions">
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
    </div>
</form>
