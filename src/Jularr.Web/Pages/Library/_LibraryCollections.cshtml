@using Jularr.Web.Features.Collections
@using Jularr.Web.Features.Localization
@model (IReadOnlyList<CollectionTileView> Tiles, UiTextBundle Ui)
@* The Collections view of the Library (docs/mockups/library): large artwork tiles, a 2x2 mosaic of the first
   posters, the name, the number of titles and a Manual / Smart marker. Styles: wwwroot/css/library.css. *@
@{
    var ui = Model.Ui;
    var tiles = Model.Tiles;
    string Items(int count) => count == 1 ? ui["library.browse.countOne"] : ui.Format("library.browse.count", ("count", count));
}
@if (tiles.Count == 0)
{
    <div class="empty-state">
        <p>@ui["library.browse.collections.empty"]</p>
        <a class="button" href="/Collections">@ui["library.browse.collections.create"]</a>
    </div>
}
else
{
    <div class="lib-toolbar">
        <p class="lib-count">@(tiles.Count == 1 ? ui["library.browse.collections.countOne"] : ui.Format("library.browse.collections.count", ("count", tiles.Count)))</p>
        <div class="lib-controls">
            <a class="lib-btn" href="/Collections">@ui["library.browse.collections.manage"]</a>
        </div>
    </div>

    <ul class="lib-collections">
        @foreach (var tile in tiles)
        {
            var full = tile.PosterUrls.Count >= CollectionService.MosaicSize;
            <li>
                <a class="lib-tile" href="@Url.Page("/Collections/Detail", new { id = tile.Id })">
                    <span class="lib-tile-art@(full ? " is-mosaic" : "")" aria-hidden="true">
                        @if (tile.PosterUrls.Count == 0)
                        {
                            <span class="lib-card-initial">@(tile.Name.Length > 0 ? tile.Name[..1].ToUpperInvariant() : "·")</span>
                        }
                        else if (full)
                        {
                            @foreach (var poster in tile.PosterUrls.Take(CollectionService.MosaicSize))
                            {
                                <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                            }
                        }
                        else
                        {
                            <img src="@tile.PosterUrls[0]" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                        }
                    </span>
                    <span class="lib-tile-copy">
                        <strong>@tile.Name</strong>
                        <span class="lib-tile-meta">
                            <span>@Items(tile.ItemCount)</span>
                            <span class="lib-kind">@ui[tile.Kind == CollectionKind.Smart ? "library.browse.collections.kind.smart" : "library.browse.collections.kind.manual"]</span>
                        </span>
                    </span>
                </a>
            </li>
        }
    </ul>
}
