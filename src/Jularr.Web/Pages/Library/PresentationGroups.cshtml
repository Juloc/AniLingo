@page "/Library/PresentationGroups/{id:guid}"
@model Jularr.Web.Pages.Library.PresentationGroupsModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("library.presentation.pageTitle", ("work", Model.WorkTitle));
}

@section Head {
    <link rel="stylesheet" href="~/css/library-presentation.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" href="@Model.BackUrl">&larr; @Model.WorkTitle</a>
        <h1>@ui["library.presentation.title"]</h1>
        <p>@ui.Format("library.presentation.description", ("units", Model.Units))</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <p class="metadata-error" style="color:inherit">@Model.StatusMessage</p>
}

@if (Model.GroupableItemCount == 0)
{
    <section class="panel">
        <p class="muted">@ui.Format("library.presentation.noItems", ("units", Model.Units))</p>
    </section>
}
else
{
    <div class="settings-grid">
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["library.presentation.editHeading"]</h2>
            </div>
            <form method="post" asp-route-id="@Model.WorkId" asp-route-media="@Model.MediaRouteValue" class="form-stack">
                @for (var i = 0; i < Model.Groups.Count; i++)
                {
                    var group = Model.Groups[i];
                    <div class="presentation-editor-group">
                        <div class="presentation-editor-group-head">
                            <label>
                                <span>@ui["library.presentation.groupNameLabel"]</span>
                                <input type="text"
                                       name="Groups[@i].Name"
                                       value="@group.Name"
                                       maxlength="80"
                                       placeholder="@ui["library.presentation.groupNamePlaceholder"]" />
                            </label>
                            <label>
                                <span>@ui["library.presentation.orderLabel"]</span>
                                <input class="presentation-editor-order"
                                       type="number"
                                       name="Groups[@i].Order"
                                       value="@group.Order"
                                       min="1" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(group.Name))
                            {
                                <label class="presentation-editor-delete">
                                    <input type="checkbox" name="Groups[@i].Delete" value="true" />
                                    <span>@ui["library.presentation.deleteGroup"]</span>
                                </label>
                            }
                        </div>
                        <div class="presentation-editor-ranges">
                            @for (var j = 0; j < group.Ranges.Count; j++)
                            {
                                var range = group.Ranges[j];
                                <div class="presentation-editor-range">
                                    <label>
                                        <span>@ui.Format("library.presentation.rangeFrom", ("units", Model.Units))</span>
                                        <input type="number"
                                               name="Groups[@i].Ranges[@j].Start"
                                               value="@(range.Start?.ToString())"
                                               min="1" />
                                    </label>
                                    <label>
                                        <span>@ui["library.presentation.rangeTo"]</span>
                                        <input type="number"
                                               name="Groups[@i].Ranges[@j].End"
                                               value="@(range.End?.ToString())"
                                               min="1"
                                               placeholder="@ui["library.presentation.rangeToPlaceholder"]" />
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="inline-actions">
                    <button class="button" type="submit" asp-page-handler="Preview">@ui["library.presentation.previewButton"]</button>
                    <button class="button button-primary" type="submit" asp-page-handler="Apply">@ui["library.presentation.apply"]</button>
                </div>
            </form>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["library.presentation.previewHeading"]</h2>
                @if (Model.PreviewIsUnsaved)
                {
                    <span>@ui["library.presentation.previewUnsaved"]</span>
                }
            </div>
            @if (Model.Preview.Count == 0)
            {
                <p class="muted">@ui.Format("library.presentation.previewEmpty", ("units", Model.Units))</p>
            }
            else
            {
                @foreach (var groupSection in Model.Preview)
                {
                    <details class="presentation-group" open>
                        <summary class="presentation-group-summary">
                            <span class="presentation-group-name">@groupSection.Name</span>
                            <span class="presentation-group-count">@ui.Format("library.presentation.itemCount", ("count", groupSection.Items.Count), ("units", Model.PreviewItemUnits))</span>
                        </summary>
                        <div class="episode-list">
                            @foreach (var item in groupSection.Items)
                            {
                                <div class="episode-row-shell">
                                    <div class="episode-row">
                                        <div class="episode-number">@item.UnitLabel</div>
                                        <div class="episode-main">
                                            <strong>@item.Title</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                }
            }
            <p class="presentation-reference">@ui.Format("library.presentation.reference", ("count", Model.GroupableUnitCount), ("units", Model.Units), ("first", Model.FirstUnit), ("last", Model.LastUnit))</p>
        </section>
    </div>
}
